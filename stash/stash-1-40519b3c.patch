+
+
+class ScriptRepairTests(unittest.TestCase):
+    def test_all_shot_targets_resolve_uniquely(self):
+        paths = [
+            "lobomig/scripts/firemissiles_ic1.sqs",
+            "lobomig/scripts/firemissiles_ic2.sqs",
+            "lobof5/scripts/firemissiles2.sqs",
