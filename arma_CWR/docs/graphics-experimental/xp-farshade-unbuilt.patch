+    {
+        const GLuint base = _shaderProgramRemaster[VSTransform][0][0][L.ps];
+        const char* body = Poseidon::gl33lighting::RemasterFragmentMain(L.ps);
+        if (!base || !body)
+            continue;
+        const std::string src = common + body;
+        if (dumpDir && *dumpDir)
+        {
+            // The base program again, linked retrievable (a cache-restored one may not be).
+            const GLuint fs = CompileGLShader(GL_FRAGMENT_SHADER, src.c_str(), "xpBaseCopy");
+            if (fs)
+            {
+                const GLuint copy = FinishLinkProgramRetrievable(BeginLinkProgramRetrievable(vsObj, fs), "xpBaseCopy");
+                XpDumpProgram(copy, dumpDir, std::string(L.name) + "-base");
+                if (copy)
+                    glDeleteProgram(copy);
+                glDeleteShader(fs);
+            }
+        }
+        for (int t = 1; t <= 2; ++t)
+        {
+            const bool far = t == static_cast<int>(XpTwin::Far);
+            if (!far && _xpFarShade < 2)
+                continue;
+            const std::string twinSrc = XpTwinSource(src, far, _xpFarShade >= 3);
+            const std::string name = std::string(L.name) + (far ? "RemasterXpFar" : "RemasterXpLean");
+            const GLuint fs = CompileGLShader(GL_FRAGMENT_SHADER, twinSrc.c_str(), name.c_str());
+            if (!fs)
+                continue;
+            const GLuint prog = FinishLinkProgramRetrievable(BeginLinkProgramRetrievable(vsObj, fs), name.c_str());
+            glDeleteShader(fs);
+            if (!prog)
+                continue;
+            bindSamplersAndBlocks(prog);
+            XpDumpProgram(prog, dumpDir, std::string(L.name) + (far ? "-far" : "-lean"));
+            _xpTwinPrograms.push_back(prog);
+            if (_xpTwinOf[t].size() <= base)
+                _xpTwinOf[t].resize(base + 64, 0);
+            _xpTwinOf[t][base] = prog;
+            if (_xpBaseOf.size() <= prog)
+                _xpBaseOf.resize(prog + 64, 0);
+            _xpBaseOf[prog] = base;
+            ++built;
+        }
+    }
+    s_worldProgramBound = 0; // bindSamplersAndBlocks left program 0 bound
+    LOG_INFO(Graphics, "GL33: xp-farshade level {}: {} twin programs built in {} ms", _xpFarShade, built,
+             std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count());
+}
