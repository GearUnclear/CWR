+
+namespace
+{
+// The far twin's distance floor: every distance-faded term it drops is exactly
+// nothing past it (terrain detail kTdMaxDistance 300 m; the land's relief and
+// cavity 80 and 200 m; the objects' relief and cavity 60 m).
+constexpr float kXpFarDistance = 300.0f;
+// The shape's bounding box may not hold every drawn vertex (land-fitted
+// vertices, animated parts): its radius is taken this much larger, plus this
+// many metres.
+constexpr float kXpRadiusScale = 1.25f;
+constexpr float kXpRadiusPad = 20.0f;
+} // namespace
+
+void EngineGL33::XpDecideMesh(const Shape& sMesh)
+{
+    const XpTwin rest = _xpFarShade >= 2 ? XpTwin::Lean : XpTwin::Base;
+    _xpMeshWant = rest;
+    if (!_remasterPrograms || !_worldPassOpen)
+        return;
+    const Vector3 mn = sMesh.Min();
+    const Vector3 mx = sMesh.Max();
+    const float c[3] = {0.5f * (mn.X() + mx.X()), 0.5f * (mn.Y() + mx.Y()), 0.5f * (mn.Z() + mx.Z())};
+    const float hx = 0.5f * (mx.X() - mn.X()), hy = 0.5f * (mx.Y() - mn.Y()), hz = 0.5f * (mx.Z() - mn.Z());
+    const float half = std::sqrt(hx * hx + hy * hy + hz * hz);
+    float reach = 0.0f;
+    float fwd[3] = {0.0f, 0.0f, 1.0f};
+    const bool shadows = XpShadowReach(reach, fwd);
+    // The lit pass's shadow lookup point is the fragment plus the camera's
+    // move since the shadow pass (litShadowDelta).
+    const float delta[3] = {_frameState.cameraPos[0] - _shadowCamPos[0], _frameState.cameraPos[1] - _shadowCamPos[1],
+                            _frameState.cameraPos[2] - _shadowCamPos[2]};
+    // Every instance (or the one object) wholly past both thresholds.
+    auto farOf = [&](const GfxMatrix& m)
+    {
+        // Camera-relative centre (row vector times the row-major matrix) and a
+        // radius bound (the 3x3 part's Frobenius norm bounds its largest scale).
+        const float w[3] = {c[0] * m._11 + c[1] * m._21 + c[2] * m._31 + m._41,
+                            c[0] * m._12 + c[1] * m._22 + c[2] * m._32 + m._42,
+                            c[0] * m._13 + c[1] * m._23 + c[2] * m._33 + m._43};
+        const float s2 = m._11 * m._11 + m._12 * m._12 + m._13 * m._13 + m._21 * m._21 + m._22 * m._22 + m._23 * m._23 +
+                         m._31 * m._31 + m._32 * m._32 + m._33 * m._33;
+        const float r = half * std::sqrt(s2) * kXpRadiusScale + kXpRadiusPad;
+        const float dist = std::sqrt(w[0] * w[0] + w[1] * w[1] + w[2] * w[2]);
+        if (dist - r < kXpFarDistance)
+            return false;
+        if (!shadows)
+            return true;
+        const float eye = (w[0] + delta[0]) * fwd[0] + (w[1] + delta[1]) * fwd[1] + (w[2] + delta[2]) * fwd[2];
+        return eye - r > reach;
+    };
+    bool far = true;
+    if (_instCount > 1)
+    {
+        for (int i = 0; i < _instCount && far; ++i)
+            far = farOf(_instArray[i]);
+    }
+    else
+    {
+        far = farOf(_currentDrawItem.worldMatrix);
+    }
+    if (far)
+        _xpMeshWant = XpTwin::Far;
+    ++_xpDraws[static_cast<int>(_xpMeshWant)];
+    const std::uint32_t frame = GetFrameCounter();
+    if (frame - _xpLogFrame >= 600)
+    {
+        _xpLogFrame = frame;
+        LOG_INFO(Graphics, "GL33: xp-farshade level {}: meshes base {} lean {} far {} (600 frames), shadow reach {} m",
+                 _xpFarShade, _xpDraws[0], _xpDraws[1], _xpDraws[2], shadows ? reach : 0.0f);
+        _xpDraws[0] = _xpDraws[1] = _xpDraws[2] = 0;
+    }
 }
