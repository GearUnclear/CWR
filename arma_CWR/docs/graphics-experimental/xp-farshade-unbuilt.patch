+// ---- Experiment xp-farshade (POSEIDON_XP_FARSHADE; EngineGL33.hpp XpTwin) ----
+
+// A twin's fragment source: the remastered source with its defines after the
+// #version line. Without them the preprocessed text is the base program's.
+std::string XpTwinSource(const std::string& src, bool far, bool fog)
+{
+    const size_t eol = src.find('\n');
+    if (eol == std::string::npos)
+        return {};
+    std::string out = src.substr(0, eol + 1);
+    out += "#define UD_LEAN 1\n";
+    if (far)
+        out += "#define UD_FAR 1\n";
+    if (far && fog)
+        out += "#define UD_FAR_FOG 1\n";
+    out += src.substr(eol + 1);
+    return out;
+}
+
+// POSEIDON_XP_FARSHADE_DUMP=<dir>: each linked program's driver binary (the NV
+// blob carries the driver's assembly text) for comparing the twins offline.
+void XpDumpProgram(GLuint prog, const char* dir, const std::string& name)
+{
+    if (!dir || !*dir || !prog)
+        return;
+    ShaderCacheEntry e;
+    if (!CaptureProgramBinary(prog, e))
+        return;
+    std::error_code ec;
+    std::filesystem::create_directories(dir, ec);
+    std::ofstream out(std::filesystem::path(dir) / ("xp-" + name + ".bin"), std::ios::binary);
+    out.write(reinterpret_cast<const char*>(e.blob.data()), static_cast<std::streamsize>(e.blob.size()));
+}
 } // namespace
 
+bool EngineGL33::XpShadowReach(float& reach, float fwd[3]) const
+{
+    // What UploadShadowConstants handed the lit programs (ctl.x, the splits,
+    // the shadow pass's camera forward).
+    if (s_psShadow[2 * 4] < 0.5f)
+        return false;
+    const int n = std::clamp(static_cast<int>(s_psShadow[25 * 4] + 0.5f), 0, 4);
+    if (n <= 0)
+        return false;
+    reach = 0.0f;
+    for (int i = 0; i < n; ++i)
+        reach = std::max(reach, s_psShadow[24 * 4 + i]);
+    for (int i = 0; i < 3; ++i)
+        fwd[i] = s_psShadow[26 * 4 + i];
+    return true;
+}
+
+unsigned int EngineGL33::XpTwinFor(unsigned int prog, XpTwin want) const
+{
+    const int w = static_cast<int>(want);
+    if (w <= 0 || w > 2 || prog >= _xpTwinOf[w].size())
+        return 0;
+    return _xpTwinOf[w][prog];
+}
+
+void EngineGL33::XpSyncProgram()
+{
+    // s_worldProgramBound is trusted only while _pixelShaderSel is a selection.
+    if (!_xpFarShade || _pixelShaderSel == PSNone)
+        return;
+    const GLuint cur = s_worldProgramBound;
+    if (!cur)
+        return;
+    const GLuint base = (cur < _xpBaseOf.size() && _xpBaseOf[cur]) ? _xpBaseOf[cur] : cur;
+    GLuint want = base;
+    if (_xpWant != XpTwin::Base)
+    {
+        const GLuint twin = XpTwinFor(base, _xpWant);
+        if (twin)
+            want = twin;
+    }
+    if (want == cur)
+        return;
+    glUseProgram(want);
+    s_worldProgramBound = want;
+    // The per-program uniforms (surfClass, decalLayerMode) follow the bound one.
+    if (_surfBoundProgram)
+        _surfBoundProgram = want;
+}
+
+void EngineGL33::XpDeleteTwins()
+{
+    if (!_xpTwinPrograms.empty())
+    {
+        if (std::find(_xpTwinPrograms.begin(), _xpTwinPrograms.end(), s_worldProgramBound) != _xpTwinPrograms.end())
+        {
+            glUseProgram(0);
+            s_worldProgramBound = 0;
+        }
+        for (unsigned int prog : _xpTwinPrograms)
+            glDeleteProgram(prog);
+    }
+    _xpTwinPrograms.clear();
+    for (auto& v : _xpTwinOf)
+        v.clear();
+    _xpBaseOf.clear();
+    _xpMeshWant = XpTwin::Base;
+    _xpWant = XpTwin::Base;
+}
