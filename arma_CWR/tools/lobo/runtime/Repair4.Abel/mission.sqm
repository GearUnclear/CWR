version=11;
class Mission
{
    // Runtime probes for LoBo repair 2026-10-11.4 (lobo #13, #14 and the #9
    // runtime items). Same addOns[] and WEST player as Repair3.Abel, plus one
    // EAST group led by a LoBo_Egypt_Pilot (r4East) far from the test area, so
    // a probe can create AI crew in a group other than the player's.
    // LoBoWeapNad owns LoBo_throw2 in that pilot's weapons[] and LoBo_Pilot does
    // not require it. Without it the placed pilot fails CheckAccess, which
    // rejects the boot and leaves Trident flashing the main menu
    // (agent_guidelines/flashing-main-menu.md).
    // LoBoEgypt, LoBo_M1, LoBo_F5, LoBo_Objects, LoBo_FAB and LoBoRadios own
    // the classes repair4/lobo_restored_content (R7) creates from its script
    // (Egyptian infantry, Guard M1s, F-5s, medic barrack, Snunit, BAS_Satcom);
    // check_mission_addons.py reports them MISSING without these entries.
    addOns[]={"LoBoWeapons","LoBoWeapNad","LoBoammo","LoBo_airammo","LoBo_MiG","LoBo_A4","LoBo_F4","LoBo_IL28","LoBoF15","LoBoF16","LoBoTerror","LoBoMerkava2","LoBoEghelo","JAM_Magazines","JAM_Vehicles","LoBo_Sounds","LoBo_Pilot","LoBoEgypt","LoBo_M1","LoBo_F5","LoBo_Objects","LoBo_FAB","LoBoRadios"};
    randomSeed=20261012;
    class Intel { viewDistance=1800; year=1985; month=6; day=15; hour=12; minute=0; };
    class Groups
    {
        items=2;
        class Item0
        {
            side="WEST";
            class Vehicles
            {
                items=1;
                class Item0
                {
                    position[]={7985,0,9450}; azimut=0; id=0; side="WEST";
                    vehicle="SoldierWB"; player="PLAYER COMMANDER"; leader=1; skill=0.6;
                };
            };
        };
        class Item1
        {
            side="EAST";
            class Vehicles
            {
                items=1;
                class Item0
                {
                    position[]={7000,0,9000}; azimut=0; id=1; side="EAST";
                    vehicle="LoBo_Egypt_Pilot"; leader=1; skill=0.6;
                    text="r4East";
                };
            };
        };
    };
};
