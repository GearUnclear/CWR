// Market.Abel - playable test mission for the headquarters / cache / garage /
// dealer loop (native GuerrillaBase + Market, driven by the campaign's own
// scripts/market.sqs policy layer), on the Houdan plain of Abel (Malden,
// full CWA 1.99 data).
//
// HOOKED INTO THE MAIN MODE'S SYSTEMS, NOT A RE-IMPLEMENTATION: the three
// files under scripts/ (lib.sqs, market.sqs, market_action.sqs) are
// BYTE-IDENTICAL copies of the Guerrilla.* shared core
// (test_mission_script_core.cpp enforces it for every Market.* template),
// and the HQ / garage / dealer state they act on is the same native engine
// code a Guerrilla campaign runs. Only the bootstrap (init.sqs), the debug
// actions (act_*.sqs) and the readout (hud.sqs) are mission-local, so the
// money loop is the only moving part on display - the other campaign
// managers (capture, economy, recruit, qrf, civilians, ...) are
// deliberately NOT started, and the treasury is seeded fat (50000 R) so
// every stock row is affordable.
//
// install-missions.ps1 installs it like the other templates; once installed
// it is launchable straight from the main menu's MARKET button
// (kReferenceMissions, UI/OptionsUIApp.cpp) or via
// run-game.ps1 -Mission 'Missions\Market.Abel'.
//
// What activates what:
//   * class CfgGuerrillaZones -> ZoneRegistry (+ GuerrillaBase, TownFlags,
//     Traffic, ...) go live natively at mission load. seedCities=1 turns
//     every named town of Malden into a CITY zone - the dealers are drawn
//     over those, and any CITY is an HQ candidate (Houdan, ~490 m NW of the
//     start, is the nearest: act_tp_town.sqs).
//   * Camp (RESISTANCE) at the player start on the fig-tree plain: a
//     building-less CAMP zone, so "Establish headquarters here" at the
//     Camp exercises the EDGE-OF-TOWN fallback (outdoor cache + garage).
//   * class CfgGuerrillaMarket -> Market: ~a third of the CITY zones get an
//     arms dealer, a third a vehicle dealer (independent draws, seeded once
//     and serialized); the stock below is the Classic 1.99 roster.

onLoadMission = "Market Test - Houdan plain (Malden)";
onLoadIntro = "A fat treasury, dealers in the towns, and a headquarters to found. Buy, stash, lock, move.";
respawn = 0;
joinInProgress = 0;

class CfgGuerrillaZones
{
    // Engine tuning at stock defaults (zoneArea=150; cacheRadius=800;
    // revealRadius=1500; hqMinPos=4; garageRadius=100; garageInvulnerable=1).
    // Direct-launch faction fallbacks (the menu button publishes no gmSel*):
    defaultOccupier = "EAST";
    defaultResistance = "GUER";
    playerSide = "GUER";
    seedCities = 1;       // every named town of Malden is a CITY zone
    seedCitySupport = 20;

    class Zones
    {
        // position[] is script/getPos order [easting, northing, elevation]
        // (NOT the mission.sqm order) - ZoneRegistry::LoadZones enforces it.
        class Camp
        {
            name = "Camp";
            type = "CAMP";
            owner = "RESISTANCE";
            garrison = 0;
            support = 100;
            income = 0;
            marker = "gmZoneMarker_0";
            position[] = {7515, 5790, 20}; // player start, fig-tree plain SE of Houdan (dry)
        };
    };
};

// The dealer market: tuning + the Classic 1.99 stock. Every classname below
// is verified against Bin\CONFIG.BIN (PoseidonTools config search); the
// engine re-probes them at load and drops what a package lacks (logged).
// OFP magazine convention: a simple weapon IS its own magazine class, so the
// magazine keys reuse the weapon classname; launcher grenades, hand grenades
// and explosives are magazine-only bundles (weapon = "").
class CfgGuerrillaMarket
{
    dealerShare = 0.34;          // fraction of CITY zones per dealer kind
    dealerRespawnSeconds = 600;  // a killed dealer is back after this
    hqMoveCost = 500;            // R debited by market.sqs when MOVING the HQ
    // dealerClass falls back to the CIV descriptor's civClass1, then "Civilian"
    // weaponDealers[] / vehicleDealers[] left absent: the towns are drawn

    class Weapons
    {
        class AK47       { weapon = "AK47";               magazine = "AK47";              mags = 4; price = 220; };
        class AK74       { weapon = "AK74";               magazine = "AK74";              mags = 4; price = 260; };
        class AK47CZ     { weapon = "AK47CZ";             magazine = "AK47";              mags = 4; price = 240; };
        class AK74SU     { weapon = "AK74SU";             magazine = "AK74";              mags = 4; price = 240; };
        class M16        { weapon = "M16";                magazine = "M16";               mags = 4; price = 280; };
        class HK         { weapon = "HK";                 magazine = "HK";                mags = 5; price = 300; };
        class M16GL      { weapon = "M16GrenadeLauncher"; magazine = "M16";               mags = 4; price = 420; };
        class AK74GL     { weapon = "AK74GrenadeLauncher"; magazine = "AK74";             mags = 4; price = 400; };
        class GLGrenades { weapon = "";                   magazine = "GrenadeLauncher";   mags = 6; price = 90; };
        class M21        { weapon = "M21";                magazine = "M21";               mags = 4; price = 600; };
        class SVD        { weapon = "SVDDragunov";        magazine = "SVDDragunov";       mags = 4; price = 650; };
        class PK         { weapon = "PK";                 magazine = "PK";                mags = 2; price = 900; };
        class M60        { weapon = "M60";                magazine = "M60";               mags = 2; price = 950; };
        class LAW        { weapon = "LAWLauncher";        magazine = "LAWLauncher";       mags = 2; price = 500; };
        class RPG        { weapon = "RPGLauncher";        magazine = "RPGLauncher";       mags = 2; price = 550; };
        class CarlGustav { weapon = "CarlGustavLauncher"; magazine = "CarlGustavLauncher"; mags = 2; price = 900; };
        class AT4        { weapon = "AT4Launcher";        magazine = "AT4Launcher";       mags = 2; price = 900; };
        class Strela     { weapon = "9K32Launcher";       magazine = "9K32Launcher";      mags = 1; price = 1200; };
        class Stinger    { weapon = "AALauncher";         magazine = "AALauncher";        mags = 1; price = 1200; };
        class Binocular  { weapon = "Binocular";          magazine = "";                            price = 60; };
        class NVGoggles  { weapon = "NVGoggles";          magazine = "";                            price = 250; };
        class Grenades   { weapon = "";                   magazine = "HandGrenade";       mags = 4; price = 80; };
        class Mines      { weapon = "";                   magazine = "Mine";              mags = 2; price = 150; };
        class Satchels   { weapon = "";                   magazine = "PipeBomb";          mags = 2; price = 200; };
    };
    class Vehicles
    {
        class Skoda      { vehicle = "Skoda";      price = 600; };
        class Rapid      { vehicle = "Rapid";      price = 700; };
        class Tractor    { vehicle = "Tractor";    price = 500; };
        class Jeep       { vehicle = "Jeep";       price = 1500; };
        class GJeep      { vehicle = "GJeep";      price = 1400; };
        class UAZ        { vehicle = "UAZ";        price = 1400; };
        class JeepMG     { vehicle = "JeepMG";     price = 3000; };
        class UAZG       { vehicle = "UAZG";       price = 3000; };
        class Truck5t    { vehicle = "Truck5t";    price = 3500; };
        class Ural       { vehicle = "Ural";       price = 3500; };
        class TruckV3SG  { vehicle = "TruckV3SG";  price = 3200; };
        class M113       { vehicle = "M113";       price = 9000; };
        class BMP        { vehicle = "BMP";        price = 12000; };
        class T55G       { vehicle = "T55G";       price = 20000; };
    };
};

// Faction descriptors, copied verbatim from Qrf.Abel / Showcase.Abel (every
// classname verified against the 1.99 Bin\CONFIG.BIN). The CIV descriptor
// supplies the dealer body (civClass1) and keeps the ambient traffic alive.
class CfgGuerrillaFactions
{
    class EAST // occupier descriptor
    {
        side = "EAST";
        tiers[] = {"SoldierEB", "SoldierEG", "SoldierECrew"};
        tierThresholds[] = {3, 5};
        tiersMG[]     = {"SoldierEMG", "SoldierEMG", "SoldierEMG"};
        tiersAT[]     = {"SoldierELAW", "SoldierELAW", "SoldierELAW"};
        tiersMedic[]  = {"SoldierEMedic", "SoldierEMedic", "SoldierEMedic"};
        tiersSniper[] = {"", "", "SoldierESniper"};
        vehicles[] = {"UAZ", "Ural", "BMP", "T72"};
        vehicleThresholds[] = {3, 6, 8};
        officer = "OfficerE";
        flag = "\flags\ussr.jpg";
    };
    class GUER // resistance descriptor
    {
        side = "GUER";
        tiers[] = {"SoldierGB"};
        tierThresholds[] = {};
        tiersMG[]    = {"SoldierGMG"};
        tiersAT[]    = {"SoldierGLAW"};
        tiersMedic[] = {"SoldierGMedic"};
        vehicles[] = {"GJeep", "TruckV3SG", "BMP", "T55G"};
        vehicleThresholds[] = {4, 7, 9};
        officer = "SoldierGB";

        holdClass = "SoldierGB";
        holdCount = 3;
        recruitFighter = "SoldierGB";
        recruitSpecialist = "SoldierGMG";
        companionClass = "SoldierGB";

        baseWeapon = "AK47";
        baseMagazine = "AK47";
        lootRiflemanWeapon = "AK47";
        lootRiflemanMag = "AK47";
        lootMedicWeapon = "AK47";
        lootMedicMag = "AK47";
        lootMGWeapon = "PK";
        lootMGMag = "PK";
        lootATWeapon = "RPGLauncher";
        lootATMag = "RPGLauncher";
        lootSniperWeapon = "SVDDragunov";
        lootSniperMag = "SVDDragunov";

        flag = "\flags\fia.jpg";
    };
    class CIV // civilian population descriptor (dealer bodies + traffic)
    {
        side = "CIV";
        civClassCount = 3;
        civClass1 = "Civilian";
        civClass2 = "Civilian2";
        civClass3 = "Civilian3";
        // Kept in sync with Guerrilla.Abel (see the comment there: Trabant/
        // Mini/Bus are Resistance-era addon-pbo classes shipped with 1.99).
        civVehicles[] = {"Skoda", "SkodaBlue", "SkodaRed", "SkodaGreen", "Rapid",
                         "Trabant", "Mini", "Bus", "Tractor"};
    };
};
