// Undercover.Abel - playable test mission for the deep-undercover layer
// (engine/Poseidon/Game/Guerrilla/Undercover.*), set in the real town of
// Houdan on Abel (Malden, full CWA 1.99 data).
//
// NOT a full Guerrilla.*/Showcase.* shared-core mission: its own bootstrap
// (init.sqs + hud/patrol/act_*.sqs) starts ONLY the disguise layer, but the
// cover policy it runs is the campaign's real \gmcore\scripts\undercover.sqs
// (+ its lib.sqs helpers) straight out of the ONE shared core (issue #54 B1,
// pinned by test_mission_script_core.cpp) - so the undercover system is the
// only moving part on display and never a drifted re-implementation.
// install-missions.ps1 installs it like the other templates, and
// once installed it is launchable straight from the main menu's UNDERCOVER
// button (kReferenceMissions, UI/OptionsUIApp.cpp) or via
// run-game.ps1 -Mission 'Missions\Undercover.Abel'.
//
// What activates what:
//   * class CfgGuerrillaZones     -> ZoneRegistry + AlertMachine + Undercover
//     go live natively; init.sqs supplies the captive + gmUndercover baseline.
//   * Houdan CITY zone            -> the Heat spike target nearest any in-town
//     witness (CITY zones are never natively garrisoned - the in-town patrol
//     and checkpoint are scripted in init.sqs).
//   * Checkpoint OUTPOST zone     -> native garrison of 6, spawned at boot
//     (inside the 800 m cacheRadius of the player start).

onLoadMission = "Undercover Test - Houdan (Malden)";
onLoadIntro = "Pass as a civilian. A rifle lies in the town square - what happens next is up to you.";
respawn = 0;
joinInProgress = 0;

class CfgGuerrillaZones
{
    // Engine tuning stays at stock defaults (undercoverNoticeRadius=20;
    // undercoverBackArcCos=-0.2; boosts 2.0/1.4; alertHeatBreak=25;
    // undercoverHeatWitness=8). Direct-launch faction fallbacks:
    defaultOccupier = "EAST";
    defaultResistance = "GUER";
    seedCities = 0; // just the two authored zones - keep the map readable

    class Zones
    {
        // position[] is script/getPos order [easting, northing, elevation]
        // (NOT the mission.sqm order) - ZoneRegistry::LoadZones enforces it.
        class Houdan
        {
            name = "Houdan";
            type = "CITY";
            owner = "NEUTRAL";
            support = 20;
            marker = "gmZoneMarker_0";
            position[] = {7117, 6069, 35}; // CfgWorlds >> Abel >> Names (Showcase survey)
        };
        class Checkpoint
        {
            name = "Checkpoint";
            type = "OUTPOST";
            owner = "OCCUPIER";
            garrison = 6;
            income = 25;
            marker = "gmZoneMarker_1";
            position[] = {7290, 5985, 30}; // ~250 m SE of town, inside cacheRadius
        };
    };
};

// Faction descriptors, copied verbatim from Showcase.Abel (every classname
// verified against the 1.99 Bin\CONFIG.BIN - see that file's header notes).
class CfgGuerrillaFactions
{
    class EAST // occupier descriptor
    {
        side = "EAST";
        tiers[] = {"SoldierEB", "SoldierEG", "SoldierECrew"};
        tierThresholds[] = {3, 5};
        tiersMG[]     = {"SoldierEMG", "SoldierEMG", "SoldierEMG"};
        tiersAT[]     = {"SoldierELAW", "SoldierELAW", "SoldierELAW"};
        tiersMedic[]  = {"SoldierEMedic", "SoldierEMedic", "SoldierEMedic"};
        tiersSniper[] = {"", "", "SoldierESniper"};
        vehicles[] = {"UAZ", "Ural", "BMP", "T72"};
        vehicleThresholds[] = {3, 6, 8};
        officer = "OfficerE";
        flag = "\flags\ussr.jpg";
    };
    class GUER // resistance descriptor
    {
        side = "GUER";
        tiers[] = {"SoldierGB"};
        tierThresholds[] = {};
        tiersMG[]    = {"SoldierGMG"};
        tiersAT[]    = {"SoldierGLAW"};
        tiersMedic[] = {"SoldierGMedic"};
        vehicles[] = {"GJeep", "TruckV3SG", "BMP", "T55G"};
        vehicleThresholds[] = {4, 7, 9};
        officer = "SoldierGB";

        holdClass = "SoldierGB";
        holdCount = 3;
        recruitFighter = "SoldierGB";
        recruitSpecialist = "SoldierGMG";
        companionClass = "SoldierGB";

        baseWeapon = "AK47";
        baseMagazine = "AK47";
        lootRiflemanWeapon = "AK47";
        lootRiflemanMag = "AK47";
        lootMedicWeapon = "AK47";
        lootMedicMag = "AK47";
        lootMGWeapon = "PK";
        lootMGMag = "PK";
        lootATWeapon = "RPGLauncher";
        lootATMag = "RPGLauncher";
        lootSniperWeapon = "SVDDragunov";
        lootSniperMag = "SVDDragunov";

        flag = "\flags\fia.jpg";
    };
};
