// Guerrilla Mode - Sinai island pack (issue #3 items 4+6: second island,
// different occupier). This file is the ONLY island-specific data in the
// template - init.sqs + scripts/ are byte-identical to Guerrilla.Demo (the
// shared island-agnostic core; a parity test enforces that). The war
// FACTIONS are no longer here: see the note above CfgGuerrillaFactions.
//
// The scenario is deliberately ASYMMETRIC to prove the sides are fully
// generalized: the OCCUPIER is the IDF (side WEST) and the RESISTANCE is the
// Egyptian Frontier Corps (side EAST). Classnames come from the @LoBo mod
// (Sinai world "sinai" in lost.pbo; CfgPatches LoBoIs / LoBoEgypt /
// JAM_Magazines / LoBoHMWV / LoBo_Zelda - all verified against the shipped
// configs).
//
// Defining class CfgGuerrillaZones activates the native guerrilla systems
// (ZoneRegistry / AlertMachine / GarrisonCache).

onLoadMission = "Guerrilla Mode - Sinai (IDF occupation)";
onLoadIntro  = "Drive the occupier out of the Sinai, one zone at a time.";
respawn = 0;
joinInProgress = 0;

class CfgGuerrillaZones
{
    // Side resolution when the new-game UI selections (gmSelOccupier /
    // gmSelResistance) are unset - i.e. any direct launch of this mission.
    // Values are CfgGuerrillaFactions class names from the MERGED faction
    // table (the @LoBo roster in @lobofixup); the engine resolves
    // them to sides (ZoneRegistry::ResolveSides): IDF -> WEST occupier,
    // EgyptFrontier -> EAST resistance.
    defaultOccupier = "IDF";
    defaultResistance = "EgyptFrontier";

    // The side mission.sqm welds the player's unit to (side="EAST",
    // LoBo_Egypt_FrtCrp). The campaign's RESISTANCE side is pinned to this:
    // the engine counts resistance presence via the resistance side's
    // center, so a resistance on any other side would never count the
    // player. The resistance cycler therefore picks a ROSTER, not a side.
    playerSide = "EAST";

    // Engine tuning left at stock defaults (tickInterval=3; zoneArea=150;
    // revealRadius=1500; cacheRadius=800; supportRate=5; supportFlip=60; ...).
    // Town auto-seed on: southern Sinai's Names block carries ~34 named
    // locations (type-less OFP-era entries -> all seed as CITY zones, deduped
    // within 300 m of the explicit zones below).
    seedCities = 1;
    seedCitySupport = 20;

    class Zones
    {
        // COORDINATE ORDER (load-bearing): position[] is authored in
        // script/getPos order [easting, northing, elevation] - NOT the
        // mission.sqm order [easting, ELEVATION, northing]. Elevations below
        // are the real sampled ground heights from sinai.wrp (4WVR, 256x256
        // grid at 50 m, LANDDATA_SCALE 0.045) - the earlier 120/160 values
        // were placeholders 30-150 m above the actual surface. The native
        // garrison spawn snaps units to the surface regardless (GarrisonCache
        // uses SurfaceYAboveWater), so these are cosmetic, but wrong ones make
        // every hand-check of a zone position look wrong too.
        //
        // Layout: the Camp sits in the open wadi floor south of the airbase
        // plateau, ~30 m below it and out of line of sight; the Wadi
        // Checkpoint is 552 m away so the occupier garrison distance-cache
        // (cacheRadius 800) engages as soon as the campaign starts; Ras
        // Nasrani Outpost is 1.8 km out - beyond cache range until the player
        // moves on it.
        //
        // DO NOT move the Camp back to {7900, 3200}. That spot is INSIDE the
        // fenced airbase compound that spans x 7687..8215, z 3167..4190 in
        // sinai.wrp (hangars, HAS shelter, control tower, barracks, ringed by
        // lobobloc\plot_provizorni_25 fence segments on all four sides). The
        // player spawned walled in with no way out, and it is an occupier
        // installation besides - the last place a resistance camp belongs.
        // Any new candidate must be flood-fill verified as reaching open
        // terrain, not just "no object within N metres": the compound
        // interior is one of the emptiest patches on the island.
        class Camp
        {
            name = "Camp";
            type = "CAMP";
            owner = "RESISTANCE";   // generic token, resolved per campaign
            garrison = 0;
            support = 100;
            income = 0;
            marker = "gmZoneMarker_0";
            position[] = {8350, 2950, 36};
        };
        class WadiCheckpoint
        {
            name = "Wadi Checkpoint";
            type = "OUTPOST";
            owner = "OCCUPIER";     // generic token, resolved per campaign
            garrison = 6;
            income = 25;
            marker = "gmZoneMarker_1";
            position[] = {8300, 3500, 65};
        };
        class RasNasraniOutpost
        {
            name = "Ras Nasrani Outpost";
            type = "OUTPOST";
            owner = "OCCUPIER";
            garrison = 8;
            income = 25;
            marker = "gmZoneMarker_2";
            position[] = {9100, 4600, 12};
        };
        // Explicit CITY on top of the world's named town (the auto-seed skips
        // any Names entry within 300 m of an explicit zone, so this REPLACES
        // the seeded "El Tor" with a hand-tuned one).
        class ElTor
        {
            name = "El Tor";
            type = "CITY";
            owner = "NEUTRAL";
            support = 35;
            marker = "gmZoneMarker_3";
            position[] = {6827, 2808, 32};
        };
    };
};

// The ISLAND half of the faction table (issue #54 A4). The @LoBo war rosters
// this campaign runs on - IDF, EgyptFrontier, EgyptArmy, Syria, Jordan,
// Hizballah, PLO, PLO_East - are NOT island facts (the Golani brigade is the
// same brigade here as in south Lebanon), so they moved to the mod-level
// config tests/fixtures/mods-lobo/@lobofixup/bin/config.cpp, mounted after
// @LoBo. The engine unions that global table with the block below
// (Game/Guerrilla/FactionSources.*), this file winning on a class-name
// collision, so the cyclers still offer the full @LoBo roster here.
//
// defaultOccupier/defaultResistance above name classes from that global
// table; they resolve against the MERGED table, not against this block.
//
// What stays: CIV, the island's own population and traffic hulls. The scripts
// read every descriptor through gmFactionValue / gmFactionTierClass /
// gmFactionVehicle; nothing is hardcoded anywhere else. Key schema:
// guerrilla-mode/config/guerrilla-factions.hpp.
class CfgGuerrillaFactions
{
    class CIV // civilian population descriptor (issue #8)
    {
        // side MUST be exactly "CIV" - GM_fnSideFromString (scripts/lib.sqs)
        // matches the engine's rendered side name (SideNames in
        // World/Scene/Object.cpp), and the civilian side renders as "CIV",
        // NOT "CIVILIAN".
        side = "CIV";
        // Numbered keys + a count, NOT a civClasses[] array: gmFactionValue
        // returns raw config text and skips array entries (LoadFactions
        // IsArray gate), so the scripts read civClassCount and then
        // civClass1..civClassN.
        //
        // @LoBo civilians, verified via `PoseidonTools pbo show LoBoTer.pbo
        // config.cpp` (CfgPatches LoBoTerror, requiredAddons[]={}; the
        // SoldierEB parent resolves from the 1.99 core config the lobo lane
        // loads; LoBoTer.pbo is stock - the @lobofixup patching only touches
        // LoBoammo/LoBo_airammo): LoBo_Civ_01..31 "Arab Civilian <n>"
        // (: SoldierEB, explicit side=3, scope=public, vehicleClass "Arab
        // Civilians", unarmed) and LoBo_CivF_01 "Arab Female 1"
        // (: LoBo_Civ_01, side=3). Deliberately NOT the LoBo_CivRock_* /
        // bottle-thrower variants - they carry stone/molotov throw
        // magazines, wrong for a passive CIV population.
        civClassCount = 4;   // number of civClass<N> keys that follow
        civClass1 = "LoBo_Civ_01";
        civClass2 = "LoBo_Civ_02";
        civClass3 = "LoBo_Civ_03";
        civClass4 = "LoBo_CivF_01";
        // Ambient road traffic hulls (native Traffic service; array, read by
        // ZoneRegistry::LoadFactions and package-probed like vehicles[], so
        // an unresolvable class is dropped, never fatal). @LoBo civilian vans
        // from LoBoCars.pbo (`PoseidonTools pbo show LoBoCars.pbo config.cpp`:
        // LoBo_S1203 "S 1203" and LoBo_Uaz3741 "Uaz 3741", both side=3
        // scope=2; NOT LoBo_S1203CB, the car bomb) ahead of the 1.99 core's
        // Skoda / Rapid, which the lobo lane also loads. Bus is the
        // Resistance-era addon-pbo class from the core install (O.pbo; see
        // Guerrilla.Abel) - the bus-stop passenger plan target
        // (guerrilla-mode/BUS-STOPS.md); probe-dropped if the lane cannot
        // resolve it.
        civVehicles[] = {"LoBo_S1203", "LoBo_Uaz3741", "Skoda", "SkodaBlue",
                         "SkodaRed", "Rapid", "Bus"};
    };
};

// The dealer market (issues #27/#28) on Sinai: @LoBo stock drawn from the
// descriptors above (weapon -> magazine pairs read out of the LoBoWeapons /
// JAM_Magazines config bodies, the same pairs the loot keys use) plus the
// civilian cars the CIV descriptor fields. The engine re-probes every class
// at load and drops what the package lacks (logged, non-fatal). The LoBoammo-
// armed hulls need the @lobofixup patched pbos in strict/autotest lanes, like
// the faction ladders. The dealer body is the stock LoBo civilian.
class CfgGuerrillaMarket
{
    dealerShare = 0.34;
    dealerRespawnSeconds = 600;
    hqMoveCost = 500;
    dealerClass = "LoBo_Civ_01";

    class Weapons
    {
        class AK47      { weapon = "LoBoAK47";           magazine = "JAM_E762_30mag";    mags = 4; price = 240; };
        class RPD       { weapon = "JAM_RPD";            magazine = "JAM_E762M_100mag";  mags = 2; price = 900; };
        class RPG7      { weapon = "JAM_RPG7Launcher";   magazine = "JAM_RPG7ALLRocket"; mags = 2; price = 550; };
        class SVD       { weapon = "LoBo_SVD";           magazine = "JAM_E762_10mag";    mags = 4; price = 650; };
        class M4A1      { weapon = "LoBo_M4A1";          magazine = "LoBoCAR15Mag";      mags = 4; price = 320; };
        class Minimi    { weapon = "LoBoM249";           magazine = "LoBoM249Mag";       mags = 2; price = 950; };
        class M72       { weapon = "JAM_M72LAWLauncher"; magazine = "JAM_M72ALLRocket";  mags = 2; price = 500; };
        class SR25      { weapon = "LoBo_SR25";          magazine = "LoBo_SR25Mag";      mags = 4; price = 700; };
        class AKMags    { weapon = "";                   magazine = "JAM_E762_30mag";    mags = 6; price = 60; };
        class CARMags   { weapon = "";                   magazine = "LoBoCAR15Mag";      mags = 6; price = 70; };
        class Binocular { weapon = "Binocular";          magazine = "";                            price = 60; };
        class NVGoggles { weapon = "NVGoggles";          magazine = "";                            price = 250; };
        class Grenades  { weapon = "";                   magazine = "HandGrenade";       mags = 4; price = 80; };
        class Mines     { weapon = "";                   magazine = "Mine";              mags = 2; price = 150; };
        class Satchels  { weapon = "";                   magazine = "PipeBomb";          mags = 2; price = 200; };
    };
    class Vehicles
    {
        class S1203     { vehicle = "LoBo_S1203";           price = 600; };
        class Uaz3741   { vehicle = "LoBo_Uaz3741";         price = 700; };
        class Skoda     { vehicle = "Skoda";                price = 600; };
        class Rapid     { vehicle = "Rapid";                price = 700; };
        class Toyota    { vehicle = "LoBo_EToymg";          price = 2800; };
        class Humvee    { vehicle = "LoBoHMWV_Mag_Patrol";  price = 3200; };
        class BTR60     { vehicle = "LoBo_BTR60";           price = 9000; };
        class Zelda     { vehicle = "LoBo_Zelda";           price = 9500; };
    };
};
