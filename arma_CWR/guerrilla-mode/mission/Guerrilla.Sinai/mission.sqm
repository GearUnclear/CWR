version=11;
class Mission
{
	// Verified addon set. Load-bearing: entries land in the engine's
	// active-addon list (World::ActivateAddons) and EVERY config class a
	// spawned unit touches - including its weapons[]/magazines[] - is
	// visibility-checked against that list (ParamOwnerList "Access denied",
	// World::CheckAddon). A missing entry here does not just warn: the unit
	// type fails to build and the whole mission refuses to boot
	// ("StartAutoTest could not boot"). Since issue #54 C1 the engine derives
	// the TRANSITIVE closure itself: the placed player's weapons[]/magazines[]
	// owners at launch (Guerrilla::ActivateTemplateAddons) and everything the
	// faction descriptors name at registry load
	// (ZoneRegistry::ActivateFactionAddons). So this lists only what the
	// mission itself PLACES: the world and the player's own pbo. The former
	// hand-listed transitive set (LoBoTerror, LoBoWeapons, LoBoWeapNad,
	// LoBoWeapat, LoBoammo, JAM_Magazines, LoBoIs, LoBoHMWV, LoBo_Zelda) is
	// what the walk now activates and logs at INFO.
	addOns[]=
	{
		"sinai",
		"LoBoEgypt"
	};
	addOnsAuto[]=
	{
		"sinai",
		"LoBoEgypt"
	};
	randomSeed=14000001;
	class Intel
	{
	};
	class Groups
	{
		items=1;
		class Item0
		{
			// The RESISTANCE side of this campaign is EAST (Egyptian Frontier
			// Corps) - the occupier is the WEST IDF. Deliberate side flip vs
			// Guerrilla.Demo (GUER resistance): proves nothing in the shared
			// core assumes which side resists.
			side="EAST";
			class Vehicles
			{
				items=1;
				class Item0
				{
					// Player: the lone Frontier Corps guerrilla at the Camp.
					// mission.sqm position order is [easting, ELEVATION,
					// northing] (unlike description.ext zone position[]).
					// Must track the Camp zone in description.ext - see the
					// "DO NOT move the Camp back to {7900, 3200}" note there:
					// the old spawn sat inside the fenced airbase compound and
					// the player could not walk out of it.
					position[]={8350,36,2950};
					id=0;
					side="EAST";
					vehicle="LoBo_Egypt_FrtCrp";
					player="PLAYER COMMANDER";
					leader=1;
					skill=0.600000;
				};
			};
		};
	};
};
class Intro
{
	randomSeed=14000002;
	class Intel
	{
	};
};
class OutroWin
{
	randomSeed=14000003;
	class Intel
	{
	};
};
class OutroLoose
{
	randomSeed=14000004;
	class Intel
	{
	};
};
