// Guerrilla Mode SHOWCASE mission on Abel (Malden, full CWA 1.99 data) -
// the issue #9 oversight/verification mission. Same island data as the
// playable Guerrilla.Abel template (zone seed + faction descriptors copied
// verbatim, so the systems on display behave exactly like the real
// campaign), plus a showcase/ overlay bootstrapped from mission.sqm:
// narrated, self-verifying CHAPTERS (one per gameplay system, extendable
// via the showcase/chapters.sqs manifest) plus a state-change event ticker,
// all over the small-font sideChat radio log. See showcase/README.md.
//
// The scripts/ directory and init.sqs stay the byte-identical shared core
// (enforced by test_mission_script_core.cpp, which walks Showcase.* too);
// ONLY this file, mission.sqm and the showcase/ overlay differ.
//
// Zone geometry (see Guerrilla.Abel for the survey notes):
//   * Camp     (RESISTANCE) coastal plain SE of Houdan; player start.
//   * Outpost  (OCCUPIER, garrison 6) ~515 m NNE - INSIDE the 800 m
//     cacheRadius, so the native GarrisonCache spawns it at boot.
//   * Village  = the real town of Houdan (~490 m NW), NEUTRAL CITY.
// All three sit within revealRadius of the Camp -> revealed on tick 1.

onLoadMission = "Guerrilla Mode Showcase - Abel";
onLoadIntro  = "Narrated, self-verifying chapters: run DEMO ALL or any chapter from the action menu.";
respawn = 0;
joinInProgress = 0;

class CfgGuerrillaZones
{
    // Engine tuning left at stock defaults (tickInterval=3; zoneArea=150;
    // revealRadius=1500; cacheRadius=800; supportRate=5; supportFlip=60;
    // heatCapSpike=40; defaultIncome=25; cacheInterval=5; groupSize=12;
    // alertInterval=5; alert*Knows/Heat defaults).  Direct-launch faction
    // fallbacks are stated explicitly (single-mission browser launches skip
    // the new-game UI, so nothing is published there):
    defaultOccupier = "EAST";
    defaultResistance = "GUER";
    seedCities = 1;       // auto-seed CITY zones from Abel's named towns
    seedCitySupport = 20; // their starting support (markers "gmZoneCity_<n>")

    class Zones
    {
        // COORDINATE ORDER (load-bearing): position[] is authored in
        // script/getPos order [easting, northing, elevation] - NOT the
        // mission.sqm order [easting, ELEVATION, northing]. The engine's
        // ZoneRegistry::LoadZones documents and enforces this contract.
        class Camp
        {
            name = "Camp";
            type = "CAMP";
            owner = "RESISTANCE";   // generic token, resolved per campaign
            garrison = 0;
            support = 100;
            income = 0;
            marker = "gmZoneMarker_0";
            position[] = {7515, 5790, 20};
        };
        class Village
        {
            name = "Village";
            type = "CITY";
            owner = "NEUTRAL";
            support = 20;
            marker = "gmZoneMarker_1";
            position[] = {7117, 6069, 35};  // Houdan (CfgWorlds >> Abel >> Names)
        };
        class Outpost
        {
            name = "Outpost";
            type = "OUTPOST";
            owner = "OCCUPIER";     // generic token, resolved per campaign
            garrison = 6;
            income = 25;
            marker = "gmZoneMarker_2";
            position[] = {7600, 6300, 25};
        };
    };
};

// Faction descriptors for the FULL CWA 1.99 dataset.  Every classname below
// was verified against Bin\CONFIG.BIN (PoseidonTools config search/dump).
// NOTE the OFP magazine convention: simple weapons ARE their own magazine
// class (CfgWeapons AK47 has scopeMagazine=2), so baseMagazine/loot*Mag reuse
// the weapon classname - there is no "AK47Mag" class in this dataset.
class CfgGuerrillaFactions
{
    class EAST // occupier descriptor
    {
        side = "EAST";
        // WL<3 conscripts -> WL3-4 grenadiers -> WL5+ crack troops
        tiers[] = {"SoldierEB", "SoldierEG", "SoldierECrew"};
        tierThresholds[] = {3, 5};
        // per-tier role variants (plan 15; all verified in the 1.99 config):
        // MG/AT/medic/sniper slots for the native squad composer; the sniper
        // only arrives with the elite tier
        tiersMG[]     = {"SoldierEMG", "SoldierEMG", "SoldierEMG"};
        tiersAT[]     = {"SoldierELAW", "SoldierELAW", "SoldierELAW"};
        tiersMedic[]  = {"SoldierEMedic", "SoldierEMedic", "SoldierEMedic"};
        tiersSniper[] = {"", "", "SoldierESniper"};
        // QRF escort ladder (full vehicleThresholds[] form): UAZ patrol ->
        // Ural troop truck -> BMP IFV -> T72 escort
        vehicles[] = {"UAZ", "Ural", "BMP", "T72"};
        vehicleThresholds[] = {3, 6, 8};
        officer = "OfficerE";
        // town flagpole texture (native TownFlags); matches the engine's
        // side-EAST default - stated for the data-file contract
        flag = "\flags\ussr.jpg";
    };
    class GUER // resistance descriptor
    {
        side = "GUER";
        tiers[] = {"SoldierGB"};
        tierThresholds[] = {};
        // role variants for the post-capture hold squads; no sniper class
        // exists in the core GUER roster
        tiersMG[]    = {"SoldierGMG"};
        tiersAT[]    = {"SoldierGLAW"};
        tiersMedic[] = {"SoldierGMedic"};
        // Captured/irregular motor pool: guerrilla jeep -> PV3S truck ->
        // captured BMP -> T55. Kept in step with Guerrilla.Abel, whose GUER
        // descriptor this copies (see the header) - "BMPRes" used to sit on
        // this rung and does not exist in 1.99 at all, so the rung was being
        // dropped by ResolveFactionClasses and T55G silently unlocked at WL7
        // instead of WL9. "BMP" is the EAST-sided hull on purpose: 1.99 ships
        // no GUER APC/IFV, and a vehicle's side comes from the AICenter of the
        // group it spawns into, not from its config class - so a BMP spawned
        // into the resistance's center IS resistance armour. See the fuller
        // note in Guerrilla.Abel/description.ext.
        vehicles[] = {"GJeep", "TruckV3SG", "BMP", "T55G"};
        vehicleThresholds[] = {4, 7, 9};
        officer = "SoldierGB";

        holdClass = "SoldierGB";
        holdCount = 3;
        recruitFighter = "SoldierGB";
        recruitSpecialist = "SoldierGMG";
        companionClass = "SoldierGB";

        baseWeapon = "AK47";
        baseMagazine = "AK47";
        lootRiflemanWeapon = "AK47";
        lootRiflemanMag = "AK47";
        lootMedicWeapon = "AK47";
        lootMedicMag = "AK47";
        lootMGWeapon = "PK";
        lootMGMag = "PK";
        lootATWeapon = "RPGLauncher";
        lootATMag = "RPGLauncher";
        lootSniperWeapon = "SVDDragunov";
        lootSniperMag = "SVDDragunov";

        // town flagpole texture; matches the engine's side-GUER default
        flag = "\flags\fia.jpg";
    };
};

// The dealer market (issues #27/#28): tuning + the Classic 1.99 stock. Every
// classname is verified against Bin\CONFIG.BIN (PoseidonTools config search);
// the engine re-probes them at load and drops what a package lacks (logged,
// non-fatal - the Demo [Remaster] package keeps whatever subset it ships).
// OFP magazine convention: a simple weapon IS its own magazine class, so the
// magazine keys reuse the weapon classname; launcher grenades, hand grenades
// and explosives are magazine-only bundles (weapon = "").
class CfgGuerrillaMarket
{
    dealerShare = 0.34;          // fraction of CITY zones per dealer kind (independent draws)
    dealerRespawnSeconds = 600;  // a killed dealer is back after this
    hqMoveCost = 500;            // R debited by market.sqs when MOVING the HQ
    // dealerClass falls back to the CIV descriptor's civClass1, then "Civilian";
    // weaponDealers[] / vehicleDealers[] absent: the towns are drawn at the first tick

    class Weapons
    {
        class AK47       { weapon = "AK47";               magazine = "AK47";              mags = 4; price = 220; };
        class AK74       { weapon = "AK74";               magazine = "AK74";              mags = 4; price = 260; };
        class AK47CZ     { weapon = "AK47CZ";             magazine = "AK47";              mags = 4; price = 240; };
        class AK74SU     { weapon = "AK74SU";             magazine = "AK74";              mags = 4; price = 240; };
        class M16        { weapon = "M16";                magazine = "M16";               mags = 4; price = 280; };
        class HK         { weapon = "HK";                 magazine = "HK";                mags = 5; price = 300; };
        class M16GL      { weapon = "M16GrenadeLauncher"; magazine = "M16";               mags = 4; price = 420; };
        class AK74GL     { weapon = "AK74GrenadeLauncher"; magazine = "AK74";             mags = 4; price = 400; };
        class GLGrenades { weapon = "";                   magazine = "GrenadeLauncher";   mags = 6; price = 90; };
        class M21        { weapon = "M21";                magazine = "M21";               mags = 4; price = 600; };
        class SVD        { weapon = "SVDDragunov";        magazine = "SVDDragunov";       mags = 4; price = 650; };
        class PK         { weapon = "PK";                 magazine = "PK";                mags = 2; price = 900; };
        class M60        { weapon = "M60";                magazine = "M60";               mags = 2; price = 950; };
        class LAW        { weapon = "LAWLauncher";        magazine = "LAWLauncher";       mags = 2; price = 500; };
        class RPG        { weapon = "RPGLauncher";        magazine = "RPGLauncher";       mags = 2; price = 550; };
        class CarlGustav { weapon = "CarlGustavLauncher"; magazine = "CarlGustavLauncher"; mags = 2; price = 900; };
        class AT4        { weapon = "AT4Launcher";        magazine = "AT4Launcher";       mags = 2; price = 900; };
        class Strela     { weapon = "9K32Launcher";       magazine = "9K32Launcher";      mags = 1; price = 1200; };
        class Stinger    { weapon = "AALauncher";         magazine = "AALauncher";        mags = 1; price = 1200; };
        class Binocular  { weapon = "Binocular";          magazine = "";                            price = 60; };
        class NVGoggles  { weapon = "NVGoggles";          magazine = "";                            price = 250; };
        class Grenades   { weapon = "";                   magazine = "HandGrenade";       mags = 4; price = 80; };
        class Mines      { weapon = "";                   magazine = "Mine";              mags = 2; price = 150; };
        class Satchels   { weapon = "";                   magazine = "PipeBomb";          mags = 2; price = 200; };
    };
    class Vehicles
    {
        class Skoda      { vehicle = "Skoda";      price = 600; };
        class Rapid      { vehicle = "Rapid";      price = 700; };
        class Tractor    { vehicle = "Tractor";    price = 500; };
        class Jeep       { vehicle = "Jeep";       price = 1500; };
        class GJeep      { vehicle = "GJeep";      price = 1400; };
        class UAZ        { vehicle = "UAZ";        price = 1400; };
        class JeepMG     { vehicle = "JeepMG";     price = 3000; };
        class UAZG       { vehicle = "UAZG";       price = 3000; };
        class Truck5t    { vehicle = "Truck5t";    price = 3500; };
        class Ural       { vehicle = "Ural";       price = 3500; };
        class TruckV3SG  { vehicle = "TruckV3SG";  price = 3200; };
        class M113       { vehicle = "M113";       price = 9000; };
        class BMP        { vehicle = "BMP";        price = 12000; };
        class T55G       { vehicle = "T55G";       price = 20000; };
    };
};
