; ============================================================================
;  escalation.sqs  -  War Level (slow) + per-region Heat decay (fast)
; ----------------------------------------------------------------------------
;  Two timescales, one manager - formulas UNCHANGED from Phase 1:
;
;   * WAR LEVEL (gmWarLevel, 1..10, SLOW): the % of zones the resistance owns
;     drives an integer ladder. The native GarrisonCache and qrf.sqs read the
;     scalar (spawn tiers now come from the faction descriptor via
;     gmFactionTierClass, thresholds in config - no script tier table).
;
;   * HEAT (per-zone, 0..100, FAST): spikes are raised NATIVELY (capture,
;     alert edges, cover break). This manager only DECAYS, and only while the
;     zone is lying low (native alert state GREEN). The OWNS-table direction
;     split survives the rewrite as an ENGINE CONTRACT: there is no direct
;     "heat" setter - scripts can only gmZoneSet "heatRaise" (+=, clamped) or
;     "heatDecay" (-=, clamped), and this file uses only the decay verb.
;
;  OWNS: gmWarLevel, heat DECAY direction, gmEsc_* scratch.
;  READS: gmZoneCount/gmZone owners, gmResistanceSide, gmZoneAlert, gmHeatDecay.
;  NOTE: the old gmUndercoverDetect scalar is GONE - undercover detection is
;  per-observer engine code now, and it reads gmWarLevel directly (the
;  panicked-town detection multiplier retired with the scalar).
;  NOTE: with seedCities=1 the ladder denominator includes every seeded town,
;  so full War Level now genuinely means winning over the island.
; ============================================================================
@GM_LIB_READY

; ---- tunables (escalation-local; not persisted) ------------------------------
;   gmEsc_slowEvery  recompute War Level once per 6 fast ticks (~60s)
;   gmEsc_slow       fast-tick counter toward the next slow recompute
gmEsc_slowEvery = 6
gmEsc_slow      = 0

; ============================================================================
;  MAIN LOOP  (fast tick = Heat decay; slow sub-tick = War Level recompute)
; ============================================================================
#loop
~10

; ---- FAST: per-zone Heat decay, gated on "lying low" (native GREEN) ----------
gmEsc_i = 0
while {gmEsc_i < gmZoneCount} do {if ((gmZoneAlert gmEsc_i) == 0) then {gmZoneSet [gmEsc_i, "heatDecay", gmHeatDecay]}; gmEsc_i = gmEsc_i + 1}

; ---- SLOW: recompute War Level every gmEsc_slowEvery fast ticks --------------
gmEsc_slow = gmEsc_slow + 1
?(gmEsc_slow < gmEsc_slowEvery): goto "loop"
gmEsc_slow = 0

; % of zones held by the resistance
gmEsc_held  = gmResistanceSide call GM_fnCountOwnedBy
gmEsc_total = gmZoneCount
gmEsc_pct   = 0
if (gmEsc_total > 0) then {gmEsc_pct = (gmEsc_held * 100) / gmEsc_total}

; Integer War Level ladder (ascending if/then picks the highest band reached).
; Crosses the faction tierThresholds tier-2 boundary (WL>=3) at 40% held,
; tier-3 (WL>=5) at 70%. Phase-1 caps at 6.
gmWarLevel = 1
if (gmEsc_pct >= 20) then {gmWarLevel = 2}
if (gmEsc_pct >= 40) then {gmWarLevel = 3}
if (gmEsc_pct >= 55) then {gmWarLevel = 4}
if (gmEsc_pct >= 70) then {gmWarLevel = 5}
if (gmEsc_pct >= 85) then {gmWarLevel = 6}

goto "loop"
