; ============================================================================
;  chapters/alert.sqs  -  the alert FSM and the QRF, live.
; ----------------------------------------------------------------------------
;  SYSTEM ON DISPLAY: AlertMachine (native FSM: GREEN/YELLOW/RED per zone off
;  garrison knowsAbout - YELLOW at 0.5, RED at 1.5 or a 20 s YELLOW window
;  expiring), undercover.sqs (cover), qrf.sqs (posture, investigate), and the
;  answer to RED: with occupierForces = 1 the native director answers the
;  alarm (OccupierForces::AnswerAlarms, an "ALARM" row in gmOccupierOps whose
;  target is the zone); with the key off or an old save (gmLegacyQrf) the
;  scripted qrf.sqs convoy (GM_QRF_ACTIVE). Either counts as the QRF here.
;  Seams: gmBreakUndercover, gmGarrisonForceDespawn (the stand-down lever:
;  no perception sources -> the zone calms -> the answer stands down),
;  allowDammage (the demo shield - the staged firefight must not end the
;  mission by killing the observer).
;  Chapter order note (README.md): runs BEFORE capture so the garrison lives.
; ============================================================================
? isNil "SC_READY" : exit

; ---- preconditions ---------------------------------------------------------------
? ((gmZone SC_OUT) select GM_Z_OWNER) != gmOccupierSide : ["SKIP", "Outpost already liberated - no garrison left to alarm"] call SC_fnDone
? ((gmZone SC_OUT) select GM_Z_OWNER) != gmOccupierSide : exit

"Every zone runs a native alert machine on what the garrison actually PERCEIVES of you (knowsAbout): 0.5 turns it YELLOW, 1.5 - or 20 s of unresolved YELLOW - turns it RED. RED is the alarm the occupier answers." call SC_fnSay
~SC_BEAT

; ---- arrive 150 m off the wire, SOLO (cover is personal - see lib.sqs), garrison up -
;      (the walk-in to witness range happens after the shield goes up below)
SC_cOP = (gmZone SC_OUT) select GM_Z_POS
[[(SC_cOP select 0) - 110, (SC_cOP select 1) - 110, 0], 10] call SC_fnTpSolo
SC_cW = 0
#swait
? (gmGarrisonSpawned SC_OUT) and ((gmGarrisonLive SC_OUT) > 0) : goto "staged"
~1
SC_cW = SC_cW + 1
? SC_cW < 25 : goto "swait"
["FAIL", "no garrison spawned to run the alert demo against"] call SC_fnDone
exit

#staged
SC_cRed = false
SC_cQrf = false
SC_cNat = false
; true while a native alarm answer (gmOccupierOps row: 1 kind, 3 package,
; 5 target zone name, 6 phase) is aimed at the Outpost; SC_tmpAOr keeps the row
SC_fnAlarmOp = {SC_tmpAO = false; SC_tmpAOn = (gmZone SC_OUT) select GM_Z_NAME; {if (((_x select 1) == "ALARM") and ((_x select 5) == SC_tmpAOn)) then {SC_tmpAO = true; SC_tmpAOr = _x}} forEach gmOccupierOps; SC_tmpAO}
true call SC_fnShield
"You came ALONE (the squad waits at the Camp - the disguise covers you, not them). Demo shield up (allowDammage off): this firefight is staged and you are the observer, not the target of the lesson." call SC_fnSay
~SC_BEAT

; ---- walk the last stretch in: a break nobody WITNESSED is just a loud noise.
;      Exposure is per-observer (deep undercover) - gmBreakUndercover only
;      marks groups that currently hold a record of your face, and at low War
;      Level a sentry does not clock a face 150 m out. Stage 35 m from a live
;      garrison group and wait until at least one group actually knows the
;      player before pulling the latch (same staging contract the
;      guerrilla_native_undercover lifecycle test proves at 30 m).
SC_cGrps = gmGarrisonGroups SC_OUT
? (count SC_cGrps) < 1 : goto "nofsm"
SC_cLdr = leader (SC_cGrps select 0)
aP setPos [((getPos SC_cLdr) select 0) + 35, ((getPos SC_cLdr) select 1), 0]
"Walking in under the disguise - close enough for the sentries to see a face, which is exactly the point: cover is only tested by the groups that PERCEIVE you." call SC_fnSay
SC_cW = 0
#kwait
SC_cKnow = false
{if ((_x knowsAbout aP) > 0) then {SC_cKnow = true}} forEach SC_cGrps
? SC_cKnow : goto "known"
~1
SC_cW = SC_cW + 1
? SC_cW < 45 : goto "kwait"
goto "nofsm"

#known
? gmUndercoverStatus == 2 : "Cover is already blown to at least one occupier group from earlier play - they re-acquire you on sight (unseen zones still read you as a civilian)." call SC_fnSay
? gmUndercoverStatus < 2 : "Breaking cover in full view of the wire (the same latch a fired shot trips). Every group that currently knows your face marks you as hostile; Heat spikes on the witness zone and the garrison starts hunting. Watch the ticker." call SC_fnSay
gmBreakUndercover "showcase alert chapter"

; ---- YELLOW: perception crossed 0.5 ------------------------------------------------
SC_cW = 0
#ywait
? (gmZoneAlert SC_OUT) >= 1 : goto "yellow"
~1
SC_cW = SC_cW + 1
? SC_cW < 60 : goto "ywait"
goto "nofsm"

#yellow
"YELLOW: the garrison turns AWARE and qrf.sqs marches it on your LAST-KNOWN position (the native gmZoneLastKnown - where they lost you, not where you are). Break contact for 20 s and the zone calms back to GREEN." call SC_fnSay

; ---- RED: 1.5 knowsAbout, or the 20 s YELLOW window expiring -----------------------
? (gmZoneAlert SC_OUT) >= 2 : goto "red"
SC_cW = 0
#rwait
? (gmZoneAlert SC_OUT) >= 2 : goto "red"
~1
SC_cW = SC_cW + 1
? SC_cW < 60 : goto "rwait"
goto "nofsm"

#red
SC_cRed = true
"RED: the zone is in open alarm - garrison to COMBAT, heat spiked. Another occupier zone now answers it: the forces director picks a package from its own pool (foot squad, truck, column or helicopter) and fields it out of your sight." call SC_fnSay
SC_cW = 0
#qwait
SC_cQ = false; if (not (isNil "GM_QRF_ACTIVE")) then {SC_cQ = GM_QRF_ACTIVE}
? SC_cQ : goto "qrf"
? [] call SC_fnAlarmOp : goto "native"
~1
SC_cW = SC_cW + 1
? SC_cW < 30 : goto "qwait"
goto "epilogue"

#native
SC_cQrf = true
SC_cNat = true
format ["The alarm is answered: op %1, a %2 package out of %3, phase %4. It travels to the reported position (where they last saw you, not where you are), searches it, and joins the Outpost garrison once the zone stays quiet.", SC_tmpAOr select 0, SC_tmpAOr select 3, SC_tmpAOr select 4, SC_tmpAOr select 6] call SC_fnSay
~SC_BEAT
~SC_BEAT
goto "epilogue"

#qrf
SC_cQrf = true
"QRF is rolling (the scripted convoy: this campaign runs without the forces director, or is an old save). It convoys on MOVE waypoints and finishes with SEARCH-AND-DESTROY on the last-known position; if pathing stalls for 120 s it inserts directly (the para-insertion fallback)." call SC_fnSay
~SC_BEAT
~SC_BEAT
goto "epilogue"

; ---- FSM never climbed: report honestly, then clean up -----------------------------
#nofsm
"The garrison never built enough perception to escalate (dead angle, distance, or bodies already gone). Cleaning the stage up." call SC_fnSay
goto "cleanup"

; ---- epilogue: the disengage loop, demonstrated -------------------------------------
#epilogue
? not SC_cNat : "Now the other half of the machine: you MELT AWAY. Back to the Camp - with its perception sources gone the zone collapses to GREEN and qrf.sqs stands the convoy down and deletes it." call SC_fnSay
? SC_cNat : "Now the other half of the machine: you MELT AWAY. Back to the Camp - with its perception sources gone the zone collapses to GREEN. The answer still reaches the reported position, finds nobody, and after a quiet minute joins the garrison." call SC_fnSay
#cleanup
[(gmZone SC_CAMP) select GM_Z_POS, 15] call SC_fnTpSolo
? (gmGarrisonSpawned SC_OUT) : gmGarrisonForceDespawn SC_OUT
SC_cW = 0
#cwait
SC_cQ = false; if (not (isNil "GM_QRF_ACTIVE")) then {SC_cQ = GM_QRF_ACTIVE}
? ((gmZoneAlert SC_OUT) == 0) and (not SC_cQ) : goto "calm"
~1
SC_cW = SC_cW + 1
? SC_cW < 60 : goto "cwait"
goto "verdict"

#calm
"GREEN again, QRF stood down. Alert, response and disengage - the full loop." call SC_fnSay
? SC_cNat and ([] call SC_fnAlarmOp) : (format ["The alarm answer (op %1) is still out, phase %2: it settles into the garrison on its own once the zone has been quiet for a minute.", SC_tmpAOr select 0, SC_tmpAOr select 6]) call SC_fnSay

#verdict
false call SC_fnShield
? SC_cRed and SC_cQrf : ["PASS", "GREEN -> YELLOW -> RED -> QRF -> disengage, all observed"] call SC_fnDone
? SC_cRed and (not SC_cQrf) : ["FAIL", "zone went RED but no QRF launched"] call SC_fnDone
? not SC_cRed : ["FAIL", "alert FSM never reached RED"] call SC_fnDone
exit
