; ============================================================================
;  showcase/run.sqs  -  chapter runner: one loop, one writer, one ledger.
; ----------------------------------------------------------------------------
;  Consumes SC_QUEUE (filled by action.sqs, the DEMO ALL reel, or the Trident
;  smoke test writing the same seam), one chapter at a time:
;
;    pop index -> banner -> reset the outcome contract -> exec the chapter ->
;    wait for SC_DONE (bounded by SC_CH_TIMEOUT) -> stamp the ledger
;    (SC_RES / SC_RESMSG) -> post a summary line -> raise SC_LASTDONE.
;
;  SC_LASTDONE is the completion handshake (showcase_smoke.test.sqf waits on
;  it); SC_BUSY guards double-dispatch. SC_BEAT is recomputed per dispatch so
;  a test can flip SC_AUTO at any point.
;
;  Also polls GM_pSaveAct each pass: campaign.sqs re-arms its Save action
;  after a campaign load, so a changed id means "a load happened" - the
;  showcase menu (whose action ids died with the old session) is re-mounted
;  and the round-trip is reported. Native event slots are single-owner, so
;  the overlay registers no handlers (see README.md).
; ============================================================================

@ not (isNil "SC_READY")

#loop
~0.5

; ---- campaign-load detector ----------------------------------------------------
? GM_pSaveAct != SC_SAVEACT : goto "rearm"

? (count SC_QUEUE) < 1 : goto "loop"

; ---- pop the next chapter (also swallows accidental duplicate requests) --------
SC_CH = SC_QUEUE select 0
SC_QUEUE = SC_QUEUE - [SC_CH]
? (SC_CH < 0) or (SC_CH >= count SC_CH_IDS) : goto "loop"
SC_BUSY = true

; ---- pacing: readable beats for a human, fast beats for the harness ------------
SC_BEAT = 6
? SC_AUTO : SC_BEAT = 0.3

; ---- banner + dispatch ----------------------------------------------------------
(format ["SHOWCASE %1/%2 - %3", SC_CH + 1, count SC_CH_IDS, SC_CH_TITLES select SC_CH]) call SC_fnBanner
SC_DONE = false
SC_OUTCOME = "FAIL"
SC_OUTMSG = "chapter never reported"
[] exec (format ["showcase/chapters/%1.sqs", SC_CH_IDS select SC_CH])

; ---- bounded completion wait (a stuck chapter must not wedge the runner) -------
SC_rW = 0
#cwait
? SC_DONE : goto "record"
~1
SC_rW = SC_rW + 1
? SC_rW < SC_CH_TIMEOUT : goto "cwait"
SC_OUTCOME = "FAIL"
SC_OUTMSG = format ["timed out after %1 s", SC_CH_TIMEOUT]

#record
SC_RES set [SC_CH, SC_OUTCOME]
SC_RESMSG set [SC_CH, SC_OUTMSG]
? SC_OUTCOME == "PASS" : (format ["RESULT %1/%2 %3: PASS - %4", SC_CH + 1, count SC_CH_IDS, SC_CH_TITLES select SC_CH, SC_OUTMSG]) call SC_fnSay
? SC_OUTCOME != "PASS" : (format ["RESULT %1/%2 %3: %4 - %5", SC_CH + 1, count SC_CH_IDS, SC_CH_TITLES select SC_CH, SC_OUTCOME, SC_OUTMSG]) call SC_fnSay
SC_LASTDONE = SC_CH
SC_CH = -1
SC_BUSY = false
goto "loop"

; ---- campaign load detected: action ids died with the old session --------------
#rearm
[] call SC_fnUnmount
[] call SC_fnMount
SC_SAVEACT = GM_pSaveAct
"Campaign load detected: zones, alerts, garrisons, companions and the gear stash came back through the native serializers; showcase menu re-armed. Persistence round-trip verified." call SC_fnSay
goto "loop"
