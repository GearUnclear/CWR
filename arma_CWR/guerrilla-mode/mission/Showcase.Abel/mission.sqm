					//
					// The init line is the SHOWCASE bootstrap: mission.sqm is
					// the sanctioned per-mission divergence point (init.sqs +
					// scripts/ must stay the byte-identical shared core), so
					// the overlay execs from here. boot.sqs gates on
					// GM_LIB_READY before touching anything.
					position[]={7515.000000,20.000000,5790.000000};
					id=0;
					side="GUER";
					vehicle="SoldierGB";
					player="PLAYER COMMANDER";
					leader=1;
					skill=0.600000;
					init="[] exec ""showcase/boot.sqs""";
				};
			};
		};
	};
