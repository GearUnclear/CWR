; Human suite manifest. Each row: id, category, title, prerequisites,
; read-only eligibility, HT-only baseline capture, [instruction, evidence kind, read-only check] steps.
; The core owns ALL gameplay. A true visual probe requires human attestation;
; it is deliberately not represented as an automated gameplay assertion.
HT_CASES = []

; movement - Movement, stance and equipment
HT_CASES = HT_CASES + [["movement", "Soldier", "Movement, stance and equipment", "Start alive at Camp, before combat.", {alive aP}, {HT_pos = getPos aP; HT_weapon = primaryWeapon aP}, [["Walk, sprint, crouch and go prone on the Camp terrain. Turn and aim in each stance. Confirm responsive controls, ground contact and no camera jumps. Move at least 20 m from your start.", "STATE + HUMAN CHECK: live state must agree with your observation.", {((getPos aP) distance HT_pos) > 20}], ["Open equipment, inspect your actual faction rifle and ammunition. Equip binoculars if available, return to the rifle, aim and reload after firing safely away from people. Confirm animation, ammo consumption, sights and audio match the action.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(primaryWeapon aP) != ""}]]]]

; squad - Squad commands and vehicle crew
HT_CASES = HT_CASES + [["squad", "Soldier", "Squad commands and vehicle crew", "Recruit at least one fighter through Camp actions first.", {(count units (group aP)) > 1}, {HT_squad = (units (group aP)) - [aP]}, [["Select a fighter with the normal squad controls. Order move, stop, regroup and change stance. Confirm the selected unit obeys without moving unselected units.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}], ["Use a purchased or commandeered vehicle. Order the squad aboard, drive, stop and order everyone out. Confirm seats, leader control, dismount and regroup work. Return on foot.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(vehicle aP) == aP}]]]]

; combat - Combat, wounds and weapon roles
HT_CASES = HT_CASES + [["combat", "Soldier", "Combat, wounds and weapon roles", "Carry ammunition. Find an occupier garrison and use cover; save before combat.", {alive aP}, {HT_rating = rating aP}, [["Engage real occupiers with aimed rifle fire. Confirm recoil, shots, impacts, audio and enemy return fire agree. Kill an enemy through normal combat.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(rating aP) > HT_rating}], ["Test grenade/launcher blast and ammunition use with bought or looted equipment. Take a survivable wound, use a recruited medic through normal controls and verify injury feedback and treatment. Record FAIL for any broken interaction.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}]]]]

; zones - Map, discovery and town flags
HT_CASES = HT_CASES + [["zones", "Territory", "Map, discovery and town flags", "Open the map before leaving Camp. Use a fresh campaign with unexplored towns.", {gmZoneCount > 3}, {HT_pos = getPos aP}, [["Compare the map with Camp, Village/Houdan and Outpost in the world. Check names, ownership colors, objective icons and your position.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}], ["Travel to a previously unexplored town. Watch its zone reveal as you approach, then inspect its physical flag and map entry. Confirm both reflect the current owner.", "STATE + HUMAN CHECK: live state must agree with your observation.", {((getPos aP) distance HT_pos) > 1500}]]]]

; town_support - Town support and peaceful liberation
HT_CASES = HT_CASES + [["town_support", "Territory", "Town support and peaceful liberation", "Use a fresh neutral Village. Stay nearby peacefully; avoid panic and extortion.", {((gmZone SC_VILL) select GM_Z_OWNER) == "NEUTRAL"}, {HT_support = (gmZone SC_VILL) select GM_Z_SUPPORT}, [["Walk to Village/Houdan and operate peacefully nearby. Open its journal page and observe support increase naturally.", "STATE + HUMAN CHECK: live state must agree with your observation.", {((gmZone SC_VILL) select GM_Z_SUPPORT) > HT_support}], ["Remain until the town joins the resistance. Confirm the owner, marker, flag and journal change without killing the townspeople.", "STATE + HUMAN CHECK: live state must agree with your observation.", {((gmZone SC_VILL) select GM_Z_OWNER) == gmResistanceSide}]]]]

; garrison - Garrison spawn, casualties and distance cache
HT_CASES = HT_CASES + [["garrison", "Territory", "Garrison spawn, casualties and distance cache", "Outpost must still be occupier-owned. Keep at least one defender alive.", {((gmZone SC_OUT) select GM_Z_OWNER) == gmOccupierSide}, {HT_live = 0}, [["Approach Outpost until its garrison is visible. Inspect officer and faction units, then CHECK before firing.", "STATE + HUMAN CHECK: live state must agree with your observation.", {HT_live = gmGarrisonLive SC_OUT; (gmGarrisonSpawned SC_OUT) and (HT_live > 1)}], ["Kill at least one defender yourself but leave survivors. Confirm the live count falls.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(gmGarrisonLive SC_OUT) > 0 and ((gmGarrisonLive SC_OUT) < HT_live)}], ["Withdraw beyond the garrison cache distance (travel over 1500 m from Outpost). Confirm the garrison banks naturally.", "STATE + HUMAN CHECK: live state must agree with your observation.", {not (gmGarrisonSpawned SC_OUT)}], ["Return. Confirm survivors rematerialize with faction equipment and casualties are not restored as a fresh full garrison.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(gmGarrisonSpawned SC_OUT) and ((gmGarrisonLive SC_OUT) > 0)}]]]]

; capture - Clear, consolidate and hold an outpost
HT_CASES = HT_CASES + [["capture", "Territory", "Clear, consolidate and hold an outpost", "Outpost must still belong to the occupier. Bring recruits and ammo; complete alert/garrison checks first.", {((gmZone SC_OUT) select GM_Z_OWNER) == gmOccupierSide}, {}, [["Fight and clear Outpost, then remain inside its objective area. Confirm the securing meter starts through normal combat and presence.", "STATE + HUMAN CHECK: live state must agree with your observation.", {((gmZone SC_OUT) select GM_Z_CAPTURE) > 0}], ["Hold until the zone flips. Confirm the green marker, liberation message and friendly hold garrison. No test script clears defenders or changes the owner.", "STATE + HUMAN CHECK: live state must agree with your observation.", {((gmZone SC_OUT) select GM_Z_OWNER) == gmResistanceSide}], ["Leave and return. Confirm your hold squad and friendly ownership persist, and the zone appears in campaign income and the journal.", "STATE + HUMAN CHECK: live state must agree with your observation.", {((gmZone SC_OUT) select GM_Z_OWNER) == gmResistanceSide}]]]]

; capture_contested - Consolidation pauses under contest
HT_CASES = HT_CASES + [["capture_contested", "Territory", "Consolidation pauses under contest", "Use a fresh occupier Outpost. Bring a squad; coordinate a QRF/patrol entering while securing. This can require a separate attempt.", {((gmZone SC_OUT) select GM_Z_OWNER) == gmOccupierSide}, {}, [["Clear the initial defenders, start securing, then allow an enemy patrol/QRF inside the zone. Observe the meter stop while any enemy remains. CHECK while contested; if no enemy arrives use BLOCKED, never PASS.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}], ["Defeat the new enemy inside the zone and continue holding. Confirm progress resumes and the zone eventually becomes friendly.", "STATE + HUMAN CHECK: live state must agree with your observation.", {((gmZone SC_OUT) select GM_Z_OWNER) == gmResistanceSide}]]]]

; alert - Detection, investigation and QRF response
HT_CASES = HT_CASES + [["alert", "Occupation", "Detection, investigation and QRF response", "Outpost must be occupied. Approach alone, armed; keep defenders alive to report you.", {((gmZone SC_OUT) select GM_Z_OWNER) == gmOccupierSide}, {}, [["Approach until occupiers detect suspicious/hostile activity. Observe the transition out of GREEN and their investigation or combat posture.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(gmZoneAlert SC_OUT) > 0}], ["Remain observable or engage so the alert reaches RED. Watch the actual QRF arrive, escort travel and troop dismount; CHECK once it is active.", "STATE + HUMAN CHECK: live state must agree with your observation.", {GM_QRF_ACTIVE}], ["Break contact and withdraw. Wait for alert GREEN and the QRF to stand down. Confirm searching ends without a forced memory wipe.", "STATE + HUMAN CHECK: live state must agree with your observation.", {((gmZoneAlert SC_OUT) == 0) and (not GM_QRF_ACTIVE)}]]]]

; undercover - Undercover suspicion, compromise and evasion
HT_CASES = HT_CASES + [["undercover", "Occupation", "Undercover suspicion, compromise and evasion", "Fresh campaign; go alone. Use normal equipment controls to put your weapon away. Do not run staged demos.", {gmUndercoverStatus == 0}, {}, [["Walk near occupiers with weapon concealed. Observe cover status, distance and witness behavior; CHECK while still uncompromised.", "STATE + HUMAN CHECK: live state must agree with your observation.", {gmUndercoverStatus < 2}], ["Draw/fire in front of a live occupier who can see you. Observe the compromise warning and reaction.", "STATE + HUMAN CHECK: live state must agree with your observation.", {gmUndercoverWitnesses > 0}], ["Break line of sight and evade. Re-approach a different group with weapon concealed. Check that suspicion/recognition follows actual witnesses and that clean groups do not magically share permanent personal knowledge.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}]]]]

; vehicle_cover - Civilian and stolen military vehicle cover
HT_CASES = HT_CASES + [["vehicle_cover", "Occupation", "Civilian and stolen military vehicle cover", "Acquire civilian and military vehicles through normal play. Fresh cover recommended; leave squad behind.", {alive aP}, {}, [["Drive a civilian car through an occupied area without firing. Observe cover and traffic reactions, then CHECK from inside the car.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(vehicle aP) != aP}], ["Drive a stolen occupier military vehicle close to a staffed checkpoint/garrison. Confirm close inspection can expose the disguise. Escape and abandon it; verify on-foot behavior resumes.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(vehicle aP) == aP}]]]]

; heat - Heat spike and recovery
HT_CASES = HT_CASES + [["heat", "Occupation", "Heat spike and recovery", "Keep Outpost occupied. Create a real detected hostile incident before the second step.", {((gmZone SC_OUT) select GM_Z_OWNER) == gmOccupierSide}, {HT_heat = (gmZone SC_OUT) select GM_Z_HEAT}, [["Engage or break cover near Outpost. Observe its heat rise in the journal.", "STATE + HUMAN CHECK: live state must agree with your observation.", {((gmZone SC_OUT) select GM_Z_HEAT) > HT_heat}], ["Withdraw until GREEN; CHECK to record the hot zone before recovery.", "STATE + HUMAN CHECK: live state must agree with your observation.", {HT_hot = (gmZone SC_OUT) select GM_Z_HEAT; ((gmZoneAlert SC_OUT) == 0) and (HT_hot > 0)}], ["Stay disengaged and observe heat fall on the campaign tick.", "STATE + HUMAN CHECK: live state must agree with your observation.", {((gmZone SC_OUT) select GM_Z_HEAT) < HT_hot}]]]]

; escalation - War Level and stronger occupier forces
HT_CASES = HT_CASES + [["escalation", "Occupation", "War Level and stronger occupier forces", "Long campaign check: liberate towns and outposts through normal play. Do not alter War Level from a debug menu.", {gmWarLevel < 6}, {HT_war = gmWarLevel}, [["Liberate enough of the island to raise War Level. Confirm the journal announces the change.", "STATE + HUMAN CHECK: live state must agree with your observation.", {gmWarLevel > HT_war}], ["Visit a newly materialized enemy garrison and trigger a later QRF. Compare its troops/vehicle tier with the current faction roster and War Level. Verify higher levels produce the configured stronger forces.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}]]]]

; income - Natural income and manpower
HT_CASES = HT_CASES + [["income", "Cell", "Natural income and manpower", "Stay safe for an income tick (up to ten simulation minutes). Win town support first for manpower. Spend nothing during this check.", {alive aP}, {HT_money = gmResources; HT_manpower = gmManpower; HT_t = time}, [["Wait for the actual Cell income message. Compare treasury before/after, supportive town income and captured military zones with the journal. CHECK only after seeing the income event.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(gmResources > HT_money) and (time > HT_t)}], ["At an income tick with a supportive calm town, inspect manpower. Verify growth up to the campaign cap; at cap another tick must not overflow it.", "STATE + HUMAN CHECK: live state must agree with your observation.", {gmManpower <= GM_MANPOWER_CAP}]]]]

; recruit - Recruit fighter and specialist
HT_CASES = HT_CASES + [["recruit", "Cell", "Recruit fighter and specialist", "Stand at Camp with at least 2 HR and enough resources for a specialist; wait for companions to spawn before Begin.", {gmRecruitActive and (gmManpower >= 2) and (gmResources >= GM_SPEC_COST_R)}, {HT_units = units (group aP); HT_hr = gmManpower}, [["Use the normal Recruit Fighter action. Confirm one fighter joins, one HR is spent and faction equipment/role are correct.", "STATE + HUMAN CHECK: live state must agree with your observation.", {((count units (group aP)) > (count HT_units)) and (gmManpower < HT_hr)}], ["Use Recruit Specialist. Confirm an additional specialist joins with the advertised resource/manpower debit and correct weapon role.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(count units (group aP)) >= ((count HT_units) + 2)}]]]]

; train - Squad training and rejection
HT_CASES = HT_CASES + [["train", "Cell", "Squad training and rejection", "At Camp with recruits, training resources and room below the current skill cap. Repeat at cap/low funds to test rejection.", {gmRecruitActive and ((count units (group aP)) > 1) and (gmResources >= GM_TRAIN_COST_R)}, {HT_unit = ((units (group aP)) - [aP]) select 0; HT_skill = skill HT_unit; HT_money = gmResources}, [["Use Train Squad. Confirm the advertised debit and a real skill increase on eligible squad members.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(skill HT_unit) > HT_skill}], ["Repeat until the current training cap or insufficient funds prevents further training. Verify clear feedback, no extra skill and no invalid debit. Spend resources through normal purchases if needed.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}]]]]

; recruit_limits - Recruitment funds, proximity and group overflow
HT_CASES = HT_CASES + [["recruit_limits", "Cell", "Recruitment funds, proximity and group overflow", "Longer Camp check: spend manpower normally; allow income to replenish it for overflow. No grants.", {gmRecruitActive}, {}, [["Use recruitment until manpower is insufficient; attempt one more. Verify refusal creates no free fighter and never makes treasury/manpower negative.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(gmResources >= 0) and (gmManpower >= 0)}], ["Walk outside Camp recruitment range. Verify recruit/train actions disappear, then return and verify they appear only once.", "STATE + HUMAN CHECK: live state must agree with your observation.", {not gmRecruitActive}], ["Recruit beyond the first squad capacity over multiple income ticks. Confirm additional fighters enter a separate friendly group, remain commandable as supported, and do not disappear.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(count GM_PLAYER_GROUPS) > 1}]]]]

; loot - Combat loot and permanent gear unlock
HT_CASES = HT_CASES + [["loot", "Cell", "Combat loot and permanent gear unlock", "Fight real garrison troops. Several fights may be needed for an unlock; QRF corpses currently do not feed this tally.", {alive aP}, {HT_counts = format ["%1", GM_GEAR_COUNT]; HT_unlocks = count GM_GEAR_UNLOCKED}, [["Kill a garrison defender using your weapon. Observe the production loot tally change once; verify the same corpse cannot pay twice.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(format ["%1", GM_GEAR_COUNT]) != HT_counts}], ["Keep fighting garrisons until gear reaches its configured unlock threshold. Confirm a new permanent unlock and its journal entry.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(count GM_GEAR_UNLOCKED) > HT_unlocks}], ["Recruit a fighter/specialist of the unlocked weapon role at Camp. Inspect actual equipment and confirm the unlocked loadout is used.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}]]]]

; companion_progress - Companion survival, kills and promotion
HT_CASES = HT_CASES + [["companion_progress", "Cell", "Companion survival, kills and promotion", "A living companion must have spawned. Let them fight through squad commands; allow survival time.", {(count GM_COMP_OBJ) > 0}, {HT_xp = GM_COMP_XP select 0; HT_rank = GM_COMP_RANK select 0}, [["Keep the companion alive and command them in a real engagement. Observe XP accruing from survival and a kill. Confirm its status in the journal.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(GM_COMP_XP select 0) > HT_xp}], ["Continue until promoted naturally. Confirm the live unit rank, skill and journal agree; no test injects XP.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(GM_COMP_RANK select 0) != HT_rank}]]]]

; companion_death - Companion permadeath
HT_CASES = HT_CASES + [["companion_death", "Cell", "Companion permadeath", "Destructive campaign check: save a disposable test campaign first. One living companion must exist.", {(count GM_COMP_ALIVE) > 0}, {}, [["Allow the first companion to die in normal combat. Confirm the death notice, memorial entry and removal from the living roster.", "STATE + HUMAN CHECK: live state must agree with your observation.", {not (GM_COMP_ALIVE select 0)}], ["Save with the normal Save Game action, reload that save, then continue for several companion ticks. Confirm the dead named companion does not respawn.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(HT_LOADS > HT_STARTLOAD) and (not (GM_COMP_ALIVE select 0))}]]]]

; hq - Establish and relocate headquarters
HT_CASES = HT_CASES + [["hq", "Logistics", "Establish and relocate headquarters", "Have enough resources for relocation. Enter a suitable town/Camp on foot using normal play.", {alive aP}, {HT_moves = gmHqMoveCount}, [["Find the actual HQ (or establish it using the normal action). Inspect building, cache, garage and map marker.", "STATE + HUMAN CHECK: live state must agree with your observation.", {gmHqEstablished}], ["Travel to another eligible town/Camp and use Move HQ. Verify the debit, new marker and moved cache/garage, with old location no longer offering HQ services.", "STATE + HUMAN CHECK: live state must agree with your observation.", {gmHqMoveCount > HT_moves}]]]]

; stash - Weapon cache deposit and retrieval
HT_CASES = HT_CASES + [["stash", "Logistics", "Weapon cache deposit and retrieval", "An HQ must exist. Carry a rifle and ammunition to its cache.", {gmHqEstablished}, {HT_weapon = primaryWeapon aP; HT_stashes = gmStashCount}, [["Approach the HQ cache on foot. Deposit your primary weapon with its real cache action. Confirm carried weapon and cache cargo change once.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(primaryWeapon aP) != HT_weapon}], ["Retrieve equipment using normal gear/cargo controls. Verify weapon, magazine counts and registered stash remain consistent.", "STATE + HUMAN CHECK: live state must agree with your observation.", {((primaryWeapon aP) != "") and (gmStashCount > 0)}]]]]

; market_arms - Arms dealer purchase and insufficient funds
HT_CASES = HT_CASES + [["market_arms", "Logistics", "Arms dealer purchase and insufficient funds", "Find an arms dealer on the campaign map; accumulate resources naturally. Check exact price before purchase.", {gmMarketActive and (gmDealerCount > 0)}, {HT_money = gmResources}, [["Approach the arms dealer and purchase a weapon or magazines with the normal action. Inspect delivered cargo/equipment and the advertised debit.", "STATE + HUMAN CHECK: live state must agree with your observation.", {gmResources < HT_money}], ["Attempt an item you cannot afford. Verify the refusal message, no delivered item and no debit. Walk out of range and confirm stock actions disappear.", "STATE + HUMAN CHECK: live state must agree with your observation.", {gmResources >= 0}]]]]

; market_vehicle - Vehicle dealer and HQ delivery
HT_CASES = HT_CASES + [["market_vehicle", "Logistics", "Vehicle dealer and HQ delivery", "Accumulate enough resources for a vehicle. An HQ and a vehicle dealer must exist.", {gmMarketActive and gmHqEstablished}, {HT_money = gmResources}, [["Buy a vehicle for local delivery. Confirm one usable vehicle arrives near the dealer and exactly the advertised price is charged.", "STATE + HUMAN CHECK: live state must agree with your observation.", {gmResources < HT_money}], ["Use the normal delivery destination action and buy another for HQ delivery. Travel to HQ, verify the correct hull/location, enter and drive it.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(vehicle aP) != aP}]]]]

; garage - Garage lock, release and persistence
HT_CASES = HT_CASES + [["garage", "Logistics", "Garage lock, release and persistence", "Own an HQ and drive a bought/commandeered vehicle to its garage ring.", {gmHqEstablished}, {HT_garages = gmGarageCount}, [["Park in the garage, get out and use the real lock/store action. Confirm the vehicle is registered and the menu changes to release.", "STATE + HUMAN CHECK: live state must agree with your observation.", {gmGarageCount > HT_garages}], ["Save and reload; inspect the same vehicle, damage, fuel, cargo and garage ownership.", "STATE + HUMAN CHECK: live state must agree with your observation.", {HT_LOADS > HT_STARTLOAD}], ["Use the normal release action. Verify it can be driven away and is no longer counted as locked in the garage.", "STATE + HUMAN CHECK: live state must agree with your observation.", {gmGarageCount <= HT_garages}]]]]

; legend_names - Earned Legend names, faces and dossiers
HT_CASES = HT_CASES + [["legend_names", "Cell", "Earned Legend names, faces and dossiers", "A living companion must have spawned. Play until the cell records at least one promotion; no test injects XP.", {(count GM_COMP_OBJ) > 0}, {HT_legend = gmLegendName 0; HT_legendid = gmLegendId 0; HT_legendface = gmLegendFace 0}, [["Inspect the first companion in the world and on the map roster. Confirm the same name is shown on the unit label, the cursor target, the journal roster and the People page, and that a portrait face is recorded.", "STATE + HUMAN CHECK: live state must agree with your observation.", {((gmLegendName 0) != "") and ((gmLegendFace 0) != "")}], ["Command that companion through real engagements until a promotion is announced. Confirm the announcement names the companion, that an earned nickname is added rather than replacing the original name, and that the diary records the promotion once.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(gmLegendName 0) != HT_legend}], ["Open the companion dossier from the People page. Read the biography and the recorded deeds, then compare the name and portrait with the live unit. Confirm the biography describes a background only and never restates rank or kills.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}], ["Open Chronicles and read the campaign history and its three event pages. Confirm the places and factions named there belong to this island and campaign, and that reopening the journal shows the same text word for word.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}]]]]

; legend_boss - Enemy commanders: dossier, stand, defeat
HT_CASES = HT_CASES + [["legend_boss", "Cell", "Enemy commanders: dossier, stand, defeat", "Use a fresh campaign; the three enemy commanders are the first three Legend rows and are named before you meet them. Bring ammunition and a squad, and save first.", {gmLegendCount > 2}, {HT_bossname = gmLegendName 0; HT_bosspos = gmLegendPos 0; HT_bossmark = gmLegendMarker 0}, [["Open the map journal People page before you make contact. Read the three Enemy Legends: each carries a name, a role of Sniper, Commander or Tank Commander, the place he watches and a biography. Compare each one with its map marker and its Eliminate objective; all three must name the same man and the same place.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(gmLegendCount > 2) and ((gmLegendName 0) != "")}], ["Travel to the first marked commander and observe him from cover. Confirm he stands outside the zone circle with his guards around him, in faction equipment, and that he returns fire without walking off his ground. Then take the zone he watches while he is still alive and confirm the capture completes anyway.", "STATE + HUMAN CHECK: live state must agree with your observation.", {not (gmLegendDefeated 0)}], ["Kill that commander through normal combat. Confirm the diary records his death once, his marker and dossier change to defeated, his objective completes, and he stays in Enemy Legends rather than moving to the memorial. Wait several minutes and confirm no replacement commander appears.", "STATE + HUMAN CHECK: live state must agree with your observation.", {gmLegendDefeated 0}], ["If one commander rides a tank, destroy the tank without killing him. Confirm the crew bails out, his objective stays open and the dossier still lists him at large until he himself is killed. Record BLOCKED when this campaign fielded no tank commander.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}]]]]

; civilians - Ambient population, conversation and cache
HT_CASES = HT_CASES + [["civilians", "Population", "Ambient population, conversation and cache", "Travel to a populated town. Do not use debug spawns or disable the civilian director.", {GM_CIV_READY}, {}, [["Walk through town. Confirm civilians spawn with the island roster, walk naturally and offer conversation only at close range.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(count GM_CIV_GROUPS) > 0}], ["Leave the town beyond the population cache range, then return. Verify population is cleaned up/recreated without duplicate crowds, stale actions or phantom conversations.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}]]]]

; solicit - Assess, solicit, refuse and cooldown
HT_CASES = HT_CASES + [["solicit", "Population", "Assess, solicit, refuse and cooldown", "Approach a calm ambient civilian on foot. Outcomes depend on their opinion; test both a donation and refusal across actual residents.", {GM_CI_READY}, {HT_last = format ["%1", GM_CI_LAST]}, [["Use the normal assessment action twice. Confirm readable opinion/fear, stable assessment and no money/support debit. Dealers and companions must not offer ambient requests.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(count GM_CI_PROFILES) > 0}], ["Ask for a contribution using the normal action. Confirm the response matches the resident, a donation pays once and a refusal pays nothing.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(format ["%1", GM_CI_LAST]) != HT_last}], ["Try the same resident again during cooldown/after payment. Confirm accurate wait or already-paid feedback and no second payment. Repeat with another resident to cover the other response.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}]]]]

; extortion - Extortion preview, cancel, commit and recovery
HT_CASES = HT_CASES + [["extortion", "Population", "Extortion preview, cancel, commit and recovery", "Approach a calm ambient resident. This changes campaign opinion/support; use a disposable save.", {GM_CI_READY}, {HT_last = format ["%1", GM_CI_LAST]}, [["Choose Consider Extortion. Read the consequences and timed confirmation, then CHECK before choosing.", "STATE + HUMAN CHECK: live state must agree with your observation.", {gmCiMenuState == "CONFIRM"}], ["Cancel. Verify no money, fear or support consequence; preview again and let it expire or walk away. Confirm stale confirmation cannot become a threat.", "STATE + HUMAN CHECK: live state must agree with your observation.", {isNull gmCiConfirmBody}], ["Approach again and explicitly confirm a threat. Verify one response, the resulting money/fear/opinion/support consequences and clear feedback. Later return to inspect recovery.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(format ["%1", GM_CI_LAST]) != HT_last}]]]]

; panic - Civilian harm, panic and economic recovery
HT_CASES = HT_CASES + [["panic", "Population", "Civilian harm, panic and economic recovery", "Use a disposable save in a populated town; witness real violence. Do not inject a kill queue or panic flag.", {GM_CIV_READY}, {}, [["Witness a civilian being shot during live combat (or cause a civilian casualty in this test campaign). Verify fleeing, scream/chat feedback and town panic.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(count GM_PANIC_ZONES) > 0}], ["Observe the journal/support response appropriate to who caused the death. At an income tick, inspect reduced town income and suspended manpower from the panicked town.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}], ["Leave violence behind and wait for calm to recover. Confirm town life and income eligibility resume.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(count GM_PANIC_ZONES) == 0}]]]]

; shakedown - Occupier street shakedown and intervention
HT_CASES = HT_CASES + [["shakedown", "Population", "Occupier street shakedown and intervention", "Wait near populated towns for the actual director. It is probabilistic; use BLOCKED if an eligible scene cannot occur in this session.", {not (isNil "GM_SHK_READY")}, {}, [["Watch a naturally generated occupier pair approach a civilian. Confirm movement, dialogue and the victim's reaction. CHECK while the scene is active.", "STATE + HUMAN CHECK: live state must agree with your observation.", {GM_SHK_ACTIVE}], ["Intervene through normal combat to stop the occupiers. Confirm scene resolution, survivor behavior, journal/support consequences and eventual cleanup.", "STATE + HUMAN CHECK: live state must agree with your observation.", {not GM_SHK_ACTIVE}]]]]

; reprisal - Occupation violence and delayed resentment
HT_CASES = HT_CASES + [["reprisal", "Population", "Occupation violence and delayed resentment", "Separate disposable session: observe an uninterrupted shakedown. Killing branch is probabilistic; do not force it.", {not (isNil "GM_SHK_READY")}, {}, [["Observe a natural shakedown through its end, including the public-killing branch when it occurs. Verify correct civilian casualty attribution and panic. If only nonlethal scenes occur, keep waiting or mark BLOCKED.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}], ["Continue the campaign across the delayed resentment/day tick. Inspect the affected town's support and journal response; verify one deferred consequence, not repeated payments/events.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}]]]]

; assailant_rogue - Spontaneous armed civilian incident
HT_CASES = HT_CASES + [["assailant_rogue", "Population", "Spontaneous armed civilian incident", "Stay near eligible calm residents for the production incident clock. No random-number overrides or force-register commands.", {GM_AS_READY}, {}, [["Wait for a spontaneous armed civilian attack. Confirm the attacker was a real ambient resident and threatens nearby people; take cover. CHECK while registered.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(gmAssailantCount "ROGUE") > 0}], ["Observe occupier/civilian/resistance responses, then stop the attacker through normal combat. Verify panic, casualty attribution and cleanup without innocent bystanders being classified as attackers.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(gmAssailantCount "ROGUE") == 0}]]]]

; assailant_resist - Civilian resistance to extortion
HT_CASES = HT_CASES + [["assailant_resist", "Population", "Civilian resistance to extortion", "Find a defiant resident through normal assessment. Confirm actual threats until a resistance outcome occurs; no forced rolls.", {GM_AS_READY}, {}, [["Confirm extortion against a sufficiently defiant resident. If they retaliate, take cover and CHECK while the incident is live. Refusal alone does not pass this step.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(gmAssailantCount "RESISTER") > 0}], ["Verify retaliation is directed at the extorter and treated differently from an indiscriminate rogue attack. Disengage or stop the attacker normally; inspect panic, journal and witness reactions.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}]]]]

; traffic_ambient - Road traffic, parking and distance lifecycle
HT_CASES = HT_CASES + [["traffic_ambient", "Traffic", "Road traffic, parking and distance lifecycle", "Travel between towns with roads. Give the native traffic scheduler time to run.", {alive aP}, {}, [["Observe civilian road traffic driving town-to-town. Follow a car and check road alignment, turning, braking and collisions.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(count gmTrafficVehicles) > 0}], ["Watch a car reach town and park/wait before leaving again. Observe traffic through a long view distance: visible cars must not pop out. Travel away and return; verify traffic remains bounded and resumes.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}]]]]

; traffic_commandeer - Commandeering and abandoned vehicle cleanup
HT_CASES = HT_CASES + [["traffic_commandeer", "Traffic", "Commandeering and abandoned vehicle cleanup", "Find a live civilian traffic car using normal travel. Stay armed and use the game's actual stop/commandeer interaction.", {alive aP}, {}, [["Stop a civilian traffic car through the normal player interaction. Verify it brakes, driver exits/flees, and the hull becomes usable without duplicate occupants.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}], ["Enter and drive the released car away, then abandon it. Verify it remains under player control while occupied and old empty hulls/wrecks eventually clean up at distance.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(vehicle aP) != aP}]]]]

; traffic_patrol - Occupier vehicle patrols and danger response
HT_CASES = HT_CASES + [["traffic_patrol", "Traffic", "Occupier vehicle patrols and danger response", "On fresh Abel, walk to Village and use Prepare road fixture before Begin. It calls native traffic and makes Camp an enemy endpoint; restart before other cases.", {alive aP}, {}, [["Find an occupier traffic patrol. Follow it through a route and observe faction hull/crew, road movement and stops.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(gmTrafficCount "PATROL") > 0}], ["Threaten or attack it normally. Verify the crew's danger reaction, engagement/dismount and recovery or cleanup after disengagement.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}]]]]

; traffic_convoy - Supply convoy and escort
HT_CASES = HT_CASES + [["traffic_convoy", "Traffic", "Supply convoy and escort", "On fresh Abel, walk to Village and use Prepare road fixture before Begin. Native traffic supplies the truck and escort. A missing event is BLOCKED.", {alive aP}, {}, [["Observe a supply convoy with its escort. Verify spacing, same route and coordinated movement.", "STATE + HUMAN CHECK: live state must agree with your observation.", {(gmTrafficCount "CONVOY") > 0}], ["Ambush the escort through real combat. Verify convoy danger/escape behavior and what happens after the escort is lost; drive off or destroy the truck and inspect cleanup.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}]]]]

; journal - Journal, objectives and map navigation
HT_CASES = HT_CASES + [["journal", "Campaign", "Journal, objectives and map navigation", "Complete at least one recruit/capture/conversation action first.", {gmZoneCount > 0}, {}, [["Open the map journal. Walk Situation, Plan, Zones, Cell, Resistance, Diary and Handbook. Check readable text, scrolling and selection with normal controls.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}], ["Open a zone-linked note/objective and navigate to its zone. Compare resources, companion roster, gear unlocks and completed objectives with the world. Verify fresh campaign events update the displayed pages.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}]]]]

; persistence - Save/load the live campaign and test ledger
HT_CASES = HT_CASES + [["persistence", "Campaign", "Save/load the live campaign and test ledger", "Prepare a meaningful campaign: recruit, loot, move HQ/store cargo, interact with residents and capture a zone. Save only after the first CHECK.", {alive aP}, {}, [["Inspect treasury, manpower, zone ownership/heat, companion rank, gear, HQ, cargo, vehicles and current civilian/traffic state. CHECK to record evidence, then use the normal Save Game action. Do not start a staged demo.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}], ["Load that save through the normal menu. Verify this same test step/ledger resumes, exactly one Save action and one test menu exist, and the recorded campaign facts match. Let companions, garrisons, civilians and traffic tick without duplication.", "STATE + HUMAN CHECK: live state must agree with your observation.", {HT_LOADS > HT_STARTLOAD}], ["Perform another real recruit, purchase or conversation after reload. Verify a single debit/outcome, then save/load again and inspect continued campaign play.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}]]]]

; campaign_matrix - New-game islands, factions and outfits
HT_CASES = HT_CASES + [["campaign_matrix", "Campaign", "New-game islands, factions and outfits", "External-session checklist: perform the documented new-game matrix, then record the result here. Use the real GUERRILLA menu; see HUMAN-TESTS.md.", {alive aP}, {}, [["From the main menu, create campaigns on each installed island. Cycle available occupier/resistance rosters and both supported outfits. Verify previews, required-content gating, spawn location, player body/equipment and faction sides.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}], ["On each selected combination, recruit, encounter a garrison, interact with a civilian, use a dealer and save/reload. Verify assets resolve and local UI/journal/map text reflects that island/faction. Record unavailable content as BLOCKED in the external run sheet, never a pass.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}]]]]

; ai - AI perception, suppression, morale and target choice
HT_CASES = HT_CASES + [["ai", "Soldier", "AI perception, suppression, morale and target choice", "Use actual garrisons and QRFs in a disposable campaign. Repeat encounters from a save to compare approaches.", {alive aP}, {}, [["Approach a garrison at comparable distance standing in the open, then prone behind concealment. Observe detection and lost-contact search. Confirm cover/stance/line of sight influence spotting and enemies do not track through solid terrain.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}], ["Suppress defenders with sustained nearby fire, then flank with your squad. Observe ducking, reduced return fire, cover seeking and morale after casualties. Verify retreat seeks usable cover and units recover when pressure ends.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}], ["Engage a mixed QRF using infantry and a vehicle. Observe role-appropriate target choice, nearby groups responding to reports and eventually forgetting lost targets. Report stuck pathing, impossible knowledge or indiscriminate targeting.", "HUMAN VISUAL CHECK: your confirmation is the evidence.", {true}]]]]

HT_CASES_READY = true
exit
