; ============================================================================
;  init.sqs  -  Guerrilla Mode bootstrap (auto-loaded by RunInitScript,
;               engine/Poseidon/UI/DisplayUI.cpp)
; ----------------------------------------------------------------------------
;  THIN by design (Phase 1.5): the zone model, fog-of-war/markers repaint,
;  capture flips, garrison distance-cache, alert FSM and campaign persistence
;  are all NATIVE now (engine/Poseidon/Game/Guerrilla/*, activated by
;  class CfgGuerrillaZones in description.ext). This file only:
;    1. seeds SCRIPT-side state (economy scalars, gear/companion rosters,
;       event queues) - all plain GGameState globals, so they serialize free;
;    2. creates the marker OBJECT for every zone (the engine repaints only
;       markers that already exist in markersMap; created markers serialize
;       with the world, so this runs once per campaign, never on load);
;    3. registers the native event handlers (they are SERIALIZED - a loaded
;       campaign keeps them without any re-arm);
;    4. execs the helper library + the event-driven manager scripts.
;
;  EVENT-QUEUE PATTERN (binding for every manager): native handlers cannot
;  ~sleep (they run synchronously inside the engine tick), so each handler is
;  ONE line that appends its _this tuple to a gmEvt* queue global. Exactly one
;  manager consumes each queue with an atomic drain-swap
;  ("GM_x = gmEvtX + []; gmEvtX = []" on a single SQS line - one evaluated
;  unit, so no handler can interleave) and reacts inside its own ~ loop.
;
;  NAMING CONVENTION (unchanged):
;    GM_*   constants / structured data     gm*     mutable scalar state
;    GM_fn* code-string helpers (lib.sqs)   GM_tmp* helper scratch (never read)
;    gmEvt* native-event queues (owner: the consuming manager; appenders: the
;           one-line handlers registered below)
;
;  DIALECT: SQS (one statement per line, ~N waits, @cond gates, #label/goto).
;  The evaluator now also has compile/isNil/setVariable/nearestObjects/
;  distance-on-arrays/setRank/private - used where they clarify.
; ============================================================================

; ---- single-run guard (isNil is available now; a save/load never re-runs
;      init.sqs anyway - scripts and globals resume from the snapshot) --------
? not (isNil "GM_BOOTED") : exit
GM_BOOTED = true

; ===========================================================================
;  ZONE TUPLE INDEX CONSTANTS - the shape returned by `gmZone <i>`:
;  [name, type, owner, garrison, support, income, heat, marker, [x,y,z], capture]
;  Positions are getPos order [easting, northing, elevation]. Zone STATE
;  lives in the native ZoneRegistry; these constants exist only so scripts
;  reading gmZone tuples stay legible.
; ===========================================================================
; (SQS gotcha, learned the hard way: a mid-line ; is a STATEMENT SEPARATOR,
;  not a comment - annotations live on their own ;-lines throughout.)
;   GM_Z_NAME    string,  unique zone id
;   GM_Z_TYPE    string,  "CAMP" | "AIRFIELD" | "SEAPORT" | "OUTPOST" | "CITY"
;   GM_Z_OWNER   string,  side string (compare against gmOccupierSide / gmResistanceSide) or "NEUTRAL"
;   GM_Z_GAR     scalar,  occupier reserve while despawned (native cache)
;   GM_Z_SUPPORT scalar,  0..100 town support
;   GM_Z_INCOME  scalar,  per economy tick when resistance-owned
;   GM_Z_HEAT    scalar,  0..100 per-zone Heat (write via gmZoneSet heatRaise/heatDecay only)
;   GM_Z_MARKER  string,  marker name the zone owns
;   GM_Z_POS     array,   [x,y,z] center, getPos order
;   GM_Z_CAPTURE scalar,  0..100 military consolidation meter (native)
GM_Z_NAME    = 0
GM_Z_TYPE    = 1
GM_Z_OWNER   = 2
GM_Z_GAR     = 3
GM_Z_SUPPORT = 4
GM_Z_INCOME  = 5
GM_Z_HEAT    = 6
GM_Z_MARKER  = 7
GM_Z_POS     = 8
GM_Z_CAPTURE = 9

; ===========================================================================
;  PLAYER-FACTION ECONOMY & ESCALATION SCALARS
; ===========================================================================
;   gmResources   Rouble treasury (training, gear, vehicles, bribes)
;   gmManpower    HR: 1 HR = 1 recruitable body; hard cap on faction size
;   gmWarLevel    1..10 slow escalation; the native garrison + qrf.sqs read it
;   gmHeatDecay   Heat bled per GREEN zone per escalation tick
;   gmUndercover  script-OWNED (the engine only READS it each alert tick);
;                 undercover.sqs establishes true at boot and KEEPS it -
;                 exposure is per-observer native state (gmUndercoverStatus)
gmResources = 100
gmManpower  = 2
gmWarLevel  = 1
gmHeatDecay = 1
gmUndercover = false

; ===========================================================================
;  CHARACTER OUTFIT FAMILY (issue #25)
; ===========================================================================
; gmSelOutfit is published by the new-game character cycler ("WARRIOR" /
; "CIVILIAN") and is NIL on any direct launch - the isNil gate keeps the
; fold safe there (string == is case-insensitive). The engine has already
; substituted the PLAYER body at load (WorldInit.cpp); this flag is what the
; managers read to match recruits/companions/hold squads (recruit.sqs,
; companions.sqs, capture.sqs) via the *Civ descriptor keys. Locked at
; new-game by construction: a save resumes these scripts with the flag
; already folded, and no writer exists after these lines.
GM_OUTFIT_CIV = false
? not (isNil "gmSelOutfit") : GM_OUTFIT_CIV = format ["%1", gmSelOutfit] == "CIVILIAN"

; ===========================================================================
;  GEAR PROGRESSION  (parallel arrays; sole writer is lib's GM_fnBumpGear)
; ===========================================================================
; loot N of an item -> faction-wide unlock
GM_GEAR_THRESHOLD = 25
GM_GEAR_ITEMS     = []
GM_GEAR_COUNT     = []
GM_GEAR_UNLOCKED  = []

; ===========================================================================
;  NAMED COMPANIONS  (parallel arrays keyed by name; GM_COMP_OBJ transient)
; ===========================================================================
; seed triple is ladder-consistent (companions.sqs): XP 100 = CORPORAL,
; skill = 0.35 + 0.10 * rankIdx = 0.45
GM_COMP_NAMES   = ["Petra"]
GM_COMP_ALIVE   = [true]
GM_COMP_RANK    = ["CORPORAL"]
GM_COMP_XP      = [100]
GM_COMP_SKILL   = [0.45]
; GM_COMP_LOADOUT: per-companion [weapons[], mags[]]
; GM_COMP_OBJ: live handle; reconciled by campaign.sqs on load
GM_COMP_LOADOUT = [ [ [], [] ] ]
GM_COMP_OBJ     = [objNull]

; ===========================================================================
;  PLAYER-GROUP BOOKKEEPING (recruit.sqs owns; 12-cap overflow groups)
; ===========================================================================
GM_PLAYER_GROUPS = []

; ===========================================================================
;  CIVILIAN LAYER SHARED STATE (issue #8; civilians.sqs + shakedown.sqs)
; ===========================================================================
; gmCivKilled  civilian KILL QUEUE. Tuples [victim, killer, pos, zoneIdx].
;   Appended by (a) the per-unit killed-EH civilians.sqs attaches at spawn
;   (loot.sqs tag pattern - script EHs, NOT a native gmZoneOnEvent; there is
;   no native civilian-kill event and none is added) and (b) shakedown.sqs
;   posting SYNTHETIC records with the TRUE initiator for scripted
;   executions (setDammage fires no killer attribution). Drained ONLY by
;   civilians.sqs with the atomic one-line swap
;   "GM_x = gmCivKilled + []; gmCivKilled = []". Handles inside queued
;   tuples may come back null after a load - the consumer prunes, the pos /
;   zoneIdx fields stay authoritative. gmCivKilled deliberately does NOT use
;   the gmEvt* prefix: it is a script-EH queue, not a native-event queue
;   (the drain-swap discipline is the same).
; GM_PSEUDO_GROUPS  pseudo-team roster (GROUP handles). Seeded EMPTY here;
;   issue #2's spawner is the sole future writer (and owns post-load
;   reconciliation). civilians.sqs only READS it for killer classification:
;   (group killer) in GM_PSEUDO_GROUPS -> PSEUDO -> blame the player.
; GM_PANIC_ZONES / GM_PANIC_UNTIL  town panic ledger (parallel arrays):
;   zone NAME + recovery expiry (time-based). Owner: civilians.sqs.
; GM_RESENT_ZONES / GM_RESENT_DUE / GM_RESENT_AMT  resentment ledger
;   (parallel arrays): zone NAME, due time, +support amount. Writers: lib's
;   GM_fnResentAdd only. Consumer: shakedown.sqs ticker. System 3 proper
;   (closures/reprisals) will REUSE this ledger - keep the shape dumb.
; GM_RESENT_MAXPEND  per-town pending-entry cap (GM_fnResentAdd reads it).
; gmDayCount / gmDayLast  campaign day counter: shakedown.sqs bumps
;   gmDayCount when dayTime wraps past midnight (gmDayLast > dayTime).
; GM_CIV_GROUPS / GM_CIV_GROUP_ZONE  civ population registers (owner:
;   civilians.sqs, which re-seeds them at boot). Seeded here TOO so
;   shakedown.sqs can read them even when civilians.sqs no-op exits or has
;   not booted yet - no exec-order dependency between the two managers.
gmCivKilled      = []
GM_PSEUDO_GROUPS = []
GM_PANIC_ZONES   = []
GM_PANIC_UNTIL   = []
GM_RESENT_ZONES  = []
GM_RESENT_DUE    = []
GM_RESENT_AMT    = []
GM_RESENT_MAXPEND = 3
gmDayCount = 0
gmDayLast  = 0
GM_CIV_GROUPS     = []
GM_CIV_GROUP_ZONE = []

; ---- handy aliases ---------------------------------------------------------
aP = player
gmPlayer = player

; ===========================================================================
;  NATIVE-EVENT QUEUES  (each handler below appends; one manager drains each)
;    gmEvtCaptured   [zoneIndex, zoneName, ownerString]  -> capture.sqs
;    gmEvtSupport    [zoneIndex, zoneName, ownerString]  -> capture.sqs
;    gmEvtRevealed   [zoneIndex, zoneName, ownerString]  -> capture.sqs (drained)
;    gmEvtCapStart   [zoneIndex, zoneName, ownerString]  -> capture.sqs
;    gmEvtContested  [zoneIndex, zoneName, ownerString]  -> capture.sqs
;    gmEvtCapLost    [zoneIndex, zoneName, ownerString]  -> capture.sqs
;    gmEvtLoaded     [saveVersion]                       -> campaign.sqs
;    gmEvtAlert      [zoneIndex, zoneName, old, new]     -> qrf.sqs
;    gmEvtUcBroken   [reason]                            -> undercover.sqs
;    gmEvtGarSpawned / gmEvtGarDespawned [idx, name, n]  -> loot.sqs
; ===========================================================================
gmEvtCaptured    = []
gmEvtSupport     = []
gmEvtRevealed    = []
gmEvtCapStart    = []
gmEvtContested   = []
gmEvtCapLost     = []
gmEvtLoaded      = []
gmEvtAlert       = []
gmEvtUcBroken    = []
gmEvtGarSpawned  = []
gmEvtGarDespawned = []
gmEvtTrSpawned   = []
gmEvtTrDespawned = []
gmEvtTrCommandeered = []
gmEvtTrArrived   = []

; ===========================================================================
;  MARKERS: create one per zone (config zones AND seedCities-seeded towns all
;  come through gmZoneCount/gmZone). The engine repaints color/label natively
;  but only for markers present in markersMap - creating them is the mission's
;  job. "Flag" / the sizes are engine-level marker facts, not island data.
; ===========================================================================
GM_iI = 0
#mkmarkers
? GM_iI >= gmZoneCount : goto "mkdone"
GM_iRec = gmZone GM_iI
GM_iM = createMarker [(GM_iRec select GM_Z_MARKER), (GM_iRec select GM_Z_POS)]
(GM_iRec select GM_Z_MARKER) setMarkerType "Flag"
(GM_iRec select GM_Z_MARKER) setMarkerSize [0.6, 0.6]
GM_iI = GM_iI + 1
goto "mkmarkers"
#mkdone

; ===========================================================================
;  NATIVE EVENT HANDLERS - one line each, enqueue only (SQS handlers cannot
;  wait; managers do the real work). Handlers are serialized by the engine,
;  so a loaded campaign fires them without re-registration.
; ===========================================================================
gmZoneOnEvent ["captured", {gmEvtCaptured = gmEvtCaptured + [_this]}]
gmZoneOnEvent ["supportThreshold", {gmEvtSupport = gmEvtSupport + [_this]}]
gmZoneOnEvent ["revealed", {gmEvtRevealed = gmEvtRevealed + [_this]}]
gmZoneOnEvent ["captureStarted", {gmEvtCapStart = gmEvtCapStart + [_this]}]
gmZoneOnEvent ["contested", {gmEvtContested = gmEvtContested + [_this]}]
gmZoneOnEvent ["captureLost", {gmEvtCapLost = gmEvtCapLost + [_this]}]
gmZoneOnEvent ["campaignLoaded", {gmEvtLoaded = gmEvtLoaded + [_this]}]
gmAlertOnEvent ["alertChanged", {gmEvtAlert = gmEvtAlert + [_this]}]
gmAlertOnEvent ["undercoverBroken", {gmEvtUcBroken = gmEvtUcBroken + [_this]}]
gmGarrisonOnEvent ["garrisonSpawned", {gmEvtGarSpawned = gmEvtGarSpawned + [_this]}]
gmGarrisonOnEvent ["garrisonDespawned", {gmEvtGarDespawned = gmEvtGarDespawned + [_this]}]
; Ambient road traffic (native Traffic service): enqueue-only handlers plus
; the driverKilled killed-EH EXPRESSION every civilian driver carries - it
; routes a road murder into the same civilians.sqs ledger tuple as a town
; civilian (guarded: no CIV layer, no ledger).
gmTrafficOnEvent ["spawned", {gmEvtTrSpawned = gmEvtTrSpawned + [_this]}]
gmTrafficOnEvent ["despawned", {gmEvtTrDespawned = gmEvtTrDespawned + [_this]}]
gmTrafficOnEvent ["commandeered", {gmEvtTrCommandeered = gmEvtTrCommandeered + [_this]}]
gmTrafficOnEvent ["arrived", {gmEvtTrArrived = gmEvtTrArrived + [_this]}]
gmTrafficOnEvent ["driverKilled", {if (not (isNil "GM_fnCivKilledEH")) then {_this call GM_fnCivKilledEH}}]

; ===========================================================================
;  LAUNCH SEQUENCE - helpers first (exec is async; the @-gate on the lib-ready
;  sentinel is kept over isNil-polling for simplicity: one flag, one gate,
;  and every manager re-guards on it), then the event-driven managers.
; ===========================================================================
GM_LIB_READY = false
[] exec "scripts/lib.sqs"
@GM_LIB_READY

;   capture.sqs     captured-event reaction: hold garrison + notify
;   qrf.sqs         alert policy: garrison posture + QRF convoy
;   undercover.sqs  establish cover + fired-EH + break reaction
;   campaign.sqs    Save action + campaignLoaded reconciliation
;   economy.sqs     Resources / Manpower income tick
;   escalation.sqs  War Level ladder + Heat decay
;   loot.sqs        loot-on-kill stash + gear-unlock tally
;   recruit.sqs     Camp action menu: recruit / specialist / train
;   market.sqs      HQ / cache / garage / dealer action menus (native
;                   GuerrillaBase + Market facts; the second "-" writer of
;                   gmResources: purchases and HQ moves)
;   companions.sqs  companion XP -> rank/skill, permadeath
;   civilians.sqs   town population cache + kill-queue consumer + panic FSM
;   shakedown.sqs   occupier street-theatre director + resentment ticker
[] exec "scripts/capture.sqs"
[] exec "scripts/qrf.sqs"
[] exec "scripts/undercover.sqs"
[] exec "scripts/campaign.sqs"
[] exec "scripts/economy.sqs"
[] exec "scripts/escalation.sqs"
[] exec "scripts/loot.sqs"
[] exec "scripts/recruit.sqs"
[] exec "scripts/market.sqs"
[] exec "scripts/companions.sqs"
[] exec "scripts/civilians.sqs"
[] exec "scripts/shakedown.sqs"

exit
