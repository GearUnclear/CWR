// Guerrilla Mode on Abel (Malden, full CWA 1.99 data) - the per-island data
// file (issue #3 item 3). Everything island- or faction-specific lives HERE:
// the zone seed (CfgGuerrillaZones) and the faction descriptors
// (CfgGuerrillaFactions). The scripts/ directory is the shared
// island-agnostic core - byte-identical to guerrilla-mode/mission/
// Guerrilla.Demo (enforced by test_mission_script_core.cpp).
//
// This is the PLAYABLE stock-island template: the GUERRILLA new-game menu
// resolves "missions\Guerrilla.Abel" for the Abel island entry, and the
// single-mission browser can direct-launch it (the default* keys below
// cover that path, where no new-game selection was published).
//
// Zone geometry derives from the surveyed test mission
// (tests/integration/missions/guerrilla_native.abel), verified on-land via
// `PoseidonTools terrain inspect/objects abel.wrp` + CfgWorlds >> Abel -
// with ONE deliberate difference: the test Camp centre [7600,5700] sits
// ~120 m offshore (kept there for assertion stability); a playable Camp
// must be dry, so this template centres it on the fig-tree plain at
// [7515,5790] where the player also starts (mission.sqm).
//   * Camp     (RESISTANCE) coastal plain SE of Houdan; player start.
//   * Outpost  (OCCUPIER, garrison 6) ~515 m NNE - INSIDE the 800 m
//     cacheRadius, so the native GarrisonCache spawns it at boot.
//   * Village  = the real town of Houdan (~490 m NW), an explicit NEUTRAL
//     CITY zone; the seedCities pass then dedups the town's own Names entry.
// All three sit within revealRadius of the Camp -> revealed on tick 1.

onLoadMission = "Guerrilla Mode - Abel";
onLoadIntro  = "Liberate Malden, one zone at a time.";
respawn = 0;
joinInProgress = 0;

class CfgGuerrillaZones
{
    // Engine tuning left at stock defaults (tickInterval=3; zoneArea=150;
    // revealRadius=1500; cacheRadius=800; supportRate=5; supportFlip=60;
    // heatCapSpike=40; defaultIncome=25; cacheInterval=5; groupSize=12;
    // alertInterval=5; alert*Knows/Heat defaults).  Direct-launch faction
    // fallbacks are stated explicitly (single-mission browser launches skip
    // the new-game UI, so nothing is published there):
    // Ambient road traffic (native Traffic service) runs on its stock
    // defaults too: trafficEnabled=1; trafficInterval=5; trafficRadius=1500;
    // trafficMinSpawnDist=300; trafficDespawnHysteresis=300; trafficMaxCiv=3;
    // trafficMaxPatrols=1; trafficMaxConvoys=1; trafficCivChance=0.5;
    // trafficPatrolChance=0.25; trafficConvoyChance=0.04;
    // trafficConvoyWarScale=0.5; trafficStallTimeout=90; trafficArriveRadius=60;
    // trafficMaxLegs=3; trafficCommandeerRadius=25;
    // trafficCommandeerLaneHalfWidth=4; trafficCommandeerStopDelay=2.5;
    // trafficFleeDist=150 (set trafficEnabled=0 to switch it off).
    defaultOccupier = "EAST";
    defaultResistance = "GUER";
    // The side mission.sqm welds the player's unit to (side="GUER",
    // SoldierGB). The campaign's RESISTANCE side is pinned to this: the
    // engine counts resistance presence via the resistance side's center,
    // so a resistance on any other side would never count the player.
    // The resistance cycler therefore picks a ROSTER, not a side.
    playerSide = "GUER";
    seedCities = 1;       // auto-seed CITY zones from Abel's named towns
    seedCitySupport = 20; // their starting support (markers "gmZoneCity_<n>")

    class Zones
    {
        // COORDINATE ORDER (load-bearing): position[] is authored in
        // script/getPos order [easting, northing, elevation] - NOT the
        // mission.sqm order [easting, ELEVATION, northing]. The engine's
        // ZoneRegistry::LoadZones documents and enforces this contract.
        class Camp
        {
            name = "Camp";
            type = "CAMP";
            owner = "RESISTANCE";   // generic token, resolved per campaign
            garrison = 0;
            support = 100;
            income = 0;
            marker = "gmZoneMarker_0";
            position[] = {7515, 5790, 20};
        };
        class Village
        {
            name = "Village";
            type = "CITY";
            owner = "NEUTRAL";
            support = 20;
            marker = "gmZoneMarker_1";
            position[] = {7117, 6069, 35};  // Houdan (CfgWorlds >> Abel >> Names)
        };
        class Outpost
        {
            name = "Outpost";
            type = "OUTPOST";
            owner = "OCCUPIER";     // generic token, resolved per campaign
            garrison = 6;
            income = 25;
            marker = "gmZoneMarker_2";
            position[] = {7600, 6300, 25};
        };
    };
};

// Faction descriptors for the FULL CWA 1.99 dataset.  Every classname below
// was verified against Bin\CONFIG.BIN (PoseidonTools config search/dump).
// NOTE the OFP magazine convention: simple weapons ARE their own magazine
// class (CfgWeapons AK47 has scopeMagazine=2), so baseMagazine/loot*Mag reuse
// the weapon classname - there is no "AK47Mag" class in this dataset.
class CfgGuerrillaFactions
{
    class WEST // US force - selectable as occupier OR resistance
    {
        side = "WEST";
        // Mirrors EAST's ladder rung-for-rung: WL<3 riflemen -> WL3-4
        // grenadiers -> WL5+ crack troops. Deliberately SYMMETRIC with EAST:
        // either side can now be the occupier, so an asymmetric elite step
        // would silently turn the occupier pick into a difficulty setting.
        // SoldierWCrew (M4 + NVGoggles) is the structural twin of EAST's
        // SoldierECrew (AK74SU + NVGoggles). classic-infantry.md suggests
        // SoldierWSaboteurDay as the elite step; rejected - tiers[i] is the
        // squad's RIFLEMAN class and its only rifle is the ~200 m HK/MP5, so
        // a WL5+ garrison would shoot worse than the WL1 M16 conscripts it
        // replaces. A true elite step must change BOTH sides together.
        tiers[] = {"SoldierWB", "SoldierWG", "SoldierWCrew"};
        tierThresholds[] = {3, 5};
        // per-tier role variants (plan 15; all verified in the 1.99 config):
        // the native squad composer fills MG/AT/medic/sniper slots from
        // these; "" = the tier fields no such role. The sniper appears only
        // with the elite tier - identical policy to EAST.
        tiersMG[]     = {"SoldierWMG", "SoldierWMG", "SoldierWMG"};
        tiersAT[]     = {"SoldierWLAW", "SoldierWLAW", "SoldierWLAW"};
        tiersMedic[]  = {"SoldierWMedic", "SoldierWMedic", "SoldierWMedic"};
        tiersSniper[] = {"", "", "SoldierWSniper"};
        // QRF escort ladder, mirroring EAST rung-for-rung: Jeep patrol (3
        // cargo, the twin of EAST's UAZ) -> 5t troop truck (12, a full
        // group) -> M113 APC (8) -> M60 escort (0 cargo, escort-only)
        vehicles[] = {"Jeep", "Truck5t", "M113", "M60"};
        vehicleThresholds[] = {3, 6, 8};
        officer = "OfficerW";

        // ---- resistance-capable key set (any faction may now be the
        // resistance roster; on this island it spawns onto the GUER player
        // side): post-capture hold squads, recruitment, the player's loot ----
        holdClass = "SoldierWB";
        holdCount = 3;
        recruitFighter = "SoldierWB";
        recruitSpecialist = "SoldierWMG";
        companionClass = "SoldierWB";

        baseWeapon = "M16";
        baseMagazine = "M16";
        lootRiflemanWeapon = "M16";
        lootRiflemanMag = "M16";
        lootMedicWeapon = "M16";
        lootMedicMag = "M16";
        // NOTE: "M60" is used with TWO meanings in this file, deliberately.
        // Here it is CfgWeapons M60 (the 7.62 MG, scopeWeapon=2/scopeMagazine=2);
        // in vehicles[] above it is CfgVehicles M60 (the tank, side=1 scope=2).
        // Safe: ResolveFactionClasses probes bank-scoped - it resolves
        // vehicles[] against kVeh="CfgVehicles" and loot*/base* against
        // kWpn="CfgWeapons", so neither reading can pick up the other's class.
        lootMGWeapon = "M60";
        lootMGMag = "M60";
        lootATWeapon = "LAWLauncher";
        lootATMag = "LAWLauncher";
        lootSniperWeapon = "M21";
        lootSniperMag = "M21";

        // town flagpole texture (native TownFlags); matches the engine's
        // side-WEST default - stated for the data-file contract
        flag = "\flags\usa.jpg";
    };
    class EAST // occupier descriptor; also selectable as the RESISTANCE roster
    {
        side = "EAST";
        // WL<3 conscripts -> WL3-4 grenadiers -> WL5+ crack troops
        tiers[] = {"SoldierEB", "SoldierEG", "SoldierECrew"};
        tierThresholds[] = {3, 5};
        // per-tier role variants (plan 15; all verified in the 1.99 config):
        // the native squad composer fills MG/AT/medic/sniper slots from
        // these; "" = the tier fields no such role. The sniper appears only
        // with the elite tier - regulars do not embed marksmen in a
        // checkpoint garrison.
        tiersMG[]     = {"SoldierEMG", "SoldierEMG", "SoldierEMG"};
        tiersAT[]     = {"SoldierELAW", "SoldierELAW", "SoldierELAW"};
        tiersMedic[]  = {"SoldierEMedic", "SoldierEMedic", "SoldierEMedic"};
        tiersSniper[] = {"", "", "SoldierESniper"};
        // QRF escort ladder (full vehicleThresholds[] form): UAZ patrol ->
        // Ural troop truck -> BMP IFV -> T72 escort
        vehicles[] = {"UAZ", "Ural", "BMP", "T72"};
        vehicleThresholds[] = {3, 6, 8};
        officer = "OfficerE";

        // ---- resistance-capable key set (EAST may now be the resistance
        // roster; on this island it spawns onto the GUER player side) ----
        holdClass = "SoldierEB";
        holdCount = 3;
        recruitFighter = "SoldierEB";
        recruitSpecialist = "SoldierEMG";
        companionClass = "SoldierEB";

        // SoldierECrew's AK74SU is deliberately NOT a loot weapon:
        // scopeMagazine=0, it feeds from AK74 mags (see the convention note
        // above the class).
        baseWeapon = "AK74";
        baseMagazine = "AK74";
        lootRiflemanWeapon = "AK74";
        lootRiflemanMag = "AK74";
        lootMedicWeapon = "AK74";
        lootMedicMag = "AK74";
        lootMGWeapon = "PK";
        lootMGMag = "PK";
        lootATWeapon = "RPGLauncher";
        lootATMag = "RPGLauncher";
        lootSniperWeapon = "SVDDragunov";
        lootSniperMag = "SVDDragunov";

        // town flagpole texture (native TownFlags); matches the engine's
        // side-EAST default - stated for the data-file contract
        flag = "\flags\ussr.jpg";
    };
    class GUER // resistance descriptor; also selectable as the OCCUPIER
    {
        side = "GUER";
        // WL<4 riflemen -> WL4+ grenadiers. Honestly TWO tiers, not three: the
        // 1.99 core config ships no GUER special-forces/saboteur class, so the
        // ladder stops here rather than promoting SoldierGMG out of its role
        // slot. The vehicle ladder (which does reach T55G) carries the
        // high-war-level escalation instead. Tier 0 stays SoldierGB, so the
        // pre-existing resistance behaviour at low war level is unchanged.
        tiers[] = {"SoldierGB", "SoldierGG"};
        tierThresholds[] = {4};
        // role variants for the post-capture hold squads AND for the
        // GUER-as-occupier swap; parallel to tiers[], so two entries each.
        tiersMG[]    = {"SoldierGMG", "SoldierGMG"};
        tiersAT[]    = {"SoldierGLAW", "SoldierGLAW"};
        tiersMedic[] = {"SoldierGMedic", "SoldierGMedic"};
        // no GUER sniper exists in the 1.99 core config (SoldierGSniper is a
        // Resistance-era addon class, absent from the merged CONFIG.BIN).
        // "" = role-absent. For the SNIPER specifically that means the slot is
        // SUPPRESSED, not filled by a stand-in: ComposeSquad's `tierHasSniper`
        // test reads this entry's length and forces the sniper count to 0, so
        // the role() rifleman-substitution the other three roles get never runs
        // for it and the squad simply fills to size with riflemen. NOT
        // substituted with a cross-side SVD carrier. The SVDDragunov
        // lootSniper* entries below stay: the player still arms marksmen from
        // captured Soviet stock, which is the historically plausible FIA
        // answer anyway.
        tiersSniper[] = {"", ""};
        // Captured/irregular motor pool: guerrilla jeep -> PV3S truck ->
        // captured BMP -> T55.
        //
        // "BMP" is CfgVehicles BMP, which is side=0 (EAST) and crew=SoldierECrew
        // - and that is deliberate, not an oversight. 1.99 ships NO GUER-sided
        // APC or IFV at all (the complete side=2 scope=2 vehicle set is GJeep,
        // UAZG, SGUAZG, TruckV3SG +Reammo/Refuel/Repair, T55G, ParachuteG), so
        // the alternative is no APC rung. A vehicle's SIDE comes from the
        // AICenter of the group it spawns into, never from its config class
        // (GameStateExtWorld.cpp does veh->SetTargetSide(center->GetSide())),
        // so a BMP spawned into the resistance's center IS resistance armour.
        // That is exactly the captured-hull fiction this rung wants: the FIA
        // does not manufacture IFVs, it takes them. Same reasoning as T55G's
        // real history, minus a re-sided class to take it from.
        vehicles[] = {"GJeep", "TruckV3SG", "BMP", "T55G"};
        vehicleThresholds[] = {4, 7, 9};
        // CHANGED from SoldierGB: now that GUER can be picked as the
        // OCCUPIER, `officer` seeds garrison/QRF leader slots, and a leader
        // identical to his own riflemen is a real downgrade. OfficerG is a
        // verified side=2 scope=2 class (: SoldierGB, AK47 + Binocular).
        officer = "OfficerG";

        holdClass = "SoldierGB";
        holdCount = 3;
        recruitFighter = "SoldierGB";
        recruitSpecialist = "SoldierGMG";
        companionClass = "SoldierGB";

        // ---- character outfit family (issue #25): the CIVILIAN column of
        // the warrior/civilian axis. SoldierGFakeC/SoldierGFakeC2 are BIS's
        // own resistance-in-plainclothes classes (": Civilian"/": Civilian2",
        // side=2, armed, accuracy=2, scope=1 - hidden from the editor but
        // spawnable at runtime; verified in the 1.99 CONFIG.BIN). Honest gap:
        // 1.99 ships no civilian-model MG/AT/medic variants, so every role
        // wears the FakeC pair and role weapons come from loot
        // (GM_fnEquipFromUnlocked) - which is what an outfit axis wants.
        // playerClassWarrior documents the authored mission.sqm class; the
        // engine seam substitutes ONLY playerClassCiv (WorldInit.cpp /
        // Game/Guerrilla/OutfitSelect.cpp) and keeps the authored class when
        // the choice is warrior, unset, or unresolvable.
        playerClassWarrior = "SoldierGB";
        playerClassCiv = "SoldierGFakeC";
        recruitFighterCiv = "SoldierGFakeC";
        recruitSpecialistCiv = "SoldierGFakeC2";
        companionClassCiv = "SoldierGFakeC";
        holdClassCiv = "SoldierGFakeC";
        // civilian-outfit ladder for AI garrison/guard/militia rungs (native
        // gmFactionCivTier; also issue #16's guardClass surface). Same
        // tierThresholds[] gates as tiers[], clamped to its own length.
        civTier[] = {"SoldierGFakeC", "SoldierGFakeC2"};

        baseWeapon = "AK47";
        baseMagazine = "AK47";
        lootRiflemanWeapon = "AK47";
        lootRiflemanMag = "AK47";
        lootMedicWeapon = "AK47";
        lootMedicMag = "AK47";
        lootMGWeapon = "PK";
        lootMGMag = "PK";
        lootATWeapon = "RPGLauncher";
        lootATMag = "RPGLauncher";
        lootSniperWeapon = "SVDDragunov";
        lootSniperMag = "SVDDragunov";

        // town flagpole texture; matches the engine's side-GUER default
        flag = "\flags\fia.jpg";
    };
    class CIV // civilian population descriptor (issue #8)
    {
        // side MUST be exactly "CIV" - GM_fnSideFromString (scripts/lib.sqs)
        // matches the engine's rendered side name (SideNames in
        // World/Scene/Object.cpp), and the civilian side renders as "CIV",
        // NOT "CIVILIAN".
        side = "CIV";
        // Numbered keys + a count, NOT a civClasses[] array: gmFactionValue
        // returns raw config text and skips array entries (LoadFactions
        // IsArray gate), so the scripts read civClassCount and then
        // civClass1..civClassN. Managers treat an empty civClassCount probe
        // as "no CIV layer" and exit (the Showcase.Abel no-op rule).
        //
        // All three classnames verified against this dataset's Bin\CONFIG.BIN
        // via PoseidonTools config search/debin: CfgVehicles Civilian
        // (: Man, side=3, scope=2, model "MC civil"), Civilian2/Civilian3
        // (: Civilian, models "MC civil2"/"MC civil3"). Civilian4..Civilian15
        // do NOT exist in the 1.99 core config (Resistance-era addon
        // classes) - do not add them here.
        civClassCount = 3;   // number of civClass<N> keys that follow
        civClass1 = "Civilian";
        civClass2 = "Civilian2";
        civClass3 = "Civilian3";
        // Ambient road traffic hulls (native Traffic service, CIV cars
        // driving town-to-town; commandeerable). A real array this time:
        // civVehicles[] is read by ZoneRegistry::LoadFactions and
        // package-probed like vehicles[] (unresolvable hulls are dropped,
        // an empty result leaves civilian traffic inert). All five
        // verified present in the 1.99 core config: Skoda, SkodaBlue,
        // SkodaRed, SkodaGreen, Rapid (Trabant / Mini / Bus are
        // Resistance-era - absent, do not add).
        civVehicles[] = {"Skoda", "SkodaBlue", "SkodaRed", "SkodaGreen", "Rapid"};
    };
};

// The dealer market (issues #27/#28): tuning + the Classic 1.99 stock. Every
// classname is verified against Bin\CONFIG.BIN (PoseidonTools config search);
// the engine re-probes them at load and drops what a package lacks (logged,
// non-fatal - the Demo [Remaster] package keeps whatever subset it ships).
// OFP magazine convention: a simple weapon IS its own magazine class, so the
// magazine keys reuse the weapon classname; launcher grenades, hand grenades
// and explosives are magazine-only bundles (weapon = "").
class CfgGuerrillaMarket
{
    dealerShare = 0.34;          // fraction of CITY zones per dealer kind (independent draws)
    dealerRespawnSeconds = 600;  // a killed dealer is back after this
    hqMoveCost = 500;            // R debited by market.sqs when MOVING the HQ
    // dealerClass falls back to the CIV descriptor's civClass1, then "Civilian";
    // weaponDealers[] / vehicleDealers[] absent: the towns are drawn at the first tick

    class Weapons
    {
        class AK47       { weapon = "AK47";               magazine = "AK47";              mags = 4; price = 220; };
        class AK74       { weapon = "AK74";               magazine = "AK74";              mags = 4; price = 260; };
        class AK47CZ     { weapon = "AK47CZ";             magazine = "AK47";              mags = 4; price = 240; };
        class AK74SU     { weapon = "AK74SU";             magazine = "AK74";              mags = 4; price = 240; };
        class M16        { weapon = "M16";                magazine = "M16";               mags = 4; price = 280; };
        class HK         { weapon = "HK";                 magazine = "HK";                mags = 5; price = 300; };
        class M16GL      { weapon = "M16GrenadeLauncher"; magazine = "M16";               mags = 4; price = 420; };
        class AK74GL     { weapon = "AK74GrenadeLauncher"; magazine = "AK74";             mags = 4; price = 400; };
        class GLGrenades { weapon = "";                   magazine = "GrenadeLauncher";   mags = 6; price = 90; };
        class M21        { weapon = "M21";                magazine = "M21";               mags = 4; price = 600; };
        class SVD        { weapon = "SVDDragunov";        magazine = "SVDDragunov";       mags = 4; price = 650; };
        class PK         { weapon = "PK";                 magazine = "PK";                mags = 2; price = 900; };
        class M60        { weapon = "M60";                magazine = "M60";               mags = 2; price = 950; };
        class LAW        { weapon = "LAWLauncher";        magazine = "LAWLauncher";       mags = 2; price = 500; };
        class RPG        { weapon = "RPGLauncher";        magazine = "RPGLauncher";       mags = 2; price = 550; };
        class CarlGustav { weapon = "CarlGustavLauncher"; magazine = "CarlGustavLauncher"; mags = 2; price = 900; };
        class AT4        { weapon = "AT4Launcher";        magazine = "AT4Launcher";       mags = 2; price = 900; };
        class Strela     { weapon = "9K32Launcher";       magazine = "9K32Launcher";      mags = 1; price = 1200; };
        class Stinger    { weapon = "AALauncher";         magazine = "AALauncher";        mags = 1; price = 1200; };
        class Binocular  { weapon = "Binocular";          magazine = "";                            price = 60; };
        class NVGoggles  { weapon = "NVGoggles";          magazine = "";                            price = 250; };
        class Grenades   { weapon = "";                   magazine = "HandGrenade";       mags = 4; price = 80; };
        class Mines      { weapon = "";                   magazine = "Mine";              mags = 2; price = 150; };
        class Satchels   { weapon = "";                   magazine = "PipeBomb";          mags = 2; price = 200; };
    };
    class Vehicles
    {
        class Skoda      { vehicle = "Skoda";      price = 600; };
        class Rapid      { vehicle = "Rapid";      price = 700; };
        class Tractor    { vehicle = "Tractor";    price = 500; };
        class Jeep       { vehicle = "Jeep";       price = 1500; };
        class GJeep      { vehicle = "GJeep";      price = 1400; };
        class UAZ        { vehicle = "UAZ";        price = 1400; };
        class JeepMG     { vehicle = "JeepMG";     price = 3000; };
        class UAZG       { vehicle = "UAZG";       price = 3000; };
        class Truck5t    { vehicle = "Truck5t";    price = 3500; };
        class Ural       { vehicle = "Ural";       price = 3500; };
        class TruckV3SG  { vehicle = "TruckV3SG";  price = 3200; };
        class M113       { vehicle = "M113";       price = 9000; };
        class BMP        { vehicle = "BMP";        price = 12000; };
        class T55G       { vehicle = "T55G";       price = 20000; };
    };
};
