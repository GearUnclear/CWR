// Guerrilla Mode - mission metadata + THE per-island data file (issue #3 item 3).
// Everything ISLAND-specific lives HERE: the zone seed (CfgGuerrillaZones), the
// civilian population and any faction override (CfgGuerrillaFactions) and the
// dealer stock (CfgGuerrillaMarket). The vanilla war rosters do NOT - they moved
// to the global library guerrilla-mode/config/guerrilla-factions.hpp (issue #54
// A4) and are unioned in at load. The scripts/ directory is the shared
// island-agnostic core - it contains no classnames and no side strings; it reads
// this data through the native gmZone* / gmFaction* command surface
// (engine/Poseidon/Game/Guerrilla/).
//
// Defining class CfgGuerrillaZones is what ACTIVATES the native guerrilla
// systems (ZoneRegistry / AlertMachine / GarrisonCache). No class = plain
// mission, zero engine overhead.

onLoadMission = "Guerrilla Mode - Three Zones (MVP)";
onLoadIntro  = "Liberate the island, one zone at a time.";
respawn = 0;
joinInProgress = 0;

class CfgGuerrillaZones
{
    // Side resolution for a direct (no-UI) launch: the same pair the new-game
    // screen seeds from these keys, so an untouched screen and a direct
    // launch bind the SAME faction blocks (the rosters come from the global
    // library since issue #54 A4; the built-in EAST/GUER side defaults alone
    // would leave the faction binding empty on a direct launch).
    defaultOccupier = "EAST";
    defaultResistance = "GUER";

    // Engine tuning (all left at stock defaults): tickInterval=3; zoneArea=150;
    // revealRadius=1500; cacheRadius=800; supportRate=5; supportFlip=60;
    // heatCapSpike=40; defaultIncome=25; cacheInterval=5; groupSize=12;
    // alertInterval=5; alertYellowKnows=0.5; alertRedKnows=1.5;
    // alertWindowSeconds=20; alertHeatYellow=4; alertHeatRed=15; alertHeatBreak=25.
    // Only the town auto-seed is switched on:
    seedCities = 1;       // auto-seed CITY zones from the world's named towns
    seedCitySupport = 20; // their starting support (markers "gmZoneCity_<n>")

    class Zones
    {
        // COORDINATE ORDER (load-bearing): position[] is authored in
        // script/getPos order [easting, northing, elevation] - NOT the
        // mission.sqm order [easting, ELEVATION, northing]. The engine's
        // ZoneRegistry::LoadZones documents and enforces this contract.
        class Camp
        {
            name = "Camp";
            type = "CAMP";
            owner = "RESISTANCE";   // generic token, resolved per campaign
            garrison = 0;
            support = 100;
            income = 0;
            marker = "gmZoneMarker_0";
            position[] = {6519.04, 6473.68, 149.66};
        };
        class Village
        {
            name = "Village";
            type = "CITY";
            owner = "NEUTRAL";
            support = 20;
            marker = "gmZoneMarker_1";
            position[] = {6300, 6600, 150};
        };
        class Outpost
        {
            name = "Outpost";
            type = "OUTPOST";
            owner = "OCCUPIER";     // generic token, resolved per campaign
            garrison = 8;
            income = 25;
            marker = "gmZoneMarker_2";
            position[] = {6750, 6300, 150};
        };
    };
};

// The ISLAND half of the faction table (issue #54 A4). The vanilla
// WEST/EAST/GUER rosters live in the global library
// guerrilla-mode/config/guerrilla-factions.hpp (installed to
// <GameDir>\bin\, pulled in by bin\config-extra.cpp, documented there -
// including the script-facing KEY NAMING SCHEME every descriptor follows);
// the engine unions that block with this one, this file winning on a
// class-name collision (Game/Guerrilla/FactionSources.*).
//
// The new-game UI publishes gmSelOccupier/gmSelResistance and the engine
// resolves them against the merged table; the nulars gmOccupierSide /
// gmResistanceSide hand the resolved side strings to the scripts (defaults
// "EAST"/"GUER" when no selection was made).
//
// EAST is NOT redeclared here: this template's old EAST block was a strict
// subset of the library's, key for key and value for value, so inheriting the
// library version only adds the hold/recruit/loot keys it lacked - all
// package-probed, so the classes the Demo [Remaster] set lacks degrade
// (logged) rather than aborting.
class CfgGuerrillaFactions
{
    // ISLAND OVERRIDE of the library's GUER (whole class, no per-key merge).
    // WHY: the library's GUER is authored against the FULL 1.99 roster - a
    // two-rung tier ladder (SoldierGG), OfficerG, a captured BMP - and the
    // Demo dataset ships none of that. This one stays on the single rung and
    // the classes the Demo package can actually resolve, so the descriptor
    // reads as what the mission will really spawn instead of relying on the
    // resolution pass to blank half of it.
    class GUER // resistance descriptor
    {
        side = "GUER";
        tiers[] = {"SoldierGB"};
        tierThresholds[] = {};
        // role variants for hold squads / a future GUER-occupier swap; the
        // Demo [Remaster] package ships none of these - the resolution pass
        // degrades the whole faction onto its GUER fallback (SoldierGFakeE)
        tiersMG[]    = {"SoldierGMG"};
        tiersAT[]    = {"SoldierGLAW"};
        tiersMedic[] = {"SoldierGMedic"};
        // captured/irregular motor pool (Classic-only classes; auto-dropped
        // on packages that lack them): jeep -> PV3S -> captured BMP -> T55
        vehicles[] = {"GJeep", "TruckV3SG", "BMPRes", "T55G"};
        vehicleThresholds[] = {4, 7, 9};
        officer = "SoldierGB";

        holdClass = "SoldierGB";
        holdCount = 3;
        recruitFighter = "SoldierGB";
        recruitSpecialist = "SoldierGMG";
        companionClass = "SoldierGB";

        // character outfit family (issue #25): BIS's plainclothes fighters.
        // Classic-only classes - the Demo [Remaster] package lacks the FakeC
        // pair, so the resolution pass degrades these to warrior fallbacks
        // there (and the player seam keeps the authored class); stated for
        // the schema contract, exercised on the Classic templates.
        playerClassWarrior = "SoldierGB";
        playerClassCiv = "SoldierGFakeC";
        recruitFighterCiv = "SoldierGFakeC";
        recruitSpecialistCiv = "SoldierGFakeC2";
        companionClassCiv = "SoldierGFakeC";
        holdClassCiv = "SoldierGFakeC";
        civTier[] = {"SoldierGFakeC"};

        // OFP magazine convention (verified in CONFIG.BIN): simple weapons
        // ARE their own magazine class (CfgWeapons AK47 scopeMagazine=2), so
        // the mag keys reuse the weapon classname - "AK47Mag"-style classes
        // do not exist in this config family.
        baseWeapon = "AK47";
        baseMagazine = "AK47";
        lootRiflemanWeapon = "AK47";
        lootRiflemanMag = "AK47";
        lootMedicWeapon = "AK47";
        lootMedicMag = "AK47";
        lootMGWeapon = "PK";
        lootMGMag = "PK";
        lootATWeapon = "RPGLauncher";
        lootATMag = "RPGLauncher";
        lootSniperWeapon = "SVDDragunov";
        lootSniperMag = "SVDDragunov";

        // town flagpole texture; matches the engine's side-GUER default
        flag = "\flags\fia.jpg";
    };
    class CIV // civilian population descriptor (issue #8)
    {
        // side MUST be exactly "CIV" - GM_fnSideFromString (scripts/lib.sqs)
        // matches the engine's rendered side name (SideNames in
        // World/Scene/Object.cpp), and the civilian side renders as "CIV",
        // NOT "CIVILIAN".
        side = "CIV";
        // Numbered keys + a count, NOT a civClasses[] array: gmFactionValue
        // returns raw config text and skips array entries (LoadFactions
        // IsArray gate), so the scripts read civClassCount and then
        // civClass1..civClassN. Managers treat an empty civClassCount probe
        // as "no CIV layer" and exit - guerrilla_capture.Demo /
        // guerrilla_persist.Demo and Showcase.Abel deliberately ship no CIV
        // class and run that no-op path.
        //
        // !! PLACEHOLDER - FLAGGED FOR VERIFICATION (issues #8 / #13) !!
        // The Demo [Remaster] BIN\CONFIG.BIN ships NO civilian unit class at
        // all (exhaustive debin, 2026-07-10: every side=3 CfgVehicles entry
        // is a non-Man class - SkodaHelper/LaserTarget/Thing/buildings/
        // targets - and the Man-derived roster is only SoldierW*/SoldierE*/
        // Officer*/GeneralE/Angelina/SoldierGFakeE; Angelina is scope=1,
        // side=EAST - unusable). SoldierWCaptive is the ONLY unarmed public
        // human in that config (scope=2 via SoldierWB, weapons[]={}). Its
        // CONFIG side is WEST(1), but civilians.sqs spawns bodies into
        // CIV-side groups (createCenter/createGroup on GM_CIV_SIDE), so
        // spawned units register as side CIV regardless. Replace with a real
        // civilian class when the Demo-package descriptor remap (#13) lands.
        civClassCount = 1;   // number of civClass<N> keys that follow
        civClass1 = "SoldierWCaptive";
    };
};

// The dealer market (issues #27/#28): tuning + the Classic 1.99 stock. Every
// classname is verified against Bin\CONFIG.BIN (PoseidonTools config search);
// the engine re-probes them at load and drops what a package lacks (logged,
// non-fatal - the Demo [Remaster] package keeps whatever subset it ships).
// OFP magazine convention: a simple weapon IS its own magazine class, so the
// magazine keys reuse the weapon classname; launcher grenades, hand grenades
// and explosives are magazine-only bundles (weapon = "").
class CfgGuerrillaMarket
{
    dealerShare = 0.34;          // fraction of CITY zones per dealer kind (independent draws)
    dealerRespawnSeconds = 600;  // a killed dealer is back after this
    hqMoveCost = 500;            // R debited by market.sqs when MOVING the HQ
    // dealerClass falls back to the CIV descriptor's civClass1, then "Civilian";
    // weaponDealers[] / vehicleDealers[] absent: the towns are drawn at the first tick

    class Weapons
    {
        class AK47       { weapon = "AK47";               magazine = "AK47";              mags = 4; price = 220; };
        class AK74       { weapon = "AK74";               magazine = "AK74";              mags = 4; price = 260; };
        class AK47CZ     { weapon = "AK47CZ";             magazine = "AK47";              mags = 4; price = 240; };
        class AK74SU     { weapon = "AK74SU";             magazine = "AK74";              mags = 4; price = 240; };
        class M16        { weapon = "M16";                magazine = "M16";               mags = 4; price = 280; };
        class HK         { weapon = "HK";                 magazine = "HK";                mags = 5; price = 300; };
        class M16GL      { weapon = "M16GrenadeLauncher"; magazine = "M16";               mags = 4; price = 420; };
        class AK74GL     { weapon = "AK74GrenadeLauncher"; magazine = "AK74";             mags = 4; price = 400; };
        class GLGrenades { weapon = "";                   magazine = "GrenadeLauncher";   mags = 6; price = 90; };
        class M21        { weapon = "M21";                magazine = "M21";               mags = 4; price = 600; };
        class SVD        { weapon = "SVDDragunov";        magazine = "SVDDragunov";       mags = 4; price = 650; };
        class PK         { weapon = "PK";                 magazine = "PK";                mags = 2; price = 900; };
        class M60        { weapon = "M60";                magazine = "M60";               mags = 2; price = 950; };
        class LAW        { weapon = "LAWLauncher";        magazine = "LAWLauncher";       mags = 2; price = 500; };
        class RPG        { weapon = "RPGLauncher";        magazine = "RPGLauncher";       mags = 2; price = 550; };
        class CarlGustav { weapon = "CarlGustavLauncher"; magazine = "CarlGustavLauncher"; mags = 2; price = 900; };
        class AT4        { weapon = "AT4Launcher";        magazine = "AT4Launcher";       mags = 2; price = 900; };
        class Strela     { weapon = "9K32Launcher";       magazine = "9K32Launcher";      mags = 1; price = 1200; };
        class Stinger    { weapon = "AALauncher";         magazine = "AALauncher";        mags = 1; price = 1200; };
        class Binocular  { weapon = "Binocular";          magazine = "";                            price = 60; };
        class NVGoggles  { weapon = "NVGoggles";          magazine = "";                            price = 250; };
        class Grenades   { weapon = "";                   magazine = "HandGrenade";       mags = 4; price = 80; };
        class Mines      { weapon = "";                   magazine = "Mine";              mags = 2; price = 150; };
        class Satchels   { weapon = "";                   magazine = "PipeBomb";          mags = 2; price = 200; };
    };
    class Vehicles
    {
        class Skoda      { vehicle = "Skoda";      price = 600; };
        class Rapid      { vehicle = "Rapid";      price = 700; };
        class Tractor    { vehicle = "Tractor";    price = 500; };
        class Jeep       { vehicle = "Jeep";       price = 1500; };
        class GJeep      { vehicle = "GJeep";      price = 1400; };
        class UAZ        { vehicle = "UAZ";        price = 1400; };
        class JeepMG     { vehicle = "JeepMG";     price = 3000; };
        class UAZG       { vehicle = "UAZG";       price = 3000; };
        class Truck5t    { vehicle = "Truck5t";    price = 3500; };
        class Ural       { vehicle = "Ural";       price = 3500; };
        class TruckV3SG  { vehicle = "TruckV3SG";  price = 3200; };
        class M113       { vehicle = "M113";       price = 9000; };
        class BMP        { vehicle = "BMP";        price = 12000; };
        class T55G       { vehicle = "T55G";       price = 20000; };
    };
};
