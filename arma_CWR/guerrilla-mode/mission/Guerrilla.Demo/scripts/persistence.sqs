; ============================================================================
;  persistence.sqs  -  Guerrilla Mode save/load reconciliation
; ----------------------------------------------------------------------------
;  OWNS (exclusive write): nothing PERSISTENT. Persistence only writes TRANSIENT
;        live-handle state when rebuilding it after a load:
;          GM_COMP_OBJ[*]  (re-pointed to freshly created units)
;          GM_CACHE_GROUPS, GM_CACHE_ZONEIDX  (reset to despawned-integer state)
;          GM_PLAYER_GROUPS  (reseeded to the player's restored group)
;          every zone marker "gmZoneMarker_<i>"  (rebuilt on load)
;        plus its OWN bookkeeping: GM_SAVED (load sentinel), GM_pSaveAct (action id).
;  READS: every persisted GM_*/gm* global (GM_ZONES, gmResources/gmManpower/
;         gmWarLevel, per-region GM_Z_HEAT, GM_GEAR_*, GM_COMP_* rows).
;  Does NOT write any persistent gameplay value (never gmResources, never
;  GM_Z_GAR, never companion XP/rank/skill/alive rows) - those are owned by
;  their managers and round-trip for free.
;
;  WHY THIS WORKS (engine ground truth):
;    saveGame (GameStateExt.cpp:880, nular) serialises the whole GGameState,
;    which includes every global variable. So all the integer/string/array meta
;    -state above is restored automatically on load. The ONE thing that does NOT
;    survive intact is a live OBJECT/GROUP handle (design rule: "persist IDs/
;    classnames, never object handles"). Therefore the only job here is to
;    REBUILD the transient live objects from the persisted rows after a load.
;
;  CONFIRMED COMMANDS USED (all grepped in GameStateExt*.cpp):
;    saveGame :880, addAction :1361 / removeAction :1367, createGroup :1184,
;    createUnit :1334 (array [pos,group,init,skill,rank], GameStateExtWorld:237),
;    leader :969/975, group :978, side :995, join :1298 (array join group),
;    setSkill :1381, removeAllWeapons :1019, addWeapon :1253, addMagazine :1255,
;    getPos :936, isNull :933, objNull :856, alive :935, count, set, select,
;    createMarker [name,pos] (size-2), deleteMarker :1188, setMarkerType :1246,
;    setMarkerColor :1248, hint :1045.
;
;  RELOAD RE-APPLY PATH (documented contract):
;    1. Player picks the in-game "Save Game" action -> this file is re-exec'd by
;       the engine with _this = [obj, caller, id] (an addAction handler). The
;       dispatch at the top routes that call to #saveaction, which sets
;       GM_SAVED=true, calls saveGame (snapshot now contains GM_SAVED==true),
;       then immediately resets GM_SAVED=false for the still-live session.
;    2. On LOAD the engine restores globals (GM_SAVED==true from the snapshot)
;       and resumes the long-lived manager scripts (this #loop included). Within
;       one tick the loop sees GM_SAVED==true -> #onload:
;         - null every GM_COMP_OBJ handle, clear GM_CACHE_*, reseed
;           GM_PLAYER_GROUPS to (group player), rebuild every zone marker from
;           GM_ZONES, re-arm exactly one Save action,
;         - then fall through to #reconcile which re-creates each LIVING
;           companion from its row and re-applies rank (createUnit rank arg) +
;           setSkill + addWeapon/addMagazine loadout.
;       Despawned occupier garrisons are NOT rebuilt here: clearing GM_CACHE_*
;       returns them to their authoritative integer GM_Z_GAR, and spawning.sqs
;       re-materialises them from that integer when the player next closes in.
;
;  DIALECT: SQS. The tick loop needs ~waits + #label/goto, which only SQS has.
; ============================================================================

; ---- DISPATCH ---------------------------------------------------------------
; If this file was launched as the Save addAction handler, _this is the action
; tuple [obj, caller, id] (count >= 3); a plain [] exec from init.sqs gives
; count 0. Route the action call straight to the save branch so it does NOT
; spin up a second manager loop or clobber state.
? (count _this) > 0 : goto "saveaction"

; ---- main manager path ------------------------------------------------------
@GM_LIB_READY

; persistence-owned bookkeeping (init.sqs does not define these):
GM_SAVED    = false   ; load-detect sentinel (true only inside a saved snapshot)
GM_pSaveAct = -1      ; transient: id of the player's "Save Game" action
; VERIFY: companion base class. The faction is GUER, so the stock Resistance
;         rifleman "SoldierGB" matches the mission.sqm player VERIFY note. If the
;         Demo dataset ships no GUER classes, swap this for a present class
;         WITHOUT flipping the player's side model.
GM_COMP_CLASS = "SoldierGB"

; Install exactly one in-game Save action on the player. The action's script
; arg is this very file; on activation the engine re-execs it with _this set
; (handled by the dispatch above).  // VERIFY: addAction script arg is exec'd
; as an SQS handler with _this=[obj,caller,id] (OFP/CWA convention).
GM_pSaveAct = player addAction ["Save Game", "scripts/persistence.sqs"]

; Initial build (fresh start): reconcile spawns the living companions from their
; rows. It is fully idempotent, so the same path serves every later load.
~1
goto "reconcile"

; ============================================================================
;  MAIN TICK LOOP - cheap: just an isNull sweep unless a load just happened.
; ============================================================================
#loop
~5
? GM_SAVED : goto "onload"
goto "reconcile"

; ----------------------------------------------------------------------------
;  #onload - heavy, runs once per load. Tear down stale transient handles and
;            rebuild everything that does not survive a save/load intact.
; ----------------------------------------------------------------------------
#onload
GM_SAVED = false

; (a) null every stale companion handle so #reconcile rebuilds it from its row.
GM_pI = 0
#nullobj
? GM_pI >= (count GM_COMP_OBJ) : goto "nulldone"
GM_COMP_OBJ set [GM_pI, objNull]
GM_pI = GM_pI + 1
goto "nullobj"
#nulldone

; (b) reset the spawn cache to the despawned-integer state. The authoritative
;     garrison strength lives in GM_Z_GAR (persisted, untouched here); clearing
;     the live-group cache hands control back to spawning.sqs, which re-spawns
;     from GM_Z_GAR on approach. (We do NOT write GM_Z_GAR - that is spawning's.)
GM_CACHE_GROUPS  = []
GM_CACHE_ZONEIDX = []

; (c) reseed the player-faction group list to the restored player group so
;     recruit.sqs keeps tracking the squad the engine brought back on load.
GM_PLAYER_GROUPS = [group player]

; (d) rebuild every zone marker from GM_ZONES (delete-then-create avoids a stale
;     duplicate if the marker partially survived the snapshot).
GM_pI = 0
#mk
? GM_pI >= (count GM_ZONES) : goto "mkdone"
GM_pZ = GM_ZONES select GM_pI
deleteMarker (GM_pZ select GM_Z_MARKER)
GM_pTmp = createMarker [(GM_pZ select GM_Z_MARKER), (GM_pZ select GM_Z_POS)]
; VERIFY: marker type / color strings vs the Demo CfgMarkers (mirror zones.sqs).
(GM_pZ select GM_Z_MARKER) setMarkerType "Flag"
GM_pOwn = GM_pZ select GM_Z_OWNER
? GM_pOwn == "GUER"    : (GM_pZ select GM_Z_MARKER) setMarkerColor "ColorGreen"
? GM_pOwn == "EAST"    : (GM_pZ select GM_Z_MARKER) setMarkerColor "ColorRed"
? GM_pOwn == "NEUTRAL" : (GM_pZ select GM_Z_MARKER) setMarkerColor "ColorBlack"
GM_pI = GM_pI + 1
goto "mk"
#mkdone

; (e) re-arm exactly one Save action (the old id is stale after load; removing
;     an invalid id is a harmless no-op).
player removeAction GM_pSaveAct
GM_pSaveAct = player addAction ["Save Game", "scripts/persistence.sqs"]

; fall through to the companion rebuild.
goto "reconcile"

; ----------------------------------------------------------------------------
;  #reconcile - IDEMPOTENT companion (re)spawn. For every LIVING companion whose
;  live handle is null (fresh start, or just nulled by #onload), build the unit
;  from its persisted row and re-apply rank/skill/loadout. A companion that is
;  dead (permadeath: GM_COMP_ALIVE[i]=false, set by companions.sqs) or already
;  live (handle not null) is skipped, so this never duplicates or resurrects.
; ----------------------------------------------------------------------------
#reconcile
GM_pI = 0
#crec
? GM_pI >= (count GM_COMP_NAMES) : goto "crecdone"
? not (GM_COMP_ALIVE select GM_pI) : goto "crecnext"
? not (isNull (GM_COMP_OBJ select GM_pI)) : goto "crecnext"

; --- (re)create companion GM_pI next to the player ---
;     Rank is applied through the createUnit rank arg (no setRank command exists
;     in this engine); a single-unit temp group lets us grab the handle via
;     `leader`, then we merge the companion into the player's squad with `join`.
GM_pG = createGroup (side player)
GM_COMP_CLASS createUnit [getPos player, GM_pG, "", (GM_COMP_SKILL select GM_pI), (GM_COMP_RANK select GM_pI)]
GM_pU = leader GM_pG
[GM_pU] join (group player)
GM_COMP_OBJ set [GM_pI, GM_pU]

; re-apply skill (rank already baked at creation).
GM_pU setSkill (GM_COMP_SKILL select GM_pI)

; re-apply persisted loadout = [ [weaponClasses...], [magClasses...] ].
; An empty weapons list means "keep the class-default loadout" (Phase-1 seed),
; so we only strip + rebuild weapons when the row actually carries gear.
GM_pLO = GM_COMP_LOADOUT select GM_pI
GM_pW  = GM_pLO select 0
GM_pM  = GM_pLO select 1
? (count GM_pW) == 0 : goto "crecnext"
GM_pU removeAllWeapons
GM_pJ = 0
#crecw
? GM_pJ >= (count GM_pW) : goto "crecm"
GM_pU addWeapon (GM_pW select GM_pJ)
GM_pJ = GM_pJ + 1
goto "crecw"
#crecm
GM_pJ = 0
#crecmag
? GM_pJ >= (count GM_pM) : goto "crecnext"
GM_pU addMagazine (GM_pM select GM_pJ)
GM_pJ = GM_pJ + 1
goto "crecmag"

#crecnext
GM_pI = GM_pI + 1
goto "crec"
#crecdone
goto "loop"

; ----------------------------------------------------------------------------
;  #saveaction - the Save Game addAction handler. Bake GM_SAVED=true INTO the
;  snapshot (so the loop detects the load), persist, then drop the flag back to
;  false for the live session that keeps running after the synchronous save.
; ----------------------------------------------------------------------------
#saveaction
GM_SAVED = true
saveGame
GM_SAVED = false
hint "Guerrilla campaign saved."
exit
