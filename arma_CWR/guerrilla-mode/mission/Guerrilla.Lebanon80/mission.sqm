version=11;
class Mission
{
	// Verified addon set. Load-bearing: entries land in the engine's
	// active-addon list (World::ActivateAddons) and EVERY config class a
	// spawned unit touches - including its weapons[]/magazines[] - is
	// visibility-checked against that list (ParamOwnerList "Access denied",
	// World::CheckAddon). A missing entry here does not just warn: the unit
	// type fails to build and the whole mission refuses to boot
	// ("StartAutoTest could not boot"). So this lists the TRANSITIVE owners:
	// world (LoBo_Leb + LoBolebObject terrain objects), player + resistance
	// (LoBoHizballah, vehicles LoBoHizballCar, AT launchers ICPrpg7, weapons
	// LoBoWeapons/LoBoWeapNad, mags JAM_Magazines), occupier garrison + QRF
	// (LoBoIs, LoBoWeapat, LoBoHMWV, LoBo_Zelda), civilians (LoBoTerror owns
	// LoBo_Civ_*), and the shared ammo pool (LoBoammo). CfgPatches class
	// names verified against the shipped @LoBo configs. Like Guerrilla.Sinai,
	// LoBoM60/LoBoCen (QRF ladder rungs 3-4) are deliberately not listed -
	// replicating the shipped, passing Sinai configuration.
	addOns[]=
	{
		"LoBo_Leb",
		"LoBolebObject",
		"LoBoHizballah",
		"LoBoHizballCar",
		"ICPrpg7",
		"LoBoTerror",
		"LoBoWeapons",
		"LoBoWeapNad",
		"LoBoWeapat",
		"LoBoammo",
		"JAM_Magazines",
		"LoBoIs",
		"LoBoHMWV",
		"LoBo_Zelda"
	};
	addOnsAuto[]=
	{
		"LoBo_Leb",
		"LoBoHizballah"
	};
	randomSeed=15000001;
	class Intel
	{
	};
	class Groups
	{
		items=1;
		class Item0
		{
			// The RESISTANCE side of this campaign is EAST (Hizballah) - the
			// occupier is the WEST IDF. Same side layout guerrilla_sinai_swap
			// already proves; only the resistance roster differs.
			side="EAST";
			class Vehicles
			{
				items=1;
				class Item0
				{
					// Player: the lone Hizballah fighter at the Camp.
					// mission.sqm position order is [easting, ELEVATION,
					// northing] (unlike description.ext zone position[]).
					position[]={11500,145,12000};
					id=0;
					side="EAST";
					vehicle="LoBo_HizballahRifle4";
					player="PLAYER COMMANDER";
					leader=1;
					skill=0.600000;
				};
			};
		};
	};
};
class Intro
{
	randomSeed=15000002;
	class Intel
	{
	};
};
class OutroWin
{
	randomSeed=15000003;
	class Intel
	{
	};
};
class OutroLoose
{
	randomSeed=15000004;
	class Intel
	{
	};
};
