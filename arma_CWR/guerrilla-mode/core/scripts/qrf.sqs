; ============================================================================
;  qrf.sqs  -  occupier alert POLICY: garrison posture + the QRF convoy.
; ----------------------------------------------------------------------------
;  The alert STATE MACHINE is native now (AlertMachine: GREEN/YELLOW/RED per
;  zone from garrison knowsAbout, disengage window, heat spikes, last-known
;  position, undercover-break detection). Policy - what the occupier DOES
;  about an alert - stays scripted here, preserving the old alert.sqs +
;  spawning.sqs behavior:
;    * on an alertChanged EDGE: set the zone garrison's behaviour
;      (GREEN "SAFE" / YELLOW "AWARE" / RED "COMBAT");
;    * while a zone sits YELLOW: re-issue an investigate `move` each tick
;      toward the native last-known position (the old scripts approximated
;      this with `getPos aP`; gmZoneLastKnown is the honest value);
;    * while a zone is RED: field ONE QRF - officer + role-mixed war-level
;      tier squad (native gmFactionSquad composition, plan 15) +
;      war-level escort vehicle, staged a few hundred metres out and
;      road-snapped, convoying in on MOVE->SAD waypoints, with the old
;      teleport-on-stall insertion fallback and stand-down cleanup.
;
;  EVENT-QUEUE CONSUMER: drains gmEvtAlert ([zoneIndex, zoneName, old, new],
;  appended by the one-line handler init.sqs registered).
;
;  OWNS: gmEvtAlert (consumer), GM_QRF_* state/tunables, the QRF group and
;        escort vehicle handles (transient).
;  READS: gmZoneAlert / gmZoneLastKnown / gmGarrisonSpawned / gmGarrisonGroups,
;        gmZone tuples, gmWarLevel, gmOccupierSide + faction descriptors
;        (squad via gmFactionSquad with gmFactionTierClass as the tier-less
;        fallback, escort via gmFactionVehicle, officer via gmFactionValue).
;        NO classnames, NO side-string literals.
; ============================================================================
@GM_LIB_READY

; ---- tunables ---------------------------------------------------------------
;   GM_QRF_TICK      manager tick (s)
;   GM_QRF_SIZE      riflemen per QRF (officer joins on top)
;   GM_QRF_MAXTRAVEL s before pathing is judged stuck -> insertion fallback
;   GM_QRF_ARRIVE    arrival radius (m) around the target zone
GM_QRF_TICK      = 5
GM_QRF_SIZE      = 5
GM_QRF_MAXTRAVEL = 120
GM_QRF_ARRIVE    = 100

; ---- state (transient) -------------------------------------------------------
GM_QRF_ACTIVE = false
GM_QRF_ZONE   = -1
GM_QRF_VEH    = objNull
GM_QRF_TIMER  = 0

; ---- occupier side value + AI center (createGroup needs a center; the native
;      garrison usually made one already - createCenter is idempotent) ---------
GM_QRF_SIDE = gmOccupierSide call GM_fnSideFromString
GM_qC = createCenter GM_QRF_SIDE

; ============================================================================
;  MAIN LOOP
; ============================================================================
#loop
~GM_QRF_TICK

; ---------- 1) posture edges from the native alertChanged events -------------
GM_qBatch = gmEvtAlert + []; gmEvtAlert = []
GM_qI = 0
#aev
? GM_qI >= (count GM_qBatch) : goto "aevdone"
GM_qEv  = GM_qBatch select GM_qI
GM_qIdx = GM_qEv select 0
GM_qNew = GM_qEv select 3
GM_qBeh = "SAFE"
? GM_qNew == 1 : GM_qBeh = "AWARE"
? GM_qNew == 2 : GM_qBeh = "COMBAT"
{_x setBehaviour GM_qBeh} forEach (gmGarrisonGroups GM_qIdx)
GM_qI = GM_qI + 1
goto "aev"
#aevdone

; ---------- 2) YELLOW zones: keep the garrison tracking the last-known pos ---
GM_qZ = 0
#ywalk
? GM_qZ >= gmZoneCount : goto "ydone"
? (gmZoneAlert GM_qZ) != 1 : goto "ynext"
? not (gmGarrisonSpawned GM_qZ) : goto "ynext"
GM_qTgt = gmZoneLastKnown GM_qZ
? (count GM_qTgt) < 3 : GM_qTgt = (gmZone GM_qZ) select GM_Z_POS
{_x move GM_qTgt} forEach (gmGarrisonGroups GM_qZ)
#ynext
GM_qZ = GM_qZ + 1
goto "ywalk"
#ydone

; ---------- 3) QRF: one at a time --------------------------------------------
? GM_QRF_ACTIVE : goto "qrfManage"

; -- look for a RED zone -------------------------------------------------------
GM_qJ = 0
#qrfScan
? GM_qJ >= gmZoneCount : goto "loopTail"
? (gmZoneAlert GM_qJ) >= 2 : goto "qrfLaunch"
GM_qJ = GM_qJ + 1
goto "qrfScan"

#qrfLaunch
GM_QRF_ZONE = GM_qJ
GM_QRF_TPOS = (gmZone GM_qJ) select GM_Z_POS
; the assault target: the native last-known player position when one exists
GM_QRF_APOS = gmZoneLastKnown GM_qJ
? (count GM_QRF_APOS) < 3 : GM_QRF_APOS = GM_QRF_TPOS
; staging origin: a few hundred metres off the target, road-snapped.
; "RoadSegment" is the engine's road-network object type (world-agnostic).
GM_QRF_OPOS = [GM_QRF_TPOS, 600] call GM_fnRandPosNear
GM_QRF_RS = nearestObject [GM_QRF_OPOS, "RoadSegment"]
? (not (isNull GM_QRF_RS)) : GM_QRF_OPOS = getPos GM_QRF_RS
; squad: native role-diverse composition (plan 15: MG/AT/medic/sniper slots
; from the faction's tier role arrays; role-less descriptors compose the old
; all-riflemen squad) + the faction officer. Monoculture fallback only when
; the faction has no tiers at all (gmFactionSquad -> []).
GM_QRF_CLASSES = gmFactionSquad [gmOccupierSide, gmWarLevel, GM_QRF_SIZE]
GM_QRF_TIER = gmFactionTierClass [gmOccupierSide, gmWarLevel]
? (count GM_QRF_CLASSES) > 0 : GM_QRF_GROUP = [GM_QRF_SIDE, GM_QRF_CLASSES, GM_QRF_OPOS] call GM_fnSpawnSquad
? (count GM_QRF_CLASSES) == 0 : GM_QRF_GROUP = [GM_QRF_SIDE, GM_QRF_TIER, GM_QRF_SIZE, GM_QRF_OPOS] call GM_fnSpawnGroup
(gmFactionValue [gmOccupierSide, "officer"]) createUnit [GM_QRF_OPOS, GM_QRF_GROUP, "", 0.6, "SERGEANT"]
; escort: war level picks the faction vehicle ("" = the faction fields none).
; Crew the driver AND the gunner seat (an unmanned turret never fired a shot -
; the vehicle survey's headline qrf finding); moveInGunner on a gunnerless
; hull is a harmless no-op. Cargo mounting stays out on purpose: the stall
; fallback setPos-teleports the foot element and must keep working.
GM_QRF_VC = gmFactionVehicle [gmOccupierSide, gmWarLevel]
? GM_QRF_VC != "" : GM_QRF_VEH = GM_QRF_VC createVehicle GM_QRF_OPOS
? (not (isNull GM_QRF_VEH)) : ((units GM_QRF_GROUP) select 0) moveInDriver GM_QRF_VEH
? (not (isNull GM_QRF_VEH)) and ((count units GM_QRF_GROUP) > 1) : ((units GM_QRF_GROUP) select 1) moveInGunner GM_QRF_VEH
; convoy chain: immediate move + MOVE (road-snapped mid) -> SAD at the target
GM_QRF_MID = [GM_QRF_TPOS, 300] call GM_fnRandPosNear
GM_QRF_RS = nearestObject [GM_QRF_MID, "RoadSegment"]
? (not (isNull GM_QRF_RS)) : GM_QRF_MID = getPos GM_QRF_RS
GM_QRF_GROUP setBehaviour "COMBAT"
GM_QRF_GROUP setCombatMode "RED"
GM_QRF_GROUP move GM_QRF_MID
GM_QRF_WP = GM_QRF_GROUP addWaypoint [GM_QRF_MID, 0]
GM_QRF_WP setWaypointType "MOVE"
GM_QRF_WP2 = GM_QRF_GROUP addWaypoint [GM_QRF_APOS, 0]
GM_QRF_WP2 setWaypointType "SAD"
GM_QRF_ACTIVE = true
GM_QRF_TIMER  = 0
; journal: the diary records every QRF launch (native Journal, map Notes page)
gmJournalLog format ["%1 went RED: an occupier quick reaction force is moving on your last known position.", (gmZone GM_qJ) select GM_Z_NAME]
goto "loopTail"

#qrfManage
; stand down once the target zone is no longer RED (native FSM cleared it)
? (GM_QRF_ZONE < 0) or (GM_QRF_ZONE >= gmZoneCount) : goto "qrfStandDown"
? ((gmZoneAlert GM_QRF_ZONE) < 2) : goto "qrfStandDown"
; arrival check: close enough -> leave it to fight (the SAD waypoint owns combat)
GM_QRF_D = (getPos (leader GM_QRF_GROUP)) distance GM_QRF_TPOS
? GM_QRF_D <= GM_QRF_ARRIVE : goto "loopTail"
; not arrived: accumulate travel time; insertion fallback if pathing stalled
GM_QRF_TIMER = GM_QRF_TIMER + GM_QRF_TICK
? GM_QRF_TIMER < GM_QRF_MAXTRAVEL : goto "loopTail"
; FALLBACK (heli/para insertion): teleport the foot element next to the target
; and re-issue the move. The escort vehicle (if any) is left behind.
{_x setPos ([GM_QRF_TPOS, 60] call GM_fnRandPosNear)} forEach units GM_QRF_GROUP
GM_QRF_GROUP move GM_QRF_TPOS
goto "loopTail"

#qrfStandDown
{deleteVehicle _x} forEach units GM_QRF_GROUP
deleteGroup GM_QRF_GROUP
? (not (isNull GM_QRF_VEH)) : deleteVehicle GM_QRF_VEH
GM_QRF_VEH    = objNull
GM_QRF_ACTIVE = false
GM_QRF_ZONE   = -1
goto "loopTail"

#loopTail
goto "loop"
