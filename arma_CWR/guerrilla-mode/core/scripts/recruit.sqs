; ============================================================================
;  recruit.sqs  -  action-menu command layer: recruit / specialist / train.
; ----------------------------------------------------------------------------
;  Flow UNCHANGED from Phase 1: proximity-gated Camp addAction menu; the thin
;  recruit_action.sqs dispatcher enqueues (gmReqId/gmReqPending); this loop is
;  the single writer that debits and spawns.
;
;  WHAT CHANGED (Phase 1.5):
;    * Camp anchor = the first zone of type "CAMP" from the native registry
;      ("CAMP" call GM_fnZoneOfType) - no zone-name literal.
;    * Recruit classes come from the resistance faction descriptor
;      (recruitFighter / recruitSpecialist via gmFactionValue).
;    * Proximity uses the binary `distance` on position arrays.
;
;  OWNS: GM_PLAYER_GROUPS, the action ids (gmAct*), the request queue
;        (gmReq*); debits gmResources/gmManpower ("-" direction only;
;        economy.sqs owns "+"). Also its GM_RECRUIT_*/GM_*_COST_* consts.
;  READS: gmZone tuples (Camp anchor), gmWarLevel (train cap),
;        gmResistanceSide + faction recruit keys, GM_fnEquipFromUnlocked.
; ============================================================================

@GM_LIB_READY

; ---- tunables (recruit-owned consts) -----------------------------------------
;   GM_RECRUIT_POLL    seconds between proximity / request polls
;   GM_RECRUIT_RADIUS  how close to the Camp the menu appears (metres)
;   GM_GROUP_CAP       engine MAX_UNITS_PER_GROUP - overflow to new group
;   GM_RECRUIT_COST_*  fighter: manpower / resource cost
;   GM_SPEC_COST_*     specialist: manpower / resource cost
;   GM_TRAIN_COST_R    squad-training resource cost per use
;   GM_TRAIN_STEP      skill added per training use
;   GM_RECRUIT_SKILL   starting skill of a basic fighter
;   GM_SPEC_SKILL      starting skill of a specialist
GM_RECRUIT_POLL    = 1
GM_RECRUIT_RADIUS  = 30
GM_GROUP_CAP       = 12
GM_RECRUIT_COST_HR = 1
GM_RECRUIT_COST_R  = 0
GM_SPEC_COST_HR    = 1
GM_SPEC_COST_R     = 40
GM_TRAIN_COST_R    = 30
GM_TRAIN_STEP      = 0.1
GM_RECRUIT_SKILL   = 0.35
GM_SPEC_SKILL      = 0.6
GM_RECRUIT_FIGHTER = gmFactionValue [gmResistanceSide, "recruitFighter"]
GM_RECRUIT_SPEC    = gmFactionValue [gmResistanceSide, "recruitSpecialist"]
; civilian outfit family (issue #25): recruits auto-match the player's outfit
; when the campaign started CIVILIAN and the descriptor authors a resolvable
; *Civ class (gmClassExists = the engine's own package probe); the CLASS is
; the body, role weapons still come from unlocked loot below
GM_RECRUIT_CIVF = gmFactionValue [gmResistanceSide, "recruitFighterCiv"]
? GM_OUTFIT_CIV and (GM_RECRUIT_CIVF != "") and (gmClassExists GM_RECRUIT_CIVF) : GM_RECRUIT_FIGHTER = GM_RECRUIT_CIVF
GM_RECRUIT_CIVS = gmFactionValue [gmResistanceSide, "recruitSpecialistCiv"]
? GM_OUTFIT_CIV and (GM_RECRUIT_CIVS != "") and (gmClassExists GM_RECRUIT_CIVS) : GM_RECRUIT_SPEC = GM_RECRUIT_CIVS

; ---- mutable state -------------------------------------------------------------
;   gmRecruitActive  is the addAction menu currently mounted?
;   gmReqPending     set true by recruit_action.sqs dispatcher
;   gmReqId          which action id fired
;   gmReqCaller      who pulled the action (reserved for gear use)
gmRecruitActive = false
gmActRecruit    = -1
gmActSpec       = -1
gmActTrain      = -1
gmReqPending    = false
gmReqId         = -1
gmReqCaller     = aP

; ---- locate the Camp (the recruiter anchor): first zone of type CAMP ---------
gmCampIdx = "CAMP" call GM_fnZoneOfType
? gmCampIdx < 0 : hint "GM ERROR: no CAMP zone in CfgGuerrillaZones - recruit menu disabled."
? gmCampIdx < 0 : exit
gmCampPos = (gmZone gmCampIdx) select GM_Z_POS

; journal: starter objective on the map's Plan page (native Journal; flips
; DONE on the first recruit below). Set once per campaign - this boot code
; never re-runs after a load.
gmJournalObjective ["firstRecruit", "Recruit your first fighter at the Camp (1 HR)", "ACTIVE"]

#loop
~GM_RECRUIT_POLL
gmRecDist = (getPos aP) distance gmCampPos
? (gmRecDist < GM_RECRUIT_RADIUS) and (not gmRecruitActive) : goto "addMenu"
? (gmRecDist >= GM_RECRUIT_RADIUS) and gmRecruitActive : goto "delMenu"
? gmReqPending : goto "request"
goto "loop"

; ---- mount the Camp menu ------------------------------------------------------
#addMenu
gmActRecruit = aP addAction ["Recruit Fighter (1 HR)", "\gmcore\scripts\recruit_action.sqs"]
gmActSpec = aP addAction ["Recruit Specialist (1 HR, 40 R)", "\gmcore\scripts\recruit_action.sqs"]
gmActTrain = aP addAction ["Train Squad (+skill, 30 R)", "\gmcore\scripts\recruit_action.sqs"]
gmRecruitActive = true
goto "loop"

; ---- tear the Camp menu down --------------------------------------------------
#delMenu
aP removeAction gmActRecruit
aP removeAction gmActSpec
aP removeAction gmActTrain
gmActRecruit = -1
gmActSpec = -1
gmActTrain = -1
gmRecruitActive = false
goto "loop"

; ---- dispatch a queued request by action id -----------------------------------
#request
gmReqPending = false
? gmReqId == gmActRecruit : goto "doRecruit"
? gmReqId == gmActSpec : goto "doSpec"
? gmReqId == gmActTrain : goto "doTrain"
goto "loop"

; ---- recruit a basic fighter --------------------------------------------------
#doRecruit
? gmManpower < GM_RECRUIT_COST_HR : hint "Not enough Manpower (need 1 HR)."
? gmManpower < GM_RECRUIT_COST_HR : goto "loop"
? gmResources < GM_RECRUIT_COST_R : hint "Not enough Resources."
? gmResources < GM_RECRUIT_COST_R : goto "loop"
gmRecClass = GM_RECRUIT_FIGHTER
gmRecSkill = GM_RECRUIT_SKILL
gmRecCostHR = GM_RECRUIT_COST_HR
gmRecCostR = GM_RECRUIT_COST_R
gmRecRole  = "RIFLEMAN"
goto "spawnUnit"

; ---- recruit a specialist ------------------------------------------------------
#doSpec
? gmManpower < GM_SPEC_COST_HR : hint "Not enough Manpower (need 1 HR)."
? gmManpower < GM_SPEC_COST_HR : goto "loop"
? gmResources < GM_SPEC_COST_R : hint "Not enough Resources (need 40 R)."
? gmResources < GM_SPEC_COST_R : goto "loop"
gmRecClass = GM_RECRUIT_SPEC
gmRecSkill = GM_SPEC_SKILL
gmRecCostHR = GM_SPEC_COST_HR
gmRecCostR = GM_SPEC_COST_R
gmRecRole  = "MG"
goto "spawnUnit"

; ---- shared spawn body: pick a group with room (12-cap), else new group -------
;  One atomic evaluated line: scan [group aP] + GM_PLAYER_GROUPS for the first
;  group under the cap; if all full, createGroup (side aP) and append (the
;  overflow contract). createUnit returns NOTHING, so the new handle is
;  captured by diffing `units` before/after (same idiom as companions.sqs).
#spawnUnit
gmRecList = [group aP] + GM_PLAYER_GROUPS; gmRecI = 0; gmRecPick = -1; while {gmRecI < (count gmRecList)} do {if ((gmRecPick < 0) and ((count units (gmRecList select gmRecI)) < GM_GROUP_CAP)) then {gmRecPick = gmRecI}; gmRecI = gmRecI + 1}; if (gmRecPick < 0) then {gmRecGrp = createGroup (side aP); GM_PLAYER_GROUPS = GM_PLAYER_GROUPS + [gmRecGrp]} else {gmRecGrp = gmRecList select gmRecPick}; gmRecPre = units gmRecGrp; gmRecClass createUnit [getPos aP, gmRecGrp, "", gmRecSkill, "PRIVATE"]; gmRecNew = (units gmRecGrp) - gmRecPre; gmNewUnit = objNull; if ((count gmRecNew) > 0) then {gmNewUnit = gmRecNew select 0}
; kit the new fighter from role-appropriate unlocked gear (loot.sqs PUBLIC
; helper); falls back to the base kit until the role weapon is unlocked.
? not (isNull gmNewUnit) : [gmNewUnit, gmRecRole] call GM_fnEquipFromUnlocked
gmManpower = gmManpower - gmRecCostHR
gmResources = gmResources - gmRecCostR
hint format ["Recruited %1.\nManpower %2 HR | Treasury %3 R", gmRecClass, gmManpower, gmResources]
gmJournalLog format ["Recruited a new %1 at the Camp (%2 HR, %3 R left).", gmRecRole, gmManpower, gmResources]
gmJournalObjective ["firstRecruit", "", "DONE"]
goto "loop"

; ---- train the player's squad (skill bump, War-Level capped) -------------------
#doTrain
? gmResources < GM_TRAIN_COST_R : hint "Not enough Resources (need 30 R)."
? gmResources < GM_TRAIN_COST_R : goto "loop"
gmTrUnits = units (group aP); gmTrCap = 0.4 + (gmWarLevel * 0.05); if (gmTrCap > 1) then {gmTrCap = 1}; gmTrI = 0; while {gmTrI < (count gmTrUnits)} do {gmTrU = gmTrUnits select gmTrI; gmTrNew = (skill gmTrU) + GM_TRAIN_STEP; if (gmTrNew > gmTrCap) then {gmTrNew = gmTrCap}; gmTrU setSkill gmTrNew; gmTrI = gmTrI + 1}
gmResources = gmResources - GM_TRAIN_COST_R
hint format ["Squad trained (skill cap %1).\nTreasury %2 R", gmTrCap, gmResources]
gmJournalLog format ["Squad trained at the Camp (skill cap %1, %2 R left).", gmTrCap, gmResources]
goto "loop"
