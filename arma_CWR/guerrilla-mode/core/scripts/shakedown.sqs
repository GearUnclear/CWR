; ============================================================================
;  shakedown.sqs  -  occupier population-control theatre: shakedown scenes,
;                    rare public killings, the resentment ticker, day counter
; ----------------------------------------------------------------------------
;  ABSTRACT-SCENE RULE (mod-plan 14, verbatim): units halt, face the subject,
;  hold a stance, a timer runs, the outcome lands as text plus state change.
;  ZERO new animations, ZERO new commands.
;  OWNS: GM_SHK_* state/tunables, gmShkTicks, gmDayCount/gmDayLast (writer),
;        GM_RESENT_* ledger (CONSUMER side; GM_fnResentAdd is the writer),
;        the scene initiator pair (transient handles).
;  READS: gmZoneCount/gmZone, gmZoneAlert, gmWarLevel, gmOccupierSide +
;        faction descriptor (tier classes), GM_CIV_GROUPS/GM_CIV_GROUP_ZONE,
;        GM_PANIC_ZONES, aP, time, dayTime.
;  Kill effects flow through ONE owner: this file only POSTS the synthetic
;  kill record; civilians.sqs's consumer applies support/resentment/panic.
;  The scene runs as a PHASED state machine advanced once per tick (no long
;  ~waits mid-scene), so the resentment ticker and day counter run every
;  tick, scene or not. All tunables are plain globals read at USE time, so
;  Trident tests may override them before forcing behavior.
; ============================================================================

@GM_LIB_READY

; ---- no-op rule: same probe as civilians.sqs, literally repeated - this
;      manager must not depend on civilians.sqs's exec order or its
;      GM_CIV_READY timing. (Showcase.Abel and the .Demo test missions share
;      this exact file.)
? (gmFactionValue ["CIV", "civClassCount"]) == "" : exit
gmShkNC = 0; gmShkI = 0; while {gmShkI < gmZoneCount} do {if (((gmZone gmShkI) select GM_Z_TYPE) == "CITY") then {gmShkNC = gmShkNC + 1}; gmShkI = gmShkI + 1}
? gmShkNC < 1 : exit
GM_SHK_READY = true

; This file reads GM_CIV_GROUPS/GM_CIV_GROUP_ZONE. init.sqs seeds both []
; unconditionally, so there is NO dependency on civilians.sqs's exec order or
; its GM_CIV_READY sentinel (the contract's no-dependency rule): unpopulated
; registers just mean no scene launches.

; ===========================================================================
;  TUNABLES  (names binding per the issue-#8 contract; values are tuning)
; ===========================================================================
;   GM_SHK_TICK       director tick (s)
;   GM_SHK_RANGE      scene must be within this of the player (witnessed)
;   GM_SHK_COOLDOWN   s per-zone between scenes
;   GM_SHK_CHANCE     base per-tick chance once all gates pass
;   GM_SHK_HEAT_W     chance += zone heat (0..100) * this
;   GM_SHK_WL_W       chance += gmWarLevel * this
;   GM_SHK_KILLCHANCE probability an ORGANIC scene ends in a public killing
;   GM_SHK_WALK_T     s allowed for the pair to reach the victim
;   GM_SHK_BEAT_T     s between groupChat beats
;   GM_SHK_AIM_T      the aim pause before the execution
GM_SHK_TICK      = 10
GM_SHK_RANGE     = 500
GM_SHK_COOLDOWN  = 600
GM_SHK_CHANCE    = 0.15
GM_SHK_HEAT_W    = 0.01
GM_SHK_WL_W      = 0.03
GM_SHK_KILLCHANCE = 0.08
GM_SHK_WALK_T    = 45
GM_SHK_BEAT_T    = 8
GM_SHK_AIM_T     = 4

; ---- state ---------------------------------------------------------------------
;   GM_SHK_ACTIVE  one scene at a time (qrf.sqs pattern)
;   GM_SHK_GRP     initiator pair group (transient handle)
;   GM_SHK_VICTIM  scene victim (transient handle)
;   GM_SHK_ZONE    scene zone index (transient)
;   GM_SHK_LASTZ / GM_SHK_LASTT  cooldown ledger: zone names + last-scene
;                  times (parallel; names+times only - serializes free)
;   gmShkTicks     loop-liveness counter
;   gmShkPhase     scene FSM: 0 idle / 1 approach / 2 beats / 3 execute
;   gmShkT0        current-phase start (or last-beat) time
;   gmShkBeat      beat counter within phase 2
;   gmShkOrganic   scene launched by the organic roll (forced scenes NEVER
;                  roll the kill - deterministic in both directions)
GM_SHK_ACTIVE = false
GM_SHK_GRP    = grpNull
GM_SHK_VICTIM = objNull
GM_SHK_ZONE   = -1
GM_SHK_LASTZ  = []
GM_SHK_LASTT  = []
gmShkTicks  = 0
gmShkPhase  = 0
gmShkT0     = 0
gmShkBeat   = 0
gmShkOrganic = false

; ---- force hooks (DEBUG/TEST; binding semantics) ---------------------------------
;   GM_SHK_FORCE = true     next tick SKIPS chance/cooldown/heat/WL/range
;     gates, picks the nearest POPULATED CITY to the player, starts a scene.
;     Consumed only when the scene ACTUALLY launches (victim picked, pair
;     spawned); stays set (retried next tick) while no populated CITY exists
;     or the victim pick finds only dead/stale rows.
;   GM_SHK_FORCEKILL = true forces the outcome roll to the KILL branch.
;     Consumed when the outcome resolves.
GM_SHK_FORCE     = false
GM_SHK_FORCEKILL = false

; ---- occupier side value + AI center (createCenter idempotent, as qrf.sqs) ------
GM_SHK_SIDE = gmOccupierSide call GM_fnSideFromString
gmShkC = createCenter GM_SHK_SIDE

; ============================================================================
;  MAIN LOOP  (ticker + day counter EVERY tick; then scene FSM / selection)
; ============================================================================
#loop
~GM_SHK_TICK
gmShkTicks = gmShkTicks + 1

; ---------- resentment ticker: land every due +support tick ------------------
; Backwards walk, index-stable removal (rebuild sans the landed row). Zone
; re-resolved by NAME via gmZoneIndex (>= 0 guard) - never a stored index.
gmShkRi = (count GM_RESENT_DUE) - 1; while {gmShkRi >= 0} do {if ((GM_RESENT_DUE select gmShkRi) <= time) then {gmShkRz = gmZoneIndex (GM_RESENT_ZONES select gmShkRi); if (gmShkRz >= 0) then {gmShkRn = [gmShkRz, GM_RESENT_AMT select gmShkRi] call GM_fnSupportAdd}; gmShkRnz = []; gmShkRnd = []; gmShkRna = []; gmShkRj = 0; while {gmShkRj < (count GM_RESENT_ZONES)} do {if (gmShkRj != gmShkRi) then {gmShkRnz = gmShkRnz + [GM_RESENT_ZONES select gmShkRj]; gmShkRnd = gmShkRnd + [GM_RESENT_DUE select gmShkRj]; gmShkRna = gmShkRna + [GM_RESENT_AMT select gmShkRj]}; gmShkRj = gmShkRj + 1}; GM_RESENT_ZONES = gmShkRnz; GM_RESENT_DUE = gmShkRnd; GM_RESENT_AMT = gmShkRna}; gmShkRi = gmShkRi - 1}

; ---------- day counter: midnight wrap detection ------------------------------
? dayTime < gmDayLast : gmDayCount = gmDayCount + 1
gmDayLast = dayTime

; ---------- scene FSM / selection ----------------------------------------------
? GM_SHK_ACTIVE : goto "scene"
? GM_SHK_FORCE : goto "forcepick"

; ---- organic selection: walk CITY zones; a zone qualifies when it has live
;      civ groups, is not panicked, is witnessed (player in range) and off
;      cooldown. One chance roll per qualifying zone; first hit wins the tick.
gmShkI = 0
#scan
? gmShkI >= gmZoneCount : goto "loopTail"
gmShkZt = gmZone gmShkI
? (gmShkZt select GM_Z_TYPE) != "CITY" : goto "scannext"
? (gmShkZt select GM_Z_NAME) in GM_PANIC_ZONES : goto "scannext"
? ((getPos aP) distance (gmShkZt select GM_Z_POS)) > GM_SHK_RANGE : goto "scannext"
; cooldown lookup in two steps: `and` evaluates BOTH operands in this
; evaluator, so `select gmShkCi` must never see -1
gmShkCi = GM_SHK_LASTZ find (gmShkZt select GM_Z_NAME)
gmShkCt = -999999
? gmShkCi >= 0 : gmShkCt = GM_SHK_LASTT select gmShkCi
? (time - gmShkCt) < GM_SHK_COOLDOWN : goto "scannext"
gmShkN = 0; gmShkJ = 0; while {gmShkJ < (count GM_CIV_GROUP_ZONE)} do {if ((GM_CIV_GROUP_ZONE select gmShkJ) == (gmShkZt select GM_Z_NAME)) then {gmShkN = gmShkN + 1}; gmShkJ = gmShkJ + 1}
? gmShkN < 1 : goto "scannext"
? (random 1) > (GM_SHK_CHANCE + ((gmShkZt select GM_Z_HEAT) * GM_SHK_HEAT_W) + (gmWarLevel * GM_SHK_WL_W)) : goto "scannext"
gmShkZi = gmShkI
gmShkOrganic = true
goto "launch"
#scannext
gmShkI = gmShkI + 1
goto "scan"

; ---- forced selection: nearest POPULATED CITY to the player, no gates --------
#forcepick
gmShkBest = -1; gmShkBd = 999999; gmShkI = 0; while {gmShkI < gmZoneCount} do {gmShkZt = gmZone gmShkI; if ((gmShkZt select GM_Z_TYPE) == "CITY") then {gmShkN = 0; gmShkJ = 0; while {gmShkJ < (count GM_CIV_GROUP_ZONE)} do {if ((GM_CIV_GROUP_ZONE select gmShkJ) == (gmShkZt select GM_Z_NAME)) then {gmShkN = gmShkN + 1}; gmShkJ = gmShkJ + 1}; if (gmShkN > 0) then {gmShkD = (getPos aP) distance (gmShkZt select GM_Z_POS); if (gmShkD < gmShkBd) then {gmShkBd = gmShkD; gmShkBest = gmShkI}}}; gmShkI = gmShkI + 1}
; no populated CITY yet: flag stays set, retried next tick (tests wait on
; GM_SHK_ACTIVE)
? gmShkBest < 0 : goto "loopTail"
gmShkZi = gmShkBest
gmShkOrganic = false
goto "launch"

; ---- launch: pick a victim, spawn the initiator pair --------------------------
#launch
GM_SHK_ZONE = gmShkZi
; victim: a random live unit from the zone's civ groups (reservoir-style pick)
gmShkV = objNull; gmShkJ = 0; while {gmShkJ < (count GM_CIV_GROUPS)} do {if ((GM_CIV_GROUP_ZONE select gmShkJ) == ((gmZone gmShkZi) select GM_Z_NAME)) then {gmShkU = units (GM_CIV_GROUPS select gmShkJ); gmShkK = 0; while {gmShkK < (count gmShkU)} do {if ((alive (gmShkU select gmShkK)) and ((isNull gmShkV) or ((random 1) < 0.5))) then {gmShkV = gmShkU select gmShkK}; gmShkK = gmShkK + 1}}; gmShkJ = gmShkJ + 1}
? isNull gmShkV : goto "loopTail"
GM_SHK_VICTIM = gmShkV
; initiators (binding decision): a DEDICATED spawned 2-man occupier pair at
; zone-edge distance, deleted at scene end - NOT borrowed garrison members
; (garrison groups are under AlertMachine/qrf.sqs setBehaviour control;
; borrowing them makes scenes racy). #2 SEAM: a future branch may substitute
; a group drawn from GM_PSEUDO_GROUPS as the pair here.
gmShkP = [getPos GM_SHK_VICTIM, 120] call GM_fnRandPosNear
GM_SHK_GRP = [GM_SHK_SIDE, gmFactionTierClass [gmOccupierSide, gmWarLevel], 2, gmShkP] call GM_fnSpawnGroup
GM_SHK_GRP setBehaviour "AWARE"
(units GM_SHK_GRP) doMove (getPos GM_SHK_VICTIM)
doStop GM_SHK_VICTIM
GM_SHK_VICTIM doWatch (leader GM_SHK_GRP)
; consume the force flag only NOW - a bail at the null-victim guard above
; keeps it set for a retry next tick (binding force-hook semantics)
? not gmShkOrganic : GM_SHK_FORCE = false
GM_SHK_ACTIVE = true
gmShkPhase = 1
gmShkT0 = time
gmShkBeat = 0
goto "loopTail"

; ============================================================================
;  SCENE FSM  (one phase step per tick; all registered commands)
; ============================================================================
#scene
; victim died out from under the scene (crossfire etc.): its organic killed-EH
; already posted the honest record - just wind down
? (isNull GM_SHK_VICTIM) or (not (alive GM_SHK_VICTIM)) : goto "release"
; pair wiped out / post-load null group: wind down (units of a null group is
; an empty array, so this guard is load-safe)
? (count (units GM_SHK_GRP)) < 1 : goto "release"
? gmShkPhase == 1 : goto "approach"
? gmShkPhase == 2 : goto "beats"
? gmShkPhase == 3 : goto "execute"
goto "release"

; ---- phase 1: approach --------------------------------------------------------
#approach
? ((getPos (leader GM_SHK_GRP)) distance (getPos GM_SHK_VICTIM)) <= 10 : goto "arrive"
? (time - gmShkT0) <= GM_SHK_WALK_T : goto "keepwalk"
; walk timeout: a pending FORCEKILL scene SNAPS the pair to the victim (the
; qrf.sqs teleport-on-stall precedent) so the debug hook stays deterministic;
; organic scenes abort clean via the release path - no ledger effect.
? GM_SHK_FORCEKILL : goto "snap"
goto "release"
#snap
{_x setPos ([getPos GM_SHK_VICTIM, 5] call GM_fnRandPosNear)} forEach (units GM_SHK_GRP)
goto "arrive"
#keepwalk
(units GM_SHK_GRP) doMove (getPos GM_SHK_VICTIM)
goto "loopTail"
#arrive
; halt/face: pair stops, everyone stands and watches (abstract-scene rule)
{doStop _x} forEach (units GM_SHK_GRP)
{_x doWatch GM_SHK_VICTIM} forEach (units GM_SHK_GRP)
{_x setUnitPos "UP"} forEach (units GM_SHK_GRP)
GM_SHK_VICTIM setUnitPos "UP"
GM_SHK_VICTIM doWatch (leader GM_SHK_GRP)
gmShkPhase = 2
gmShkBeat = 0
gmShkT0 = time
goto "loopTail"

; ---- phase 2: text beats (generic occupier lines - no faction-specific text) --
#beats
? (time - gmShkT0) < GM_SHK_BEAT_T : goto "loopTail"
gmShkT0 = time
gmShkBeat = gmShkBeat + 1
? gmShkBeat == 1 : (leader GM_SHK_GRP) groupChat "Papers."
? gmShkBeat == 2 : (leader GM_SHK_GRP) groupChat "You. Turn around. Hands where I can see them."
? gmShkBeat == 3 : GM_SHK_VICTIM groupChat "Please - I have done nothing."
? gmShkBeat < 4 : goto "loopTail"
; outcome roll: kill iff FORCEKILL, or the scene was ORGANIC and the rare
; roll lands. FORCE-launched scenes without FORCEKILL always release.
gmShkKill = false
? GM_SHK_FORCEKILL : gmShkKill = true
? (gmShkOrganic) and ((random 1) < GM_SHK_KILLCHANCE) : gmShkKill = true
? gmShkKill : goto "aimstart"
(leader GM_SHK_GRP) groupChat "Move along."
goto "release"
#aimstart
; the aim pause: doFire would be ignored (IsEnemy gate) - this is the
; mandated doTarget/doWatch + setDammage beat
(leader GM_SHK_GRP) doTarget GM_SHK_VICTIM
(leader GM_SHK_GRP) doWatch GM_SHK_VICTIM
gmShkPhase = 3
gmShkT0 = time
goto "loopTail"

; ---- phase 3: the public killing (binding order) -------------------------------
#execute
? (time - gmShkT0) < GM_SHK_AIM_T : goto "loopTail"
; strip the victim's organic killed-EH FIRST - setDammage fires it with no
; killer attribution and the consumer would double-count one death as two
; records
GM_SHK_VICTIM removeAllEventHandlers "killed"
GM_SHK_VICTIM setDammage 1
; post the SYNTHETIC record with the TRUE initiator, ONE line - the setDammage
; path has no killer attribution; NEVER rely on the EH for scripted executions
gmCivKilled = gmCivKilled + [[GM_SHK_VICTIM, leader GM_SHK_GRP, getPos GM_SHK_VICTIM, GM_SHK_ZONE]]
; outcome resolved: consume the force-kill hook
GM_SHK_FORCEKILL = false
; hold the pair ALIVE until civilians.sqs's consumer has drained the record:
; the release path deleteVehicles the initiators, and a deleted killer handle
; reads isNull at the consumer's up-to-GM_CIV_TICK-later drain - demoting the
; OCCUPIER classification (-support + resentment) to OTHER (small -support,
; NO resentment). The consumer drains every tick unconditionally, so this
; gate always opens; the time cap only guards a wedged peer manager.
gmShkT0 = time
#drainhold
~1
? (count gmCivKilled) < 1 : goto "release"
? (time - gmShkT0) < 20 : goto "drainhold"
goto "release"

; ---- release / cleanup (shared by every outcome) --------------------------------
; Panic/support/resentment all land via civilians.sqs's consumer - no direct
; ledger writes here. The victim's group resumes wander on the next
; civilians.sqs wander pass; the doStop'ed victim gets one doMove so it does
; not stand frozen until then.
#release
{_x setUnitPos "AUTO"} forEach (units GM_SHK_GRP)
? (not (isNull GM_SHK_VICTIM)) and (alive GM_SHK_VICTIM) : GM_SHK_VICTIM setUnitPos "AUTO"
? ((not (isNull GM_SHK_VICTIM)) and (alive GM_SHK_VICTIM)) and (GM_SHK_ZONE >= 0) : GM_SHK_VICTIM doMove ([((gmZone GM_SHK_ZONE) select GM_Z_POS), 40] call GM_fnRandPosNear)
{deleteVehicle _x} forEach (units GM_SHK_GRP)
deleteGroup GM_SHK_GRP
; stamp the cooldown ledger (zone NAME keyed, refresh in place when present)
? GM_SHK_ZONE >= 0 : gmShkCn = (gmZone GM_SHK_ZONE) select GM_Z_NAME
? GM_SHK_ZONE >= 0 : gmShkCi = GM_SHK_LASTZ find gmShkCn
? GM_SHK_ZONE >= 0 : if (gmShkCi >= 0) then {GM_SHK_LASTT set [gmShkCi, time]} else {GM_SHK_LASTZ = GM_SHK_LASTZ + [gmShkCn]; GM_SHK_LASTT = GM_SHK_LASTT + [time]}
GM_SHK_GRP    = grpNull
GM_SHK_VICTIM = objNull
GM_SHK_ZONE   = -1
GM_SHK_ACTIVE = false
gmShkPhase = 0
goto "loopTail"

#loopTail
goto "loop"
