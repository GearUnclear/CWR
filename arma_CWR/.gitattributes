# Auto-detect text and use one checkout representation on every platform. This
# repository is used from both Windows and Linux, so core.autocrlf must not make
# the same shared working tree alternate between CRLF and LF.
* text=auto eol=lf

# Force CRLF line endings for Windows-specific files
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.sln text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# C/C++ source files use LF on every platform.
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf

# Markdown files
*.md text eol=lf

# Makefiles must use LF
Makefile text eol=lf

# Binary files
*.lib binary
*.obj binary
*.exe binary
*.dll binary
*.pdb binary
*.suo binary
*.user binary
*.ncb binary
*.aps binary
*.sdf binary
*.opensdf binary
*.db binary
*.opendb binary
# Git LFS is not used: the game data guard (.githooks/check_no_game_data.py)
# reads blob contents, and an LFS pointer would hide them. packages/ and
# release/ are gitignored game data and build output. The menu text resources
# below stay normalized to LF in case one is ever added deliberately.
packages/**/BIN/*.hpp text eol=lf !filter !diff !merge
packages/**/BIN/STRINGTABLE_MAINMENU.utf8.csv text eol=lf !filter !diff !merge
packages/README.md text eol=lf !filter !diff !merge
