; ============================================================================
;  market.sqs  -  action-menu command layer: headquarters / cache / garage /
;                 dealer purchases (issues #16 M1+M4, #27, #28).
; ----------------------------------------------------------------------------
;  The engine owns the facts (Game/Guerrilla/GuerrillaBase: HQ election,
;  siting, the keep-when-empty cache holder, the garage ring + locks;
;  Game/Guerrilla/Market: dealer towns, NPCs, stock). This script owns the
;  POLICY: the proximity-gated action menus, the single gmResources debit
;  for purchases and HQ moves, the purchase effects (WeaponHolder / create-
;  Vehicle / delivery to the HQ cache or garage), hints, journal lines and
;  the hqEstablish objective.
;
;  OWNS: gmMkt* state, the action ids, the request queue (gmMktReq*),
;        GM_MKT_* consts and flags; debits gmResources ("-" direction, the
;        SECOND "-" writer next to recruit.sqs; economy.sqs owns "+").
;  READS: gmHq* / gmGarage* (GuerrillaBase), gmMarket* / gmDealer*
;        (Market), gmJournal* (Journal), the player's weapons/magazines.
;
;  Menus are mounted/unmounted by proximity on every poll, so they self-heal
;  across a save/load without any re-arm (a loaded campaign resumes this
;  loop; action ids are per-session, the menus simply re-mount).
;  Retrieval from the cache uses the holder's own TAKE WEAPON / TAKE
;  MAGAZINE actions (a WeaponHolder is a stock supply object). Script
;  fallback if an interior holder ever proves invisible to the action menu:
;  weaponCargo / removeWeaponCargo + addWeapon, mounted like the stash
;  actions below.
;  DIALECT: SQS. A mid-line ; is a STATEMENT SEPARATOR, not a comment.
; ============================================================================

@GM_LIB_READY

; ---- tunables (market-owned consts) ------------------------------------------
;   GM_MKT_POLL           seconds between proximity / request polls
;   GM_MKT_DEALER_RADIUS  how close to a dealer NPC the buy menu appears (m)
;   GM_MKT_CACHE_RADIUS   how close to the cache holder the stash menu appears
;   GM_MKT_VEH_RADIUS     nearest-vehicle search radius for the garage action
;   GM_MKT_MAX_STOCK      action-menu rows per dealer (the menu is short)
;   GM_MKT_HQ_COST        R debited when MOVING an established HQ (native knob)
;   GM_MKT_GARAGE_R       garage ring radius (native knob)
GM_MKT_POLL          = 1
GM_MKT_DEALER_RADIUS = 12
GM_MKT_CACHE_RADIUS  = 8
GM_MKT_VEH_RADIUS    = 8
GM_MKT_MAX_STOCK     = 8
GM_MKT_HQ_COST       = gmMarketValue "hqMoveCost"
GM_MKT_GARAGE_R      = gmHqValue "garageRadius"

; ---- helpers (code strings; GM_tmp* scratch) -------------------------------
;   GM_MKT_fnNearVeh    -> nearest vehicle (land/air/sea) within GM_MKT_VEH_RADIUS, objNull
;   GM_MKT_fnNearDealer -> index of the nearest LIVE dealer NPC of either kind
;                          within GM_MKT_DEALER_RADIUS, -1
GM_MKT_fnNearVeh = {GM_tmpMV = nearestObjects [aP, ["LandVehicle", "Air", "Ship"], GM_MKT_VEH_RADIUS]; GM_tmpMR = objNull; if ((count GM_tmpMV) > 0) then {GM_tmpMR = GM_tmpMV select 0}; GM_tmpMR}
GM_MKT_fnNearDealer = {GM_tmpDb = -1; GM_tmpDd = GM_MKT_DEALER_RADIUS; GM_tmpDw = gmDealerNearest ["WEAPON", getPos aP]; if (GM_tmpDw >= 0) then {GM_tmpDn = (gmDealer GM_tmpDw) select 3; if ((not (isNull GM_tmpDn)) and (alive GM_tmpDn)) then {GM_tmpDe = aP distance GM_tmpDn; if (GM_tmpDe < GM_tmpDd) then {GM_tmpDd = GM_tmpDe; GM_tmpDb = GM_tmpDw}}}; GM_tmpDv = gmDealerNearest ["VEHICLE", getPos aP]; if (GM_tmpDv >= 0) then {GM_tmpDn = (gmDealer GM_tmpDv) select 3; if ((not (isNull GM_tmpDn)) and (alive GM_tmpDn)) then {GM_tmpDe = aP distance GM_tmpDn; if (GM_tmpDe < GM_tmpDd) then {GM_tmpDd = GM_tmpDe; GM_tmpDb = GM_tmpDv}}}; GM_tmpDb}

; ---- mutable state -------------------------------------------------------------
;   gmMktReqPending/Id/Caller  set by market_action.sqs (the dispatcher)
;   gmMktHqAct/HqActive/HqDirty   the Establish/Move HQ action
;   gmMktCacheActs/CacheActive    the stash actions (+ the weapons they were built for)
;   gmMktGarAct/GarActive/GarVeh/GarLocked   the garage lock/unlock action
;   gmMktBuyActs/BuyActive/Dealer/DealerRec/DealerKind/Stock/DelivAct/DelivHq/BuyDirty
;   GM_MKT_MARKED / GM_MKT_HQMARK / gmMktHqMoves   one-time map markers (serialized)
;   gmMktHqSeen        first sighting of an established HQ (objective + diary)
gmMktReqPending = false
gmMktReqId      = -1
gmMktReqCaller  = aP
gmMktHqAct      = -1
gmMktHqActive   = false
gmMktHqDirty    = false
gmMktCacheActs  = []
gmMktCacheActive = false
gmMktCachePri   = ""
gmMktCacheSec   = ""
gmMktGarAct     = -1
gmMktGarActive  = false
gmMktGarVeh     = objNull
gmMktGarLocked  = false
gmMktBuyActs    = []
gmMktBuyActive  = false
gmMktBuyDirty   = false
gmMktDealer     = -1
gmMktDealerRec  = []
gmMktDealerKind = ""
gmMktStock      = []
gmMktDelivAct   = -1
gmMktDelivHq    = false
GM_MKT_MARKED   = false
GM_MKT_HQMARK   = false
gmMktHqMoves    = -1
gmMktHqSeen     = false

; journal: the starter objective (flips DONE the first time an HQ exists -
; whether the start-town election or the action menu put it there)
gmJournalObjective ["hqEstablish", "Establish a headquarters: walk into a town (or the Camp) and use the action menu", "ACTIVE"]
GM_MKT_READY = true

#loop
~GM_MKT_POLL
? gmMktReqPending : goto "request"
gmMktOnFoot = (vehicle aP) == aP

; ---- first sighting of an HQ (start-town election lands on tick 1) -----------
? gmHqEstablished and (not gmMktHqSeen) : goto "hqSeen"
#hqSeenDone

; ---- map markers: dealers once the market assigned them, HQ on every move ----
? (not GM_MKT_MARKED) and gmMarketActive and (gmDealerCount > 0) : goto "mkMarkers"
#mkDone
? gmHqEstablished and (gmMktHqMoves != gmHqMoveCount) : goto "hqMarker"
#hqMarkDone

; ---- HQ action: inside any zone, on foot ---------------------------------------
gmMktCanHq = gmMktOnFoot and (gmHqCanEstablish (getPos aP))
? gmMktHqActive and ((not gmMktCanHq) or gmMktHqDirty) : goto "delHq"
#hqDel
? gmMktCanHq and (not gmMktHqActive) : goto "addHq"
#hqDone

; ---- cache: next to the holder, on foot; labels follow the weapons carried ---
;  (SQS evaluates a whole line - no short-circuit - so the distance reads are
;   guarded on their own lines: gmHqCache is objNull and gmHqGaragePos is []
;   while no HQ stands)
gmMktNearCache = false
? gmHqEstablished and gmMktOnFoot and (not (isNull gmHqCache)) : gmMktNearCache = (aP distance gmHqCache) < GM_MKT_CACHE_RADIUS
gmMktPri = primaryWeapon aP
gmMktSec = secondaryWeapon aP
? gmMktCacheActive and ((not gmMktNearCache) or (gmMktPri != gmMktCachePri) or (gmMktSec != gmMktCacheSec)) : goto "delCache"
#cacheDel
? gmMktNearCache and (not gmMktCacheActive) and ((gmMktPri != "") or (gmMktSec != "")) : goto "addCache"
#cacheDone

; ---- garage: inside the ring, on foot, a vehicle within reach ------------------
gmMktNearGar = false
? gmHqEstablished and gmMktOnFoot : gmMktNearGar = ((getPos aP) distance gmHqGaragePos) <= GM_MKT_GARAGE_R
gmMktVeh = objNull
? gmMktNearGar : gmMktVeh = [] call GM_MKT_fnNearVeh
gmMktVehLocked = false
? not (isNull gmMktVeh) : gmMktVehLocked = gmGarageHas gmMktVeh
; (bools have no != in this evaluator: the lock-state change is spelled out)
gmMktGarStale = (isNull gmMktVeh) or (gmMktVeh != gmMktGarVeh) or (gmMktVehLocked and (not gmMktGarLocked)) or ((not gmMktVehLocked) and gmMktGarLocked)
? gmMktGarActive and gmMktGarStale : goto "delGar"
#garDel
? (not (isNull gmMktVeh)) and (not gmMktGarActive) : goto "addGar"
#garDone

; ---- dealers: next to a live dealer NPC, on foot ------------------------------
gmMktD = -1
? gmMarketActive and gmMktOnFoot : gmMktD = [] call GM_MKT_fnNearDealer
? gmMktBuyActive and ((gmMktD < 0) or (gmMktD != gmMktDealer) or gmMktBuyDirty) : goto "delBuy"
#buyDel
? (gmMktD >= 0) and (not gmMktBuyActive) : goto "addBuy"
#buyDone
goto "loop"

; ============================================================================
;  first sighting: objective DONE + diary line (the action path logs its own)
; ============================================================================
#hqSeen
gmMktHqSeen = true
gmJournalObjective ["hqEstablish", "", "DONE"]
gmJournalLog format ["Headquarters stands in %1.", gmHqZone]
hint format ["Headquarters: %1.\nThe weapon cache is at the HQ; vehicles within %2 m of the garage can be locked from the action menu.", gmHqZone, GM_MKT_GARAGE_R]
goto "hqSeenDone"

; ============================================================================
;  markers (created once; created markers serialize with the world)
; ============================================================================
#mkMarkers
gmMktI = 0
#mkLoop
? gmMktI >= gmDealerCount : goto "mkEnd"
gmMktRec = gmDealer gmMktI
gmMktMName = format ["gmDealer_%1", gmMktI]
gmMktM = createMarker [gmMktMName, gmMktRec select 2]
gmMktMName setMarkerType "Dot"
gmMktMName setMarkerColor "ColorBlack"
gmMktMText = "Arms dealer"
? (gmMktRec select 1) == "VEHICLE" : gmMktMText = "Vehicle dealer"
gmMktMName setMarkerText format ["%1 (%2)", gmMktMText, gmMktRec select 0]
gmMktI = gmMktI + 1
goto "mkLoop"
#mkEnd
GM_MKT_MARKED = true
goto "mkDone"

#hqMarker
? not GM_MKT_HQMARK : gmMktM = createMarker ["gmHqMarker", gmHqPos]
? not GM_MKT_HQMARK : "gmHqMarker" setMarkerType "Flag"
? not GM_MKT_HQMARK : "gmHqMarker" setMarkerColor "ColorBlue"
GM_MKT_HQMARK = true
"gmHqMarker" setMarkerPos gmHqPos
"gmHqMarker" setMarkerText format ["HQ (%1)", gmHqZone]
gmMktHqMoves = gmHqMoveCount
goto "hqMarkDone"

; ============================================================================
;  menu mount / unmount
; ============================================================================
#addHq
? not gmHqEstablished : gmMktHqAct = aP addAction ["Establish headquarters here", "scripts/market_action.sqs"]
? gmHqEstablished : gmMktHqAct = aP addAction [format ["Move headquarters here (%1 R)", GM_MKT_HQ_COST], "scripts/market_action.sqs"]
gmMktHqActive = true
gmMktHqDirty = false
goto "hqDone"

#delHq
aP removeAction gmMktHqAct
gmMktHqAct = -1
gmMktHqActive = false
gmMktHqDirty = false
goto "hqDel"

#addCache
gmMktCacheActs = [-1, -1]
gmMktCachePri = gmMktPri
gmMktCacheSec = gmMktSec
? gmMktPri != "" : gmMktCacheActs set [0, aP addAction [format ["Stash %1 in cache", gmMktPri], "scripts/market_action.sqs"]]
? gmMktSec != "" : gmMktCacheActs set [1, aP addAction [format ["Stash %1 in cache", gmMktSec], "scripts/market_action.sqs"]]
gmMktCacheActive = true
goto "cacheDone"

#delCache
? (gmMktCacheActs select 0) >= 0 : aP removeAction (gmMktCacheActs select 0)
? (gmMktCacheActs select 1) >= 0 : aP removeAction (gmMktCacheActs select 1)
gmMktCacheActs = []
gmMktCacheActive = false
goto "cacheDel"

#addGar
gmMktGarVeh = gmMktVeh
gmMktGarLocked = gmMktVehLocked
? not gmMktGarLocked : gmMktGarAct = aP addAction [format ["Lock %1 in garage", typeOf gmMktGarVeh], "scripts/market_action.sqs"]
? gmMktGarLocked : gmMktGarAct = aP addAction [format ["Unlock %1", typeOf gmMktGarVeh], "scripts/market_action.sqs"]
gmMktGarActive = true
goto "garDone"

#delGar
aP removeAction gmMktGarAct
gmMktGarAct = -1
gmMktGarActive = false
gmMktGarVeh = objNull
goto "garDel"

#addBuy
gmMktDealer = gmMktD
gmMktDealerRec = gmDealer gmMktD
gmMktDealerKind = gmMktDealerRec select 1
gmMktStock = gmDealerStock gmMktDealerKind
gmMktBuyActs = []
gmMktI = 0
#addBuyLoop
? (gmMktI >= (count gmMktStock)) or (gmMktI >= GM_MKT_MAX_STOCK) : goto "addBuyDeliv"
gmMktRow = gmMktStock select gmMktI
gmMktA = aP addAction [format ["Buy %1 (%2 R)", gmMktRow select 1, gmMktRow select 2], "scripts/market_action.sqs"]
gmMktBuyActs = gmMktBuyActs + [gmMktA]
gmMktI = gmMktI + 1
goto "addBuyLoop"
#addBuyDeliv
gmMktDelivAct = -1
? gmHqEstablished and gmMktDelivHq : gmMktDelivAct = aP addAction ["Delivery: to HQ (switch to here)", "scripts/market_action.sqs"]
? gmHqEstablished and (not gmMktDelivHq) : gmMktDelivAct = aP addAction ["Delivery: here (switch to HQ)", "scripts/market_action.sqs"]
gmMktBuyActive = true
gmMktBuyDirty = false
goto "buyDone"

#delBuy
{aP removeAction _x} forEach gmMktBuyActs
? gmMktDelivAct >= 0 : aP removeAction gmMktDelivAct
gmMktBuyActs = []
gmMktDelivAct = -1
gmMktBuyActive = false
gmMktBuyDirty = false
gmMktDealer = -1
goto "buyDel"

; ============================================================================
;  dispatch a queued request by action id
; ============================================================================
#request
gmMktReqPending = false
? gmMktReqId == gmMktHqAct : goto "doHq"
? gmMktReqId == gmMktGarAct : goto "doGarage"
? (gmMktReqId >= 0) and (gmMktReqId == gmMktDelivAct) : goto "doDeliv"
? (gmMktReqId >= 0) and ((gmMktCacheActs find gmMktReqId) >= 0) : goto "doStash"
? (gmMktReqId >= 0) and ((gmMktBuyActs find gmMktReqId) >= 0) : goto "doBuy"
goto "loop"

; ---- establish / move the headquarters ----------------------------------------
#doHq
gmMktCost = 0
? gmHqEstablished : gmMktCost = GM_MKT_HQ_COST
? gmResources < gmMktCost : hint format ["Not enough Resources to move the headquarters (need %1 R).", gmMktCost]
? gmResources < gmMktCost : goto "loop"
gmMktWasHq = gmHqEstablished
gmMktOk = gmHqEstablish (getPos aP)
? not gmMktOk : hint "No suitable spot for a headquarters here."
? not gmMktOk : goto "loop"
gmResources = gmResources - gmMktCost
gmMktWhere = "outdoors, at the edge of town"
? gmHqIndoors : gmMktWhere = "in a building"
gmMktHqSeen = true
gmJournalObjective ["hqEstablish", "", "DONE"]
? gmMktWasHq : hint format ["Headquarters moved to %1 (%2).\nCost %3 R | Treasury %4 R", gmHqZone, gmMktWhere, gmMktCost, gmResources]
? not gmMktWasHq : hint format ["Headquarters established in %1 (%2).\nThe weapon cache is at the HQ; vehicles within %3 m of the garage can be locked.", gmHqZone, gmMktWhere, GM_MKT_GARAGE_R]
? gmMktWasHq : gmJournalLog format ["Headquarters moved to %1 (%2 R).", gmHqZone, gmMktCost]
? not gmMktWasHq : gmJournalLog format ["Headquarters established in %1 (%2).", gmHqZone, gmMktWhere]
gmMktHqDirty = true
goto "loop"

; ---- lock / unlock the nearest vehicle in the garage ----------------------------
#doGarage
? isNull gmMktGarVeh : goto "loop"
gmMktLock = not (gmGarageHas gmMktGarVeh)
gmMktOk = gmGarageLock [gmMktGarVeh, gmMktLock]
? gmMktOk and gmMktLock : hint format ["%1 locked in the garage (%2 garaged). Beep beep.", typeOf gmMktGarVeh, gmGarageCount]
? gmMktOk and (not gmMktLock) : hint format ["%1 unlocked.", typeOf gmMktGarVeh]
? not gmMktOk : hint "The garage refused that vehicle (not inside the ring, or you are sitting in it)."
? gmMktOk and gmMktLock : gmJournalLog format ["%1 locked in the HQ garage (%2 garaged).", typeOf gmMktGarVeh, gmGarageCount]
goto "loop"

; ---- delivery toggle (labels re-render on the remount) -------------------------
#doDeliv
gmMktDelivHq = not gmMktDelivHq
gmMktBuyDirty = true
goto "loop"

; ---- stash the carried weapon (and its magazines) in the cache ------------------
;  OFP convention: a weapon's magazines share its class name (AK47 -> "AK47"),
;  so the matching mags travel with it; a launcher variant keeps its second
;  magazine type on the player. Retrieval = the holder's own TAKE actions.
#doStash
gmMktSlot = gmMktCacheActs find gmMktReqId
gmMktW = primaryWeapon aP
? gmMktSlot == 1 : gmMktW = secondaryWeapon aP
? (gmMktW == "") or (isNull gmHqCache) : goto "loop"
gmMktN = 0
{if (_x == gmMktW) then {gmMktN = gmMktN + 1}} forEach (magazines aP)
aP removeWeapon gmMktW
? gmMktN > 0 : aP removeMagazines gmMktW
gmHqCache addWeaponCargo [gmMktW, 1]
? gmMktN > 0 : gmHqCache addMagazineCargo [gmMktW, gmMktN]
hint format ["%1 stashed in the headquarters cache (%2 magazine(s)). Take it back through the cache's own action menu.", gmMktW, gmMktN]
gmJournalLog format ["Stashed %1 in the HQ cache.", gmMktW]
goto "loop"

; ---- buy a stock row from the dealer at hand -------------------------------------
#doBuy
gmMktK = gmMktBuyActs find gmMktReqId
? (gmMktK < 0) or (gmMktK >= (count gmMktStock)) : goto "loop"
gmMktRow = gmMktStock select gmMktK
gmMktPrice = gmMktRow select 2
? gmResources < gmMktPrice : hint format ["Not enough Resources (need %1 R, you have %2 R).", gmMktPrice, gmResources]
? gmResources < gmMktPrice : goto "loop"
gmMktToHq = gmMktDelivHq and gmHqEstablished
? gmMktDealerKind == "VEHICLE" : goto "buyVehicle"
; weapon / magazine bundle: [class, displayName, price, magazine, mags]
gmMktCls = gmMktRow select 0
gmMktMag = gmMktRow select 3
gmMktMags = gmMktRow select 4
gmMktHolder = objNull
? gmMktToHq and (not (isNull gmHqCache)) : gmMktHolder = gmHqCache
? isNull gmMktHolder : gmMktHolder = "WeaponHolder" createVehicle (getPos aP)
? isNull gmMktHolder : goto "loop"
? gmMktCls != "" : gmMktHolder addWeaponCargo [gmMktCls, 1]
? (gmMktMag != "") and (gmMktMags > 0) : gmMktHolder addMagazineCargo [gmMktMag, gmMktMags]
gmResources = gmResources - gmMktPrice
? gmMktHolder == gmHqCache : hint format ["Bought %1 for %2 R - delivered to the headquarters cache.\nTreasury %3 R", gmMktRow select 1, gmMktPrice, gmResources]
? gmMktHolder != gmHqCache : hint format ["Bought %1 for %2 R - it is on the ground at your feet.\nTreasury %3 R", gmMktRow select 1, gmMktPrice, gmResources]
gmJournalLog format ["Bought %1 from the arms dealer in %2 (%3 R).", gmMktRow select 1, gmMktDealerRec select 0, gmMktPrice]
goto "loop"
#buyVehicle
; vehicle row: [class, displayName, price]; dropped on the dealer's lot, or
; straight into the HQ garage (locked) when delivering to the HQ
gmMktCls = gmMktRow select 0
gmMktSpot = gmMktDealerRec select 4
? gmMktToHq : gmMktSpot = gmHqGaragePos
gmMktV = gmMktCls createVehicle gmMktSpot
? isNull gmMktV : hint "The dealer could not deliver that vehicle."
? isNull gmMktV : goto "loop"
gmResources = gmResources - gmMktPrice
? gmMktToHq : gmMktLocked = gmGarageLock [gmMktV, true]
? gmMktToHq : hint format ["Bought %1 for %2 R - delivered to the HQ garage and locked.\nTreasury %3 R", gmMktRow select 1, gmMktPrice, gmResources]
? not gmMktToHq : hint format ["Bought %1 for %2 R - parked on the dealer's lot.\nTreasury %3 R", gmMktRow select 1, gmMktPrice, gmResources]
gmJournalLog format ["Bought a %1 from the vehicle dealer in %2 (%3 R).", gmMktRow select 1, gmMktDealerRec select 0, gmMktPrice]
goto "loop"
