; ============================================================================
;  alert.sqs  -  Guerrilla Mode graduated alert state machine
;               (GREEN / YELLOW / RED), per zone, driven by garrison knowsAbout.
; ----------------------------------------------------------------------------
;  OWNS (exclusive write):
;     GM_ALERT_STATE[i]   0 GREEN | 1 YELLOW | 2 RED   (index-aligned to GM_ZONES)
;     GM_ALERT_TIMER[i]   YELLOW disengage countdown (seconds) before RED
;     GM_AL_* tunables    (alert-local constants, redefined each load)
;  RAISES (append-only, never lowers - escalation.sqs is the only decayer):
;     GM_Z_HEAT on each zone record  (+= spike on escalation edges)
;  READS:
;     GM_ZONES (count, GM_Z_HEAT), GM_CACHE_GROUPS / GM_CACHE_ZONEIDX (live
;     garrison groups + which zone each holds), aP (player), `knowsAbout`.
;  SIGNALS spawning.sqs for the QRF: there is no separate flag - spawning.sqs
;     READS GM_ALERT_STATE and launches a QRF when a zone is RED (state 2).
;     Setting GM_ALERT_STATE[i] = 2 here IS "radio the QRF".
;
;  STATE MACHINE (per zone i, evaluated every GM_AL_TICK seconds):
;     know = max over that zone's live garrison groups of (group knowsAbout aP)
;       know <  0.5            -> GREEN : sentry, behaviour "SAFE"
;       0.5 <= know <  1.5     -> YELLOW: investigate last-known pos (group move),
;                                 behaviour "AWARE", run disengage countdown
;       know >= 1.5            -> RED   : behaviour "COMBAT", radio QRF, +Heat
;     YELLOW -> RED also fires if the disengage countdown expires.
;     Detection is RECOVERABLE: if know drops the zone decays YELLOW->GREEN
;     (lost contact) and RED->YELLOW (partial contact, restart the window).
;
;  CONFIRMED COMMANDS ONLY:
;     knowsAbout  (GameStateExt.cpp:1263, GameObjectOrGroup knowsAbout GameObject -> scalar)
;     setBehaviour(GameStateExt.cpp:1297, group setBehaviour string)
;     move        (GameStateExt.cpp:1295, group move [x,y,z])  - doMove is NOT registered
;     getPos      (GameStateExt.cpp:938)
;     count/select/set on arrays, >= <= != == and/not, +/-  (express.cpp)
;
;  DIALECT: SQS. ~N waits, `? cond : stmt` conditional, `#label`/goto loops -
;  all confirmed in shipped Demo missions and the spine's zones.sqs.
;
;  DISTANCE-CACHING / AI BUDGET: all per-group work iterates GM_CACHE_GROUPS
;  only (the distance-spawned live garrison - spawning.sqs caches despawned
;  garrison down to the scalar GM_Z_GAR). Despawned zones have no cache groups,
;  so know stays 0 and they cost a single empty inner-loop pass. No new groups
;  or units are created here, so the 12/group + ~63/side + ~50-100 live-AI
;  budget is untouched by the alert layer.
; ============================================================================

@GM_LIB_READY

; ---- alert-local tunables (owned by alert.sqs) -----------------------------
GM_AL_TICK        = 5    ; poll interval (s). MUST match the literal ~5 below.
GM_AL_WINDOW      = 20   ; YELLOW disengage countdown (s) before escalating RED
GM_AL_HEAT_YELLOW = 4    ; Heat spike added on entering YELLOW
GM_AL_HEAT_RED    = 15   ; Heat spike added on entering RED

; ============================================================================
;  MAIN TICK LOOP
; ============================================================================
#tick
~5
GM_alZ = 0

#zoneloop
? GM_alZ >= (count GM_ZONES) : goto "tickdone"

; --- 1) know = max knowsAbout across this zone's live garrison groups --------
GM_alKnow = 0
GM_alC = 0
#knowloop
? GM_alC >= (count GM_CACHE_GROUPS) : goto "knowdone"
? not ((GM_CACHE_ZONEIDX select GM_alC) == GM_alZ) : goto "knownext"
GM_alK = (GM_CACHE_GROUPS select GM_alC) knowsAbout aP
? GM_alK > GM_alKnow : GM_alKnow = GM_alK
#knownext
GM_alC = GM_alC + 1
goto "knowloop"
#knowdone

; --- 2) decide new state + timer from band(know) and old state --------------
GM_alOld  = GM_ALERT_STATE select GM_alZ
GM_alOldT = GM_ALERT_TIMER select GM_alZ
GM_alNew  = GM_alOld
GM_alNewT = GM_alOldT

? GM_alKnow >= 1.5 : goto "toRed"
? GM_alKnow >= 0.5 : goto "toYellow"
; band GREEN: lost contact -> calm from any state (recoverable)
GM_alNew  = 0
GM_alNewT = 0
goto "decided"

#toRed
GM_alNew  = 2
GM_alNewT = 0
goto "decided"

#toYellow
? GM_alOld == 1 : goto "yCount"
; entering YELLOW from GREEN, or de-escalating RED->YELLOW: start the window
GM_alNew  = 1
GM_alNewT = GM_AL_WINDOW
goto "decided"
#yCount
; already YELLOW: bleed the disengage countdown by one tick
GM_alNewT = GM_alOldT - GM_AL_TICK
? GM_alNewT <= 0 : GM_alNew  = 2
? GM_alNewT <= 0 : GM_alNewT = 0
? GM_alNewT >  0 : GM_alNew  = 1

#decided

; --- 3) commit owned state --------------------------------------------------
GM_ALERT_STATE set [GM_alZ, GM_alNew]
GM_ALERT_TIMER set [GM_alZ, GM_alNewT]

; --- 4) one-shot Heat spike on ESCALATION edges (newState > oldState) --------
;     append-only: alert.sqs only raises Heat; escalation.sqs decays it.
? not (GM_alNew > GM_alOld) : goto "noheat"
GM_alSpk = GM_AL_HEAT_YELLOW
? GM_alNew == 2 : GM_alSpk = GM_AL_HEAT_RED
GM_alZRec = GM_ZONES select GM_alZ
GM_alH = (GM_alZRec select GM_Z_HEAT) + GM_alSpk
? GM_alH > 100 : GM_alH = 100
GM_alZRec set [GM_Z_HEAT, GM_alH]
#noheat

; --- 5) apply reaction to this zone's live groups ---------------------------
;     behaviour is (re)set only on a state EDGE so GREEN sentries keep their
;     spawning.sqs waypoints; YELLOW re-issues the investigate move every tick
;     so the garrison keeps tracking the last-known position.
GM_alEdge = false
? not (GM_alNew == GM_alOld) : GM_alEdge = true
; nothing to do for a steady (non-edge) GREEN or RED zone
? (not GM_alEdge) and (not (GM_alNew == 1)) : goto "applydone"

GM_alBeh = "SAFE"
? GM_alNew == 1 : GM_alBeh = "AWARE"
? GM_alNew == 2 : GM_alBeh = "COMBAT"
; VERIFY: knownTargets (plan 10) is unimplemented, so "last-known position" is
;   approximated by the player's current position. Swap to the group's reported
;   target pos (knownTargets) when plan 10 lands.
GM_alPos = getPos aP

GM_alC = 0
#applyloop
? GM_alC >= (count GM_CACHE_GROUPS) : goto "applydone"
? not ((GM_CACHE_ZONEIDX select GM_alC) == GM_alZ) : goto "applynext"
GM_alGrp = GM_CACHE_GROUPS select GM_alC
? GM_alEdge : GM_alGrp setBehaviour GM_alBeh
? GM_alNew == 1 : GM_alGrp move GM_alPos
#applynext
GM_alC = GM_alC + 1
goto "applyloop"
#applydone

GM_alZ = GM_alZ + 1
goto "zoneloop"

#tickdone
goto "tick"
