; ============================================================================
;  loot.sqs  -  loot-on-kill stash + gear-unlock tally (the Arsenal substitute)
; ----------------------------------------------------------------------------
;  Logic UNCHANGED from Phase 1: dead occupiers are stripped, each weapon/mag
;  classname is tallied via GM_fnBumpGear (the sole GM_GEAR_* writer), and a
;  classname crossing GM_GEAR_THRESHOLD unlocks permanently (toast once).
;  GM_fnEquipFromUnlocked stays the public kit-out helper for recruit.sqs.
;
;  WHAT CHANGED (Phase 1.5):
;    * The enemy-body source is the NATIVE garrison cache: bodies are tagged
;      per spawned zone via gmGarrisonSpawned/gmGarrisonGroups (the old
;      GM_CACHE_GROUPS transient is gone). The gmEvtGarSpawned/Despawned
;      queues (filled by the handlers init.sqs registered) are drained each
;      pass; the tag sweep itself covers every spawned zone, so the events
;      cost nothing extra - draining keeps the queues bounded and makes the
;      spawn->tag latency at most one sweep.
;    * NO classnames in this file: the role table below is built ONCE at boot
;      from the resistance faction descriptor (keys loot<Role>Weapon /
;      loot<Role>Mag + baseWeapon/baseMagazine - see description.ext).
;    * QRF bodies remain untagged, exactly like Phase 1 (only garrison
;      corpses feed the stash).
;
;  OWNS: GM_GEAR_* (via GM_fnBumpGear only), gmEvtGarSpawned/Despawned
;        (consumer), loot-private helpers/state below.
;  READS: gmZoneCount, gmGarrisonSpawned/gmGarrisonGroups, dead bodies'
;        weapons/magazines, gmResistanceSide + faction loot keys.
;  Persistence: GM_GEAR_* are plain arrays -> serialize free. GM_LOOT_TAGGED
;        holds live handles; restored links either come back valid (already
;        tagged units keep their killed-EH via the world serializer) or null
;        (pruned by the alive sweep) - same policy as Phase 1.
; ============================================================================

@GM_LIB_READY

; ===========================================================================
;  TUNABLES / CONSTANTS
; ===========================================================================
;   GM_LOOT_SWEEP    seconds between tag-sweeps of the spawned garrisons
;   GM_LOOT_MAGCOUNT fallback-kit magazines (the "infinite" supply)
GM_LOOT_SWEEP    = 5
GM_LOOT_MAGCOUNT = 6

; Fallback kit: what a unit gets when its role weapon is not yet unlocked, so
; no spawned unit is ever unarmed. From the faction descriptor.
GM_LOOT_BASEWEAP = gmFactionValue [gmResistanceSide, "baseWeapon"]
GM_LOOT_BASEMAG  = gmFactionValue [gmResistanceSide, "baseMagazine"]

; Role -> [roleName, weaponClass, [magClass], magCount], built from the
; faction keys loot<Role>Weapon / loot<Role>Mag. Mag counts are gameplay
; tuning (island-agnostic) and stay script-side. ONE physical line: SQS is
; line-oriented, a statement cannot span lines.
GM_LOOT_LOADOUTS = [ ["RIFLEMAN", gmFactionValue [gmResistanceSide, "lootRiflemanWeapon"], [gmFactionValue [gmResistanceSide, "lootRiflemanMag"]], 6], ["MEDIC", gmFactionValue [gmResistanceSide, "lootMedicWeapon"], [gmFactionValue [gmResistanceSide, "lootMedicMag"]], 6], ["MG", gmFactionValue [gmResistanceSide, "lootMGWeapon"], [gmFactionValue [gmResistanceSide, "lootMGMag"]], 4], ["AT", gmFactionValue [gmResistanceSide, "lootATWeapon"], [gmFactionValue [gmResistanceSide, "lootATMag"]], 4], ["SNIPER", gmFactionValue [gmResistanceSide, "lootSniperWeapon"], [gmFactionValue [gmResistanceSide, "lootSniperMag"]], 6] ]

; ---- loot-private state ------------------------------------------------------
;   GM_LOOT_TAGGED    live units already given the killed-EH
;   GM_LOOT_ANNOUNCED unlocks already toasted
GM_LOOT_TAGGED    = []
GM_LOOT_ANNOUNCED = GM_GEAR_UNLOCKED + []

; ===========================================================================
;  HELPERS  (single-line code values; synchronous; GM_tmpL* scratch)
; ===========================================================================

; --- GM_fnLootItem( [classname, amount] ) -> newCount -------------------------
;   Tally through GM_fnBumpGear; toast the player once per fresh unlock.
GM_fnLootItem = {GM_tmpLC = _this select 0; GM_tmpLN = [GM_tmpLC, _this select 1] call GM_fnBumpGear; if ((GM_tmpLC in GM_GEAR_UNLOCKED) and (not (GM_tmpLC in GM_LOOT_ANNOUNCED))) then {GM_LOOT_ANNOUNCED = GM_LOOT_ANNOUNCED + [GM_tmpLC]; hint format ["Gear unlocked: %1 - now in infinite supply for your fighters.", GM_tmpLC]}; GM_tmpLN}

; --- GM_fnLootKilledEH : the "killed" event-handler body -----------------------
;   _this = [deadUnit, killer]. Tally weapons AND magazines, strip the corpse.
GM_fnLootKilledEH = {GM_tmpLU = _this select 0; "[_x, 1] call GM_fnLootItem" forEach (weapons GM_tmpLU); "[_x, 1] call GM_fnLootItem" forEach (magazines GM_tmpLU); removeAllWeapons GM_tmpLU}

; --- GM_fnLootTag : attach the killed-EH to every live native-garrison unit ---
;   Walks gmGarrisonGroups for each spawned zone (all occupier bodies, so no
;   side test). Idempotent via GM_LOOT_TAGGED (no handler stacking).
GM_fnLootTag = {GM_tmpLZ = 0; while {GM_tmpLZ < gmZoneCount} do {if (gmGarrisonSpawned GM_tmpLZ) then {GM_tmpLGs = gmGarrisonGroups GM_tmpLZ; GM_tmpLG = 0; while {GM_tmpLG < (count GM_tmpLGs)} do {GM_tmpLA = units (GM_tmpLGs select GM_tmpLG); GM_tmpLK = 0; while {GM_tmpLK < (count GM_tmpLA)} do {GM_tmpLUN = GM_tmpLA select GM_tmpLK; if (not (GM_tmpLUN in GM_LOOT_TAGGED)) then {GM_tmpLUN addEventHandler ["killed", GM_fnLootKilledEH]; GM_LOOT_TAGGED = GM_LOOT_TAGGED + [GM_tmpLUN]}; GM_tmpLK = GM_tmpLK + 1}; GM_tmpLG = GM_tmpLG + 1}}; GM_tmpLZ = GM_tmpLZ + 1}}

; --- GM_fnLootPrune : keep GM_LOOT_TAGGED bounded ------------------------------
;   Rebuild the set keeping only living handles (dead = EH already fired;
;   null = despawned or a broken post-load link).
GM_fnLootPrune = {GM_tmpLP = []; GM_tmpLK2 = 0; while {GM_tmpLK2 < (count GM_LOOT_TAGGED)} do {if (alive (GM_LOOT_TAGGED select GM_tmpLK2)) then {GM_tmpLP = GM_tmpLP + [GM_LOOT_TAGGED select GM_tmpLK2]}; GM_tmpLK2 = GM_tmpLK2 + 1}; GM_LOOT_TAGGED = GM_tmpLP}

; --- GM_fnEquipFromUnlocked( [unit, role] ) -> unit  (PUBLIC) ------------------
;   Kit a freshly created unit: the role weapon if UNLOCKED, else the base
;   kit. role: "RIFLEMAN"|"MEDIC"|"MG"|"AT"|"SNIPER" (row 0 if unknown).
GM_fnEquipFromUnlocked = {GM_tmpEU = _this select 0; GM_tmpERole = _this select 1; GM_tmpERow = GM_LOOT_LOADOUTS select 0; GM_tmpEI = 0; while {GM_tmpEI < (count GM_LOOT_LOADOUTS)} do {if (((GM_LOOT_LOADOUTS select GM_tmpEI) select 0) == GM_tmpERole) then {GM_tmpERow = GM_LOOT_LOADOUTS select GM_tmpEI}; GM_tmpEI = GM_tmpEI + 1}; GM_tmpEW = GM_tmpERow select 1; GM_tmpEM = (GM_tmpERow select 2) select 0; GM_tmpEN = GM_tmpERow select 3; if (not (GM_tmpEW in GM_GEAR_UNLOCKED)) then {GM_tmpEW = GM_LOOT_BASEWEAP; GM_tmpEM = GM_LOOT_BASEMAG; GM_tmpEN = GM_LOOT_MAGCOUNT}; removeAllWeapons GM_tmpEU; GM_tmpEU addMagazine GM_tmpEM; GM_tmpEU addWeapon GM_tmpEW; GM_tmpEK = 1; while {GM_tmpEK < GM_tmpEN} do {GM_tmpEU addMagazine GM_tmpEM; GM_tmpEK = GM_tmpEK + 1}; GM_tmpEU}

; ===========================================================================
;  MAIN LOOP - the sweep is bounded to the natively distance-cached live
;  garrisons (the ~50-100 AI near the player), same budget as Phase 1.
; ===========================================================================
#loop
GM_LOOT_EVQ = gmEvtGarSpawned + []; gmEvtGarSpawned = []; gmEvtGarDespawned = []
[] call GM_fnLootTag
[] call GM_fnLootPrune
~GM_LOOT_SWEEP
goto "loop"
