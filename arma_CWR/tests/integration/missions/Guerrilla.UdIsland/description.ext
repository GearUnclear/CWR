// Guerrilla Mode on UD Island (CfgWorlds >> UdIsland).
// GENERATED by `PoseidonTools guerrilla scaffold` on 2026-09-02 - a STARTING POINT, not a finished
// campaign. Re-running the tool overwrites this file; pass --keep-zones to
// preserve a hand-edited class Zones block across a re-run.
//
// Zone geometry was derived from udisland\udisland.wrp: 97 road piece(s) and 15
// building(s) were identified by model-path heuristics (Guerrilla::ModelIsRoad
// / ModelIsBuilding), and every elevation below is a real sampled ground
// height, not a guess. CITY zones are the world's own Names entries that sit
// on dry land with at least 3 building(s) within 300 m - the same test the
// running engine applies (ZoneRegistry::LandscapeSettlementProbe).
//
// BEFORE YOU SHIP THIS, by hand:
//   1. defaultOccupier / defaultResistance below are PLACEHOLDERS. Set them to
//      CfgGuerrillaFactions class names your data set actually ships (the global
//      library is guerrilla-mode/config/guerrilla-factions.hpp; a mod may add
//      its own). playerSide must be the side the mission.sqm player is welded
//      to - the engine counts resistance presence through that side's center.
//   2. Walk the Camp and the Outposts in the editor. The placement rules know
//      about roads, water and slope; they know nothing about fences, compounds
//      or minefields, so a spot can be legal and still be walled in.
//   3. Rename the Outposts to real places and tune garrison / income.
//   4. Add a CfgGuerrillaMarket block if this island should have dealers.

onLoadMission = "Guerrilla Mode - UD Island";
onLoadIntro  = "Liberate UD Island, one zone at a time.";
respawn = 0;
joinInProgress = 0;

class CfgGuerrillaZones
{
    // PLACEHOLDERS - see note 1 in the header. These are the direct-launch
    // fallbacks used when the GUERRILLA new-game UI published no selection.
    defaultOccupier = "EAST";
    defaultResistance = "GUER";
    playerSide = "GUER";
    // seedCities is deliberately ABSENT (= Auto): the mission-time settlement
    // classifier runs over the loaded landscape and adds any town this offline
    // pass missed, deduped against the explicit CITY zones below at 300 m.
    seedCitySupport = 20;

    class Zones
    {
        // COORDINATE ORDER (load-bearing): position[] is authored in
        // script/getPos order [easting, northing, elevation] - NOT the
        // mission.sqm order [easting, ELEVATION, northing]. The engine's
        // ZoneRegistry::LoadZones documents and enforces this contract.
        // Elevations are real sampled ground heights from the world's .wrp.
        class Camp
        {
            // 106 m to the nearest road, 495 m to the nearest town, 0.5 m of relief across 40 m
            name = "Camp";
            type = "CAMP";
            owner = "RESISTANCE";
            garrison = 0;
            income = 0;
            support = 100;
            marker = "gmZoneMarker_0";
            position[] = {1292, 1950, 36.1};
        };
        class Outpost1
        {
            // 375 m to the nearest road, 815 m to the nearest other zone
            name = "Outpost 1";
            type = "OUTPOST";
            owner = "OCCUPIER";
            garrison = 6;
            income = 25;
            marker = "gmZoneMarker_1";
            position[] = {1700, 658, 24.0};
        };
        class Northam
        {
            // CfgWorlds >> UdIsland >> Names >> Northam; 5 building(s) within 300 m
            name = "Northam";
            type = "CITY";
            owner = "NEUTRAL";
            support = 20;
            marker = "gmZoneMarker_2";
            position[] = {1000, 2350, 23.6};
        };
        class Eastwick
        {
            // CfgWorlds >> UdIsland >> Names >> Eastwick; 5 building(s) within 300 m
            name = "Eastwick";
            type = "CITY";
            owner = "NEUTRAL";
            support = 20;
            marker = "gmZoneMarker_3";
            position[] = {2350, 1150, 26.4};
        };
        class Southmere
        {
            // CfgWorlds >> UdIsland >> Names >> Southmere; 5 building(s) within 300 m
            name = "Southmere";
            type = "CITY";
            owner = "NEUTRAL";
            support = 20;
            marker = "gmZoneMarker_4";
            position[] = {900, 900, 22.6};
        };
    };
};

// The ISLAND half of the faction table (issue #54 A4): only CIV lives here.
// The war rosters are NOT island facts and belong in the global library
// (guerrilla-mode/config/guerrilla-factions.hpp for vanilla, a mod-level
// config for a mod's own factions); the engine unions the two tables
// (Game/Guerrilla/FactionSources.*), this file winning on a name clash.
class CfgGuerrillaFactions
{
    class CIV // civilian population descriptor (issue #8)
    {
        // side MUST be exactly "CIV": GM_fnSideFromString matches the engine's
        // rendered side name, and the civilian side renders as "CIV".
        side = "CIV";
        // The probe only knows the stock Civilian* / car classnames. If your
        // data set ships its own civilians (a mod's LoBo_Civ_* and vans, say),
        // put them here instead: nothing in a config marks a class as
        // "civilian population" or "traffic hull", so this cannot be derived.
        // Numbered keys + a count, NOT an array: gmFactionValue returns raw
        // config text and skips array entries, so the scripts read
        // civClassCount and then civClass1..civClassN. Every class below was
        // probed against the mounted package at scaffold time.
        civClassCount = 1;
        civClass1 = "Civilian";
        // Ambient road-traffic hulls (native Traffic service). A real array:
        // unresolvable hulls are dropped at load, an empty result just leaves
        // civilian traffic inert.
        civVehicles[] = {};
    };
};
