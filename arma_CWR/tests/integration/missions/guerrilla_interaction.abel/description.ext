// Isolated persistence lane for #41. Native support accrual/intimidation is
// covered separately; this test diffs the exact interaction ledger after load.
class CfgGuerrillaZones
{
    // Base seeding (#76) pinned off: this mission authors every zone it wants.
    seedBases = 0;
    defaultOccupier = "EAST";
    defaultResistance = "GUER";
    seedCities = 0;
    supportRate = 0;
    supportDecayOccupied = 0;
    trafficEnabled = 0;
    // Town defenders (issue #79 B2) PINNED OFF: this fixture predates them,
    // and its tests park an armed player at the Village centre. With the
    // default cityGarrison the occupier-administered Village keeps four EAST
    // bodies, and since GarrisonCache::SpawnPoint hashes their spawn points
    // per zone (OCCUPIER-FORCES.md L11) one stands about 21 m from the centre
    // with a line of fire every run: once cover is blown it kills the player,
    // and under --autotest the mission end shuts the game down mid-test
    // (guerrilla_assailants: harness dropped at triAssertEq [asAdmitted, 8]).
    // cityGarrison = 0 is the legacy free-town rule; defended towns are
    // covered by guerrilla_town_defenders on the shipped Guerrilla.Abel.
    cityGarrison = 0;
    class Zones
    {
        class Camp
        {
            name = "Camp";
            type = "CAMP";
            owner = "RESISTANCE";
            position[] = {7515, 5790, 0};
        };
        class Village
        {
            name = "Village";
            type = "CITY";
            owner = "NEUTRAL";
            support = 20;
            position[] = {7117, 6069, 0};
        };
    };
};
class CfgGuerrillaFactions
{
    class CIV
    {
        side = "CIV";
        civClassCount = 1;
        civClass1 = "Civilian2";
    };
};
