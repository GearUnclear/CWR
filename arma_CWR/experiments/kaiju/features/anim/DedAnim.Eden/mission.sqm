// Dedushka animation test bed on Eden (Everon airfield), daylight. One stock
// player only; the anim tests (features/anim/ded_anim_*.test.sqf) create the
// creature from script. addOns[] names the creature's addon: a runtime
// createUnit of a class whose owner addon is not activated is refused, and no
// script command activates one. The addon comes from the mod folder the
// test mounts (@kj_anim for the anim feature's moves class).
version=11;
class Mission
{
	addOns[]=
	{
		"uddedushka"
	};
	addOnsAuto[]=
	{
		"uddedushka"
	};
	randomSeed=4243;
	class Intel
	{
		viewDistance=1200;
		year=1985;
		month=6;
		day=10;
		hour=11;
		minute=0;
		weather=0.100000;
		weatherForecast=0.100000;
		fog=0.000000;
		fogForecast=0.000000;
	};
	class Groups
	{
		items=1;
		class Item0
		{
			side="WEST";
			class Vehicles
			{
				items=1;
				class Item0
				{
					position[]={4772.0,20.0,11000.0};
					azimut=0.000000;
					id=0;
					side="WEST";
					vehicle="SoldierWB";
					player="PLAYER COMMANDER";
					leader=1;
					skill=0.600000;
				};
			};
		};
	};
};
