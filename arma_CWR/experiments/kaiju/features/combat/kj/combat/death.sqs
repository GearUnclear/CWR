; ============================================================================
;  kj\combat\death.sqs  -  the death of Dedushka. Started by start.sqs when
;  nothing is left of his health (or by a mission that wants it now).
;
;      [kaiju] exec "kj\combat\death.sqs"          the whole sequence
;      [kaiju, true] exec "kj\combat\death.sqs"    he is already dead and falling
;
;  Tuning: the "death" lines of the block at the top of kj\combat\init.sqf.
;
;  The sequence (KJ_deathPhase says where it is):
;    stagger  he shudders, twice; smoke pours out of the chest. From this
;             moment KJ_dead is true: the brain, the walk, the crush, the beam,
;             the drone and the furnace's own light all stop. Nothing of his
;             acts on the world again except his body coming down.
;    flare    one last roar, and the furnace climbs from orange to white.
;             (On a kaiju binary of version 2 the furnace painted on his body
;             does all of it too: it gutters through the stagger, climbs to
;             white hot in the flare, and is black from the dark on: the ribs
;             of the body are dark for good.)
;    vent     the furnace gives out in one breath of heat: men on foot near
;             him die or are burnt, soft vehicles are scorched, an aircraft
;             close to the chest is wrecked. Armour is not harmed.
;    dark     the furnace is out. He stands, black smoke where the fire was.
;    fall     the engine's own death (setDammage 1): he topples forward
;             through the fall clip.
;    down     the body meets the ground: the ground shakes far out, dust
;             along his whole length, everything under him is crushed, men
;             near him are thrown down.
;    body     he lies still. The smoke thins and stops. Men who were running
;             from him stop. The body stays: dark, silent, safe to walk up to.
;
;  Read by others: KJ_dying, KJ_deathPhase, KJ_deathLog [[phase, time], ...],
;  KJ_deathStats [men killed, men burnt or thrown, vehicles wrecked, statics
;  felled], KJ_dead.
; ============================================================================
_k = _this select 0
_fallen = false
? (count _this) > 1 : _fallen = _this select 1
? isNull _k : exit
? isNil "KJCB_ready" : call compile preprocessFile "kj\combat\init.sqf"
? KJ_dying : exit
KJ_dying = true
KJ_combatOn = false
KJ_woundHealth = 0
KJ_woundPace = 0
KJ_woundRetreat = false
; everything of his that acts on the world stops, once (the flags of the other features; harmless when they are absent)
KJ_dead = true
KJ_beamAbort = true
KJ_furnaceOn = false
KJ_presenceOn = false
KJ_walkOn = false
KJ_crushOn = false
_t = 0
_t0 = time
_f = _k call KJCB_fnFurnaceNow
_p = [_k, _f] call KJCB_fnToWorld
_p set [2, (_p select 2) + (_k call KJCB_fnGz)]
_dir = getDir _k
_g = 0
_sz = 0
_q = 0
_i = 0
_c = [0, 0]
_d = 0
_l = [0, 0]
_men = []
_veh = []
_down = []
_wet = false
_gy = 0.5
? _fallen : goto "fall"

; ---- stagger -------------------------------------------------------------------
KJ_deathPhase = "stagger"
KJ_deathLog = KJ_deathLog + [["stagger", time]]
logInfo format ["KJCOMBAT death: stagger at %1 (health %2, stage %3)", time, KJ_woundHealth, KJ_woundStage]
? alive _k : _k playMove "DedFlinch"
_t = time
_i = 0
#stagger
~0.1
? isNull _k : exit
? not (alive _k) : goto "fall"
_i = _i + 1
_f = _k call KJCB_fnFurnaceNow
_p = [_k, _f] call KJCB_fnToWorld
_p set [2, (_p select 2) + (_k call KJCB_fnGz)]
_g = 0.05 + random 0.06
_sz = 0.08 * KJCB_H
? KJCB_FX : drop ["cl_basic", "", "Billboard", 1, 7 + random 3, [(_p select 0) + 2 - random 4, (_p select 1) + 2 - random 4, (_p select 2) + 2 - random 4], [(3 * sin _dir) + 1 - random 2, (3 * cos _dir) + 1 - random 2, 2 + random 2], 0, 1.27, 1, 0.1, [_sz, 2.5 * _sz, 4.5 * _sz], [[_g, _g, _g, 0], [_g, _g, _g, 0.8], [_g, _g, _g, 0.5], [_g, _g, _g, 0]], [0], 0.5, 0.5, "", ""]
? KJCB_FX and ((_i mod 2) == 0) : drop [KJCB_GLOW, "", "Billboard", 1, 2.6 + random 1, [(_p select 0) + 3 - random 6, (_p select 1) + 3 - random 6, (_p select 2) - 2 - random 4], [2 - random 4, 2 - random 4, -1], 0, 2.6, 1, 0.01, [0.9, 0.3], [[1, 0.75, 0.35, 1], [1, 0.35, 0.05, 0.9], [0.6, 0.1, 0.02, 0]], [0], 0.4, 0.8, "", ""]
; the furnace on his body gutters: low, with a jump now and then
_q = 0.12 + random 0.3
? (random 1) < 0.2 : _q = _q + 0.5
? (_i mod 3) == 0 : [_k, _q] call KJCB_fnGlow
? _i == 27 : _k playMove "DedFlinch"
? (time - _t) < KJCB_D_STAGGER : goto "stagger"

; ---- flare ---------------------------------------------------------------------
KJ_deathPhase = "flare"
KJ_deathLog = KJ_deathLog + [["flare", time]]
logInfo format ["KJCOMBAT death: flare at %1", time]
; one last roar: the roar feature's when it is in the mission (sound, fear), else the move alone
? KJCB_hasRoar and KJCB_ACT : [_k] exec "kj\roar\roar.sqs"
? not (KJCB_hasRoar and KJCB_ACT) : _k playMove "DedRoar"
_t = time
#flare
~0.08
? isNull _k : exit
? not (alive _k) : goto "fall"
_q = (time - _t) / KJCB_D_FLARE
? _q > 1 : _q = 1
_f = _k call KJCB_fnFurnaceNow
_p = [_k, _f] call KJCB_fnToWorld
_p set [2, (_p select 2) + (_k call KJCB_fnGz)]
_sz = (0.2 + 0.9 * _q * _q) * KJCB_H
? KJCB_FX : drop [KJCB_GLOW, "", "Billboard", 1, 0.2, [_p select 0, _p select 1, _p select 2], [0, 0, 0], 0, 1.275, 1, 0, [_sz, 0.9 * _sz], [[1, 0.5 + 0.5 * _q, 0.12 + 0.85 * _q, 0.5 + 0.4 * _q], [1, 0.5 + 0.5 * _q, 0.12 + 0.85 * _q, 0]], [0], 1, 0, "", ""]
? KJCB_native : kjLight [_k, "kjcb", _f, [1, 0.5 + 0.5 * _q, 0.12 + 0.85 * _q], 1 + 6 * _q * _q]
[_k, 0.5 + 1.5 * _q * _q] call KJCB_fnGlow
? KJCB_native and (_q > 0.3) : kjShake [_k, 0.5 * _q, 2 * KJCB_H, 8 * KJCB_H, 0.3, 9]
? _q < 1 : goto "flare"

; ---- vent ----------------------------------------------------------------------
KJ_deathPhase = "vent"
KJ_deathLog = KJ_deathLog + [["vent", time]]
; the breath of heat: a white burst at the furnace, a ring of fire running out along the ground
_sz = 1.6 * KJCB_H
? KJCB_FX : drop [KJCB_GLOW, "", "Billboard", 1, 0.45, [_p select 0, _p select 1, _p select 2], [0, 0, 0], 0, 1.275, 1, 0, [0.6 * _sz, _sz], [[1, 1, 0.95, 1], [1, 0.8, 0.5, 0]], [0], 1, 0, "", ""]
_i = 0
#ring
? not KJCB_FX : goto "ringdone"
_d = _i * 15
drop [KJCB_GLOW, "", "Billboard", 1, 0.9 + random 0.5, [(_p select 0) + 6 * sin _d, (_p select 1) + 6 * cos _d, KJCB_gz + 2 + random 6], [(KJCB_VENT_BURN * KJCB_H * 0.9) * sin _d, (KJCB_VENT_BURN * KJCB_H * 0.9) * cos _d, 1], 0, 1.275, 1, 0.02, [6, 14], [[1, 0.9, 0.6, 0.9], [1, 0.45, 0.1, 0.6], [0.5, 0.1, 0.02, 0]], [0], 1, 0, "", ""]
_i = _i + 1
? _i < 24 : goto "ring"
#ringdone
? KJCB_native : kjShake [_k, 1.2, 2 * KJCB_H, 12 * KJCB_H, 1.2, 6]
? not KJCB_VENT : goto "vented"
; who stands too close. Measured along the ground from the point under the furnace.
_c = [_p select 0, _p select 1, 0]
_men = nearestObjects [_c, ["Man"], KJCB_VENT_BURN * KJCB_H]
{ if ((_x != _k) and (alive _x)) then { _d = [_x, _c] call KJCB_fnD2; if (_d <= (KJCB_VENT_KILL * KJCB_H)) then { [_x, _k] call KJCB_fnKill; KJ_deathStats set [0, (KJ_deathStats select 0) + 1] } else { _x setDammage ((getDammage _x) + 0.75 * (1 - (_d - KJCB_VENT_KILL * KJCB_H) / ((KJCB_VENT_BURN - KJCB_VENT_KILL) * KJCB_H))); KJ_deathStats set [1, (KJ_deathStats select 1) + 1] } } } forEach _men
_veh = nearestObjects [_c, ["Car", "Motorcycle", "Ship"], KJCB_VENT_BURN * KJCB_H]
{ if (alive _x) then { _x setDammage ((getDammage _x) + 0.5); KJ_deathStats set [2, (KJ_deathStats select 2) + 1] } } forEach _veh
; an aircraft close to the chest itself
_veh = nearestObjects [_c, ["Air"], 2 * KJCB_H]
{ if ((alive _x) and ((sqrt ((((getPos _x) select 0) - (_p select 0)) ^ 2 + (((getPos _x) select 1) - (_p select 1)) ^ 2 + (((getPos _x) select 2) - (_f select 2)) ^ 2)) <= (KJCB_VENT_BURN * KJCB_H))) then { [_x, _k] call KJCB_fnKill; KJ_deathStats set [2, (KJ_deathStats select 2) + 1] } } forEach _veh
#vented
logInfo format ["KJCOMBAT death: vent at %1, stats %2", time, KJ_deathStats]
~0.4

; ---- dark ----------------------------------------------------------------------
KJ_deathPhase = "dark"
KJ_deathLog = KJ_deathLog + [["dark", time]]
? KJCB_native : kjLight [_k, "kjcb", _f, [0, 0, 0], 0]
; the furnace on his body is out, for good
[_k, 0] call KJCB_fnGlow
_t = time
#dark
~0.12
? isNull _k : exit
? not (alive _k) : goto "fall"
_f = _k call KJCB_fnFurnaceNow
_p = [_k, _f] call KJCB_fnToWorld
_p set [2, (_p select 2) + (_k call KJCB_fnGz)]
_g = 0.03 + random 0.04
_sz = 0.11 * KJCB_H
? KJCB_FX : drop ["cl_basic", "", "Billboard", 1, 9 + random 4, [(_p select 0) + 3 - random 6, (_p select 1) + 3 - random 6, (_p select 2) + 3 - random 6], [(2 * sin _dir) + 1 - random 2, (2 * cos _dir) + 1 - random 2, 1 + random 2], 0, 1.27, 1, 0.1, [_sz, 2.2 * _sz, 4 * _sz], [[_g, _g, _g, 0], [_g, _g, _g, 0.9], [_g, _g, _g, 0.6], [_g, _g, _g, 0]], [0], 0.5, 0.5, "", ""]
? (time - _t) < KJCB_D_DARK : goto "dark"

; ---- fall ----------------------------------------------------------------------
#fall
KJ_deathPhase = "fall"
KJ_deathLog = KJ_deathLog + [["fall", time]]
KJ_woundStage = 5
KJ_woundLog = KJ_woundLog + [[time, 5, 0]]
? isNull _k : exit
_dir = getDir _k
_c = getPos _k
? KJCB_native : kjLight [_k, "kjcb", _f, [0, 0, 0], 0]
[_k, 0] call KJCB_fnGlow
; the ceiling that kept any one blow from killing him is lifted: a dead body's damage reads 1
? KJCB_native : kjSet [_k, "damageCeiling", -1]
? alive _k : _k setDammage 1
; the body is set down on the ground as it falls (a fall clip may leave the trunk hanging: settle.sqs)
[_k] exec "kj\combat\settle.sqs"
logInfo format ["KJCOMBAT death: fall at %1 from %2 heading %3", time, _c, _dir]
~(KJCB_D_IMPACT * KJCB_D_FALL)

; ---- down: the body meets the ground --------------------------------------------
KJCB_gz = 0
? KJCB_dropASL : KJCB_gz = [_c select 0, _c select 1] call KJCB_fnGroundAt
KJ_deathPhase = "down"
KJ_deathLog = KJ_deathLog + [["down", time]]
; the middle of the fallen body
_l = [(_c select 0) + 0.5 * KJCB_FALL_LEN * KJCB_H * sin _dir, (_c select 1) + 0.5 * KJCB_FALL_LEN * KJCB_H * cos _dir, 0]
; in the sea the fall throws spray, not dust, and the drowned furnace steams
_wet = [_l select 0, _l select 1] call KJCB_fnWet
_gy = 0.5
? _wet : _gy = 0.93
[_l, 3, 5, 4 * KJCB_H, 35 * KJCB_H] call KJCB_fnShake
; dust along his whole length, then a wall of it rolling out
_i = 0
#dust
? not KJCB_FX : goto "dustdone"
_d = (_i / 5) * KJCB_FALL_LEN * KJCB_H
[[(_c select 0) + _d * sin _dir, (_c select 1) + _d * cos _dir], 1.3 * KJCB_FALL_HALF * KJCB_H, 16, 0.22 * KJCB_H, 6, 13, _gy, 0.9] call KJCB_fnDust
_i = _i + 1
? _i <= 5 : goto "dust"
_i = 0
#wall
_d = _i * 12
drop ["cl_basic", "", "Billboard", 1, 7 + random 4, [(_l select 0) + 0.5 * KJCB_H * sin _d, (_l select 1) + 0.5 * KJCB_H * cos _d, KJCB_gz + 1.5], [18 * sin _d, 18 * cos _d, 1.5], 0, 1.3, 1, 0.06, [0.15 * KJCB_H, 0.4 * KJCB_H, 0.6 * KJCB_H], [[_gy + 0.05, _gy + 0.02, _gy - 0.04, 0], [_gy + 0.05, _gy + 0.02, _gy - 0.04, 0.8], [_gy + 0.05, _gy + 0.02, _gy - 0.04, 0.45], [_gy + 0.05, _gy + 0.02, _gy - 0.04, 0]], [0], 0.3, 0.3, "", ""]
_i = _i + 1
? _i < 30 : goto "wall"
; and what the blow throws up: a slower, taller cloud over the body
[[_l select 0, _l select 1], 0.6 * KJCB_FALL_LEN * KJCB_H, 22, 0.3 * KJCB_H, 9, 16, _gy - 0.04, 0.7] call KJCB_fnDust
#dustdone
; whatever is under him. In his frame at the moment he fell: forward 0 .. length, sideways within the half width.
_men = nearestObjects [_l, ["Man"], 0.75 * KJCB_FALL_LEN * KJCB_H]
{ if ((_x != _k) and (alive _x)) then { _d = (((getPos _x) select 0) - (_c select 0)) * sin _dir + (((getPos _x) select 1) - (_c select 1)) * cos _dir; _q = (((getPos _x) select 0) - (_c select 0)) * cos _dir - (((getPos _x) select 1) - (_c select 1)) * sin _dir; if ((_d > -0.1 * KJCB_H) and (_d < 1.05 * KJCB_FALL_LEN * KJCB_H) and ((abs _q) < KJCB_FALL_HALF * KJCB_H)) then { [_x, _k] call KJCB_fnKill; KJ_deathStats set [0, (KJ_deathStats select 0) + 1] } } } forEach _men
_veh = nearestObjects [_l, ["LandVehicle", "Air", "Ship"], 0.75 * KJCB_FALL_LEN * KJCB_H]
{ if (alive _x) then { _d = (((getPos _x) select 0) - (_c select 0)) * sin _dir + (((getPos _x) select 1) - (_c select 1)) * cos _dir; _q = (((getPos _x) select 0) - (_c select 0)) * cos _dir - (((getPos _x) select 1) - (_c select 1)) * sin _dir; if ((_d > -0.1 * KJCB_H) and (_d < 1.05 * KJCB_FALL_LEN * KJCB_H) and ((abs _q) < KJCB_FALL_HALF * KJCB_H)) then { [_x, _k] call KJCB_fnKill; KJ_deathStats set [2, (KJ_deathStats select 2) + 1] } } } forEach _veh
; houses, trees, walls under him: the crush feature knows which map objects can fall; without it, only objects that have a class
_veh = nearestObjects [_l, [], 0.75 * KJCB_FALL_LEN * KJCB_H]
{ if ((_x != _k) and (_x != KJCB_probe) and (("AllVehicles" countType [_x]) == 0)) then { _d = (((getPos _x) select 0) - (_c select 0)) * sin _dir + (((getPos _x) select 1) - (_c select 1)) * cos _dir; _q = (((getPos _x) select 0) - (_c select 0)) * cos _dir - (((getPos _x) select 1) - (_c select 1)) * sin _dir; if ((_d > -0.1 * KJCB_H) and (_d < 1.05 * KJCB_FALL_LEN * KJCB_H) and ((abs _q) < KJCB_FALL_HALF * KJCB_H)) then { _i = "skip"; if (isNil "KJC_fnKind") then { if (((typeOf _x) != "") and (("Static" countType [_x]) > 0)) then { _i = "big" } } else { _i = _x call KJC_fnKind }; if ((_i == "big") or (_i == "small")) then { if ((getDammage _x) < 1) then { [_x, _k] call KJCB_fnKill; KJ_deathStats set [3, (KJ_deathStats select 3) + 1] } } } } } forEach _veh
; the ground wave: men near him are thrown down (hurt, and flat on the ground until he lies still), light vehicles hop
_men = nearestObjects [_l, ["Man"], KJCB_FALL_SHOVE * KJCB_H]
{ if ((_x != _k) and (alive _x)) then { _d = [_x, _l] call KJCB_fnD2; _q = 1 - _d / (KJCB_FALL_SHOVE * KJCB_H); if (_q > 0) then { _x setDammage ((getDammage _x) + 0.25 * _q); [_x, [4 * _q * (((getPos _x) select 0) - (_l select 0)) / (_d + 1), 4 * _q * (((getPos _x) select 1) - (_l select 1)) / (_d + 1), 2 * _q]] call KJCB_fnThrow; _x setUnitPos "DOWN"; _down = _down + [_x]; KJ_deathStats set [1, (KJ_deathStats select 1) + 1] } } } forEach _men
_veh = nearestObjects [_l, ["Car", "Motorcycle"], KJCB_FALL_SHOVE * KJCB_H]
{ if (alive _x) then { _d = [_x, _l] call KJCB_fnD2; _q = 1 - _d / (KJCB_FALL_SHOVE * KJCB_H); if (_q > 0) then { [_x, [5 * _q * (((getPos _x) select 0) - (_l select 0)) / (_d + 1), 5 * _q * (((getPos _x) select 1) - (_l select 1)) / (_d + 1), 4 * _q]] call KJCB_fnThrow } } } forEach _veh
logInfo format ["KJCOMBAT death: down at %1, body middle %2, stats %3 (men killed, men burnt or thrown, vehicles wrecked, statics felled)", time, _l, KJ_deathStats]
~((1 - KJCB_D_IMPACT) * KJCB_D_FALL + 3)

; ---- body ----------------------------------------------------------------------
KJ_deathPhase = "body"
KJ_deathLog = KJ_deathLog + [["body", time]]
KJ_dying = false
; the men thrown down get up again
{ if (alive _x) then { _x setUnitPos "AUTO" } } forEach _down
; men who were running from him stop running
KJ_fearOff = true
_men = nearestObjects [_c, ["Man"], KJCB_RALLY_R * KJCB_H]
_i = 0
{ if ((alive _x) and (_x != player)) then { if (fleeing _x) then { (group _x) allowFleeing 0; _x doWatch _l; _i = _i + 1 } } } forEach _men
logInfo format ["KJCOMBAT death: body at %1, he lies at %2, alive %3, %4 fleeing men rallied, log %5", time, getPos _k, alive _k, _i, KJ_deathLog]
; the last smoke out of the chest thins and stops
_t = time
#cool
~0.5
? isNull _k : exit
_q = 1 - (time - _t) / 60
? _wet : _q = 1 - (time - _t) / 90
? _q <= 0 : exit
? not KJCB_FX : exit
? (random 1) > _q : goto "cool"
_g = 0.08 + random 0.05
; steam where the furnace went into the sea
? _wet : _g = 0.82 + random 0.12
drop ["cl_basic", "", "Billboard", 1, 10 + random 5, [(_l select 0) + 6 - random 12, (_l select 1) + 6 - random 12, KJCB_gz + 3 + random 4], [1 - random 2, 1 - random 2, 1.5 + random 1.5], 0, 1.27, 1, 0.1, [0.08 * KJCB_H, 0.2 * KJCB_H, 0.35 * KJCB_H], [[_g, _g, _g, 0], [_g, _g, _g, 0.5 * _q], [_g, _g, _g, 0.3 * _q], [_g, _g, _g, 0]], [0], 0.5, 0.5, "", ""]
goto "cool"
