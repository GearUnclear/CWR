; ============================================================================
;  kj\roar\presence.sqs  -  Dedushka is near, and you cannot see him yet.
;  Runs for his lifetime.
;
;      [kaiju] exec "kj\roar\presence.sqs"
;
;  Tuning: the marked block at the top of kj\roar\init.sqf.
;
;  Four things tell the player he is close before he is in sight:
;    1. The lights. Street lamps within KJR_FLICKER_R heights of him stutter;
;       within KJR_DARK_R they go out and stay out. At night a hole of
;       darkness walks through the town, and a dead street behind it shows
;       where he has been.
;    2. The birds. When he comes within KJR_BIRD_R heights of the listener
;       the birds nearby go up and fly away from him (birds.sqs), and again
;       every KJR_BIRD_GAP seconds while he is walking in range.
;    3. The radio. Inside KJR_STATIC_R heights the set breaks into static,
;       worse inside KJR_STATIC_NEAR (2D sound, the player's own radio).
;    4. The ground before the sound: that one is in step.sqs.
;  And one thing for when he is on top of you: the furnace. Inside
;  KJR_DRONE_R heights the low drone of his chest is kept playing (an 8 s
;  seamless file, restarted every KJR_DRONE_LEN seconds from the chest).
;
;  Read by others:
;    KJ_presenceLog  [["DRONE" | "DARK" | "FLICKER" | "BIRDS" | "STATIC", time, number], ...]
;    KJ_darkLamps    the lamps he has put out
;    KJ_presenceOn   set false to end this loop
; ============================================================================
_k = _this select 0
? isNil "KJR_ready" : call compile preprocessFile "kj\roar\init.sqf"
? isNil "KJR_sized" : [_k] call KJR_fnSize
? _k getVariable ["kjrPresence", false] : exit
_k setVariable ["kjrPresence", true]
KJ_presenceOn = true
_droneT = -1000
_birdT = -1000
_staticT = time + 3 + random 6
_scanAt = [-100000, -100000]
_wasNear = false
_x0 = 0
_n = 0

#tick
? not KJ_presenceOn : goto "end"
? not alive _k : goto "end"
_kp = getPos _k
_ear = call KJR_fnEar
_d = _ear distance _k
? (count KJ_presenceLog) > 300 : KJ_presenceLog = []

; ---- the furnace ------------------------------------------------------------------
? _d > (KJR_DRONE_R * KJR_H) : goto "lamps"
? time < _droneT : goto "lamps"
_e = 3 call KJR_fnEmitter
_e setPos [_kp select 0, _kp select 1, KJR_CHEST_H * KJR_H]
_e say "KJ_Furnace"
_droneT = time + KJR_DRONE_LEN
KJ_presenceLog = KJ_presenceLog + [["DRONE", time, _d]]

; ---- the lights -------------------------------------------------------------------
#lamps
; the drone's source walks with him
? time < _droneT : (3 call KJR_fnEmitter) setPos [_kp select 0, _kp select 1, KJR_CHEST_H * KJR_H]
; look for lamps again only when he has moved on
_moved = sqrt (((_kp select 0) - (_scanAt select 0)) * ((_kp select 0) - (_scanAt select 0)) + ((_kp select 1) - (_scanAt select 1)) * ((_kp select 1) - (_scanAt select 1)))
? _moved < (KJR_LAMP_SCAN * KJR_H) : goto "lampsDo"
_scanAt = [_kp select 0, _kp select 1]
_n = [_scanAt, (KJR_FLICKER_R + KJR_LAMP_SCAN) * KJR_H] call KJR_fnLampScan
? _n > 0 : logInfo format ["KJROAR presence found %1 more street lamps (%2 known)", _n, count KJR_lamps]
#lampsDo
_dark = 0
_flick = 0
{ if (not (_x in KJ_darkLamps)) then { _x0 = _x distance _k; if (_x0 < (KJR_DARK_R * KJR_H)) then { _x switchLight "OFF"; KJ_darkLamps = KJ_darkLamps + [_x]; _dark = _dark + 1 } else { if (_x0 < (KJR_FLICKER_R * KJR_H)) then { _flick = _flick + 1; if ((random 1) < 0.45) then { _x switchLight "OFF" } else { _x switchLight "AUTO" } } else { if ((lightIsOn _x) == "OFF") then { _x switchLight "AUTO" } } } } } forEach KJR_lamps
? _dark > 0 : KJ_presenceLog = KJ_presenceLog + [["DARK", time, _dark]]
? _dark > 0 : logInfo format ["KJROAR presence %1 lamps went out (%2 dark in all)", _dark, count KJ_darkLamps]
? (_flick > 0) and (not _wasNear) : KJ_presenceLog = KJ_presenceLog + [["FLICKER", time, _flick]]
_wasNear = _flick > 0

; ---- the birds ----------------------------------------------------------------------
? _d > (KJR_BIRD_R * KJR_H) : goto "radio"
? time < _birdT : goto "radio"
? ((speed _k) < 0.5) and (_birdT > -500) : goto "radio"
_birdT = time + KJR_BIRD_GAP
[_k, 0] exec "kj\roar\birds.sqs"

; ---- the radio ----------------------------------------------------------------------
#radio
? _d > (KJR_STATIC_R * KJR_H) : goto "sleep"
? time < _staticT : goto "sleep"
_staticT = time + KJR_STATIC_GAP + random 15
_cls = "KJ_StaticFaint"
? _d < (KJR_STATIC_NEAR * KJR_H) : _cls = "KJ_Static"
playSound _cls
KJ_presenceLog = KJ_presenceLog + [["STATIC", time, _d]]
logInfo format ["KJROAR presence radio %1 at %2 (he is %3 m off)", _cls, time, _d]

#sleep
~KJR_TICK
goto "tick"

#end
_k setVariable ["kjrPresence", false]
exit
