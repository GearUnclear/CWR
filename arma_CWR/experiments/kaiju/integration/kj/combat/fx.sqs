; ============================================================================
;  kj\combat\fx.sqs  -  how his wounds show, without a health bar. Started by
;  kj\combat\start.sqs; runs while that runs.
;
;      [kaiju] exec "kj\combat\fx.sqs"
;
;  By wound stage (KJ_woundStage):
;    1 stung        a thin grey wisp from the chest now and then
;    2 wounded      steady dark smoke out of the furnace and soot hanging in
;                   front of it; it gutters: a flare, then a moment of soot
;    3 badly hurt   heavy black smoke, embers dripping from the chest to the
;                   ground, the furnace gutters often
;    4 dying        the smoke pours, the embers fall in a stream
;  The smoke hangs in front of the furnace, so the glow behind it reads
;  dimmer. On the kaiju binary a small light at the furnace jumps with every
;  gutter, at night, and (engine version 2, the "glow" trait) the furnace
;  painted on his body itself flares and sinks to soot with it: every gutter
;  is published as KJ_gutterAt (its time), which the integrated set's furnace
;  loop reads; with no furnace loop running this script drives the glow of
;  the body itself, lower with every stage.
;  Mending, the smoke thins with the stage.
; ============================================================================
_k = _this select 0
_n = 0
_g = 0
_gutter = 0
_lit = false
_f = [0, 0, 0]
_p = [0, 0, 0]
_s = 0
_v = 0
_sz = 0
_i = 0
_own = true
_gw = 0
_gu = 0

#tick
~0.2
? not KJ_combatOn : goto "end"
? isNull _k : goto "end"
? KJ_dying : goto "end"
? not KJCB_FX : goto "tick"
_s = KJ_woundStage
; the furnace on his body, when nobody else drives it (this feature alone): by stage, sunk after a gutter
_own = true
? not (isNil "KJ_furnaceOn") : if (KJ_furnaceOn) then { _own = false }
? not _own : goto "staged"
_gw = 0.72 * (1 - _s / 6)
? isNil "KJ_gutterAt" : goto "ownset"
_gu = time - KJ_gutterAt
? (_gu >= 0) and (_gu < 0.25) : _gw = _gw * 1.6 + 0.3
? (_gu >= 0.25) and (_gu < 1.5) : _gw = _gw * (0.15 + 0.85 * (_gu - 0.25) / 1.25)
#ownset
[_k, _gw] call KJCB_fnGlow
#staged
? _s < 1 : goto "dark"
? ((call KJCB_fnEye) distance _k) > KJCB_FX_R : goto "tick"
_n = _n + 1
; the furnace now, in the world, height above the ground he stands on
_f = _k call KJCB_fnFurnaceNow
_p = [_k, _f] call KJCB_fnToWorld
_p set [2, (_p select 2) + (_k call KJCB_fnGz)]
; ---- smoke out of the chest: more, bigger and blacker with every stage
? (_s == 1) and ((_n mod 6) != 0) : goto "gutter"
_i = 0
#smoke
_g = 0.4 - 0.09 * _s + random 0.06
_sz = (0.03 + 0.012 * _s) * KJCB_H
_v = 1 + 0.5 * _s
drop ["cl_basic", "", "Billboard", 1, 5 + 1.5 * _s + random 3, [(_p select 0) + 2 - random 4, (_p select 1) + 2 - random 4, (_p select 2) + 1 - random 3], [(_v * sin (getDir _k)) + 0.8 - random 1.6, (_v * cos (getDir _k)) + 0.8 - random 1.6, 1.5 + random 1.5], 0, 1.27, 1, 0.1, [_sz, 2.5 * _sz, 4.5 * _sz], [[_g, _g * 0.95, _g * 0.9, 0], [_g, _g * 0.95, _g * 0.9, 0.25 + 0.14 * _s], [_g, _g, _g, 0.15 + 0.08 * _s], [_g, _g, _g, 0]], [0], 0.5, 0.5, "", ""]
_i = _i + 1
? _i < (_s - 1) : goto "smoke"

; ---- soot hanging right in front of the furnace, so the glow behind it reads dimmer: from stage 2, thicker with every stage
? _s >= 2 : drop ["cl_basic", "", "Billboard", 1, 0.7, [(_p select 0) + 1.2 * sin (getDir _k), (_p select 1) + 1.2 * cos (getDir _k), _p select 2], [0, 0, 0.3], 0, 1.275, 1, 0, [0.11 * KJCB_H, 0.13 * KJCB_H], [[0.04, 0.035, 0.03, 0], [0.04, 0.035, 0.03, 0.1 * _s], [0.04, 0.035, 0.03, 0]], [0], 0.5, 0.1, "", ""]

#gutter
; ---- the furnace gutters: from stage 2, oftener with every stage
? _s < 2 : goto "embers"
? time < _gutter : goto "embers"
_gutter = time + (9 - 2 * _s) * (0.5 + random 1)
KJ_gutterAt = time
_sz = 0.2 * KJCB_H
drop [KJCB_GLOW, "", "Billboard", 1, 0.22, [_p select 0, _p select 1, _p select 2], [0, 0, 0], 0, 1.275, 1, 0, [_sz, 0.3 * _sz], [[1, 0.8, 0.45, 0.85], [1, 0.4, 0.05, 0]], [0], 1, 0, "", ""]
drop ["cl_basic", "", "Billboard", 1, 2.2, [_p select 0, _p select 1, _p select 2], [1.5 * sin (getDir _k), 1.5 * cos (getDir _k), 0.4], 0, 1.275, 1, 0.05, [0.5 * _sz, 1.3 * _sz], [[0.06, 0.05, 0.05, 0], [0.06, 0.05, 0.05, 0.85], [0.06, 0.05, 0.05, 0]], [0], 0.5, 0.2, "", ""]
? KJCB_native : kjLight [_k, "kjcb", _f, [1, 0.5, 0.15], 1.5 + _s]; _lit = true
goto "embers2"

#embers
? KJCB_native and _lit : kjLight [_k, "kjcb", _f, [0, 0, 0], 0]; _lit = false
#embers2
; ---- embers dripping from the chest: from stage 3
? _s < 3 : goto "tick"
? (_s == 3) and ((_n mod 2) != 0) : goto "tick"
drop [KJCB_GLOW, "", "Billboard", 1, 2.6 + random 1, [(_p select 0) + 3 - random 6, (_p select 1) + 3 - random 6, (_p select 2) - 2 - random 4], [1 - random 2, 1 - random 2, -1], 0, 2.6, 1, 0.01, [0.9, 0.3], [[1, 0.75, 0.35, 1], [1, 0.35, 0.05, 0.9], [0.6, 0.1, 0.02, 0]], [0], 0.4, 0.8, "", ""]
goto "tick"

#dark
? KJCB_native and _lit : kjLight [_k, "kjcb", _f, [0, 0, 0], 0]; _lit = false
goto "tick"

#end
? isNull _k : exit
? KJCB_native and _lit : kjLight [_k, "kjcb", _f, [0, 0, 0], 0]
exit
