; ============================================================================
;  kj\roar\turn.sqs  -  a man far off hears the roar and turns toward it.
;
;      [kaiju, unit] exec "kj\roar\turn.sqs"
;
;  Called by roar.sqs for everyone in earshot who neither breaks nor freezes.
;  doWatch alone turns the head and the weapon; whether the body follows is up
;  to the AI's own idea of where it should face. So the body is swung round
;  here, at about 250 degrees a second, and his group's formation direction
;  is set toward the sound so he stays that way. Men who are walking or
;  running somewhere are not touched (only their heads turn).
; ============================================================================
_k = _this select 0
_u = _this select 1
? not alive _u : exit
? (speed _u) > 1 : exit
? (vehicle _u) != _u : exit
_b = (((getPos _k) select 0) - ((getPos _u) select 0)) atan2 (((getPos _k) select 1) - ((getPos _u) select 1))
(group _u) setFormDir _b
_n = 0
#turn
? not alive _u : exit
_diff = _b - (getDir _u)
? _diff > 180 : _diff = _diff - 360
? _diff < -180 : _diff = _diff + 360
? (abs _diff) < 3 : exit
_s = 7
? _diff < 0 : _s = -7
? (abs _diff) < 7 : _s = _diff
_u setDir ((getDir _u) + _s)
_n = _n + 1
? _n > 60 : exit
~0.02
goto "turn"
