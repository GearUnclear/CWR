logInfo format ["KVX guns 0 %1 %2 %3 %4", KJ_crushStats select 0, KJ_crushStats select 2, if (isNil "KJD_force") then { -1 } else { { alive _x } count KJD_force }, if (isNil "KJ_beamWrecks") then { 0 } else { KJ_beamWrecks }]
kvA1 = [kvA1, [0, 0, 20] call kvK, 0.2] call kvMix
kvFv1 call kvLens
triSetView ([kvE1, kvA1] call kvLook)
