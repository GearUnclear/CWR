# Proprietary game data (not part of this GPL source repo, ships separately under APL-SA).
# Brackets are gitignore character-classes, so escape them: \[Classic\] / \[Remaster\].
/ARMA Cold War Assault \[Classic\]/
/Arma Cold War Assault Demo \[Remaster\]/

# Mod test bed (2.2G binary PBOs/textures). Ours to modify since 2026-08-08, but the
# pbo bytes are third-party APL-SA data and never belong in this GPL source repo; the
# tracked artifact is the regeneration script (arma_CWR/tools/lobo/fix-lobo-scope.ps1).
/@LoBo/

# Stray window grabs. Screen-capture tools name a file after the process that owned the
# window, so a captured game window lands as PoseidonGame_<random>.png wherever the tool
# was pointed - usually the repo root. Deliberate captures go to arma_CWR/tmp/ (already
# ignored by arma_CWR/.gitignore) or, once curated and web-sized, to site/assets/img/.
PoseidonGame_*.png
PoseidonGameDemo_*.png

# API keys / secrets, at any depth
/.env
**/.env
**/.trident.env

# Game data and archive formats: Bohemia and @LoBo data are APL-SA and never belong
# here. The pre-commit guard (.githooks/check_no_game_data.py) also blocks them;
# synthetic test fixtures that need one of these are tracked already or force-added.
*.pbo
*.paa
*.pac
*.p3d
*.wrp
*.wss
*.rtm
*.fxy
*.ebo
# Archives and video: release bundles and recordings are built, not committed.
*.7z
*.rar
*.mp4
*.mkv
# Stray images dropped at the repo root (site images live in site/assets/img/).
/*.png
/*.jpg

# Local scratch output and temporary worktrees.
/tmp/

# Generated roadmap outputs (source of truth is roadmap/roadmap.yaml)
/roadmap/index.html
/roadmap/status.json
/roadmap/gh-issues-cache.json
/roadmap/__pycache__/
