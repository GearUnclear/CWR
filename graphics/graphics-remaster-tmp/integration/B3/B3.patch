+    CHECK(frame.find("SetSlot(LitConst::Sun, key.radiance.r, key.radiance.g, key.radiance.b, key.elevationDeg);") !=
+          std::string::npos);
+    CHECK(frame.find("std::atan2(key.toward[0], key.toward[2])") != std::string::npos);
