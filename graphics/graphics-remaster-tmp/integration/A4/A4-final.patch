diff --git a/arma_CWR/engine/Poseidon/Graphics/Core/PerfCounters.cpp b/arma_CWR/engine/Poseidon/Graphics/Core/PerfCounters.cpp
new file mode 100644
index 0000000..daaf497
--- /dev/null
+++ b/arma_CWR/engine/Poseidon/Graphics/Core/PerfCounters.cpp
@@ -0,0 +1,92 @@
+#include <Poseidon/Graphics/Core/PerfCounters.hpp>
+
+#include <cstdio>
+
+namespace Poseidon::perf
+{
+
+namespace
+{
+// Every FrameCounters member, int or float, in declaration order.
+struct Field
+{
+    int FrameCounters::* i;
+    float FrameCounters::* f;
+};
+using FC = FrameCounters;
+constexpr Field kFieldList[] = {
+    {&FC::lightSlots, nullptr},  {&FC::activeLights, nullptr}, {&FC::opaqueObjects, nullptr},
+    {&FC::runs, nullptr},        {&FC::runObjects, nullptr},   {&FC::litObjects, nullptr},
+    {&FC::hillRan, nullptr},     {&FC::hillIdle, nullptr},     {&FC::hillTested, nullptr},
+    {&FC::hillHidden, nullptr},  {&FC::hillKept, nullptr},     {&FC::hillBuilds, nullptr},
+    {&FC::hillWedges, nullptr},  {nullptr, &FC::hillMs},       {nullptr, &FC::lodMs},
+    {nullptr, &FC::occlusionMs}, {&FC::litUploads, nullptr},   {&FC::litSkips, nullptr},
+    {&FC::litBytes, nullptr},    {&FC::vsUploads, nullptr},    {&FC::vsSkips, nullptr},
+    {&FC::vsBytes, nullptr},
+};
+// The list holds every member (all are 4 bytes), and the header sized the sums
+// for it.
+constexpr int kListed = static_cast<int>(sizeof(kFieldList) / sizeof(kFieldList[0]));
+static_assert(kListed == Counters::kFields, "PerfCounters: one sum per listed field");
+static_assert(sizeof(FrameCounters) == static_cast<size_t>(kListed) * 4, "PerfCounters: list every member");
+
+double Value(const FrameCounters& c, const Field& f)
+{
+    return f.i ? static_cast<double>(c.*(f.i)) : static_cast<double>(c.*(f.f));
+}
+} // namespace
+
+Counters& GPerfCounters()
+{
+    static Counters s_counters;
+    return s_counters;
+}
+
+void Counters::EndFrame()
+{
+    for (int i = 0; i < kListed; ++i)
+        _sum[i] += Value(_frame, kFieldList[i]);
+    ++_frames;
+    _last = _frame;
+    _frame = FrameCounters();
+}
+
+void Counters::ResetWindow()
+{
+    for (double& s : _sum)
+        s = 0.0;
+    _frames = 0;
+}
+
+std::string Counters::Summary() const
+{
+    const double n = _frames > 0 ? static_cast<double>(_frames) : 1.0;
+    auto avg = [&](int FrameCounters::* m)
+    {
+        for (int i = 0; i < kListed; ++i)
+            if (kFieldList[i].i == m)
+                return _sum[i] / n;
+        return 0.0;
+    };
+    auto avgf = [&](float FrameCounters::* m)
+    {
+        for (int i = 0; i < kListed; ++i)
+            if (kFieldList[i].f == m)
+                return _sum[i] / n;
+        return 0.0;
+    };
+    char buf[512];
+    std::snprintf(buf, sizeof(buf),
+                  "objs opaque=%.0f runs=%.0f runobj=%.0f litobj=%.0f lights=%.0f/%.0f | hill ran=%.2f idle=%.2f "
+                  "tested=%.0f hidden=%.0f kept=%.1f builds=%.2f wedges=%.0f hillcpu=%.3f | prep lod=%.3f occ=%.3f | "
+                  "ubo lit=%.0f/%.0f litKB=%.1f vs=%.0f/%.0f vsKB=%.1f",
+                  avg(&FC::opaqueObjects), avg(&FC::runs), avg(&FC::runObjects), avg(&FC::litObjects),
+                  avg(&FC::lightSlots), avg(&FC::activeLights), avg(&FC::hillRan), avg(&FC::hillIdle),
+                  avg(&FC::hillTested), avg(&FC::hillHidden), avg(&FC::hillKept), avg(&FC::hillBuilds),
+                  avg(&FC::hillWedges), avgf(&FC::hillMs), avgf(&FC::lodMs), avgf(&FC::occlusionMs),
+                  avg(&FC::litUploads), avg(&FC::litSkips), avg(&FC::litBytes) / 1024.0, avg(&FC::vsUploads),
+                  avg(&FC::vsSkips), avg(&FC::vsBytes) / 1024.0);
+    return buf;
+}
+
+} // namespace Poseidon::perf
diff --git a/arma_CWR/engine/Poseidon/Graphics/Core/PerfCounters.hpp b/arma_CWR/engine/Poseidon/Graphics/Core/PerfCounters.hpp
new file mode 100644
index 0000000..c23b1f7
--- /dev/null
+++ b/arma_CWR/engine/Poseidon/Graphics/Core/PerfCounters.hpp
@@ -0,0 +1,78 @@
+#pragma once
+
+#include <string>
+
+// Frame-cost counters of the object pass and the constant uploads (plan
+// section 5 A4): how many objects the instanced runs grouped, how many the
+// hill cull hid, what the horizon table cost, how many uniform-buffer uploads
+// the mirrors skipped. The scene and the GL33 backend count into the frame
+// being drawn; World::Simulate closes the frame next to the frame profiler.
+// triPerfStats prints the averages over the profiler's window, so they cover
+// the same frames as its CPU phases (triPerfReset restarts both). Pure
+// bookkeeping, no engine state.
+
+namespace Poseidon::perf
+{
+
+struct FrameCounters
+{
+    // Scene::DrawObjectsAndShadowsPass1
+    int lightSlots = 0;    // Scene::NLights: light slots (a lamp that was ever on keeps one)
+    int activeLights = 0;  // lights on this frame
+    int opaqueObjects = 0; // objects through the opaque run loop
+    int runs = 0;          // instanced runs drawn (four objects or more)
+    int runObjects = 0;    // objects drawn in those runs
+    int litObjects = 0;    // objects kept out of runs because their own light list is not empty
+    // Hill culling (TerrainOcclusion.hpp)
+    int hillRan = 0;          // 1 when the cull ran this frame
+    int hillIdle = 0;         // 1 when the governor held it idle
+    int hillTested = 0;       // objects far enough to test
+    int hillHidden = 0;       // of those, hidden behind the terrain
+    int hillKept = 0;         // of those, drawn anyway: the last draw before the shadow-map pass
+    int hillBuilds = 0;       // horizon tables started (the eye moved)
+    int hillWedges = 0;       // wedges built on demand
+    float hillMs = 0.0f;      // CPU: table and tests
+    float lodMs = 0.0f;       // CPU: Scene::AdjustComplexity (LOD selection)
+    float occlusionMs = 0.0f; // CPU: the object occlusion pass
+    // Uniform-buffer uploads (EngineGL33: LitConstants and VSConstants)
+    int litUploads = 0;
+    int litSkips = 0; // flushes the mirror found unchanged
+    int litBytes = 0;
+    int vsUploads = 0;
+    int vsSkips = 0;
+    int vsBytes = 0;
+};
+
+class Counters
+{
+  public:
+    // The frame being drawn: the scene and the backend add to it.
+    FrameCounters& Frame() { return _frame; }
+    // The last closed frame.
+    const FrameCounters& Last() const { return _last; }
+    // Closes the frame: it becomes Last() and joins the window's sums.
+    void EndFrame();
+    // Starts a new window (triPerfReset).
+    void ResetWindow();
+    int WindowFrames() const { return _frames; }
+    // Per-frame averages over the window, for triPerfStats:
+    // "objs opaque=<n> runs=<n> runobj=<n> litobj=<n> lights=<slots>/<on> | hill ran=<share> idle=<share>
+    //  tested=<n> hidden=<n> kept=<n> builds=<n> wedges=<n> hillcpu=<ms> | prep lod=<ms> occ=<ms> |
+    //  ubo lit=<uploads>/<skips> litKB=<kB> vs=<uploads>/<skips> vsKB=<kB>"
+    std::string Summary() const;
+
+    // One per FrameCounters member (PerfCounters.cpp lists them; a static_assert
+    // there keeps the count).
+    static constexpr int kFields = 22;
+
+  private:
+    FrameCounters _frame;
+    FrameCounters _last;
+    // Sums over the window, in double so a long window does not round.
+    double _sum[kFields] = {};
+    int _frames = 0;
+};
+
+Counters& GPerfCounters();
+
+} // namespace Poseidon::perf
diff --git a/arma_CWR/engine/Poseidon/Graphics/Core/UboMirror.hpp b/arma_CWR/engine/Poseidon/Graphics/Core/UboMirror.hpp
new file mode 100644
index 0000000..ee44996
--- /dev/null
+++ b/arma_CWR/engine/Poseidon/Graphics/Core/UboMirror.hpp
@@ -0,0 +1,91 @@
+#pragma once
+
+#include <cstring>
+#include <vector>
+
+// What a uniform buffer holds, kept on the CPU (plan section 5 A4).
+//
+// The GL33 backend keeps a CPU copy of each constant block and used to send
+// the whole block on every flush: the 928-byte LitConstants block once per
+// draw (a material and its lights), the 1,120-byte VSConstants block whenever
+// a material or the view changed. With thousands of draws a frame that was
+// about a megabyte of uploads, almost all of it unchanged. A mirror records
+// what the buffer holds after every upload, so a flush can send only the
+// slots that changed (or nothing).
+//
+// Every upload to the buffer must go through Store (whole or partial), and a
+// newly created buffer starts unknown (Reset): then the first flush sends the
+// whole block. Slots are vec4 (four floats). Pure, no GL.
+
+namespace Poseidon::gpu
+{
+
+class UboMirror
+{
+  public:
+    // A new buffer of `slots` vec4: its contents are not known yet.
+    void Reset(int slots)
+    {
+        _slots = slots;
+        _data.assign(static_cast<size_t>(slots) * 4, 0.0f);
+        _known = false;
+    }
+    int Slots() const { return _slots; }
+    bool Known() const { return _known; }
+
+    // The buffer now holds `count` slots of `src` from slot `first` on (an
+    // upload just made, partial or whole). Storing the whole block makes the
+    // mirror known.
+    void Store(const float* src, int first, int count)
+    {
+        if (first < 0 || count <= 0 || first + count > _slots)
+            return;
+        std::memcpy(&_data[static_cast<size_t>(first) * 4], src + static_cast<size_t>(first) * 4,
+                    static_cast<size_t>(count) * 16);
+        if (first == 0 && count == _slots)
+            _known = true;
+    }
+
+    // What a flush of `src` (the whole CPU block) must upload, as one slot
+    // range. With `dedupe` off, or while the buffer's contents are unknown,
+    // the whole block. With it on, the range from the first to the last slot
+    // that differs from the buffer, skipping slots in [ignoreFirst,
+    // ignoreFirst + ignoreCount) (slots no shader reads); false when nothing
+    // differs.
+    bool Plan(const float* src, bool dedupe, int& first, int& count, int ignoreFirst = 0, int ignoreCount = 0) const
+    {
+        if (!dedupe || !_known)
+        {
+            first = 0;
+            count = _slots;
+            return _slots > 0;
+        }
+        int lo = -1, hi = -1;
+        for (int i = 0; i < _slots; ++i)
+        {
+            if (i >= ignoreFirst && i < ignoreFirst + ignoreCount)
+                continue;
+            if (std::memcmp(&_data[static_cast<size_t>(i) * 4], src + static_cast<size_t>(i) * 4, 16) != 0)
+            {
+                if (lo < 0)
+                    lo = i;
+                hi = i;
+            }
+        }
+        if (lo < 0)
+            return false;
+        first = lo;
+        count = hi - lo + 1;
+        return true;
+    }
+
+    // The mirror's copy of one slot (tests).
+    const float* SlotData(int slot) const { return &_data[static_cast<size_t>(slot) * 4]; }
+
+  private:
+    int _slots = 0;
+    bool _known = false;
+    std::vector<float> _data;
+};
+
+} // namespace Poseidon::gpu
diff --git a/arma_CWR/engine/Poseidon/World/Scene/TerrainOcclusion.cpp b/arma_CWR/engine/Poseidon/World/Scene/TerrainOcclusion.cpp
new file mode 100644
index 0000000..297459c
--- /dev/null
+++ b/arma_CWR/engine/Poseidon/World/Scene/TerrainOcclusion.cpp
@@ -0,0 +1,272 @@
+#include <Poseidon/World/Scene/TerrainOcclusion.hpp>
+
+#include <algorithm>
+#include <cmath>
+
+namespace Poseidon::TerrainOcclusion
+{
+
+namespace
+{
+constexpr float kTwoPi = 6.2831853f;
+// Rounding slack on a sphere's angular span (radians), so a sphere that ends
+// exactly on a wedge edge also asks the wedge beyond it.
+constexpr float kSpanSlack = 1e-4f;
+} // namespace
+
+// ---- HeightGrid ----
+
+void HeightGrid::Clear()
+{
+    _size = 0;
+    _v.clear();
+}
+
+void HeightGrid::BuildFromVertices(int size, float cellSize, float outside, std::vector<float> vertices)
+{
+    Clear();
+    if (size < 2 || !(cellSize > 0.0f) || vertices.size() != static_cast<size_t>(size) * size)
+        return;
+    _size = size;
+    _cellSize = cellSize;
+    _invCellSize = 1.0f / cellSize;
+    _outside = outside;
+    _v = std::move(vertices);
+}
+
+float HeightGrid::SurfaceCells(float xr, float zr) const
+{
+    // Landscape::SurfaceY's triangles, over the vertices as the renderer
+    // draws them (an off-grid vertex at the outside height).
+    const int xi = static_cast<int>(std::floor(xr));
+    const int zi = static_cast<int>(std::floor(zr));
+    const float xIn = xr - static_cast<float>(xi);
+    const float zIn = zr - static_cast<float>(zi);
+    const float y00 = Vertex(xi, zi);
+    const float y01 = Vertex(xi + 1, zi);
+    const float y10 = Vertex(xi, zi + 1);
+    const float y11 = Vertex(xi + 1, zi + 1);
+    if (xIn <= 1.0f - zIn)
+        return y00 + (y10 - y00) * zIn + (y01 - y00) * xIn;
+    return y10 + (y01 - y11) - (y10 - y11) * xIn - (y01 - y11) * zIn;
+}
+
+float HeightGrid::SegmentMin(float x0, float z0, float x1, float z1) const
+{
+    if (_size <= 0)
+        return -1e30f;
+    const float ax = x0 * _invCellSize, az = z0 * _invCellSize;
+    const float bx = x1 * _invCellSize, bz = z1 * _invCellSize;
+    float m = std::min(SurfaceCells(ax, az), SurfaceCells(bx, bz));
+    // The surface is linear inside each triangle, so along the segment its
+    // corners are where the segment crosses a line x = i, z = j or a cell
+    // diagonal x + z = k (cell units): the lowest point is one of those or an
+    // end. A segment many cells long (never a chord of the table) falls back
+    // to the lowest vertex of the cells it may touch.
+    constexpr int kMaxCrossings = 256;
+    if (std::fabs(bx - ax) + std::fabs(bz - az) > kMaxCrossings / 2)
+    {
+        const int gx0 = static_cast<int>(std::floor(std::min(ax, bx))),
+                  gx1 = static_cast<int>(std::floor(std::max(ax, bx))) + 1;
+        const int gz0 = static_cast<int>(std::floor(std::min(az, bz))),
+                  gz1 = static_cast<int>(std::floor(std::max(az, bz))) + 1;
+        for (int z = gz0; z <= gz1; ++z)
+            for (int x = gx0; x <= gx1; ++x)
+                m = std::min(m, Vertex(x, z));
+        return m;
+    }
+    auto crossings = [&](float a, float b)
+    {
+        if (a == b)
+            return;
+        const float lo = std::min(a, b), hi = std::max(a, b);
+        const float inv = 1.0f / (b - a);
+        for (float k = std::floor(lo) + 1.0f; k <= hi; k += 1.0f)
+        {
+            const float t = (k - a) * inv;
+            m = std::min(m, SurfaceCells(ax + (bx - ax) * t, az + (bz - az) * t));
+        }
+    };
+    crossings(ax, bx);
+    crossings(az, bz);
+    crossings(ax + az, bx + bz);
+    return m;
+}
+
+// ---- HorizonTable ----
+
+void HorizonTable::Build(const HeightGrid& terrain, float eyeX, float eyeY, float eyeZ, float range,
+                         const Params& params)
+{
+    _valid = false;
+    _terrain = &terrain;
+    _p = params;
+    if (!terrain.Valid() || _p.rays < 8 || !(range > 0.0f) || !(_p.nearStep > 0.0f) || !(_p.midStep > 0.0f) ||
+        !(_p.farStep > 0.0f))
+        return;
+    _ex = eyeX;
+    _ey = eyeY;
+    _ez = eyeZ;
+    _range = range;
+    _wedge = kTwoPi / static_cast<float>(_p.rays);
+    _cosHalf = std::cos(0.5f * _wedge);
+
+    _dist.clear();
+    for (float d = _p.nearStep; d <= range;)
+    {
+        _dist.push_back(d);
+        d += d < _p.nearEnd ? _p.nearStep : (d < _p.midEnd ? _p.midStep : _p.farStep);
+    }
+    if (_sin.size() != static_cast<size_t>(_p.rays) + 1)
+    {
+        _sin.resize(static_cast<size_t>(_p.rays) + 1);
+        _cos.resize(static_cast<size_t>(_p.rays) + 1);
+        for (int b = 0; b <= _p.rays; ++b)
+        {
+            const float a = static_cast<float>(b) * _wedge;
+            _sin[static_cast<size_t>(b)] = std::sin(a);
+            _cos[static_cast<size_t>(b)] = std::cos(a);
+        }
+    }
+    _slope.resize(static_cast<size_t>(_p.rays) * _dist.size());
+    if (_gen.size() != static_cast<size_t>(_p.rays))
+    {
+        _gen.assign(static_cast<size_t>(_p.rays), 0u);
+        _buildGen = 0;
+    }
+    if (++_buildGen == 0)
+    {
+        // The counter wrapped: forget every wedge.
+        std::fill(_gen.begin(), _gen.end(), 0u);
+        _buildGen = 1;
+    }
+    _wedgesBuilt = 0;
+    _valid = !_dist.empty();
+}
+
+bool HorizonTable::Matches(float eyeX, float eyeY, float eyeZ, float range) const
+{
+    return _valid && eyeX == _ex && eyeY == _ey && eyeZ == _ez && range == _range;
+}
+
+void HorizonTable::BuildWedge(int b)
+{
+    const size_t k = _dist.size();
+    float* row = &_slope[static_cast<size_t>(b) * k];
+    const float s0 = _sin[static_cast<size_t>(b)], c0 = _cos[static_cast<size_t>(b)];
+    const float s1 = _sin[static_cast<size_t>(b) + 1], c1 = _cos[static_cast<size_t>(b) + 1];
+    float steepest = -1e30f;
+    for (size_t j = 0; j < k; ++j)
+    {
+        const float d = _dist[j];
+        // The chord between the wedge's edge rays at distance d.
+        const float ax = _ex + d * s0, az = _ez + d * c0;
+        const float bx = _ex + d * s1, bz = _ez + d * c1;
+        const float low = _terrain->SegmentMin(ax, az, bx, bz) - _p.terrainMargin;
+        // Sight lines cross the chord between d cos(half wedge) and d: the
+        // slope the chord blocks for all of them.
+        const float rise = low - _ey;
+        const float slope = rise >= 0.0f ? rise / d : rise / (d * _cosHalf);
+        steepest = std::max(steepest, slope);
+        row[j] = steepest;
+    }
+    _gen[static_cast<size_t>(b)] = _buildGen;
+    ++_wedgesBuilt;
+}
+
+Result HorizonTable::Test(float cx, float cy, float cz, float radius)
+{
+    if (!_valid)
+        return Result::NotTested;
+    const float r = radius * _p.radiusScale + _p.radiusMargin;
+    const float dx = cx - _ex, dz = cz - _ez;
+    const float dc = std::sqrt(dx * dx + dz * dz);
+    const float nearD = dc - r;
+    if (!(nearD >= _p.minTestDistance))
+        return Result::NotTested;
+    // The last chord wholly in front of the sphere's nearest point.
+    const auto it = std::upper_bound(_dist.begin(), _dist.end(), nearD);
+    if (it == _dist.begin())
+        return Result::Visible;
+    const size_t k = static_cast<size_t>(it - _dist.begin()) - 1;
+    // The steepest slope from the eye to any point of the sphere: its top over
+    // the nearest distance when the top is above the eye, over the farthest
+    // when below.
+    const float top = cy + r - _ey;
+    const float objSlope = top >= 0.0f ? top / nearD : top / (dc + r);
+    float azimuth = std::atan2(dx, dz);
+    if (azimuth < 0.0f)
+        azimuth += kTwoPi;
+    const float half = std::asin(std::min(1.0f, r / dc)) + kSpanSlack;
+    const float inv = 1.0f / _wedge;
+    const int b0 = static_cast<int>(std::floor((azimuth - half) * inv));
+    const int b1 = static_cast<int>(std::floor((azimuth + half) * inv));
+    if (b1 - b0 + 1 >= _p.rays)
+        return Result::Visible;
+    const size_t chords = _dist.size();
+    for (int b = b0; b <= b1; ++b)
+    {
+        const int w = ((b % _p.rays) + _p.rays) % _p.rays;
+        if (_gen[static_cast<size_t>(w)] != _buildGen)
+            BuildWedge(w);
+        if (!(_slope[static_cast<size_t>(w) * chords + k] > objSlope))
+            return Result::Visible;
+    }
+    return Result::Hidden;
+}
+
+// ---- CullGovernor ----
+
+void CullGovernor::Reset()
+{
+    *this = CullGovernor();
+}
+
+bool CullGovernor::ShouldRun()
+{
+    if (!_idle)
+        return true;
+    if (++_framesIdle >= kWindow)
+    {
+        _framesIdle = 0;
+        return true; // a probe
+    }
+    return false;
+}
+
+void CullGovernor::Report(int tested, int hidden)
+{
+    if (_idle)
+    {
+        // A probe: a view worth culling starts the cull again.
+        if (tested >= kMinTested && static_cast<float>(hidden) >= kMinShare * static_cast<float>(tested))
+        {
+            _idle = false;
+            _reports = 0;
+            _next = 0;
+        }
+        return;
+    }
+    _tested[_next] = tested;
+    _hidden[_next] = hidden;
+    _next = (_next + 1) % kWindow;
+    if (_reports < kWindow)
+        ++_reports;
+    if (_reports < kWindow)
+        return;
+    long long sumTested = 0, sumHidden = 0;
+    for (int i = 0; i < kWindow; ++i)
+    {
+        sumTested += _tested[i];
+        sumHidden += _hidden[i];
+    }
+    const bool crowded = sumTested >= static_cast<long long>(kMinTested) * kWindow;
+    const bool pays = static_cast<float>(sumHidden) >= kMinShare * static_cast<float>(sumTested);
+    if (!crowded || !pays)
+    {
+        _idle = true;
+        _framesIdle = 0;
+    }
+}
+
+} // namespace Poseidon::TerrainOcclusion
diff --git a/arma_CWR/engine/Poseidon/World/Scene/TerrainOcclusion.hpp b/arma_CWR/engine/Poseidon/World/Scene/TerrainOcclusion.hpp
new file mode 100644
index 0000000..e1f3ca6
--- /dev/null
+++ b/arma_CWR/engine/Poseidon/World/Scene/TerrainOcclusion.hpp
@@ -0,0 +1,181 @@
+#pragma once
+
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+// Hill culling: objects that a ridge hides from the camera are not drawn.
+// Pure, no engine state; Scene::DrawObjectsAndShadowsPass1 builds the table
+// from the landscape and asks it about every queued object (the hillCull
+// feature switch, plan section 5 A4).
+//
+// The test is conservative by construction: an object is reported hidden only
+// when the terrain as the renderer draws it blocks every sight line from the
+// eye to every point of the object's (enlarged) bounding sphere.
+//
+//   - The terrain is a triangulated height grid (HeightGrid: the vertices of
+//     Landscape::ClippedData, split into triangles as Landscape::SurfaceY and
+//     the terrain segments split them, drawn at full detail: LandCache asks
+//     for segment LOD 0). Along a straight segment that surface is piecewise
+//     linear, with its corners where the segment crosses a grid line or a
+//     cell diagonal, so its lowest point is the lowest of those crossings and
+//     the two ends (HeightGrid::SegmentMin, exact).
+//   - From the eye, `rays` azimuth wedges cover the circle. In plan view a
+//     sight line keeps its azimuth, so every sight line inside wedge b crosses
+//     the chord that joins the wedge's two edge rays at distance d (at a
+//     distance between d cos(half wedge) and d). The lowest terrain along that
+//     chord blocks every such sight line that passes below it; the table
+//     keeps, per wedge and chord, the steepest such blocking slope met so far
+//     (a running maximum).
+//   - An object is hidden when, in every wedge its sphere spans, a chord in
+//     front of the sphere's nearest point blocks a slope steeper than the
+//     steepest one from the eye to any point of the sphere.
+//
+// A notch between two rays cannot hide anything: the chord takes the lowest
+// terrain across the whole width of the wedge, not the terrain under one ray. The prototype (research
+// perf track) marched single rays and compared the sphere's top over its
+// near-edge distance, which let narrow notches and objects below the eye
+// through; both are cases in test_terrain_occlusion.cpp.
+
+namespace Poseidon::TerrainOcclusion
+{
+
+struct Params
+{
+    int rays = 512; // azimuth wedges (0.70 degrees each)
+    // Chord distances: nearStep apart up to nearEnd, then midStep up to midEnd,
+    // then farStep up to the range.
+    float nearStep = 25.0f;
+    float nearEnd = 500.0f;
+    float midStep = 50.0f;
+    float midEnd = 1500.0f;
+    float farStep = 100.0f;
+    // Objects whose (enlarged) sphere comes closer than this are never hidden.
+    float minTestDistance = 75.0f;
+    // The sphere tested is the object's bounding sphere times radiusScale plus
+    // radiusMargin metres (animated parts, proxies, rounding).
+    float radiusScale = 1.25f;
+    float radiusMargin = 1.0f;
+    // Metres taken off every terrain bound (depth precision at a ridge line).
+    float terrainMargin = 0.5f;
+};
+
+// The terrain surface as the renderer draws it: a height grid split into
+// triangles along the (x + 1, z)-(x, z + 1) diagonal of every cell.
+class HeightGrid
+{
+  public:
+    // `size` vertices per side, `cellSize` metres apart; heightAt(x, z) is the
+    // height of vertex (x, z) for 0 <= x, z < size. Vertices outside the grid
+    // sit at `outside` (the engine's YOutsideMap), as the renderer draws them.
+    template <class HeightAt>
+    void Build(int size, float cellSize, float outside, HeightAt&& heightAt)
+    {
+        std::vector<float> v(static_cast<size_t>(size) * size);
+        for (int z = 0; z < size; ++z)
+            for (int x = 0; x < size; ++x)
+                v[static_cast<size_t>(z) * size + x] = heightAt(x, z);
+        BuildFromVertices(size, cellSize, outside, std::move(v));
+    }
+    void BuildFromVertices(int size, float cellSize, float outside, std::vector<float> vertices);
+    void Clear();
+    bool Valid() const { return _size > 0; }
+    int Size() const { return _size; }
+    float CellSize() const { return _cellSize; }
+
+    float Vertex(int x, int z) const
+    {
+        if (x < 0 || z < 0 || x >= _size || z >= _size)
+            return _outside;
+        return _v[static_cast<size_t>(z) * _size + x];
+    }
+    // The drawn surface at (x, z) metres.
+    float SurfaceY(float x, float z) const { return SurfaceCells(x * _invCellSize, z * _invCellSize); }
+    // The lowest point of the drawn surface along the segment from (x0, z0)
+    // to (x1, z1), metres.
+    float SegmentMin(float x0, float z0, float x1, float z1) const;
+
+  private:
+    float SurfaceCells(float xr, float zr) const; // position in cells
+
+    int _size = 0;
+    float _cellSize = 0.0f;
+    float _invCellSize = 0.0f;
+    float _outside = 0.0f;
+    std::vector<float> _v;
+};
+
+enum class Result : std::uint8_t
+{
+    NotTested, // too close to the eye, or no table
+    Visible,
+    Hidden,
+};
+
+// The horizon from one eye: per wedge and chord, the steepest slope the
+// terrain blocks so far. Wedges are built when an object first asks about
+// them, so a rebuild costs only the wedges in view.
+class HorizonTable
+{
+  public:
+    void Build(const HeightGrid& terrain, float eyeX, float eyeY, float eyeZ, float range, const Params& params);
+    void Invalidate() { _valid = false; }
+    bool Valid() const { return _valid; }
+    // The table was built for exactly this eye and range.
+    bool Matches(float eyeX, float eyeY, float eyeZ, float range) const;
+
+    // Is the sphere (centre, radius: the object's bounding sphere; the
+    // margins of Params are added here) hidden by the terrain?
+    Result Test(float cx, float cy, float cz, float radius);
+
+    int Chords() const { return static_cast<int>(_dist.size()); }
+    float ChordDistance(int k) const { return _dist[static_cast<size_t>(k)]; }
+    int WedgesBuilt() const { return _wedgesBuilt; }
+    const Params& GetParams() const { return _p; }
+
+  private:
+    void BuildWedge(int b);
+
+    const HeightGrid* _terrain = nullptr;
+    Params _p;
+    bool _valid = false;
+    float _ex = 0.0f, _ey = 0.0f, _ez = 0.0f, _range = 0.0f;
+    float _wedge = 0.0f;             // wedge angle, radians
+    float _cosHalf = 1.0f;           // cos(wedge / 2)
+    std::vector<float> _dist;        // chord distances, ascending
+    std::vector<float> _sin, _cos;   // edge ray b (0..rays): sin and cos of b * wedge
+    std::vector<float> _slope;       // [b * chords + k]: steepest blocked slope over chords 0..k
+    std::vector<std::uint32_t> _gen; // wedge b is built when _gen[b] == _buildGen
+    std::uint32_t _buildGen = 0;
+    int _wedgesBuilt = 0;
+};
+
+// The adaptive rule: hill culling pays for itself only where hills hide a
+// good share of a crowded view. After a full window of frames that tested
+// fewer than kMinTested objects on average or hid less than kMinShare of
+// them, the cull idles and runs once every kWindow frames as a probe; a probe
+// that finds a view worth culling starts it again.
+class CullGovernor
+{
+  public:
+    static constexpr int kWindow = 30;
+    static constexpr int kMinTested = 200;
+    static constexpr float kMinShare = 0.10f;
+
+    // Called once per frame: run the cull this frame?
+    bool ShouldRun();
+    // The counts of a frame that ran.
+    void Report(int tested, int hidden);
+    void Reset();
+    bool Idle() const { return _idle; }
+
+  private:
+    bool _idle = false;
+    int _framesIdle = 0;
+    int _reports = 0;
+    int _next = 0;
+    int _tested[kWindow] = {};
+    int _hidden[kWindow] = {};
+};
+
+} // namespace Poseidon::TerrainOcclusion
