+    vec3 nf = n;
+    if (pud.x > 0.0) {
+        // A puddle is level; rain rings break it while it rains near the eye.
+        nf = vec3(0.0, 1.0, 0.0);
+        float rain = clamp(litWeather.y, 0.0, 1.0);
