+float CombatNight(float classicNight, bool photoCamera, float cameraNight)
+{
+    const float classic = Clamp(classicNight, 0.0f, 1.0f);
+    return photoCamera ? std::min(classic, Clamp(cameraNight, 0.0f, 1.0f)) : classic;
