+    const float charge = std::max(indirectHit, 0.0f) * std::max(indirectHitRange, 0.0f);
+    const float size = kExplosionRefSize * std::cbrt(charge / kExplosionRefCharge);
+    return Clamp(size, kExplosionMinSize, kExplosionMaxSize);
+}
+
+float ExplosionFlashSeconds(float size)
+{
+    return kExplosionFlashPerSize * Clamp(size, kExplosionMinSize, 1.5f);
+}
+
+float FireballCoolingRate(float flashSeconds)
+{
+    return -(kFireballBirthK - kFireballFlashEndK) / std::max(flashSeconds, 0.005f);
