+TEST_CASE("Combat lights: explosion stages last as long as their physics, in simulation time",
+          "[CombatLights][remaster]")
+{
+    // Sized by the charge's cube root (indirectHit x indirectHitRange), not by
+    // the direct hit: the 120 mm HE shell is the reference, the HEAT round
+    // (its 700 hit is penetration) and the hand grenade are smaller.
+    const float he = ExplosionVisualSize(150.0f, 8.0f);
+    const float heat = ExplosionVisualSize(300.0f, 1.0f);
+    const float grenade = ExplosionVisualSize(18.0f, 7.0f);
+    CHECK(he == Approx(kExplosionRefSize));
+    CHECK(heat < 0.7f * he);
+    CHECK(grenade < heat);
+    CHECK(grenade >= kExplosionMinSize);
+    CHECK(ExplosionVisualSize(1.0e6f, 50.0f) == Approx(kExplosionMaxSize));
+    // An eighth of the charge, half the size (cube root).
+    CHECK(ExplosionVisualSize(150.0f / 8.0f, 8.0f) == Approx(0.5f * he).epsilon(0.01));
+    // The detonation flash: tens of milliseconds, growing with the size; a
+    // heavy shell's within two frames at 30 fps, a grenade's within one.
+    CHECK(ExplosionFlashSeconds(he) > 0.04f);
+    CHECK(ExplosionFlashSeconds(he) <= 2.0f / 30.0f + 1e-4f);
+    CHECK(ExplosionFlashSeconds(grenade) <= 1.0f / 30.0f);
+    CHECK(ExplosionFlashSeconds(heat) < ExplosionFlashSeconds(he));
+    // Its puffs cool from birth past glowing within the flash: their glow is
+    // under a tenth of a 2200 K puff's at its end (it was 0.2 s at -4000 K/s).
+    const float rate = FireballCoolingRate(ExplosionFlashSeconds(he));
+    CHECK(rate < -4000.0f);
+    const float endT = kFireballBirthK + rate * ExplosionFlashSeconds(he);
+    CHECK(endT == Approx(kFireballFlashEndK));
+    float albedo[3], hot[3], cooled[3];
+    REQUIRE(FireballPuff(kFireballRefK, 2200.0f, albedo, hot));
+    REQUIRE(FireballPuff(endT, 2200.0f, albedo, cooled));
+    CHECK(cooled[0] < 0.35f * hot[0]);
+    CHECK(cooled[1] < 0.12f * hot[1]);
+    // The fuel fireball burns, it does not detonate: each puff glows for
+    // about a second, ten times a shell's flash.
+    CHECK(FuelFireballGlowSeconds() > 0.7f);
+    CHECK(FuelFireballGlowSeconds() < 1.3f);
+    CHECK(FuelFireballGlowSeconds() > 10.0f * ExplosionFlashSeconds(he));
+    // Any fuel burns: a Jeep's (hit about 5) gives a small fireball feeding
+    // for a third of a second; a big one (a fuel truck's hundreds) is the
+    // largest and feeds over a second.
+    CHECK(5.0f > kFuelFireballMinHit);
+    CHECK(FuelFireballSize(5.0f) == Approx(0.35f));
+    CHECK(FuelFireballBurnSeconds(5.0f) == Approx(0.3f));
+    CHECK(FuelFireballSize(1000.0f) == Approx(1.25f));
+    CHECK(FuelFireballBurnSeconds(1000.0f) == Approx(1.25f));
+    CHECK(FuelFireballSize(100.0f) > FuelFireballSize(20.0f));
+    // The crater's column lingers: a heavy shell's puffs live 15 s and more, a
+    // grenade's still several seconds; the column stops rising (its climb
+    // decays to a slow hang).
+    const float heavyLife = (kCraterSmokeHold + kCraterSmokeFade) * CraterSmokeLifeScale(0.95f);
+    const float grenadeLife = (kCraterSmokeHold + kCraterSmokeFade) * CraterSmokeLifeScale(0.3f);
+    CHECK(heavyLife >= 15.0f);
+    CHECK(heavyLife <= 30.0f);
+    CHECK(grenadeLife >= 6.0f);
+    CHECK(grenadeLife < heavyLife);
+    const float riseS = (5.0f / 0.8f - kCraterSmokeHangRise) / -kCraterSmokeRiseDecay;
+    const float riseM = 0.5f * (5.0f / 0.8f + kCraterSmokeHangRise) * riseS;
+    CHECK(riseM > 10.0f);
+    CHECK(riseM < 30.0f);
+    // The combat light lasts as long as the flash: a grenade's has fallen
+    // under a third of its peak by the third frame, while a heavy burst's
+    // (size 1, kExplosionFlashHold) still holds there.
+    CombatTuning t;
+    const float g0 = EvaluateCombatLight(CombatLightKind::Explosion, grenade, 0.0f, 7, t).intensity;
+    const float g3 = EvaluateCombatLight(CombatLightKind::Explosion, grenade, 3.0f / 30.0f, 7, t).intensity;
+    CHECK(g3 < 0.33f * g0);
+    const float h0 = EvaluateCombatLight(CombatLightKind::Explosion, 1.0f, 0.0f, 7, t).intensity;
+    const float h3 = EvaluateCombatLight(CombatLightKind::Explosion, 1.0f, 3.0f / 30.0f, 7, t).intensity;
+    CHECK(h3 > 0.9f * h0);
+    // Source contract: every stage ages by the simulation step it is given.
+    // The burst's puffs take the timing above, the fuel takes the slow
+    // fireball and its own light, and a lingering puff spreads and drifts by
+    // its deltaT (no frame counts, no wall clock).
+    const std::string smokes =
+        ReadTextFile(EngineDir() / "Poseidon" / "Graphics" / "Rendering" / "Effects" / "Smokes.cpp");
+    const std::string ctor = FunctionBody(smokes, "Explosion::Explosion(");
+    CHECK(ctor.find("FireballCoolingRate(lighting::ExplosionFlashSeconds(_exSize))") != std::string::npos);
+    const std::string fuel = FunctionBody(smokes, "void SmokeSourceVehicle::SimulateExplosion(");
+    CHECK(fuel.find("lighting::kFuelCoolRate") != std::string::npos);
+    CHECK(fuel.find("_fireballLight = fireTime + glow;") != std::string::npos);
+    CHECK(fuel.find("if (type.hit > lighting::kFuelFireballMinHit)") < fuel.find("if (type.hit > 50)"));
+    const std::string cl = FunctionBody(smokes, "void Cloudlet::Simulate(");
+    CHECK(cl.find("_spreadAge += deltaT;") != std::string::npos);
+    CHECK(cl.find("exp(-deltaT / _windTau)") != std::string::npos);
+    const std::string crater = FunctionBody(smokes, "void Crater::Init(");
+    CHECK(crater.find("lighting::CraterSmokeLifeScale(size)") != std::string::npos);
+    const std::string shots = ReadTextFile(EngineDir() / "Poseidon" / "World" / "Entities" / "Weapons" / "Shots.cpp");
+    CHECK(shots.find("lighting::ExplosionVisualSize(Type()->indirectHit, Type()->indirectHitRange)") !=
+          std::string::npos);
+}
