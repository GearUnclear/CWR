+TEST_CASE("Combat lights: look fix boom: a burst cools by its charge, its flash scales with the cube root",
+          "[remaster][CombatLights]")
+{
+    // A cased charge's fireball is soot within about 0.1 s: a heavy shell's
+    // puffs cool kBurstCoolKps, a grenade's faster, by the cube root.
+    CHECK(BurstCoolingRate(1.0f) == Approx(kBurstCoolKps));
+    CHECK(BurstCoolingRate(0.25f) > 1.5f * BurstCoolingRate(1.0f));
+    CHECK(BurstCoolingRate(0.25f) < 1.6f * BurstCoolingRate(1.0f));
+    // From the config's 2500 K a heavy shell's puff is under 1600 K (a dull
+    // red glow at most) a fifth of a second after its birth, a 120 mm shell's
+    // (size 0.6) sooner; still yellow-white (over 2000 K) on the next frame.
+    CHECK(2500.0f - 0.2f * BurstCoolingRate(1.0f) < 1600.0f);
+    CHECK(2500.0f - 0.2f * BurstCoolingRate(0.6f) < 1400.0f);
+    CHECK(2500.0f - 1.0f / 30.0f * BurstCoolingRate(0.6f) > 2000.0f);
+    CHECK(FireballTable(2200.0f));
+    CHECK_FALSE(FireballTable(1000.0f));
+    CHECK_FALSE(FireballTable(4200.0f));
+    // A fuel tank's deflagration: cooler at its birth, glowing about a second.
+    CHECK(kFuelFireInitK < 2100.0f);
+    CHECK(kFuelFireInitK - 1.0f * kFuelFireCoolKps > 1300.0f);
+    float a[3], e[3];
+    REQUIRE(FireballPuff(kFuelFireInitK, 2200.0f, a, e));
+    CHECK(e[0] > 5.0f);        // a bright orange body
+    CHECK(e[1] < 0.7f * e[0]); // orange, not the detonation's white
+    // Under the photoreal camera (no hold) a grenade's flash is gone sooner
+    // than a heavy shell's.
+    CombatTuning noHold;
+    noHold.flashHold = 0.0f;
+    auto rel = [&](float strength, float age)
+    {
+        return EvaluateCombatLight(CombatLightKind::Explosion, strength, age, 7, noHold).intensity /
+               EvaluateCombatLight(CombatLightKind::Explosion, strength, 0.0f, 7, noHold).intensity;
+    };
+    CHECK(rel(0.25f, 1.0f / 30.0f) < rel(1.0f, 1.0f / 30.0f));
+    CHECK(rel(1.0f, 3.0f / 30.0f) < 0.05f);
+    // The fireball's puffs stand on the ground with their round foot.
+    CHECK(kFireballLiftShare > 0.5f);
+    CHECK(kFireballBirthSize > 0.5f);
+}
