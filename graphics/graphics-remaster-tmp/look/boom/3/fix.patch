diff --git a/arma_CWR/engine/Poseidon/Graphics/Rendering/Lighting/BlastLook.hpp b/arma_CWR/engine/Poseidon/Graphics/Rendering/Lighting/BlastLook.hpp
new file mode 100644
index 00000000..28b047dd
--- /dev/null
+++ b/arma_CWR/engine/Poseidon/Graphics/Rendering/Lighting/BlastLook.hpp
@@ -0,0 +1,231 @@
+#pragma once
+
+// What an explosion looks like by munition (look fix "boom", option 3: high
+// explosive against fuel). Pure numbers, no engine types, so the unit tests
+// can hold them; Smokes.cpp applies them to the explosion's cloudlet sources.
+//
+// A cased high explosive (a shell, a HEAT round, a grenade) detonates: a flash
+// of a few tens of milliseconds whose size and length go with the cube root of
+// the charge, little lasting flame, then thrown earth and a dark dust and smoke
+// column that drifts for many seconds. A vehicle's fuel deflagrates: a slower
+// rolling orange fireball of about a second that rises into thick black soot,
+// then the wreck burns. The classic config (CfgCloudlets Explosion, a 2500 K
+// puff cooling 4000 K/s; CraterSmoke1-3, 0.3 to 1.6 s of emission and puffs
+// of 3 to 4 s) gave every munition the same short orange cloud and a column
+// that was gone in under a second; the fuel fireball only burned when the
+// wreck's explosives passed the damage gate (hit > 50), which a Jeep never does.
+
+#include <algorithm>
+#include <cmath>
+
+namespace Poseidon::lighting
+{
+
+// The reference charge: CfgAmmo Shell120 (indirectHit 150 x indirectHitRange
+// 8), whose classic explosion size is 0.6 (hit 200 x 0.003). The blast's
+// linear scale is the cube root of the charge against it: HEAT120 (300 x 1)
+// 0.63, a hand grenade (18 x 7) 0.47.
+constexpr float kBlastRefCharge = 1200.0f;
+constexpr float kBlastRefSize = 0.6f;
+inline float BlastLinearScale(float indirectHit, float indirectHitRange)
+{
+    const float charge = std::max(indirectHit * indirectHitRange, 1.0f);
+    return std::cbrt(charge / kBlastRefCharge);
+}
+// The explosion size (0.25 .. 1, the classic range) from the charge rather than
+// the direct hit: by direct hit a HEAT round (hit 700) drew the largest
+// fireball of all, three times a 120 mm HE shell's charge.
+inline float BlastExplosionSize(float indirectHit, float indirectHitRange)
+{
+    return std::clamp(kBlastRefSize * BlastLinearScale(indirectHit, indirectHitRange), 0.25f, 1.0f);
+}
+
+// One kind of puff an explosion throws (a cloudlet source's settings).
+struct BlastPuffLook
+{
+    float emitSec = 0.0f;  // how long the source emits (s)
+    float initK = 0.0f;    // the puff's birth temperature (K, FireballPuff)
+    float coolKps = 0.0f;  // its cooling (K/s, negative; each puff 0.7 .. 1.3 of it)
+    float duration = 0.0f; // the puff's life at full alpha (s)
+    float fadeOut = 0.0f;  // then its fade (s)
+    float growUp = 0.0f;   // the time it grows to its size (s)
+    float radialGain = 4.0f; // outward speed per metre of offset (classic 4)
+};
+
+// High explosive: a white-hot flash. The puffs are born at kHeFlashK (white
+// under FireballPuff's glow) and fall to kHeFlashEndK, where the glow is a few
+// percent of its reference, in kHeFlashSec times the blast's linear scale. A
+// puff is first drawn one step after its birth, so a 120 mm shell shows one
+// white-yellow frame at 30 fps (about 2500 K), one orange (2000 K), then soot;
+// a grenade one yellow-orange frame. Then they are soot
+// that hangs on as the burst's dark cloud (classic: 0.2 s and a 0.2 s fade).
+constexpr float kHeFlashK = 3000.0f;
+constexpr float kHeFlashEndK = 1500.0f;
+constexpr float kHeFlashSec = 0.1f;
+constexpr float kHeEmitSec = 0.035f;
+constexpr float kHeSootSec = 0.7f;
+constexpr float kHeSootFadeSec = 1.6f;
+inline BlastPuffLook HeFlashLook(float exSize)
+{
+    const float s = std::max(exSize, 0.05f) / kBlastRefSize;
+    BlastPuffLook l;
+    l.emitSec = std::max(kHeEmitSec * s, 1.0f / 60.0f);
+    l.initK = kHeFlashK;
+    l.coolKps = -(kHeFlashK - kHeFlashEndK) / (kHeFlashSec * s);
+    l.duration = kHeSootSec * (0.5f + 0.5f * s);
+    l.fadeOut = kHeSootFadeSec * (0.5f + 0.5f * s);
+    l.growUp = 0.04f * s; // full size by its first drawn frame (it is drawn after one step)
+    l.radialGain = 2.0f; // classic 4: the soot flew 25 m out and up
+    return l;
+}
+// How long a HE flash glows (s): the time the hottest puff takes to cool to
+// kHeFlashEndK at the slowest cooling (0.7).
+inline float HeFlashSeconds(float exSize)
+{
+    const BlastPuffLook l = HeFlashLook(exSize);
+    return (l.initK - kHeFlashEndK) / (-l.coolKps * 0.7f);
+}
+
+// Fuel: a deflagration. Puffs born at kFuelFireK glow orange-yellow and cool
+// slowly (kFuelCoolKps), each glowing about a second before it is soot; the
+// source emits for kFuelEmitSec times the fire's linear scale, and the puffs
+// roll out slowly (radial gain 1.2) and grow over kFuelGrowSec.
+constexpr float kFuelFireK = 2150.0f;
+constexpr float kFuelCoolKps = -380.0f;
+constexpr float kFuelEmitSec = 0.9f;
+constexpr float kFuelGrowSec = 0.8f;
+constexpr float kFuelPuffSec = 1.0f;
+constexpr float kFuelFadeSec = 2.5f;
+constexpr float kFuelMinSize = 0.6f; // a car's tank still burns as a fireball
+// The fireball's puff size and spread per unit of fire size (classic: the
+// fire size itself, a seventh of a shell burst's puffs) and its emission
+// interval (classic 1 ms, hundreds of puffs a second).
+constexpr float kFuelPuffSize = 5.0f;
+constexpr float kFuelSpread = 2.5f;
+constexpr float kFuelInterval = 0.015f;
+inline float FuelFireSize(float explosiveHit) { return std::clamp(explosiveHit * 0.001f, kFuelMinSize, 1.25f); }
+inline BlastPuffLook FuelFireballLook(float fireSize)
+{
+    const float s = std::cbrt(std::max(fireSize, 0.05f) / kBlastRefSize);
+    BlastPuffLook l;
+    l.emitSec = kFuelEmitSec * s;
+    l.initK = kFuelFireK;
+    l.coolKps = kFuelCoolKps;
+    l.duration = kFuelPuffSec * s;
+    l.fadeOut = kFuelFadeSec * s;
+    l.growUp = kFuelGrowSec * s;
+    l.radialGain = 1.2f;
+    return l;
+}
+// The soot that rolls up with the fuel fireball (the dark fire): black, longer.
+constexpr float kFuelSootRgb[3] = {0.05f, 0.045f, 0.04f};
+inline BlastPuffLook FuelSootLook(float fireSize)
+{
+    const float s = std::cbrt(std::max(fireSize, 0.05f) / kBlastRefSize);
+    BlastPuffLook l;
+    l.emitSec = 1.6f * kFuelEmitSec * s;
+    l.duration = 2.5f * s;
+    l.fadeOut = 5.0f * s;
+    l.growUp = 2.0f * s;
+    l.radialGain = 1.0f;
+    return l;
+}
+// The fuel fireball's light: a Fire light of this strength per unit of fire
+// size while it burns (a wreck's embers are 0.9 x its smoke size).
+constexpr float kFuelFireballLight = 6.0f;
+// A burning wreck after its fuel went up: the smoke source's times (s).
+constexpr float kWreckBurnSec = 45.0f;
+constexpr float kWreckFadeSec = 30.0f;
+
+// The earth, dust and smoke a high-explosive burst leaves (Crater with smoke),
+// by the crater's size (about 1 for a 120 mm shell, 0.7 HEAT, 0.3 a grenade).
+struct BlastColumnLook
+{
+    float emitSec = 0.0f;  // the source's full emission (s)
+    float outSec = 0.0f;   // then its thinning (s)
+    float interval = 0.1f; // between puffs (s)
+    float riseMps = 0.0f;  // the source's upward speed (m/s)
+    float accY = 0.0f;     // the puff's climb acceleration (m/s^2)
+    float minY = 0.0f, maxY = 0.0f;
+    float duration = 0.0f; // puff life at full alpha (s)
+    float fadeOut = 0.0f;
+    float growUp = 0.0f;
+    float size = 1.0f;       // SmokeSource size (cloudlet size = 2 .. 3 x 2 x size)
+    float sourceSize = 1.0f; // the spread of births (m)
+    float density = 1.0f;    // alpha = density x 0.7
+    float rgb[3] = {0.0f, 0.0f, 0.0f};
+};
+// The column's life against a 120 mm shell's: a grenade's smoke lasts about
+// half as long.
+inline float BlastLifeScale(float craterSize) { return 0.35f + 0.65f * std::clamp(craterSize, 0.0f, 1.2f); }
+// Thrown earth: a fast dark brown jet that slows and falls back as it spreads.
+inline BlastColumnLook BlastEarthLook(float craterSize)
+{
+    const float c = std::clamp(craterSize, 0.2f, 1.2f);
+    const float L = BlastLifeScale(craterSize);
+    BlastColumnLook l;
+    l.emitSec = 0.2f;
+    l.outSec = 0.15f;
+    l.interval = 0.02f;
+    l.riseMps = 4.0f + 8.0f * c;
+    l.accY = -9.0f;
+    l.minY = -4.0f;
+    l.maxY = 14.0f;
+    l.duration = 2.0f * L;
+    l.fadeOut = 3.0f * L;
+    l.growUp = 1.2f * L;
+    l.size = 1.2f * c;
+    l.sourceSize = 0.6f * c;
+    l.density = 1.3f;
+    l.rgb[0] = 0.20f, l.rgb[1] = 0.17f, l.rgb[2] = 0.13f;
+    return l;
+}
+// The smoke column: dark grey-brown, rising slowly, growing and drifting for
+// many seconds (about 17 s from a 120 mm shell, 8 s from a grenade).
+inline BlastColumnLook BlastColumnLookFor(float craterSize)
+{
+    const float c = std::clamp(craterSize, 0.2f, 1.2f);
+    const float L = BlastLifeScale(craterSize);
+    BlastColumnLook l;
+    l.emitSec = 1.2f * L;
+    l.outSec = 3.0f * L;
+    l.interval = 0.1f;
+    l.riseMps = 2.0f + 2.5f * c;
+    l.accY = -2.0f;
+    l.minY = 0.3f;
+    l.maxY = 6.0f;
+    l.duration = 5.0f * L;
+    l.fadeOut = 7.0f * L;
+    l.growUp = 5.0f * L;
+    l.size = 1.5f * c;
+    l.sourceSize = 0.8f * c;
+    l.density = 1.2f;
+    l.rgb[0] = 0.15f, l.rgb[1] = 0.14f, l.rgb[2] = 0.125f;
+    return l;
+}
+// A low dust skirt that spreads along the ground and hangs.
+inline BlastColumnLook BlastHazeLook(float craterSize)
+{
+    const float c = std::clamp(craterSize, 0.2f, 1.2f);
+    const float L = BlastLifeScale(craterSize);
+    BlastColumnLook l;
+    l.emitSec = 0.5f;
+    l.outSec = 1.5f * L;
+    l.interval = 0.08f;
+    l.riseMps = 0.6f;
+    l.accY = -0.5f;
+    l.minY = 0.05f;
+    l.maxY = 1.0f;
+    l.duration = 4.0f * L;
+    l.fadeOut = 6.0f * L;
+    l.growUp = 4.0f * L;
+    l.size = 2.0f * c;
+    l.sourceSize = 2.5f * c;
+    l.density = 0.5f;
+    l.rgb[0] = 0.30f, l.rgb[1] = 0.27f, l.rgb[2] = 0.22f;
+    return l;
+}
+// How long a column stays visible (s): emission, thinning, the last puff's life.
+inline float BlastColumnSeconds(const BlastColumnLook& l) { return l.emitSec + l.outSec + l.duration + l.fadeOut; }
+
+} // namespace Poseidon::lighting
