+// Look fix "boom" (BlastLook.hpp): high explosive against fuel.
+TEST_CASE("Combat lights: blast look: a HE flash is a blink, a fuel fireball rolls for about a second",
+          "[remaster][CombatLights]")
+{
+    // Sizes from the charge (indirectHit x range), by the cube root: the
+    // 120 mm HE shell keeps its classic 0.6, HEAT and a grenade are smaller
+    // (by direct hit a HEAT round drew the largest fireball of all).
+    const float he = BlastExplosionSize(150.0f, 8.0f);
+    const float heat = BlastExplosionSize(300.0f, 1.0f);
+    const float grenade = BlastExplosionSize(18.0f, 7.0f);
+    CHECK(he == Catch::Approx(0.6f).margin(1e-4));
+    CHECK(heat == Catch::Approx(0.6f * std::cbrt(0.25f)).margin(1e-4));
+    CHECK(grenade < heat);
+    CHECK(grenade >= 0.25f);
+    CHECK(BlastExplosionSize(1000.0f, 10.0f) == 1.0f); // a satchel stays at the cap
+
+    // The flash: white at birth, a few percent of its glow within tens of
+    // milliseconds, longer for a bigger charge (cube root).
+    const float flashHe = HeFlashSeconds(he);
+    const float flashGrenade = HeFlashSeconds(grenade);
+    CHECK(flashHe > 0.05f);
+    CHECK(flashHe < 0.2f);
+    // First drawn one step (1/30 s) after birth: still white-yellow hot.
+    CHECK(kHeFlashK + HeFlashLook(he).coolKps / 30.0f > 2400.0f);
+    CHECK(flashGrenade < flashHe);
+    CHECK(flashGrenade > 0.02f);
+    const BlastPuffLook hl = HeFlashLook(he);
+    float albedo[3], birth[3], end[3];
+    REQUIRE(FireballPuff(hl.initK, 2200.0f, albedo, birth));
+    REQUIRE(FireballPuff(kHeFlashEndK, 2200.0f, albedo, end));
+    CHECK(birth[2] > 0.8f * birth[0]); // white-hot, not orange
+    CHECK(end[0] < 0.1f * birth[0]);   // the flash is over
+    CHECK(hl.emitSec < 0.05f);
+    // Its soot hangs on (classic 0.2 s and a 0.2 s fade).
+    CHECK(hl.duration + hl.fadeOut > 1.5f);
+
+    // Fuel: the puffs glow orange (red over blue well above the flash's) for
+    // about a second each, emitted for about a second, rolling out slowly.
+    const float fuel = FuelFireSize(10.0f); // a Jeep's few explosives
+    CHECK(fuel == kFuelMinSize);
+    const BlastPuffLook fl = FuelFireballLook(fuel);
+    CHECK(fl.emitSec > 0.7f);
+    CHECK(fl.emitSec < 1.3f);
+    CHECK(fl.radialGain < hl.radialGain);
+    float fBirth[3], fOne[3], fTwo[3];
+    REQUIRE(FireballPuff(fl.initK, 2200.0f, albedo, fBirth));
+    REQUIRE(FireballPuff(fl.initK + fl.coolKps * 1.0f, 2200.0f, albedo, fOne));
+    REQUIRE(FireballPuff(fl.initK + fl.coolKps * 2.0f, 2200.0f, albedo, fTwo));
+    CHECK(fBirth[0] > 1.0f);            // bright
+    CHECK(fBirth[2] < 0.5f * fBirth[0]); // orange, not white
+    CHECK(fOne[0] > 0.2f);              // still glowing after a second
+    CHECK(fTwo[0] < 0.1f);              // soot after two
+    CHECK(FuelSootLook(fuel).duration + FuelSootLook(fuel).fadeOut > 5.0f);
+    CHECK(kWreckBurnSec >= 30.0f);
+}
