+TEST_CASE("Combat lights: blast look: a HE burst leaves a dark column that lingers for many seconds",
+          "[remaster][CombatLights]")
+{
+    // Crater sizes: about 1 for a 120 mm shell, 0.3 for a grenade.
+    const BlastColumnLook col = BlastColumnLookFor(1.0f);
+    const BlastColumnLook small = BlastColumnLookFor(0.3f);
+    CHECK(BlastColumnSeconds(col) > 12.0f);
+    CHECK(BlastColumnSeconds(small) > 5.0f);
+    CHECK(BlastColumnSeconds(small) < BlastColumnSeconds(col));
+    // Dark: under a third grey, earth a little warmer than the smoke.
+    const BlastColumnLook earth = BlastEarthLook(1.0f);
+    for (int i = 0; i < 3; ++i)
+    {
+        CHECK(col.rgb[i] < 0.3f);
+        CHECK(earth.rgb[i] < 0.3f);
+    }
+    CHECK(earth.rgb[0] / earth.rgb[2] > col.rgb[0] / col.rgb[2]);
+    // Earth is thrown fast and falls back; the column rises slowly.
+    CHECK(earth.riseMps > 2.0f * col.riseMps);
+    CHECK(earth.accY < 0.0f);
+    CHECK(BlastHazeLook(1.0f).riseMps < col.riseMps);
+}
