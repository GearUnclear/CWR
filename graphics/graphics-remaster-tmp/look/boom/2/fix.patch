+
+const BlastLook& LookFor(BlastClass cls)
+{
+    const int i = std::min(std::max(static_cast<int>(cls), 0), kBlastClasses - 1);
+    return kLooks[i];
+}
+
+const char* BlastClassName(BlastClass cls)
+{
+    return LookFor(cls).name;
+}
+
+float ChargeKg(float indirectHit, float indirectHitRange)
+{
+    return kChargeKgPerSplash * std::max(indirectHit, 0.0f) * std::max(indirectHitRange, 0.0f);
+}
+
+BlastClass ClassifyAmmo(AmmoKind kind, float indirectHit, float indirectHitRange)
+{
+    const float kg = ChargeKg(indirectHit, indirectHitRange);
+    switch (kind)
+    {
+        case AmmoKind::TimeBomb:
+        case AmmoKind::PipeBomb:
+            return kg >= kBombMinKg * 2.0f ? BlastClass::Bomb : BlastClass::Satchel;
+        case AmmoKind::Mine:
+            return BlastClass::Mine;
+        case AmmoKind::Missile:
+        case AmmoKind::Rocket:
+            if (kg >= kBombMinKg)
+                return BlastClass::Bomb;
+            return indirectHitRange <= kShapedChargeMaxRange ? BlastClass::RocketWarhead : BlastClass::HEShell;
+        case AmmoKind::Shell:
+        case AmmoKind::Other:
+        default:
+            if (kg >= kBombMinKg)
+                return BlastClass::Bomb;
+            if (indirectHitRange <= 2.0f)
+                return BlastClass::HEAT;
+            return kg < kGrenadeMaxKg ? BlastClass::Grenade : BlastClass::HEShell;
+    }
+}
+
+BlastClass ClassFromSize(float exSize)
+{
+    return exSize <= 0.3f ? BlastClass::Grenade : BlastClass::HEShell;
+}
+
+float ChargeScale(const BlastLook& look, float kg)
+{
+    if (!(kg > 0.0f) || !(look.refKg > 0.0f))
+        return 1.0f;
+    return std::min(std::max(std::cbrt(kg / look.refKg), kScaleMin), kScaleMax);
+}
+
+float FireballGlowSeconds(const BlastLook& look, float scale)
+{
+    // The puffs cool at fireCoolK / scale (a bigger ball cools slower), each
+    // at 0.7 .. 1.3 of it (CloudletSource::Drop); the mean puff.
+    const float rate = look.fireCoolK / std::max(scale, 0.05f);
+    return std::max(look.fireInitK - 1300.0f, 0.0f) / std::max(rate, 1.0f);
+}
+
+} // namespace Poseidon::blast
