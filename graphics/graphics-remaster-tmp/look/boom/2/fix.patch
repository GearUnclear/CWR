@@ -0,0 +1,128 @@
+#pragma once
+
+#include <cstdint>
+
+// The per-munition explosion look (look fix "boom", approach 2): one table row
+// per class of explosion the engine can produce, read from the munition's
+// config (CfgAmmo simulation, indirectHit, indirectHitRange), so a modded
+// munition falls into a class by its data. A row says how long the burst's
+// flash lights the scene and in what colour, how long the fireball's puffs
+// glow (their birth temperature and cooling rate: CombatLights.hpp
+// FireballPuff turns that into a black-body glow) and how long they last as
+// soot, and the smoke column, the low dust skirt and the thrown earth.
+//
+// Physics the rows follow. A cased high explosive detonates in microseconds:
+// a flash of tens of milliseconds, a short afterburn of the oxygen-poor
+// detonation products, then a dark dust and smoke column with thrown earth
+// that lingers and drifts for many seconds. Size and duration grow with the
+// cube root of the charge (Hopkinson-Cranz scaling). A shaped charge (HEAT,
+// an anti-tank rocket or missile) puts its energy into the jet: a smaller,
+// more focused burst and less earth. A buried mine throws a tall brown earth
+// column with little flame. A vehicle's fuel tank deflagrates: a slower,
+// rolling orange fireball (about a second) with black soot.
+//
+// Pure: no engine state. Smokes.cpp (Explosion, Crater, the fuel explosion)
+// and Shots.cpp / Collisions.cpp drive the existing particle and combat light
+// systems from it.
+
+namespace Poseidon::blast
+{
+
+enum class BlastClass : std::uint8_t
+{
+    Grenade,       // hand and rifle grenades, small mortar rounds under 0.4 kg
+    HEShell,       // cased HE: tank and artillery shells, mortars, HE rockets
+    HEAT,          // shaped-charge gun rounds
+    RocketWarhead, // shaped-charge rockets and missiles (LAW, RPG, AT, Hellfire)
+    Satchel,       // demolition charges on the surface (time and pipe bombs)
+    Mine,          // buried anti-tank mines
+    Bomb,          // aircraft bombs and very large charges (20 kg and up)
+    FuelTank,      // a destroyed vehicle's fuel (FuelExplosion): a deflagration
+};
+constexpr int kBlastClasses = 8;
+
+// The config's ammo simulation, engine free (Weapons.hpp AmmoSimulation).
+enum class AmmoKind : std::uint8_t
+{
+    Shell,
+    Missile,
+    Rocket,
+    TimeBomb,
+    PipeBomb,
+    Mine,
+    Other,
+};
+
+struct BlastLook
+{
+    BlastClass cls;
+    const char* name;
+    float refKg; // the charge (TNT equivalent) the row is authored at
+
+    // The flash: the burst's combat light (CombatLights.hpp Explosion).
+    float flashSpan;   // time scale of its envelope (1 = 50 ms flash, 0.16 s afterglow)
+    float flashRgb[3]; // tint on its white-hot to fire colour (white = none)
+    float flashPower;  // on its strength
+
+    // The fireball: CfgCloudlets Explosion puffs.
+    float fireEmit;   // s the source emits
+    float fireLife;   // s a puff holds (glow, then soot)
+    float fireFade;   // s it fades out
+    float fireInitK;  // birth temperature (K)
+    float fireCoolK;  // cooling (K/s)
+    float fireSize;   // on the puff size
+    float fireSpread; // source radius (m)
+    float fireRise;   // fastest climb (m/s)
+
+    // The smoke column (CraterSmoke1, display colour).
+    float smokeRgb[3];
+    float smokeAlpha;
+    float smokeEmit; // s
+    float smokeLife; // s a puff holds
+    float smokeFade; // s it fades out
+    float smokeSize; // on the puff size
+    float smokeRise; // initial climb (m/s)
+
+    // The low dust skirt and thrown earth (CraterSmoke2, the ground debris).
+    float dustRgb[3];
+    float dustAlpha;
+    float dustEmit;
+    float dustLife;
+    float dustSize;
+    float debris; // on the number of earth clods thrown
+};
+
+const BlastLook& LookFor(BlastClass cls);
+const char* BlastClassName(BlastClass cls);
+
+// TNT-equivalent charge of a munition from its config: the splash damage
+// times its radius, 0.002 kg each (hand grenade 18 x 7 = 0.25 kg, 120 mm HE
+// 150 x 8 = 2.4 kg, satchel 700 x 7 = 9.8 kg, guided bomb 3500 x 15 = 105 kg).
+constexpr float kChargeKgPerSplash = 0.002f;
+float ChargeKg(float indirectHit, float indirectHitRange);
+
+// The class from the config. Shells: a splash radius of 2 m or less is a
+// shaped charge (HEAT); otherwise under kGrenadeMaxKg a grenade, else HE.
+// Missiles and rockets: 20 kg and up a bomb, a splash radius of 2.5 m or
+// less a shaped-charge warhead, else HE. Time and pipe bombs are satchels,
+// mines mines.
+constexpr float kGrenadeMaxKg = 0.4f;
+constexpr float kBombMinKg = 20.0f;
+constexpr float kShapedChargeMaxRange = 2.5f;
+BlastClass ClassifyAmmo(AmmoKind kind, float indirectHit, float indirectHitRange);
+
+// An explosion that came without its munition (network, a save): from the
+// engine's explosion size (0.25 .. 1).
+BlastClass ClassFromSize(float exSize);
+
+// Hopkinson-Cranz: lengths and times of a burst scale with the cube root of
+// its charge over the row's own; clamped to [kScaleMin, kScaleMax].
+constexpr float kScaleMin = 0.5f;
+constexpr float kScaleMax = 2.5f;
+float ChargeScale(const BlastLook& look, float kg);
+
+// How long a puff of the fireball glows visibly: from birth until it has
+// cooled to the fireball's glow floor (CombatLights.hpp kFireballGlowFullK).
+float FireballGlowSeconds(const BlastLook& look, float scale);
+
+} // namespace Poseidon::blast
