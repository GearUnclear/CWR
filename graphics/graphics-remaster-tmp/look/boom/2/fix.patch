@@ -0,0 +1,140 @@
+#include <catch2/catch_approx.hpp>
+#include <catch2/catch_test_macros.hpp>
+
+#include <Poseidon/Graphics/Rendering/Effects/BlastLook.hpp>
+#include <Poseidon/Graphics/Rendering/Lighting/CombatLights.hpp>
+
+#include <cmath>
+
+// The per-munition explosion look (Graphics/Rendering/Effects/BlastLook.hpp):
+// every CfgAmmo row of the game falls into its class by its data, the rows
+// follow the physics (cube-root scaling, a brief HE flash and a long smoke
+// column, a slow fuel deflagration), and the combat light reads a burst's
+// envelope on the munition's own time scale and colour.
+
+using namespace Poseidon;
+using namespace Poseidon::blast;
+
+TEST_CASE("BlastLook: the game's munitions fall into their class from config", "[CombatLights][BlastLook]")
+{
+    // CfgAmmo (indirectHit, indirectHitRange) of the shipped munitions.
+    CHECK(ClassifyAmmo(AmmoKind::Shell, 18.0f, 7.0f) == BlastClass::Grenade);          // GrenadeHand, Grenade
+    CHECK(ClassifyAmmo(AmmoKind::Shell, 40.0f, 10.0f) == BlastClass::HEShell);         // MortarShell
+    CHECK(ClassifyAmmo(AmmoKind::Shell, 150.0f, 8.0f) == BlastClass::HEShell);         // Shell120
+    CHECK(ClassifyAmmo(AmmoKind::Shell, 90.0f, 8.0f) == BlastClass::HEShell);          // Shell73
+    CHECK(ClassifyAmmo(AmmoKind::Shell, 300.0f, 1.0f) == BlastClass::HEAT);            // Heat120
+    CHECK(ClassifyAmmo(AmmoKind::Shell, 100.0f, 1.0f) == BlastClass::HEAT);            // Heat73
+    CHECK(ClassifyAmmo(AmmoKind::Rocket, 150.0f, 2.5f) == BlastClass::RocketWarhead);  // LAW, RPG
+    CHECK(ClassifyAmmo(AmmoKind::Missile, 200.0f, 2.5f) == BlastClass::RocketWarhead); // AT4, Carl Gustav
+    CHECK(ClassifyAmmo(AmmoKind::Missile, 600.0f, 2.5f) == BlastClass::RocketWarhead); // Hellfire
+    CHECK(ClassifyAmmo(AmmoKind::Rocket, 300.0f, 3.0f) == BlastClass::HEShell);        // Zuni (HE rocket)
+    CHECK(ClassifyAmmo(AmmoKind::Missile, 3500.0f, 15.0f) == BlastClass::Bomb);        // LaserGuidedBomb
+    CHECK(ClassifyAmmo(AmmoKind::TimeBomb, 700.0f, 7.0f) == BlastClass::Satchel);
+    CHECK(ClassifyAmmo(AmmoKind::PipeBomb, 700.0f, 7.0f) == BlastClass::Satchel);
+    CHECK(ClassifyAmmo(AmmoKind::Mine, 750.0f, 5.0f) == BlastClass::Mine);
+    // A modded heavy shell or charge still lands in a sensible class.
+    CHECK(ClassifyAmmo(AmmoKind::Shell, 2000.0f, 12.0f) == BlastClass::Bomb);
+    CHECK(ClassifyAmmo(AmmoKind::Other, 40.0f, 4.0f) == BlastClass::Grenade); // 0.32 kg
+    // Without its munition: by the engine's explosion size.
+    CHECK(ClassFromSize(0.25f) == BlastClass::Grenade);
+    CHECK(ClassFromSize(0.6f) == BlastClass::HEShell);
+    // Charges: 0.002 kg per splash unit.
+    CHECK(ChargeKg(18.0f, 7.0f) == Catch::Approx(0.252f));
+    CHECK(ChargeKg(150.0f, 8.0f) == Catch::Approx(2.4f));
+    CHECK(ChargeKg(-5.0f, 8.0f) == 0.0f);
+}
+
+TEST_CASE("BlastLook: rows follow the physics of each burst", "[CombatLights][BlastLook]")
+{
+    for (int i = 0; i < kBlastClasses; ++i)
+    {
+        const BlastLook& l = LookFor(static_cast<BlastClass>(i));
+        INFO(l.name);
+        CHECK(static_cast<int>(l.cls) == i);
+        CHECK(l.refKg > 0.0f);
+        CHECK(l.flashSpan > 0.0f);
+        CHECK(l.fireEmit > 0.0f);
+        CHECK(l.smokeLife > 0.0f);
+        // A fireball's table is read in kelvin (CombatLights FireballPuff).
+        CHECK(l.fireInitK >= lighting::kFireballGlowFullK);
+        CHECK(l.fireInitK <= lighting::kFireballTableMaxK);
+        // Smoke and dust are darker than a white wall and not coloured.
+        for (int c = 0; c < 3; ++c)
+        {
+            CHECK(l.smokeRgb[c] <= 0.35f);
+            CHECK(l.flashRgb[c] <= 1.0f);
+        }
+    }
+    const BlastLook& he = LookFor(BlastClass::HEShell);
+    const BlastLook& gren = LookFor(BlastClass::Grenade);
+    const BlastLook& heat = LookFor(BlastClass::HEAT);
+    const BlastLook& fuel = LookFor(BlastClass::FuelTank);
+    const BlastLook& bomb = LookFor(BlastClass::Bomb);
+    const BlastLook& mine = LookFor(BlastClass::Mine);
+    // HE: a flash of a frame or two, the fireball glows a few frames, the
+    // smoke column lingers many seconds (the round 5 cloud was gone in 0.6 s).
+    CHECK(FireballGlowSeconds(he, 1.0f) < 0.3f);
+    CHECK(he.smokeLife + he.smokeFade >= 10.0f);
+    // A fuel tank deflagrates: its fireball glows for about a second or more,
+    // with black soot, and its light is warm.
+    CHECK(FireballGlowSeconds(fuel, 1.0f) >= 1.0f);
+    CHECK(fuel.fireEmit >= 10.0f * he.fireEmit);
+    CHECK(fuel.smokeRgb[0] < he.smokeRgb[0]);
+    CHECK(fuel.flashRgb[2] < 0.5f);
+    CHECK(fuel.flashSpan > he.flashSpan);
+    // A shaped charge is smaller and more focused than an HE shell; a grenade
+    // smaller still; a bomb the largest; a buried mine throws the most earth.
+    CHECK(heat.fireSpread < he.fireSpread);
+    CHECK(heat.smokeSize < he.smokeSize);
+    CHECK(gren.smokeLife < he.smokeLife);
+    CHECK(gren.flashSpan < he.flashSpan);
+    CHECK(bomb.smokeLife > he.smokeLife);
+    CHECK(bomb.fireSpread > he.fireSpread);
+    CHECK(mine.debris > he.debris);
+    CHECK(mine.flashPower < he.flashPower);
+}
+
+TEST_CASE("BlastLook: sizes and times scale with the cube root of the charge", "[CombatLights][BlastLook]")
+{
+    const BlastLook& he = LookFor(BlastClass::HEShell);
+    CHECK(ChargeScale(he, he.refKg) == Catch::Approx(1.0f));
+    CHECK(ChargeScale(he, 8.0f * he.refKg) == Catch::Approx(2.0f));
+    CHECK(ChargeScale(he, he.refKg / 8.0f) == Catch::Approx(0.5f));
+    // Clamped, and a missing charge reads as the row's own.
+    CHECK(ChargeScale(he, 1000.0f * he.refKg) == Catch::Approx(kScaleMax));
+    CHECK(ChargeScale(he, 1e-6f) == Catch::Approx(kScaleMin));
+    CHECK(ChargeScale(he, 0.0f) == Catch::Approx(1.0f));
+    // A bigger ball cools slower.
+    CHECK(FireballGlowSeconds(he, 2.0f) == Catch::Approx(2.0f * FireballGlowSeconds(he, 1.0f)));
+}
