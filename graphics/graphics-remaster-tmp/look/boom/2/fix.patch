+TEST_CASE("BlastLook: a burst's light keeps its munition's time scale and colour", "[CombatLights][BlastLook]")
+{
+    lighting::CombatLightSet set;
+    const float p[3] = {0.0f, 1.0f, 0.0f};
+    const std::uint32_t shell = set.Spawn(lighting::CombatLightKind::Explosion, p, 0.6f);
+    const std::uint32_t fuel = set.Spawn(lighting::CombatLightKind::Explosion, p, 0.6f);
+    set.SetSpan(fuel, LookFor(BlastClass::FuelTank).flashSpan);
+    set.SetTint(fuel, 1.0f, 0.62f, 0.30f);
+    // 1.2 s on: the shell's burst is over (0.9 s), the fuel fireball still lights.
+    for (int i = 0; i < 36; ++i)
+        set.Tick(1.0f / 30.0f);
+    CHECK(set.Find(shell) == nullptr);
+    REQUIRE(set.Find(fuel) != nullptr);
+    set.Evaluate(lighting::CombatTuning{}, 1.0f);
+    const lighting::CombatLightSample& s = set.Find(fuel)->sample;
+    CHECK(s.intensity > 0.0f);
+    // Warm: the tint takes blue well under red.
+    CHECK(s.rgb[2] < 0.5f * s.rgb[0]);
+    // The same envelope read at age / span.
+    lighting::CombatLightRecord r;
+    r.age = 1.5f;
+    r.span = 3.0f;
+    CHECK(lighting::CombatEnvelopeAge(r) == Catch::Approx(0.5f));
+    r.span = 0.0f; // clamped, never a division by zero
+    CHECK(std::isfinite(lighting::CombatEnvelopeAge(r)));
+    // It ends: 3 x 0.9 s.
+    for (int i = 0; i < 60; ++i)
+        set.Tick(1.0f / 30.0f);
+    CHECK(set.Find(fuel) == nullptr);
+}
