+void Crater::SetBlast(blast::BlastClass cls, float chargeKg)
+{
+    if (!_isSmoke || _isWater)
+    {
+        return;
+    }
+    const blast::BlastLook& look = blast::LookFor(cls);
+    const float s = blast::ChargeScale(look, chargeKg);
+    // The column (CraterSmoke1): the munition's own smoke and dust colour (the
+    // config's white times a random grey made it anything from black to
+    // white), thrown up at smokeRise and stalling within a few seconds, then
+    // hanging and drifting with the wind for smokeLife. Classic: 0.3 s of
+    // puffs that lived 2.4 s.
+    const float column = look.smokeEmit * s;
+    // It thickens as the fireball cools: born at full density over the
+    // fireball, it hid the glow from the second frame on.
+    const float glow = blast::FireballGlowSeconds(look, s);
+    _smoke1.SetFlatTable();
+    _smoke1.SetColor(Color(look.smokeRgb[0], look.smokeRgb[1], look.smokeRgb[2], 0));
+    _smoke1.SetDensity(look.smokeAlpha / 0.7f);
+    _smoke1.SetSize(1.4f * look.smokeSize * s, 0.5f * look.smokeSize * s);
+    _smoke1.SetSourceTimes(0.7f * glow, column, 0.5f * column);
+    _smoke1.SetLife(look.smokeLife * s, look.smokeFade * s);
+    _smoke1.SetRise(look.smokeRise * s);
+    _smoke1.SetClimbRate(-look.smokeRise * s / 2.5f, 0.1f, look.smokeRise * s);
+    _smoke1.SetInterval(floatMax(column / 18.0f, 0.03f));
+    // The skirt (CraterSmoke2): earth and dust rolling out low round the
+    // crater, slower to rise, the soil's colour.
+    if (look.dustAlpha > 0.0f)
+    {
+        const float skirt = look.dustEmit * s;
+        _smoke2.SetFlatTable();
+        _smoke2.SetColor(Color(look.dustRgb[0], look.dustRgb[1], look.dustRgb[2], 0));
+        _smoke2.SetDensity(look.dustAlpha / 0.7f);
+        _smoke2.SetSize(2.0f * look.dustSize * s, 1.2f * look.dustSize * s);
+        _smoke2.SetSourceTimes(0.3f * glow, skirt, 0.5f * skirt);
+        _smoke2.SetLife(look.dustLife * s, 0.6f * look.dustLife * s);
+        _smoke2.SetRise(1.0f);
+        _smoke2.SetClimbRate(-0.3f, 0.1f, 1.5f);
+        _smoke2.SetInterval(floatMax(skirt / 10.0f, 0.04f));
+    }
+    else
+    {
+        _smoke2.SetSourceTimes(0, 0, 0);
+    }
+    // The haze (CraterSmoke3): the column's thin edge, paler and longer.
+    const float haze = 1.5f * column;
+    _smoke3.SetFlatTable();
+    _smoke3.SetColor(Color(floatMin(look.smokeRgb[0] * 1.6f, 1.0f), floatMin(look.smokeRgb[1] * 1.6f, 1.0f),
+                           floatMin(look.smokeRgb[2] * 1.6f, 1.0f), 0));
+    _smoke3.SetDensity(0.35f * look.smokeAlpha / 0.7f);
+    _smoke3.SetSize(2.6f * look.smokeSize * s, 1.0f * look.smokeSize * s);
+    _smoke3.SetSourceTimes(glow, haze, 0.5f * haze);
+    _smoke3.SetLife(1.3f * look.smokeLife * s, look.smokeFade * s);
+    _smoke3.SetRise(0.6f * look.smokeRise * s);
+    _smoke3.SetClimbRate(-0.6f * look.smokeRise * s / 3.0f, 0.3f, 0.6f * look.smokeRise * s);
+    _smoke3.SetInterval(floatMax(haze / 10.0f, 0.06f));
+}
