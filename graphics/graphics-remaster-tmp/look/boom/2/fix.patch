+        0.7f, {1.0f, 0.97f, 0.92f}, 0.75f,
+        0.03f, 0.3f, 0.8f, 2750.0f, 8000.0f, 0.4f, 0.6f, 3.0f,
+        {0.24f, 0.22f, 0.20f}, 0.85f, 0.5f, 5.0f, 4.0f, 0.6f, 4.0f,
