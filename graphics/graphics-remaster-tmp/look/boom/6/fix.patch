+void Explosion::SetBlast(float blast, bool shaped)
+{
+    _burstScale = lighting::BurstScale(blast);
+    _burstShaped = shaped;
+}
+
+// The detonation (look "boom"): a white-hot flash puff and a fireball of
+// puffs, all born at once and drawn from the frame the burst's light starts
+// (the classic puffs faded in over their first two frames, so the light lit
+// the ground a frame before any fire showed and the fire then lasted one
+// frame), sitting on the ground instead of half buried in it (the flat
+// cut-off bottom), sized and cooled by the cube root of the munition's charge.
+// What lingers is the crater's dust and smoke (Crater::Init).
+void Explosion::EmitBurst(SimulationImportance prec)
+{
+    const float s = _burstScale > 0.0f ? _burstScale : lighting::BurstScaleFromSize(_exSize);
+    const float r = lighting::BurstFireballRadius(s);
+    const float width = _burstShaped ? lighting::kBurstShapedWidth : 1.0f;
+    const float tall = _burstShaped ? 1.35f : 1.0f;
+    const Vector3 at = Position();
+    const float groundY = GLandscape->RoadSurfaceY(at.X(), at.Z());
+    // A ground burst is a dome on the ground; a burst in the air a ball.
+    const bool onGround = at.Y() - groundY < r;
+    const float centreY = onGround ? groundY + 0.45f * r * tall : at.Y();
+    const float coolBall = lighting::BurstCoolRate(s);
+    const float coolFlash = lighting::BurstFlashCoolRate(s);
+    // One puff: born full size (no grow-up) and seen at once (no fade-in),
+    // lives while it glows, then fades as soot into the crater's smoke.
+    auto drop =
+        [&](Vector3Par pos, Vector3Par vel, float diameter, float birthK, float rate, float alpha, float fadeOut)
+    {
+        const float life = lighting::BurstGlowSeconds(birthK, rate * 0.7f);
+        _fire.SetFades(0.0f, 0.0f, fadeOut);
+        // The smoke's own puff (cl_basic, resident: every smoke draws it),
+        // holding its first frame (kBurstHoldTexture). The classic puff stepped
+        // through cl_fired's 47 frames in 0.5 s, a new texture every frame,
+        // each streamed in on first use under the per-frame texture budget, so
+        // the fireball's puffs mostly were not drawn at all: the classic
+        // one-frame fire, and a first burst with no fire.
+        _fire.SetShape(GLOB_SCENE->Preloaded(CloudletBasic));
+        _fire.SetTimes(life, kBurstHoldTexture);
+        _fire.SetAlpha(alpha);
+        _fire.SetTemperatures(birthK, -rate);
+        _fire.SetClimbRate(-0.5f, 0.0f, 6.0f);
+        Cloudlet* puff = _fire.Drop(pos, vel);
+        puff->SetGrowUp(0.0f, diameter);
+        puff->SetSideSpeed(0, 0, 8.0f * s, 8.0f * s);
+        puff->Simulate(0.0f, prec);
+        GLOB_WORLD->AddCloudlet(puff);
+    };
+    // The flash: the whole ball, white-hot for a frame or two.
+    drop(Vector3(at.X(), centreY + 0.25f * r * tall, at.Z()), VUp * (1.0f * s), 2.1f * r * width,
+         lighting::kBurstFlashK, coolFlash, 0.85f, 0.05f);
+    // The fireball: its core hotter than its edge, expanding and lifting a
+    // little while its afterburn cools from yellow through orange to soot.
+    const int n = 9 + toInt(7.0f * s);
+    for (int i = 0; i < n; ++i)
+    {
+        float ux = GRandGen.RandomValue() * 2 - 1;
+        float uy = GRandGen.RandomValue() * (onGround ? 1.0f : 2.0f) - (onGround ? 0.0f : 1.0f);
+        float uz = GRandGen.RandomValue() * 2 - 1;
+        const float len = sqrtf(ux * ux + uy * uy + uz * uz);
+        if (len > 1e-3f)
+            ux /= len, uy /= len, uz /= len;
+        const float k = 0.2f + 0.55f * GRandGen.RandomValue();
+        const float d = r * (0.9f + 0.5f * GRandGen.RandomValue()) * (0.5f + 0.5f * width);
+        Vector3 pos(at.X() + ux * k * r * width, centreY + uy * k * r * tall, at.Z() + uz * k * r * width);
+        if (onGround)
+            saturateMax(pos[1], groundY + 0.4f * d);
+        const Vector3 vel(ux * (3.0f + 3.0f * GRandGen.RandomValue()) * s * width, (1.0f + uy * 3.0f) * s * tall,
+                          uz * (3.0f + 3.0f * GRandGen.RandomValue()) * s * width);
+        const float birthK = lighting::kBurstBallK * (0.86f + 0.14f * (1.0f - k));
+        drop(pos, vel, d, birthK, coolBall, 0.9f, 0.3f);
+    }
+}
