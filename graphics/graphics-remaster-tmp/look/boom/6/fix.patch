+float BurstScale(float blast)
+{
+    if (!(blast > 0.0f))
+        return -1.0f;
+    return Clamp(std::cbrt(blast / kBurstRefBlast), kBurstMinScale, kBurstMaxScale);
+}
+
+float BurstScaleFromSize(float exSize)
+{
+    // The classic size is the ammo's hit x 0.003 (0.25 .. 1): a heavy round 1,
+    // a grenade 0.25; read as the cube root of a charge in that ratio.
+    return Clamp(std::cbrt(std::max(exSize, 0.05f) / 0.8f), kBurstMinScale, kBurstMaxScale);
+}
+
+float BurstFireballRadius(float scale)
+{
+    return kBurstRefRadius * Clamp(scale, kBurstMinScale, kBurstMaxScale);
+}
+
+float BurstCoolRate(float scale)
+{
+    return kBurstCoolRef / std::max(Clamp(scale, kBurstMinScale, kBurstMaxScale), 0.35f);
+}
+
+float BurstFlashCoolRate(float scale)
+{
+    return kBurstFlashCoolRef / std::max(Clamp(scale, kBurstMinScale, kBurstMaxScale), 0.35f);
+}
+
+float BurstGlowSeconds(float birthK, float rate)
+{
+    return rate > 0.0f ? std::max(birthK - kFireballGlowFullK, 0.0f) / rate : 0.0f;
+}
+
+float CraterLinger(float craterSize)
+{
+    return 1.5f + 3.5f * Clamp(craterSize, 0.0f, 1.1f);
+}
+
+float FuelBallDiameter(float litres)
+{
+    const float m = std::max(litres, 0.0f) * kFuelKgPerLitre * kFuelBallShare;
+    return std::min(5.8f * std::cbrt(m), kFuelBallMaxDiameter);
+}
+
+float FuelBallDuration(float litres)
+{
+    const float m = std::max(litres, 0.0f) * kFuelKgPerLitre * kFuelBallShare;
+    return Clamp(0.45f * std::cbrt(m), 0.5f, 2.0f);
+}
+
+float FuelBallEnvelope(float age, float duration)
+{
+    if (age < 0.0f || age >= duration || duration <= 0.0f)
+        return 0.0f;
+    const float up = std::min(age / 0.12f, 1.0f);
+    const float down = Clamp((duration - age) / (0.55f * duration), 0.0f, 1.0f);
+    return up * up * (3.0f - 2.0f * up) * down * down * (3.0f - 2.0f * down);
+}
+
 } // namespace Poseidon::lighting
