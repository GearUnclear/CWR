+// Look "boom": a vehicle's fuel tank bursts and its fuel burns as a
+// deflagration: a large, slower, rolling orange fireball (FuelBallDiameter,
+// FuelBallDuration from the fuel aboard), thick black soot rolling up over
+// it, then the wreck's fire and smoke (40 s, as after the classic burst).
+void SmokeSourceVehicle::StartFuelBall()
+{
+    const EntityAI* veh = dyn_cast<EntityAI>(GetObject());
+    const float litres = veh ? veh->GetFuel() : 0.0f;
+    if (litres < 2.0f)
+        return;
+    _fuelBallAge = 0.0f;
+    _fuelBallDuration = lighting::FuelBallDuration(litres);
+    _fuelBallDiameter = lighting::FuelBallDiameter(litres);
+    _fuelBallNextFire = 0.0f;
+    _fuelBallNextSoot = 0.08f;
+    // Simulated every frame while it burns (the smoke's own step is 0.3 s).
+    SetSimulationPrecision(1.0f / 30.0f);
+    float rndTime = GRandGen.RandomValue() * 0.4 + 0.8;
+    SetSourceTimes(0, 40 * rndTime, 40 * rndTime);
+}
+
+void SmokeSourceVehicle::SimulateFuelBall(float deltaT)
+{
+    const float age = _fuelBallAge;
+    _fuelBallAge += deltaT;
+    const float dia = _fuelBallDiameter;
+    const Vector3 at = Position();
+    const float groundY = GLandscape->RoadSurfaceY(at.X(), at.Z());
+    // Its light for as long as it burns, warm, from the ball's middle.
+    const float env = lighting::FuelBallEnvelope(age, _fuelBallDuration);
+    if (env > 0.01f)
+    {
+        const float p[3] = {at.X(), groundY + 0.35f * dia, at.Z()};
+        _combatFuelBall.Set(lighting::CombatLightKind::Fire, p, kFuelBallLight * env * dia / 14.0f);
+    }
+    else
+    {
+        _combatFuelBall.Release();
+    }
+    // The burning fuel: puffs born over the first half, swelling and rising
+    // faster as they go (buoyant), cooling from bright orange through deep
+    // orange to soot over about a second.
+    const float emitFor = 0.45f * _fuelBallDuration;
+    _fuelBallNextFire -= deltaT;
+    while (age < emitFor && _fuelBallNextFire <= 0.0f)
+    {
+        _fuelBallNextFire += 1.0f / 30.0f;
+        const float ang = GRandGen.RandomValue() * 2.0f * H_PI;
+        const float rad = 0.22f * dia * sqrtf(GRandGen.RandomValue());
+        const float d = dia * (0.45f + 0.25f * GRandGen.RandomValue());
+        const float h = groundY + 0.38f * d + 0.25f * dia * (age / emitFor) * GRandGen.RandomValue();
+        const Vector3 pos(at.X() + rad * cosf(ang), h, at.Z() + rad * sinf(ang));
+        const Vector3 vel(cosf(ang) * (1.5f + 2.0f * GRandGen.RandomValue()), 1.5f + 2.0f * GRandGen.RandomValue(),
+                          sinf(ang) * (1.5f + 2.0f * GRandGen.RandomValue()));
+        const float birthK = lighting::kFuelBallBirthK * (0.94f + 0.06f * GRandGen.RandomValue());
+        _fire.SetFades(0.25f, 0.0f, 0.9f);
+        _fire.SetShape(GLOB_SCENE->Preloaded(CloudletBasic)); // (resident: Explosion::EmitBurst)
+        _fire.SetTimes(lighting::BurstGlowSeconds(birthK, lighting::kFuelBallCool * 0.7f), kBurstHoldTexture);
+        _fire.SetAlpha(0.95f);
+        _fire.SetTemperatures(birthK, -lighting::kFuelBallCool);
+        _fire.SetClimbRate(3.0f, 0.0f, 9.0f);
+        Cloudlet* puff = _fire.Drop(pos, vel);
+        puff->SetGrowUp(0.25f, d);
+        puff->SetSideSpeed(0, 0, 2.0f, 2.0f);
+        GLOB_WORLD->AddCloudlet(puff);
+    }
+    // The soot: black puffs rolling up out of the ball's top while it burns.
+    _fuelBallNextSoot -= deltaT;
+    while (age < 0.85f * _fuelBallDuration && _fuelBallNextSoot <= 0.0f)
+    {
+        _fuelBallNextSoot += 1.0f / 15.0f;
+        const float ang = GRandGen.RandomValue() * 2.0f * H_PI;
+        const float rad = 0.2f * dia * GRandGen.RandomValue();
+        const float d = dia * (0.4f + 0.2f * GRandGen.RandomValue());
+        const Vector3 pos(at.X() + rad * cosf(ang), groundY + dia * (0.45f + 0.35f * (age / _fuelBallDuration)),
+                          at.Z() + rad * sinf(ang));
+        _darkFire.SetFades(0.6f, 0.15f, 2.5f);
+        _darkFire.SetTimes(2.5f, 1.0f);
+        _darkFire.SetAlpha(0.85f);
+        _darkFire.SetColor(Color(0.05f, 0.045f, 0.04f));
+        _darkFire.SetClimbRate(1.5f, 0.0f, 7.0f);
+        Cloudlet* puff = _darkFire.Drop(pos, Vector3(0, 3.0f, 0) + GLandscape->GetWind() * 0.5f);
+        puff->SetGrowUp(0.8f, d);
+        GLOB_WORLD->AddCloudlet(puff);
+    }
+    if (age > _fuelBallDuration + 0.2f)
+    {
+        _fuelBallAge = -1.0f;
+        _combatFuelBall.Release();
+        SetSimulationPrecision(_interval);
+    }
+}
