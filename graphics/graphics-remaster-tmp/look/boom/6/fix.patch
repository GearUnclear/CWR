+// ---- Munition bursts (look "boom"): each munition's own explosion ----------
+// A cased charge (shell, grenade, warhead) detonates: a very brief white-hot
+// flash, a short orange afterburn of its products, then the dark dust and
+// smoke it threw up, which lingers. Its size and the length of its glow grow
+// with the cube root of the charge (blast scaling). The charge is read from
+// the ammo's blast, indirectHit x indirectHitRange; a 120 mm HE shell (150 x
+// 8) is the reference (about 2.3 kg of explosive: a fireball some 5 m across
+// whose flash is white for a frame and whose afterburn is orange for two or
+// three more, gone to soot by about a quarter of a second).
+constexpr float kBurstRefBlast = 1200.0f;
+constexpr float kBurstRefRadius = 2.4f; // m, the reference fireball's radius
+constexpr float kBurstMinScale = 0.3f;  // linear scale range against the reference
+constexpr float kBurstMaxScale = 1.5f;
+constexpr float kBurstFlashK = 3600.0f;  // the flash puff's birth temperature (white)
+constexpr float kBurstBallK = 3000.0f;   // the fireball puffs' hottest birth
+constexpr float kBurstCoolRef = 6000.0f; // K/s, the reference fireball's cooling
+constexpr float kBurstFlashCoolRef = 20000.0f;
+// A shaped charge (HEAT: indirectHitRange under kBurstShapedRange) throws its
+// fireball up and forward along its jet: narrower and taller.
+constexpr float kBurstShapedRange = 3.0f;
+constexpr float kBurstShapedWidth = 0.6f;
+// The linear scale of a burst against the reference (blast <= 0: unknown, -1).
+float BurstScale(float blast);
+// The classic explosion size (0.25 grenade .. 1 heavy round, from the ammo's
+// hit) read as a scale, for an explosion without its ammo (network copies).
+float BurstScaleFromSize(float exSize);
+float BurstFireballRadius(float scale);
+// K/s of the fireball's puffs and of its flash: the glow lasts as long as the
+// scale (cube root of the charge).
+float BurstCoolRate(float scale);
+float BurstFlashCoolRate(float scale);
+// Seconds a puff born at `birthK` cooling at `rate` glows (to kFireballGlowFullK).
+float BurstGlowSeconds(float birthK, float rate);
+// The dust and smoke a burst threw up linger: the multiplier on the classic
+// crater smoke's puff life (2.4 s) for a crater of this size (0.3 grenade,
+// about 0.7 HEAT, 1 heavy HE).
+float CraterLinger(float craterSize);
+
+// A vehicle's fuel burns as a deflagration: a large, slower, rolling orange
+// fireball with thick soot, then fire and smoke. Its diameter and duration
+// follow the fuel fireball rules D = 5.8 M^(1/3) m and t = 0.45 M^(1/3) s for
+// M kg of fuel in the ball (a share of the tank: the rest pools and burns).
+constexpr float kFuelKgPerLitre = 0.75f;
+constexpr float kFuelBallShare = 0.4f;
+constexpr float kFuelBallMaxDiameter = 16.0f;
+constexpr float kFuelBallBirthK = 2150.0f; // bright orange: soot glowing in a diffuse flame
+constexpr float kFuelBallCool = 520.0f;    // K/s
+float FuelBallDiameter(float litres);
+float FuelBallDuration(float litres);
+// The ball's light and emission over its life (0..1): up in 0.12 s, held,
+// then down by `duration`.
+float FuelBallEnvelope(float age, float duration);
+
 } // namespace Poseidon::lighting
