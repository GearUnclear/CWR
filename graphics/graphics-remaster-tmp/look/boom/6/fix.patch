+         at = shots.find("new Explosion(nullptr, _parent, size);", at + 1))
+        ++news;
+    for (size_t at = shots.find("explosion->SetBlast(Type()->indirectHit * Type()->indirectHitRange,");
+         at != std::string::npos;
+         at = shots.find("explosion->SetBlast(Type()->indirectHit * Type()->indirectHitRange,", at + 1))
+        ++blasts;
+    CHECK(news > 0);
+    CHECK(blasts == news);
+    const std::string smokes =
+        ReadTextFile(EngineDir() / "Poseidon" / "Graphics" / "Rendering" / "Effects" / "Smokes.cpp");
+    const std::string sim = FunctionBody(smokes, "void Explosion::Simulate(");
+    REQUIRE_FALSE(sim.empty());
+    CHECK(sim.find("EmitBurst(prec);") != std::string::npos);
+    const std::string emit = FunctionBody(smokes, "void Explosion::EmitBurst(");
+    REQUIRE_FALSE(emit.empty());
+    CHECK(emit.find("puff->SetGrowUp(0.0f, diameter);") != std::string::npos);
+    CHECK(emit.find("_fire.SetFades(0.0f, 0.0f, fadeOut);") != std::string::npos);
+    CHECK(emit.find("puff->Simulate(0.0f, prec);") != std::string::npos);
+    CHECK(emit.find("saturateMax(pos[1], groundY + 0.4f * d);") != std::string::npos);
+    const std::string crater = FunctionBody(smokes, "void Crater::Init(");
+    REQUIRE_FALSE(crater.empty());
+    CHECK(crater.find("lighting::CraterLinger(size)") != std::string::npos);
+    const std::string craterSim = FunctionBody(smokes, "void Crater::Simulate(");
+    REQUIRE_FALSE(craterSim.empty());
+    CHECK(craterSim.find("if (!_isSmoke)") == std::string::npos);
+    const std::string explode = FunctionBody(smokes, "void SmokeSourceVehicle::SimulateExplosion(");
+    REQUIRE_FALSE(explode.empty());
+    CHECK(explode.find("StartFuelBall();") != std::string::npos);
+    CHECK(explode.find("if (type.hit > 50)") != std::string::npos); // the blast's damage is unchanged
