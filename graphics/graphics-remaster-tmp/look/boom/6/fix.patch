+
+// Look "boom": each munition its own explosion. A cased charge's fireball and
+// the length of its glow grow with the cube root of its charge (read from the
+// ammo's blast, indirectHit x indirectHitRange); a vehicle's fuel burns as a
+// slower, larger deflagration by the fuel fireball rules.
+TEST_CASE("Combat lights: a burst's size and glow follow the cube root of its charge", "[remaster][CombatLights]")
+{
+    using namespace Poseidon::lighting;
+    // 120 mm HE (150 x 8), 120 mm HEAT (300 x 1), a hand grenade (18 x 7).
+    const float he = BurstScale(150.0f * 8.0f);
+    const float heat = BurstScale(300.0f * 1.0f);
+    const float grenade = BurstScale(18.0f * 7.0f);
+    CHECK(he == Catch::Approx(1.0f));
+    CHECK(heat == Catch::Approx(std::cbrt(0.25f)).margin(1e-4));
+    CHECK(grenade == Catch::Approx(std::cbrt(126.0f / 1200.0f)).margin(1e-4));
+    CHECK(BurstScale(0.0f) < 0.0f);
+    CHECK(BurstScale(1e9f) == Catch::Approx(kBurstMaxScale));
+    // The reference fireball is about 5 m across; a grenade's under half that.
+    CHECK(2.0f * BurstFireballRadius(he) == Catch::Approx(4.8f));
+    CHECK(BurstFireballRadius(grenade) < 0.5f * BurstFireballRadius(he));
+    CHECK(BurstFireballRadius(heat) < BurstFireballRadius(he));
+    CHECK(BurstFireballRadius(heat) > BurstFireballRadius(grenade));
+    // The glow: a quarter of a second or so for the heavy shell, a couple of
+    // frames for a grenade, the white flash shorter than the fireball.
+    const float heGlow = BurstGlowSeconds(kBurstBallK, BurstCoolRate(he));
+    const float grenadeGlow = BurstGlowSeconds(kBurstBallK, BurstCoolRate(grenade));
+    CHECK(heGlow > 0.15f);
+    CHECK(heGlow < 0.35f);
+    CHECK(grenadeGlow < 0.5f * heGlow);
+    CHECK(grenadeGlow > 1.0f / 30.0f);
+    CHECK(BurstGlowSeconds(kBurstFlashK, BurstFlashCoolRate(he)) < heGlow);
+    // The flash is born white-hot, the fireball's puffs yellow-white.
+    float albedo[3], flash[3], ball[3];
+    REQUIRE(FireballPuff(kBurstFlashK, 2200.0f, albedo, flash));
+    REQUIRE(FireballPuff(kBurstBallK, 2200.0f, albedo, ball));
+    CHECK(flash[2] > 0.9f * flash[0]);
+    CHECK(ball[1] > 0.9f * ball[0]);
+    // The classic size (hit x 0.003) read as a scale keeps its order.
+    CHECK(BurstScaleFromSize(1.0f) > BurstScaleFromSize(0.25f));
+    CHECK(BurstScaleFromSize(0.25f) >= kBurstMinScale);
+    // The dust and smoke linger longer the bigger the crater.
+    CHECK(CraterLinger(1.0f) > CraterLinger(0.7f));
+    CHECK(CraterLinger(0.7f) > CraterLinger(0.3f));
+    CHECK(2.4f * CraterLinger(1.0f) >= 10.0f); // a heavy shell's column: over 10 s
+    CHECK(2.4f * CraterLinger(0.3f) >= 5.0f);  // a grenade's puff: several seconds
+}
+
+TEST_CASE("Combat lights: a fuel tank burns as a slower, larger fireball", "[remaster][CombatLights]")
+{
+    using namespace Poseidon::lighting;
+    // A Jeep's 50 l: about 14 m across, about a second.
+    CHECK(FuelBallDiameter(50.0f) == Catch::Approx(5.8f * std::cbrt(15.0f)).margin(1e-3));
+    CHECK(FuelBallDiameter(50.0f) > 12.0f);
+    CHECK(FuelBallDuration(50.0f) > 1.0f);
+    CHECK(FuelBallDuration(50.0f) < 1.3f);
+    CHECK(FuelBallDiameter(1e6f) == Catch::Approx(kFuelBallMaxDiameter));
+    CHECK(FuelBallDuration(1e6f) == Catch::Approx(2.0f));
+    // Far larger and slower than the heaviest shell's fireball.
+    CHECK(FuelBallDiameter(50.0f) > 2.5f * 2.0f * BurstFireballRadius(1.0f));
+    CHECK(FuelBallDuration(50.0f) > 3.0f * BurstGlowSeconds(kBurstBallK, BurstCoolRate(1.0f)));
+    // Its light: up within 0.12 s, held, out at its end; nothing outside it.
+    const float t = FuelBallDuration(50.0f);
+    CHECK(FuelBallEnvelope(-0.01f, t) == 0.0f);
+    CHECK(FuelBallEnvelope(0.0f, t) == 0.0f);
+    CHECK(FuelBallEnvelope(0.12f, t) == Catch::Approx(1.0f));
+    CHECK(FuelBallEnvelope(0.4f * t, t) == Catch::Approx(1.0f));
+    CHECK(FuelBallEnvelope(0.8f * t, t) > 0.0f);
+    CHECK(FuelBallEnvelope(0.8f * t, t) < 1.0f);
+    CHECK(FuelBallEnvelope(t, t) == 0.0f);
+    // Its puffs glow orange for about a second, then are soot.
+    const float glow = BurstGlowSeconds(kFuelBallBirthK, kFuelBallCool);
+    CHECK(glow > 1.2f);
+    CHECK(glow < 2.0f);
+    float albedo[3], birth[3];
+    REQUIRE(FireballPuff(kFuelBallBirthK, 2200.0f, albedo, birth));
+    CHECK(birth[0] > 1.0f);
+    CHECK(birth[2] < 0.25f * birth[0]); // orange, never white
+}
