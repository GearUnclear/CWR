diff --git a/arma_CWR/tests/rendering/captures/gen_look_light.py b/arma_CWR/tests/rendering/captures/gen_look_light.py
new file mode 100644
index 0000000..226595b
--- /dev/null
+++ b/arma_CWR/tests/rendering/captures/gen_look_light.py
@@ -0,0 +1,104 @@
+"""Generate the look-light capture tests: the eight hero views of the photoreal
+light and camera lane (switch photoLight), each shot in several lighting modes
+in one game, so the Original (Classic) and the overhaul share camera, clock,
+weather, props and clouds.
+
+    python gen_look_light.py --modes "classic=classic;off=remastered,photoLight=0;on=remastered" [--tag NAME]
+                             [--only view,view] [--frames N]
+
+Writes look_<tag>_<world>.test.sqf + .test.toml next to this file (one test
+per world that has a selected view). Each mode is `label=setting`; the shot of
+view V in mode label L is saved as <V>__<L>.png. 1920x1080 windowed, render
+scale 1.0, 4x MSAA, the presented frame (capgen.header).
+"""
+import argparse
+from pathlib import Path
+
+import capgen
+import views
+
+HERO_NAMES = {
+    "Abel": ["lowsun_fp", "noon_fields", "forest_edge_golden", "sunrise_ridge", "coastline_sunset", "town_night",
+             "woods_pine2_evening", "blue_hour_coast"],
+    "Eden": ["overcast_broken"],
+    "Sinai": ["sinai_desert_noon"],
+}
+TABLES = {"Abel": views.TIMING_ABEL, "Eden": views.TIMING_EDEN, "Sinai": views.TIMING_SINAI}
+SIM_T0, SIM_DT = 2000, 600
+# The lane's own views: the blue hour over the west coast (sun 4.9 deg under
+# the horizon, looking into the afterglow).
+EXTRA = {
+    "blue_hour_coast": dict(name="blue_hour_coast", x=1550, z=5150, eye=3, h=295, p=2, date=[1985, 7, 5, 19, 55],
+                            vd=4000),
+}
+
+
+def find(world, name):
+    if name in EXTRA:
+        return dict(EXTRA[name])
+    for v in TABLES[world]:
+        if v["name"] == name:
+            v = dict(v)
+            v.pop("f10", None)
+            v.pop("note", None)
+            return v
+    raise KeyError(name)
+
+
+def shot(v, label, setting, shot_label, frames):
+    out = [f'"{setting}" call capMode',
+           f"triSimFrames {frames}",
+           "[] call capReadTimers",
+           "[] call capPin"]
+    if v.get("refresh"):
+        out.append(v["refresh"])
+    out += ["triSimFrames 3",
+            f'triScreenshot "{shot_label}"',
+            f'"{shot_label}" call capRecord']
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--modes", required=True, help="label=setting;label=setting;...")
+    ap.add_argument("--tag", default="light")
+    ap.add_argument("--only", default="")
+    ap.add_argument("--frames", type=int, default=90)
+    ap.add_argument("--out", default=str(capgen.HERE))
+    a = ap.parse_args()
+    modes = []
+    for item in a.modes.split(";"):
+        item = item.strip()
+        if not item:
+            continue
+        label, setting = item.split("=", 1)
+        modes.append((label.strip(), setting.strip()))
+    want = {s.strip() for s in a.only.split(",") if s.strip()}
+    written = []
+    index = 0
+    for world, names in HERO_NAMES.items():
+        vs = [find(world, n) for n in names if not want or n in want]
+        if not vs:
+            continue
+        title = f"look-light hero views on {world}: gen_look_light.py, modes {', '.join(m[0] for m in modes)}."
+        lines = [capgen.header(world, vs[0], title)]
+        for v in vs:
+            lines.append(f"\n// ---- {v['name']}")
+            lines += capgen.begin(v, v["name"], False, sim_time=SIM_T0 + SIM_DT * index)
+            index += 1
+            lines.append("triSimFrames 150")
+            for label, setting in modes:
+                lines += shot(v, v["name"], setting, f"{v['name']}__{label}", a.frames)
+            lines += capgen.end(v, False)
+        lines.append('\ncall { "view=done;event=done" call capLog }')
+        lines.append("triEndTest")
+        name = f"look_{a.tag}_{world.lower()}"
+        out = Path(a.out)
+        capgen.write(out / f"{name}.test.sqf", "\n".join(lines) + "\n")
+        capgen.write(out / f"{name}.test.toml", capgen.toml(world, title, views.WORLDS, timeout=3600))
+        written.append(f"tests/rendering/captures/{name}.test.sqf")
+    print(",".join(written))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/arma_CWR/tests/rendering/captures/gen_look_motion.py b/arma_CWR/tests/rendering/captures/gen_look_motion.py
new file mode 100644
index 0000000..89bb4f8
--- /dev/null
+++ b/arma_CWR/tests/rendering/captures/gen_look_motion.py
@@ -0,0 +1,94 @@
+"""Generate the look-light motion captures: the camera moves while the
+photoreal camera (switch photoLight) meters and adapts, to show it does not
+flicker, pump or leave TAA ghosts.
+
+    python gen_look_motion.py [--modes "on=remastered;off=remastered,photoLight=0"] [--tag motion]
+
+Two moves on Abel, each run once per mode:
+  - pan_sun: lowsun_fp's camera turns from 60 degrees left of its heading
+    across the low sun to 30 degrees right of it, 1.5 degrees a frame (a
+    brisk mouse turn), then holds;
+  - shade_open: woods_pine2_evening's camera tilts from 30 degrees down at the
+    shaded forest floor up to 25 degrees through the crowns into the sky and
+    back down, 1 degree a frame, then holds.
+Every frame logs the camera's readout (triFeatureState's "| cam ev= target="
+part) as event=motion; every `--every` frames a screenshot <move>__<mode>_<NNN>.
+"""
+import argparse
+from pathlib import Path
+
+import capgen
+import views
+
+MOVES = {
+    "pan_sun": dict(view="lowsun_fp", axis="h", path=[(-60.0, 30.0, 1.5)], hold=90),
+    "shade_open": dict(view="woods_pine2_evening", axis="p", path=[(-30.0, 25.0, 1.0), (25.0, -30.0, 1.0)], hold=90),
+}
+
+
+def find(name):
+    for v in views.TIMING_ABEL:
+        if v["name"] == name:
+            v = dict(v)
+            v.pop("f10", None)
+            v.pop("note", None)
+            return v
+    raise KeyError(name)
+
+
+def steps(path):
+    out = []
+    for a, b, d in path:
+        n = int(round(abs(b - a) / d))
+        s = d if b > a else -d
+        out += [a + s * i for i in range(n + 1)]
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--modes", default="on=remastered;off=remastered,photoLight=0")
+    ap.add_argument("--tag", default="motion")
+    ap.add_argument("--every", type=int, default=10)
+    ap.add_argument("--out", default=str(capgen.HERE))
+    a = ap.parse_args()
+    modes = [tuple(x.strip() for x in m.split("=", 1)) for m in a.modes.split(";") if m.strip()]
+    first = find(MOVES["pan_sun"]["view"])
+    title = "look-light motion captures on Abel: gen_look_motion.py (pan across a low sun, shade to sky)."
+    lines = [capgen.header("Abel", first, title)]
+    index = 0
+    for move, spec in MOVES.items():
+        v = find(spec["view"])
+        base = v["h"] if spec["axis"] == "h" else v["p"]
+        for label, setting in modes:
+            name = f"{move}__{label}"
+            lines.append(f"\n// ---- {name}")
+            lines += capgen.begin(v, name, False, sim_time=2000 + 600 * index)
+            index += 1
+            lines.append("triSimFrames 150")
+            lines.append(f'"{setting}" call capMode')
+            var = "capH" if spec["axis"] == "h" else "capP"
+            offs = steps(spec["path"])
+            lines.append(f"call {{ {var} = {capgen.num(base + offs[0])}; [] call capPinView }}")
+            lines.append("triSimFrames 120")
+            frame = 0
+            for k, o in enumerate(offs + [offs[-1]] * spec["hold"]):
+                lines.append(f"call {{ {var} = {capgen.num(base + o)}; [] call capPinView }}")
+                lines.append("triSimFrames 1")
+                lines.append(f'call {{ format ["view=%1;event=motion;move={move};mode={label};frame={frame};'
+                             f'offset={capgen.num(o)};feat=%2", capView, triFeatureState] call capLog }}')
+                if frame % a.every == 0:
+                    lines.append(f'triScreenshot "{name}_{frame:03d}"')
+                frame += 1
+            lines += capgen.end(v, False)
+    lines.append('\ncall { "view=done;event=done" call capLog }')
+    lines.append("triEndTest")
+    out = Path(a.out)
+    stem = f"look_{a.tag}_abel"
+    capgen.write(out / f"{stem}.test.sqf", "\n".join(lines) + "\n")
+    capgen.write(out / f"{stem}.test.toml", capgen.toml("Abel", title, views.WORLDS, timeout=3600))
+    print(f"tests/rendering/captures/{stem}.test.sqf")
+
+
+if __name__ == "__main__":
+    main()
