+// ---- Only puddles mirror (the owner's rule) -----------------------------------
+
+namespace
+{
+float ShaderConstant(const std::string& src, const char* name)
+{
+    const std::regex re(std::string("const float ") + name + R"( = ([0-9.]+);)");
+    std::smatch m;
+    if (!std::regex_search(src, m, re))
+        return -1.0f;
+    return std::stof(m[1].str());
+}
+
+// wetLobe's C++ mirror (EngineGL33_LightingShadersSurface.cpp): GGX with the
+// light a small sphere, water's Fresnel, no cap.
+float WetLobeMirror(const float L[3], float d, const float v[3], float a)
+{
+    const float nl = L[1];
+    if (nl <= 0.0f)
+        return 0.0f;
+    const float nv = std::max(v[1], 1e-3f);
+    const float aP = std::clamp(a + 0.15f / (2.0f * std::max(d, 0.1f)), 0.0f, 1.0f);
+    const float norm = (a / aP) * (a / aP);
+    float h[3] = {L[0] + v[0], L[1] + v[1], L[2] + v[2]};
+    const float hl = std::sqrt(h[0] * h[0] + h[1] * h[1] + h[2] * h[2]);
+    for (float& c : h)
+        c /= hl;
+    const float nh = std::max(h[1], 0.0f);
+    const float vh = std::max(v[0] * h[0] + v[1] * h[1] + v[2] * h[2], 0.0f);
+    const float a2 = aP * aP;
+    const float dd = nh * nh * (a2 - 1.0f) + 1.0f;
+    const float D = a2 / (3.14159265f * dd * dd);
+    const float vis =
+        0.5f / std::max(nl * std::sqrt(nv * nv * (1.0f - a2) + a2) + nv * std::sqrt(nl * nl * (1.0f - a2) + a2), 1e-5f);
+    const float F = 0.02f + 0.98f * std::pow(1.0f - vh, 5.0f);
+    return 3.14159265f * D * vis * nl * norm * F;
+}
+
+void Normalize3(float p[3])
+{
+    const float l = std::sqrt(p[0] * p[0] + p[1] * p[1] + p[2] * p[2]);
+    for (int i = 0; i < 3; ++i)
+        p[i] /= l;
+}
+} // namespace
