+TEST_CASE("Wet weather: only the puddles mirror, the wet ground around them darkens and glints dimly",
+          "[remaster][wet][ssr][Shaders]")
+{
+    const std::string surface = gl::RemasterFragmentPiece(gl::FragmentPiece::Surface);
+    const std::string trace = gl::PostShaderSource(gl::PostShader::SsrTrace);
+    // The trace: with the wet weather, ground outside the water reflects
+    // nothing (no trace at all), and the water is a clear mirror to its edge.
+    CHECK(trace.find(
+              "if (puddle <= kSsrMirrorMin) {\n                fragColor = packResult(vec3(0.0), reflOnly ? 0.0 : 1.0, "
+              "surface);") != std::string::npos);
+    CHECK(trace.find("float weight = mix(wetWeather ? 0.0 : ") != std::string::npos);
+    CHECK(trace.find("float cone = wetWeather ? kSsrMirrorCone : ") != std::string::npos);
+    CHECK(trace.find("0.02, wetWeather ? 1.0 : puddle);") != std::string::npos);
+    CHECK(ShaderConstant(trace, "kSsrMirrorMin") > 0.0f);
+    CHECK(ShaderConstant(trace, "kSsrMirrorMin") < 0.01f);
+    CHECK(ShaderConstant(trace, "kSsrMirrorCone") <= 0.005f);
+
+    // The forward pass: the ground keeps a thin rough share of the film, and
+    // every wet bare ground darkens and deepens a little.
+    const float sheen = ShaderConstant(surface, "kWetGroundSheen");
+    const float rough = ShaderConstant(surface, "kWetGroundRough");
+    const float view = ShaderConstant(surface, "kWetGroundGlintView");
+    CHECK(sheen > 0.0f);
+    CHECK(sheen <= 0.35f);
+    CHECK(rough >= 0.5f);
+    CHECK(view >= 0.4f);
+    CHECK(ShaderConstant(surface, "kWetGroundDarkBase") > 0.1f);
+    CHECK(ShaderConstant(surface, "kWetGroundSat") <= 0.15f);
+    CHECK(surface.find("* (ground ? kWetGroundSheen : 1.0);") != std::string::npos);
+    CHECK(surface.find("if (ground) rough = max(rough, kWetGroundRough);") != std::string::npos);
+    CHECK(surface.find("lit += wetLampStreaks(nf, vg, rough) * (film * (1.0 - pud.x));") != std::string::npos);
+    // The puddle's own lobe keeps the true view: its streak is the water's.
+    CHECK(surface.find("lit += wetLampStreaks(nf, v, kWetPuddleRough) * pud.x;") != std::string::npos);
+
+    // The glint's shape: a fire 0.5 m high, 9 m ahead of an eye 1.75 m above
+    // the ground, the light falling off with the square of its distance. With
+    // the true grazing view even the rough lobe is a bright tongue reaching
+    // from the light toward the eye (the grazing Fresnel and the mirror
+    // alignment); seen from at least kWetGroundGlintView it is a dim, rounder
+    // pool at the light's foot.
+    const float a = rough * rough;
+    const auto image = [&](float x, float z, bool raise)
+    {
+        float L[3] = {-x, 0.5f, 9.0f - z};
+        const float d2 = L[0] * L[0] + L[1] * L[1] + L[2] * L[2];
+        Normalize3(L);
+        float v[3] = {-x, 1.75f, -z};
+        Normalize3(v);
+        if (raise)
+        {
+            v[1] = std::max(v[1], view * std::sqrt(v[0] * v[0] + v[2] * v[2]));
+            Normalize3(v);
+        }
+        return WetLobeMirror(L, std::sqrt(d2), v, a) / (d2 + 0.25f);
+    };
+    float gMax = 0.0f, rMax = 0.0f, gZ = 0.0f, rZ = 0.0f;
+    for (int i = 0; i <= 160; ++i)
+    {
+        const float z = 1.0f + 0.05f * static_cast<float>(i); // 1 .. 9 m
+        if (image(0.0f, z, false) > gMax)
+            gMax = image(0.0f, z, false), gZ = z;
+        if (image(0.0f, z, true) > rMax)
+            rMax = image(0.0f, z, true), rZ = z;
+    }
+    // Far dimmer, also along the tongue toward the eye (3.5 m short of the light).
+    CHECK(rMax < 0.35f * gMax);
+    CHECK(image(0.0f, 5.5f, true) < 0.35f * image(0.0f, 5.5f, false));
+    // At least as wide across as the grazing lobe: a pool, not a streak.
+    const auto halfWidth = [&](float z, float peak, bool raise)
+    {
+        float x = 0.0f;
+        while (x < 4.0f && image(x, z, raise) >= 0.5f * peak)
+            x += 0.02f;
+        return x;
+    };
+    CHECK(halfWidth(rZ, rMax, true) >= halfWidth(gZ, gMax, false));
+    CHECK(rZ >= gZ); // and no nearer the eye
+
+    // The puddle threshold: bare ground's up to kPuddleGrassFrom, grass's at a
+    // full grass share, rising smoothly between (no step, no seam).
+    const std::string puddles = gl::RemasterFragmentPiece(gl::FragmentPiece::Puddles);
+    const float from = ShaderConstant(puddles, "kPuddleGrassFrom");
+    CHECK(from >= 0.4f);
+    CHECK(from <= 0.8f);
+    const float g = ShaderConstant(puddles, "kPuddleGround");
+    const float gr = ShaderConstant(puddles, "kPuddleGrass");
+    const auto th = [&](float veg)
+    {
+        const float t = std::clamp((veg - from) / (1.0f - from), 0.0f, 1.0f);
+        return g + (gr - g) * t * t * (3.0f - 2.0f * t);
+    };
+    CHECK(th(0.3f) == Catch::Approx(g));
+    CHECK(th(1.0f) == Catch::Approx(gr));
+    float prev = th(0.0f);
+    for (int i = 1; i <= 100; ++i)
+    {
+        const float t = th(static_cast<float>(i) / 100.0f);
+        CHECK(t >= prev);
+        CHECK(t - prev < 0.004f);
+        prev = t;
+    }
+}
