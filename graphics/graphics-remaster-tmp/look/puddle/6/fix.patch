+TEST_CASE("Wet weather ground: only the puddles mirror, the ground around them darkens and glints dimly",
+          "[remaster][wet][ssr][Shaders]")
+{
+    const std::string surface = gl::RemasterFragmentPiece(gl::FragmentPiece::Surface);
+    const std::string puddles = gl::RemasterFragmentPiece(gl::FragmentPiece::Puddles);
+    const std::string trace = gl::PostShaderSource(gl::PostShader::SsrTrace);
+
+    // The trace: with the wet weather the ground outside the puddles keeps
+    // (almost) none of B6's sheen; the puddles stay full mirrors.
+    CHECK(SurfaceConstant(trace, "kSsrDampWeight") <= 0.05f);
+    CHECK(trace.find("* (wetWeather ? kSsrDampWeight : 1.0);") != std::string::npos);
+    CHECK(trace.find("float weight = mix(sheen, 1.0, puddle);") != std::string::npos);
+    // A puddle mirrors sharp, a little wider in the rain where its rings are
+    // finer than a pixel, and its water reads on where the trace lost its way.
+    CHECK(SurfaceConstant(trace, "kSsrPuddleCone") <= 0.01f);
+    CHECK(SurfaceConstant(trace, "kSsrPuddleRainCone") <= 0.01f);
+    CHECK(trace.find("wetWeather ? kSsrPuddleFill * puddle : 0.0);") != std::string::npos);
+
+    // The forward pass: the ground's film is rough everywhere outside the
+    // water, so a lamp never draws a streak there, and only a share of it
+    // glints; bare ground soaks at least kWetGroundSeal (darker and deeper).
+    const float groundRough = SurfaceConstant(surface, "kWetGroundRough");
+    const float glint = SurfaceConstant(surface, "kWetGroundGlint");
+    CHECK(groundRough >= 0.5f);
+    CHECK(glint <= 0.5f);
+    CHECK(surface.find("float rough = ground ? max(mix(kWetFilmRough, kWetGrassRough, veg), kWetGroundRough) :") !=
+          std::string::npos);
+    CHECK(surface.find("lit += wetLampStreaks(nf, v, rough) * (film * glint * (1.0 - pud.x));") != std::string::npos);
+    CHECK(surface.find("lit += wetLampStreaks(nf, v, kWetPuddleRough) * pud.x;") != std::string::npos);
+    CHECK(surface.find("if (ground) soak = max(soak, kWetGroundSeal * (1.0 - veg));") != std::string::npos);
+    CHECK(SurfaceConstant(surface, "kWetGroundSeal") >= 0.5f);
+    // The darker wet rim around each puddle, over a short margin.
+    CHECK(SurfaceConstant(surface, "kWetDampDark") <= 0.8f);
+    CHECK(SurfaceConstant(puddles, "kPuddleDamp") <= 0.1f);
+
+    // A street lamp 5 m up, 12 m ahead of an eye 1.75 m up: where the wet
+    // ground would mirror it (3.1 m ahead), the ground's glint (its lobe on its
+    // share of a full film) is under 5 % of a puddle's at the same spot, and
+    // still there (a dim, broad glint, not black).
+    const float x = 12.0f * 1.75f / 6.75f;
+    float v[3] = {-x, 1.75f, 0.0f};
+    float L[3] = {12.0f - x, 5.0f, 0.0f};
+    const float dv = std::sqrt(v[0] * v[0] + v[1] * v[1]);
+    const float dl = std::sqrt(L[0] * L[0] + L[1] * L[1]);
+    for (int i = 0; i < 2; ++i)
+    {
+        v[i] /= dv;
+        L[i] /= dl;
+    }
+    const float up[3] = {0.0f, 1.0f, 0.0f};
+    const float cap = SurfaceConstant(surface, "kWetSpecCap");
+    const float puddleRough = SurfaceConstant(surface, "kWetPuddleRough");
+    const float pud = WetLobeMirror(L, dl, up, v, puddleRough * puddleRough, cap);
+    const float gnd = WetLobeMirror(L, dl, up, v, groundRough * groundRough, cap) * glint;
+    CHECK(pud > 1.0f);
+    CHECK(gnd > 0.0f);
+    CHECK(gnd < 0.05f * pud);
+    // Broad: half a metre to the side of that spot the ground's glint keeps
+    // over a third of its peak (no thin line toward the eye), the puddle's
+    // under a tenth.
+    float v2[3] = {-x, 1.75f, 0.5f};
+    float L2[3] = {12.0f - x, 5.0f, 0.5f};
+    const float dv2 = std::sqrt(v2[0] * v2[0] + v2[1] * v2[1] + v2[2] * v2[2]);
+    const float dl2 = std::sqrt(L2[0] * L2[0] + L2[1] * L2[1] + L2[2] * L2[2]);
+    for (int i = 0; i < 3; ++i)
+    {
+        v2[i] /= dv2;
+        L2[i] /= dl2;
+    }
+    CHECK(WetLobeMirror(L2, dl2, up, v2, groundRough * groundRough, cap) * glint > gnd / 3.0f);
+    CHECK(WetLobeMirror(L2, dl2, up, v2, puddleRough * puddleRough, cap) < 0.1f * pud);
+}
+
+TEST_CASE("Wet weather puddles: one set of rain rings moves the mirror and the glints, calm below the pixel",
+          "[remaster][wet][ssr][Shaders]")
+{
+    const std::string puddles = gl::RemasterFragmentPiece(gl::FragmentPiece::Puddles);
+    const std::string surface = gl::RemasterFragmentPiece(gl::FragmentPiece::Surface);
+    const std::string trace = gl::PostShaderSource(gl::PostShader::SsrTrace);
+    // The rings live in the shared puddles piece, once in the prelude and once
+    // in the trace.
+    CHECK(puddles.find("vec2 wetRainRings(vec2 p, float t) {") != std::string::npos);
+    CHECK(puddles.find("vec2 puddleRings(vec2 xz, float footT, float rain, float t) {") != std::string::npos);
+    CHECK(surface.find("vec2 wetRainRings(") == std::string::npos);
+    CHECK(CountOf(gl::RemasterFragmentCommon(), "vec2 wetRainRings(") == 1);
+    CHECK(CountOf(trace, "vec2 wetRainRings(") == 1);
+    // They fade out as the pixel's footprint grows past a ring's crest; the
+    // chop (a gentle tilt over a third of a metre, so a mirrored edge wavers)
+    // lasts a little further, and below its scale the water is calm.
+    CHECK(SurfaceConstant(puddles, "kPuddleRingFootFull") < SurfaceConstant(puddles, "kPuddleRingFootNone"));
+    CHECK(puddles.find("float k = 1.0 - smoothstep(kPuddleRingFootFull, kPuddleRingFootNone, footT);") !=
+          std::string::npos);
+    CHECK(SurfaceConstant(puddles, "kPuddleChopFootFull") < SurfaceConstant(puddles, "kPuddleChopFootNone"));
+    CHECK(SurfaceConstant(puddles, "kPuddleRingFootNone") <= SurfaceConstant(puddles, "kPuddleChopFootFull"));
+    CHECK(puddles.find("float c = 1.0 - smoothstep(kPuddleChopFootFull, kPuddleChopFootNone, footT);") !=
+          std::string::npos);
+    CHECK(SurfaceConstant(puddles, "kPuddleChop") <= 0.5f);
+    // Dry, the water is still.
+    CHECK(puddles.find("if (r <= 0.0) return vec2(0.0);") != std::string::npos);
+    // The forward pass's puddle normal and the trace's mirror take the same
+    // rings (the trace at its half-resolution footprint).
+    CHECK(surface.find("vec2 g = puddleRings(posAbs.xz, footT, litWeather.y, litWeather.w);") != std::string::npos);
+    CHECK(trace.find("vec2 g = puddleRings(posW.xz, 2.0 * footT, rain, litWeather.w);") != std::string::npos);
+    CHECK(SurfaceConstant(trace, "kSsrRingTilt") <= SurfaceConstant(surface, "kWetRingTilt"));
+}
