+TEST_CASE("Wet weather shaders: only puddles mirror; the ground outside them is darker, with a dim rough film",
+          "[remaster][wet][ssr][Shaders]")
+{
+    const std::string surface = gl::RemasterFragmentPiece(gl::FragmentPiece::Surface);
+    const std::string trace = gl::PostShaderSource(gl::PostShader::SsrTrace);
+    const auto constant = [](const std::string& src, const char* name)
+    {
+        const std::regex re(std::string("const float ") + name + R"( = ([0-9.]+);)");
+        std::smatch m;
+        INFO(name);
+        REQUIRE(std::regex_search(src, m, re));
+        return std::stof(m[1].str());
+    };
+    // The owner: "too much reflection on non puddle surfaces". The ground's
+    // film outside the puddles (its lamp streaks, sun glint and sky) is a
+    // small share of an object's and rough: a dim, broad glint near a light.
+    CHECK(constant(surface, "kWetGroundFilm") <= 0.15f);
+    CHECK(constant(surface, "kWetGroundFilmRough") >= 0.5f);
+    CHECK(surface.find("kWetGrassFilm * w * veg) * (ground ? kWetGroundFilm : 1.0);") != std::string::npos);
+    CHECK(surface.find("mix(kWetFilmRough, kWetGrassRough, veg), ground ? kWetGroundFilmRough : 0.0);") !=
+          std::string::npos);
+    // The puddles keep their own mirror: their lamp lobe and darkening.
+    CHECK(surface.find("lit += wetLampStreaks(nf, v, kWetPuddleRough) * pud.x;") != std::string::npos);
+    // The reflections' pass: under the wet weather the ground outside the
+    // puddles keeps a few percent of B6's sheen; a puddle is a full mirror.
+    CHECK(constant(trace, "kSsrWetSheen") <= 0.1f);
+    CHECK(trace.find("(wetWeather ? kSsrWetSheen : 1.0);") != std::string::npos);
+    CHECK(trace.find("float weight = mix(sheen, 1.0, puddle);") != std::string::npos);
+}
