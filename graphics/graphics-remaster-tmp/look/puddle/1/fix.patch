+} // namespace
+
+TEST_CASE("Wet weather ground: only standing water mirrors; the wet face darkens and glints broadly",
+          "[remaster][wet][Shaders]")
+{
+    const std::string surface = gl::RemasterFragmentPiece(gl::FragmentPiece::Surface);
+    const auto constant = [&](const char* name)
+    {
+        const std::regex re(std::string("const float ") + name + R"( = ([0-9.]+);)");
+        std::smatch m;
+        INFO(name);
+        REQUIRE(std::regex_search(surface, m, re));
+        return std::stof(m[1].str());
+    };
+
+    // Water's optics (n 1.333): F0, its diffuse external reflectance and the
+    // internal one that Lekner and Dorf's darkening needs, from Fresnel.
+    const double nWater = 1.333;
+    const double re = DiffuseReflectance(1.0, nWater);
+    const double ri = DiffuseReflectance(nWater, 1.0);
+    INFO("r_e " << re << " r_i " << ri);
+    CHECK(constant("kWaterRe") == Catch::Approx(re).margin(0.002));
+    CHECK(constant("kWaterRi") == Catch::Approx(ri).margin(0.002));
+    CHECK(ri == Catch::Approx(1.0 - (1.0 - re) / (nWater * nWater)).margin(0.002));
+    CHECK(std::pow((nWater - 1.0) / (nWater + 1.0), 2.0) == Catch::Approx(0.02).margin(0.001));
+
+    // Lekner and Dorf: the ground under water keeps (1 - r_e)(1 - r_i) / (1 - r_i A)
+    // of its albedo. A puddle's darkening is that ratio at the land's albedo
+    // (about 0.2 linear), and brighter channels keep more (the colour deepens).
+    CHECK(surface.find("return vec3((1.0 - kWaterRe) * (1.0 - kWaterRi)) / (1.0 - kWaterRi * clamp(A, 0.0, 1.0));") !=
+          std::string::npos);
+    const auto ld = [&](double A) { return (1.0 - re) * (1.0 - ri) / (1.0 - ri * A); };
+    CHECK(constant("kWetPuddleDark") == Catch::Approx(ld(0.2)).margin(0.015));
+    CHECK(ld(0.4) > ld(0.1));
+    CHECK(ld(0.1) > 0.5);
+    CHECK(ld(0.4) < 0.62);
+    // Dense ground darkens on most of its face, grass on its beads only.
+    CHECK(constant("kWetSoakDense") >= 0.5f);
+    CHECK(constant("kWetSoakGrass") <= 0.25f);
+    CHECK(surface.find("a *= mix(vec3(1.0), wetLeknerDorf(a), soakG)") != std::string::npos);
+
+    // The wet face's roughness is its relief's (the water fills only the fine
+    // grain): asphalt below bare ground below grass, all a GGX a of a third or
+    // more, where a puddle is still water.
+    const float road = constant("kWetRoughRoad");
+    const float bare = constant("kWetRoughBare");
+    const float grass = constant("kWetRoughGrass");
+    const float puddle = constant("kWetPuddleRough");
+    CHECK(road < bare);
+    CHECK(bare < grass);
+    CHECK(road * road >= 0.33f);
+    CHECK(puddle <= 0.05f);
+    CHECK(surface.find("if (filmG > 0.0) lit += wetLampStreaks(n, v, roughG) * filmG;") != std::string::npos);
+    CHECK(surface.find("if (pud.x > 0.0) lit += wetLampStreaks(nP, v, kWetPuddleRough) * pud.x;") != std::string::npos);
+    // Its sky is the sky light around the reflected direction, never the sharp
+    // sky (an image) on the wet face.
+    CHECK(surface.find("vec3 rG = normalize(mix(reflect(-v, n), n, roughG * roughG));") != std::string::npos);
+    CHECK(surface.find("lit += surfaceSkyIrradiance(rG, false) * (fG * skyVisibility * litHorizon.w);") !=
+          std::string::npos);
+
+    // A street lamp 5 m up, 12 m ahead of an eye 1.75 m above the wet ground:
+    // walking the ground between them, the brightest glint the wet face gives
+    // (asphalt, its glossiest) is a small share of a puddle's at the same spot
+    // and far broader: no streak and nothing recognisable outside the puddles.
+    const float up[3] = {0.0f, 1.0f, 0.0f};
+    float peakFace = 0.0f, peakPuddle = 0.0f;
+    std::vector<float> face, pud;
+    for (float z = 0.5f; z < 12.0f; z += 0.02f)
+    {
+        float L[3] = {0.0f, 5.0f, 12.0f - z};
+        float V[3] = {0.0f, 1.75f, -z};
+        const float dl = std::sqrt(L[0] * L[0] + L[1] * L[1] + L[2] * L[2]);
+        const float dv = std::sqrt(V[0] * V[0] + V[1] * V[1] + V[2] * V[2]);
+        for (int k = 0; k < 3; ++k)
+        {
+            L[k] /= dl;
+            V[k] /= dv;
+        }
+        face.push_back(WetLobeMirror(L, dl, up, V, std::max(road * road, 0.002f), 80.0f));
+        pud.push_back(WetLobeMirror(L, dl, up, V, std::max(puddle * puddle, 0.002f), 80.0f));
+        peakFace = std::max(peakFace, face.back());
+        peakPuddle = std::max(peakPuddle, pud.back());
+    }
+    int wideFace = 0, widePuddle = 0;
+    for (size_t i = 0; i < face.size(); ++i)
+    {
+        wideFace += face[i] > 0.5f * peakFace ? 1 : 0;
+        widePuddle += pud[i] > 0.5f * peakPuddle ? 1 : 0;
+    }
+    INFO("peak face " << peakFace << " puddle " << peakPuddle << ", half widths " << wideFace << " | " << widePuddle);
+    CHECK(peakFace < 0.05f * peakPuddle);
+    CHECK(wideFace > 10 * widePuddle);
+
+    // The reflections' trace mirrors the puddles alone while the wet weather
+    // shades the ground: level water at water's smoothness, weighted by the
+    // pixel's share of it, and no trace at all on the wet face around them.
+    const std::string trace = gl::PostShaderSource(gl::PostShader::SsrTrace);
+    CHECK(trace.find("if (puddle <= 0.0) {\n                fragColor = packResult(vec3(0.0), reflOnly ? 0.0 : 1.0, "
+                     "surface);\n                return;") != std::string::npos);
+    CHECK(trace.find("float weight = wetWeather ? puddle : ") != std::string::npos);
+    CHECK(trace.find("float rough = wetWeather ? 0.02 : ") != std::string::npos);
+    CHECK(trace.find("float cone = wetWeather ? 0.008 : ") != std::string::npos);
+    CHECK(trace.find("vec3(0.0, 1.0, 0.0), wetWeather ? 1.0 : mix(0.6, 1.0, puddle)") != std::string::npos);
+}
