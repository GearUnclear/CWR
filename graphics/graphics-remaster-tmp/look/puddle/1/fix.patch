+// ---- The wet ground: only puddles mirror (a physically based wet surface) -----
+
+namespace
+{
+
+// Unpolarised Fresnel reflectance from a medium of index n1 into n2 at the
+// cosine ci of the incidence angle (1 past the critical angle).
+double FresnelUnpolarised(double ci, double n1, double n2)
+{
+    const double s = n1 / n2 * std::sqrt(std::max(0.0, 1.0 - ci * ci));
+    if (s >= 1.0)
+        return 1.0;
+    const double ct = std::sqrt(1.0 - s * s);
+    const double rs = (n1 * ci - n2 * ct) / (n1 * ci + n2 * ct);
+    const double rp = (n1 * ct - n2 * ci) / (n1 * ct + n2 * ci);
+    return 0.5 * (rs * rs + rp * rp);
+}
+
+// Diffuse (hemispherical, cosine-weighted) reflectance of a flat interface.
+double DiffuseReflectance(double n1, double n2)
+{
+    const int steps = 4000;
+    const double dt = 0.5 * 3.14159265358979 / steps;
+    double sum = 0.0;
+    for (int i = 0; i < steps; ++i)
+    {
+        const double t = (i + 0.5) * dt;
+        sum += FresnelUnpolarised(std::cos(t), n1, n2) * 2.0 * std::sin(t) * std::cos(t) * dt;
+    }
+    return sum;
+}
+
+// The shaders' wetLobe (pi D V F (n.l), GGX, the light a small sphere of
+// kWetBulb 0.15 m, the peak capped), for a light at distance d along unit L.
+float WetLobeMirror(const float L[3], float d, const float n[3], const float v[3], float a, float cap)
+{
+    const float nl = L[0] * n[0] + L[1] * n[1] + L[2] * n[2];
+    if (nl <= 0.0f)
+        return 0.0f;
+    const float nv = std::clamp(n[0] * v[0] + n[1] * v[1] + n[2] * v[2], 1e-3f, 1.0f);
+    const float aP = std::clamp(a + 0.15f / (2.0f * std::max(d, 0.1f)), 0.0f, 1.0f);
+    const float norm = (a / aP) * (a / aP);
+    float h[3] = {L[0] + v[0], L[1] + v[1], L[2] + v[2]};
+    const float hl = 1.0f / std::sqrt(std::max(h[0] * h[0] + h[1] * h[1] + h[2] * h[2], 1e-12f));
+    for (float& c : h)
+        c *= hl;
+    const float nh = std::max(n[0] * h[0] + n[1] * h[1] + n[2] * h[2], 0.0f);
+    const float vh = std::max(v[0] * h[0] + v[1] * h[1] + v[2] * h[2], 0.0f);
+    const float a2 = aP * aP;
+    const float dd = nh * nh * (a2 - 1.0f) + 1.0f;
+    const float D = a2 / (3.14159265f * dd * dd);
+    const float vis =
+        0.5f / std::max(nl * std::sqrt(nv * nv * (1.0f - a2) + a2) + nv * std::sqrt(nl * nl * (1.0f - a2) + a2), 1e-5f);
+    const float F = 0.02f + 0.98f * std::pow(1.0f - vh, 5.0f);
+    return std::min(3.14159265f * D * vis * nl * norm, cap) * F;
+}
