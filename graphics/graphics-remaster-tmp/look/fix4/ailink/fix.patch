+            h[static_cast<size_t>(z) * n + x] = 20.0f + 3.0f * std::fabs(static_cast<float>(x - 20)) +
+                                                0.5f * static_cast<float>(z % 7);
+    const std::shared_ptr<const FogSightMap> map = BuildFogSightMap(h.data(), n, 25.0f, 16);
