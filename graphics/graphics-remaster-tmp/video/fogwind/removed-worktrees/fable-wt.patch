+    // the same sign over whole regions, and the far haze and the valley mist
+    // pumped as one sheet. Then the offset turned per cell by an
+    // interleaved-gradient pattern (d91a08e0): the pump went, but the pattern
+    // is a ramp over the cells, so with the frame's step the next frame's
+    // field was this frame's read one cell over, and the residual slid
+    // through the fog as wind. Now the cell's two taps are fixed
+    // (VolumetricFog.hpp kFogTapZ, kFogTapXY: depth strata of the slice on
+    // the diagonal quarter points of the cell, weighted by their metres) and
+    // the history is read at the cell's centre.
+    const std::string inject = gl::PostShaderSource(gl::PostShader::FogInject);
+    REQUIRE_FALSE(inject.empty());
+    CHECK(CountOf(inject, "const float kFogTapZ[2] = float[2](0.25, 0.75);") == 1);
+    CHECK(kFogTapZ[0] == 0.25f);
+    CHECK(kFogTapZ[1] == 0.75f);
+    CHECK(CountOf(inject, "const vec2 kFogTapXY[2] = vec2[2](vec2(-0.25, -0.25), vec2(0.25, 0.25));") == 1);
+    CHECK(kFogTapXY[0][0] == -0.25f);
+    CHECK(kFogTapXY[0][1] == -0.25f);
+    CHECK(kFogTapXY[1][0] == 0.25f);
+    CHECK(kFogTapXY[1][1] == 0.25f);
+    CHECK(CountOf(inject, "fogSliceDepth((s + kFogTapZ[i] + 0.25) / fogGrid.z) - fogSliceDepth((s + kFogTapZ[i] - 0.25) / "
+                          "fogGrid.z)") == 1);
+    CHECK(CountOf(inject, "acc += w * fogCell(g_tapDir[i] * fogSliceDepth((s + kFogTapZ[i]) / fogGrid.z));") == 1);
+    CHECK(CountOf(inject, "vec2 ndcI = (gl_FragCoord.xy + kFogTapXY[i]) / fogGrid.xy * 2.0 - 1.0;") == 1);
+    // The history is read at the cell's centre (read at the sample it was a
+    // leaky sum of the offsets, not their average).
+    CHECK(CountOf(inject, "vec3 rel = dirZ * fogSliceDepth((s + 0.5) / fogGrid.z);") == 1);
+    CHECK(CountOf(inject, "cur = mix(texture(fogHistory, vec3(puv, pt)), cur, fogFrame.z);") == 1);
+    // The integration reads the volume through the 3 x 3 x 3 tent that gives
+    // the fixed quadrature the mist's softness (a display filter: the same on
+    // a held and a moving camera, nothing compounds through the history).
+    const std::string integrate = gl::PostShaderSource(gl::PostShader::FogIntegrate);
+    REQUIRE_FALSE(integrate.empty());
+    CHECK(CountOf(integrate, "vec3 hc = vec3(0.5 / fogGrid.xy, 0.5 / fogGrid.z);") == 1);
+    CHECK(CountOf(integrate, "v += texture(fogInject, tc + o * hc);") == 1);
+    CHECK(CountOf(integrate, "v *= 0.000125;") == 1);
+    CHECK(CountOf(integrate, "texelFetch(fogInject") == 0);
+    // Nothing in the injection moves with the frame: no jitter uniform is
+    // read and no per-cell noise is left.
+    CHECK(CountOf(inject, "fogDepth.w") == 0);
+    CHECK(CountOf(inject, "fogFrame.xy") == 0);
+    CHECK(CountOf(inject, "fogCellNoise") == 0);
+    CHECK(CountOf(inject, "fract(fogDepth") == 0);
+    CHECK(CountOf(inject, "fract(fogFrame") == 0);
+
+    // The two failures on the mirror, so the test knows them: the frame-wide
+    // offset pumps (the block mean swings by about 3% of a slice, and the far
+    // slices are hundreds of metres deep) without travelling; the per-cell
+    // gradient pattern does not pump but travels (its residual field is the
+    // last frame's at a one-cell lag).
+    auto fract = [](double x) { return x - std::floor(x); };
+    auto golden = [&](int frame) { return fract(0.6180339887 * frame); };
+    auto gradient = [&](double x, double y) { return fract(52.9829189 * fract(x * 0.06711056 + y * 0.00583715)); };
+    const JitterResidual frameWide =
+        MeasureJitterResidual([&](int, int, int, int frame) { return golden(frame) - 0.5; });
+    const JitterResidual perCell = MeasureJitterResidual([&](int x, int y, int s, int frame)
+                                                         { return fract(golden(frame) + gradient(x + 0.5, y + 0.5) + 0.618034 * s) - 0.5; });
+    constexpr double kPumpBar = 0.01, kTravelBar = 0.2;
+    CHECK(frameWide.pump > 0.025);
+    CHECK(frameWide.travel < kTravelBar);
+    CHECK(perCell.pump < kPumpBar);
+    CHECK(perCell.travel > 0.5);
+    // The fixed taps: the same two points of the cell every frame, so the
+    // history's residual is zero and both bars hold with nothing to spare.
+    const JitterResidual fixed = MeasureJitterResidual([&](int, int, int, int) { return 0.0; });
+    CHECK(fixed.pump == 0.0);
+    CHECK(fixed.travel == 0.0);
+    CHECK(fixed.pump < kPumpBar);
+    CHECK(fixed.travel < kTravelBar);
 }
 
 TEST_CASE("Volumetric fog: round 3 medium rules (clear near air, dust, hilltops, night fog, stars)", "[remaster][fog]")
