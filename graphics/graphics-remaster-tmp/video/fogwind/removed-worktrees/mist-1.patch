+static void MistPanStep(float deltaT)
+{
+    if (!s_mistPanActive)
+        return;
+    GMistPanT += deltaT;
+    const float dur = s_mistPan[7];
+    float u = dur > 0.0f ? GMistPanT / dur : 1.0f;
+    if (u < 0.0f)
+        u = 0.0f;
+    if (u > 1.0f)
+        u = 1.0f;
+    const float s = u * u * (3.0f - 2.0f * u);
+    const float d2r = 3.14159265358979f / 180.0f;
+    const float h = (s_mistPan[3] + (s_mistPan[5] - s_mistPan[3]) * s) * d2r;
+    const float p = (s_mistPan[4] + (s_mistPan[6] - s_mistPan[4]) * s) * d2r;
+    const Vector3 dir(sinf(h) * cosf(p), sinf(p), cosf(h) * cosf(p));
+    World_SetTriViewOverride(Vector3(s_mistPan[0], s_mistPan[1], s_mistPan[2]), dir.Normalized(), VUp);
+}
