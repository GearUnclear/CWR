+// ---- mist-1 DIAGNOSTIC (scratch build only, never for the product) ----------
+// In-memory recorder of presented frames: reads the default framebuffer at the
+// triScreenshot capture point (post gamma, pre swap) into a ring of pixel-pack
+// buffers, collects each one a few frames later (no GPU stall), and writes all
+// frames once at the end as raw RGB24 (bottom-up rows) plus a .txt sidecar.
+extern char GMistRecPath[512];
+extern int GMistRecWant;
+extern int GMistRecMode;
+extern int GMistRecHalf;
+extern int GMistRecState;
+extern int GMistRecGot;
+extern int GMistRecStop;
+extern float GMistPanT;
+
+namespace
+{
+constexpr int kMistRing = 4;
+struct MistRecorder
+{
+    GLuint pbo[kMistRing] = {0, 0, 0, 0};
+    int pboFrame[kMistRing] = {-1, -1, -1, -1};
+    int w = 0, h = 0, ow = 0, oh = 0, issued = 0;
+    uint8_t* data = nullptr; // CRT malloc: the engine heap refuses multi-GB blocks
+    std::vector<double> wallMs;
+    std::vector<float> panT;
+    std::vector<int> shot;
+    std::chrono::steady_clock::time_point t0;
+};
+MistRecorder gMistRec;
+
+void MistRecCollect(int slot)
+{
+    const int f = gMistRec.pboFrame[slot];
+    if (f < 0)
+        return;
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, gMistRec.pbo[slot]);
+    const size_t w = static_cast<size_t>(gMistRec.w), h = static_cast<size_t>(gMistRec.h);
+    const auto* src = static_cast<const uint8_t*>(glMapBufferRange(GL_PIXEL_PACK_BUFFER, 0, w * h * 4, GL_MAP_READ_BIT));
+    if (src)
+    {
+        const size_t ow = static_cast<size_t>(gMistRec.ow), oh = static_cast<size_t>(gMistRec.oh);
+        uint8_t* dst = gMistRec.data + static_cast<size_t>(f) * ow * oh * 3;
+        if (!GMistRecHalf)
+        {
+            for (size_t i = 0; i < w * h; ++i)
+            {
+                dst[i * 3 + 0] = src[i * 4 + 0];
+                dst[i * 3 + 1] = src[i * 4 + 1];
+                dst[i * 3 + 2] = src[i * 4 + 2];
+            }
+        }
+        else
+        {
+            for (size_t y = 0; y < oh; ++y)
+                for (size_t x = 0; x < ow; ++x)
+                    for (int c = 0; c < 3; ++c)
+                    {
+                        const size_t a = ((2 * y) * w + 2 * x) * 4 + c, b = ((2 * y + 1) * w + 2 * x) * 4 + c;
+                        dst[(y * ow + x) * 3 + c] =
+                            static_cast<uint8_t>((src[a] + src[a + 4] + src[b] + src[b + 4] + 2) / 4);
+                    }
+        }
+        glUnmapBuffer(GL_PIXEL_PACK_BUFFER);
+    }
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    gMistRec.pboFrame[slot] = -1;
+}
+
+void MistRecFinish()
+{
+    for (int s = 0; s < kMistRing; ++s)
+        MistRecCollect(s);
+    bool ok = false;
+    if (FILE* fp = fopen(GMistRecPath, "wb"))
+    {
+        const size_t bytes = static_cast<size_t>(gMistRec.ow) * gMistRec.oh * 3 * gMistRec.issued;
+        ok = gMistRec.data && fwrite(gMistRec.data, 1, bytes, fp) == bytes;
+        fclose(fp);
+    }
+    std::string meta = std::string(GMistRecPath) + ".txt";
+    if (FILE* fp = fopen(meta.c_str(), "w"))
+    {
+        fprintf(fp, "w=%d h=%d frames=%d mode=%d half=%d\n", gMistRec.ow, gMistRec.oh, gMistRec.issued, GMistRecMode,
+                GMistRecHalf);
+        for (int i = 0; i < gMistRec.issued; ++i)
+            fprintf(fp, "%d %.3f %.5f %d\n", i, gMistRec.wallMs[i], static_cast<double>(gMistRec.panT[i]),
+                    gMistRec.shot[i]);
+        fclose(fp);
+    }
+    glDeleteBuffers(kMistRing, gMistRec.pbo);
+    std::free(gMistRec.data);
+    gMistRec = MistRecorder();
+    GMistRecState = ok ? 2 : 3;
+}
+
+void MistRecFrame(SDL_Window* win, int defW, int defH, bool shotFrame)
+{
+    if (GMistRecState != 1)
+        return;
+    if (GMistRecStop)
+    {
+        GMistRecStop = 0;
+        if (gMistRec.issued > 0)
+            MistRecFinish();
+        else
+            GMistRecState = 2;
+        return;
+    }
+    if (GMistRecMode == 1 && !shotFrame)
+        return;
+    int w = defW, h = defH;
+    if (win)
+        SDL_GetWindowSizeInPixels(win, &w, &h);
+    if (gMistRec.issued == 0)
+    {
+        gMistRec.w = w;
+        gMistRec.h = h;
+        gMistRec.ow = GMistRecHalf ? w / 2 : w;
+        gMistRec.oh = GMistRecHalf ? h / 2 : h;
+        gMistRec.data = static_cast<uint8_t*>(std::malloc(static_cast<size_t>(gMistRec.ow) * gMistRec.oh * 3 * GMistRecWant));
+        if (!gMistRec.data)
+        {
+            LOG_ERROR(Graphics, "[mist-1] recorder: malloc of {} frames failed", GMistRecWant);
+            GMistRecState = 3;
+            return;
+        }
+        gMistRec.wallMs.assign(GMistRecWant, 0.0);
+        gMistRec.panT.assign(GMistRecWant, 0.0f);
+        gMistRec.shot.assign(GMistRecWant, 0);
+        glGenBuffers(kMistRing, gMistRec.pbo);
+        for (int s = 0; s < kMistRing; ++s)
+        {
+            glBindBuffer(GL_PIXEL_PACK_BUFFER, gMistRec.pbo[s]);
+            glBufferData(GL_PIXEL_PACK_BUFFER, static_cast<GLsizeiptr>(w) * h * 4, nullptr, GL_STREAM_READ);
+            gMistRec.pboFrame[s] = -1;
+        }
+        glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+        gMistRec.t0 = std::chrono::steady_clock::now();
+    }
+    if (w != gMistRec.w || h != gMistRec.h)
+    {
+        GMistRecState = 3;
+        return;
+    }
+    const int slot = gMistRec.issued % kMistRing;
+    MistRecCollect(slot);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, gMistRec.pbo[slot]);
+    glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    const int i = gMistRec.issued;
+    gMistRec.pboFrame[slot] = i;
+    gMistRec.wallMs[i] =
+        std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - gMistRec.t0).count();
+    gMistRec.panT[i] = GMistPanT;
+    gMistRec.shot[i] = shotFrame ? 1 : 0;
+    gMistRec.issued = i + 1;
+    GMistRecGot = gMistRec.issued;
+    if (gMistRec.issued >= GMistRecWant)
+        MistRecFinish();
+}
