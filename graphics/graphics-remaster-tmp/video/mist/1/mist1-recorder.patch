+// ---- mist-1 DIAGNOSTIC (scratch build only, never for the product) ----------
+// A camera pan driven by the accumulated accelerated sim step, so the same pan
+// plays at real speed (accTime 1, real-time steps) and stepped (accTime 0 between
+// shots, one fixed 1/60 s tick per shot).  Plus the control block of the
+// in-memory presented-frame recorder in EngineGL33_VertexBuffer.cpp.
+char GMistRecPath[512] = {0};
+int GMistRecWant = 0;
+int GMistRecMode = 0; // 0 every presented frame, 1 only frames a triScreenshot captured
+int GMistRecHalf = 0; // 1 = store a 2x2 box-downsampled copy
+int GMistRecState = 0; // 0 idle, 1 recording, 2 written, 3 failed
+int GMistRecGot = 0;
+int GMistRecStop = 0; // 1 = write what is recorded at the next presented frame
+float GMistPanT = 0.0f;
+static bool s_mistPanActive = false;
+static float s_mistPan[9] = {0};
+
+void World_SetMistPan(const float* v)
+{
+    for (int i = 0; i < 9; ++i)
+        s_mistPan[i] = v[i];
+    GMistPanT = v[8];
+    s_mistPanActive = true;
+}
+
+void World_StopMistPan()
+{
+    s_mistPanActive = false;
+}
+
+static void MistPanStep(float deltaT)
+{
+    if (!s_mistPanActive)
+        return;
+    GMistPanT += deltaT;
+    const float dur = s_mistPan[7];
+    float u = dur > 0.0f ? GMistPanT / dur : 1.0f;
+    if (u < 0.0f)
+        u = 0.0f;
+    if (u > 1.0f)
+        u = 1.0f;
+    const float s = u * u * (3.0f - 2.0f * u);
+    const float d2r = 3.14159265358979f / 180.0f;
+    const float h = (s_mistPan[3] + (s_mistPan[5] - s_mistPan[3]) * s) * d2r;
+    const float p = (s_mistPan[4] + (s_mistPan[6] - s_mistPan[4]) * s) * d2r;
+    const Vector3 dir(sinf(h) * cosf(p), sinf(p), cosf(h) * cosf(p));
+    World_SetTriViewOverride(Vector3(s_mistPan[0], s_mistPan[1], s_mistPan[2]), dir.Normalized(), VUp);
+}
