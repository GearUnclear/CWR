+    LightRigInputs in = ClearSkyClassicSun(1.0f);
+    in.fogColor = Rgb(0.20f, 0.12f, 0.12f);
+    CHECK(Luminance(ComputeLightRig(in, WithLowSunRig(true)).skyHorizon) >
