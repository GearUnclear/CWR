+void EngineGL33::UploadLitSurface(TextureGL33* tex)
+{
+    if (!_lightingActive)
+        return;
+    const int kind = Poseidon::GDrawObjectKind;
+    SurfValue v{0.0f, static_cast<float>(kind), 0.0f, 0.0f};
+    if (tex)
+    {
+        const SurfKey key{tex, kind};
+        const char* raw = tex->GetName();
+        const std::string name = raw ? raw : "";
+        const size_t h = std::hash<std::string>()(name);
+        auto it = s_surfCache.find(key);
+        if (it == s_surfCache.end() || it->second.hash != static_cast<float>(h % 997u) / 997.0f)
+        {
+            std::string lower = name;
+            for (char& c : lower)
+                c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+            const bool blend = tex->GetAlphaClass() == Poseidon::AlphaStats::Blend;
+            const int cls = ClassifySurface(lower, kind, blend);
+            SurfValue nv{static_cast<float>(cls), static_cast<float>(kind), blend ? 1.0f : 0.0f,
+                         static_cast<float>(h % 997u) / 997.0f};
+            const bool fresh = it == s_surfCache.end();
+            s_surfCache[key] = nv;
+            if (fresh)
+                LOG_INFO(Graphics, "MATRESEARCH tex '{}' kind {} blend {} -> class {}", name, kind, blend ? 1 : 0, cls);
+            v = nv;
+        }
+        else
+        {
+            v = it->second;
+        }
+    }
+    float* p = s_lit + LitConst::MatClass * 4;
+    if (p[0] == v.cls && p[1] == v.kind && p[2] == v.blend && p[3] == v.hash)
+        return;
+    SetSlot(LitConst::MatClass, v.cls, v.kind, v.blend, v.hash);
+    if (s_litUBO)
+    {
+        glBindBuffer(GL_UNIFORM_BUFFER, s_litUBO);
+        glBufferSubData(GL_UNIFORM_BUFFER, LitConst::MatClass * 16, 16, p);
+    }
+}
