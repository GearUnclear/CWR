+// Texture name tokens: the stock data is Czech (sklo glass, okno window, kolo
+// wheel, pneu tyre, guma rubber, plech sheet metal, kov metal, hlaven barrel,
+// delo cannon, rez rust, xicht face, ruka hand, bota boot, plachta tarp,
+// silnice road, cesta track, beton concrete, cihla brick, strecha roof, drevo
+// wood); @LoBo and other mods are mostly English.
+int ClassifySurface(const std::string& n, int kind, bool blend)
+{
+    static const char* const glass[] = {"sklo", "skla", "glass", "window", "windscreen", "windshield", "armwin",
+                                        "canopy", "cifernik", "budik"};
+    static const char* const lens[] = {"reflekt", "svetl", "blink", "lamp", "light"};
+    static const char* const rubber[] = {"pneu", "guma", "tyre", "tire", "wheel", "kolo", "pasy", "track"};
+    static const char* const metal[] = {"hlaven", "hlavn", "delo", "kulomet", "lauf", "barrel", "kanon",
+                                        "trub",   "roura", "_rez",  "rez_",    "_kov",  "kov_",   "kovn",
+                                        "chrom",  "vyfuk", "exhaust",
+                                        "antena", "plech", "zink",  "zelez",   "metal", "steel",  "pipe"};
+    static const char* const fabric[] = {"plachta", "sedl", "sedad", "taska", "igelit", "lano", "_sit", "net",
+                                         "tarp",    "canvas", "seat", "bench", "cloth", "camnet", "maskovac",
+                                         "stan_",   "stan.",  "tent"};
+    static const char* const skin[] = {"xicht", "hlava", "head", "face", "hand", "ruce"};
+    static const char* const road[] = {"silnic", "asfalt", "cesta", "road", "dlazb", "chodnik", "runway", "draha"};
+    static const char* const wood[] = {"drev", "prkn", "plank", "wood", "bark", "kmen", "dreva", "bedna", "crate"};
+    static const char* const weapon[] = {"ak47", "ak74", "m16", "m21", "m60", "rpg", "law", "carl", "g36", "fal",
+                                         "uzi",  "pistol", "m249", "pk", "mag", "weapon", "zbran", "scope"};
+    const bool okno = Has(n, "okno") && !Has(n, "ram") && !Has(n, "_in") && !Has(n, "bez");
+    if (HasAny(n, glass) || okno)
+        return SurfGlass;
+    switch (kind)
+    {
+        case 7: // tents, camouflage nets (object class name)
+            return SurfFabric;
+        case 1: // land vehicle
+        case 4: // aircraft
+        case 5: // ship
+            // Alpha-blended vehicle textures are mostly cutout details (wheel
+            // rims, tools, handles), not glass: glass comes from the name only.
+            (void)blend;
+            if (Has(n, "skl"))
+                return SurfGlass;
+            if (HasAny(n, lens))
+                return SurfLens;
+            if (HasAny(n, rubber))
+                return SurfRubber;
+            // Gun barrels and cannons on military vehicles are painted steel.
+            if (Has(n, "hlaven") || Has(n, "hlavn") || Has(n, "delo") || Has(n, "kanon") || Has(n, "barrel") ||
+                Has(n, "lauf"))
+                return SurfPaint;
+            if (HasAny(n, metal) && !Has(n, "plech"))
+                return SurfMetal;
+            if (HasAny(n, fabric))
+                return SurfFabric;
+            return SurfPaint;
+        case 2: // man
+            if (HasAny(n, skin) || (Has(n, "ruka") && !Has(n, "rukav")))
+                return SurfSkin;
+            if (Has(n, "bota") || Has(n, "boot"))
+                return SurfLeather;
+            if (HasAny(n, weapon))
+                return SurfWeapon;
+            return SurfFabric;
+        case 6: // weapon proxy
+            return SurfWeapon;
+        default: // static objects, things, terrain decals
+            if (HasAny(n, road))
+                return SurfRoad;
+            if (Has(n, "strech") || Has(n, "roof"))
+                return Has(n, "plech") ? SurfMetal : SurfRoof;
+            if (HasAny(n, metal))
+                return SurfMetal;
+            if (HasAny(n, wood))
+                return SurfWood;
+            if (HasAny(n, fabric))
+                return SurfFabric;
+            if (HasAny(n, lens) && blend)
+                return SurfLens;
+            return kind == 3 ? SurfMasonry : SurfDefault;
+    }
+}
