+﻿// RESEARCH PROTOTYPE (track "atmosphere"): physically based clear-sky
+// atmosphere for the remastered lighting. See Atmosphere.hpp.
+
+#include <Poseidon/Graphics/Remaster/Atmosphere.hpp>
+
+#include <algorithm>
+#include <cmath>
+
+namespace Poseidon::remaster
+{
+
+namespace
+{
+constexpr float kPi = 3.14159265358979323846f;
+
+// Earth, Bruneton 2017 / Hillaire 2020 defaults (metres).
+constexpr float kRg = 6360000.0f;
+constexpr float kRt = 6460000.0f;
+constexpr float kRayleighH = 8000.0f;
+constexpr float kMieH = 1200.0f;
+constexpr float kRayleigh[3] = {5.802e-6f, 13.558e-6f, 33.1e-6f};
+constexpr float kMieScat = 3.996e-6f;
+constexpr float kMieExt = 4.40e-6f;
+constexpr float kOzone[3] = {0.650e-6f, 1.881e-6f, 0.085e-6f};
+constexpr float kOzoneCentre = 25000.0f;
+constexpr float kOzoneHalfWidth = 15000.0f;
+constexpr float kGroundAlbedo = 0.3f;
+constexpr float kMieG = 0.8f;
+
+constexpr int kTW = 256; // transmittance: mu
+constexpr int kTH = 64;  // transmittance: r
+constexpr int kMW = 32;  // multiple scattering: mu_s
+constexpr int kMH = 32;  // multiple scattering: height
+
+struct V3
+{
+    float x, y, z;
+};
+inline V3 Add(V3 a, V3 b)
+{
+    return {a.x + b.x, a.y + b.y, a.z + b.z};
+}
+inline V3 Mul(V3 a, float s)
+{
+    return {a.x * s, a.y * s, a.z * s};
+}
+inline float Dot(V3 a, V3 b)
+{
+    return a.x * b.x + a.y * b.y + a.z * b.z;
+}
+inline float Len(V3 a)
+{
+    return std::sqrt(Dot(a, a));
+}
+
+float Clamp(float v, float lo, float hi)
+{
+    return std::min(hi, std::max(lo, v));
+}
+
+float DistanceToTop(float r, float mu)
+{
+    const float disc = r * r * (mu * mu - 1.0f) + kRt * kRt;
+    return std::max(0.0f, -r * mu + std::sqrt(std::max(disc, 0.0f)));
+}
+
+float DistanceToBottom(float r, float mu)
+{
+    const float disc = r * r * (mu * mu - 1.0f) + kRg * kRg;
+    return std::max(0.0f, -r * mu - std::sqrt(std::max(disc, 0.0f)));
+}
+
+bool HitsGround(float r, float mu)
+{
+    return mu < 0.0f && r * r * (mu * mu - 1.0f) + kRg * kRg >= 0.0f;
+}
+
+struct Medium
+{
+    float scatR[3];
+    float scatM;
+    float ext[3];
+};
+
+Medium SampleMedium(float h, float haze)
+{
+    const float rr = std::exp(-std::max(h, 0.0f) / kRayleighH);
+    const float rm = std::exp(-std::max(h, 0.0f) / kMieH) * haze;
+    const float ro = std::max(0.0f, 1.0f - std::fabs(h - kOzoneCentre) / kOzoneHalfWidth);
+    Medium m;
+    m.scatM = kMieScat * rm;
+    for (int c = 0; c < 3; ++c)
+    {
+        m.scatR[c] = kRayleigh[c] * rr;
+        m.ext[c] = m.scatR[c] + kMieExt * rm + kOzone[c] * ro;
+    }
+    return m;
+}
+
+float RayleighPhase(float c)
+{
+    return 3.0f / (16.0f * kPi) * (1.0f + c * c);
+}
+
+} // namespace
+
+float Atmosphere::MiePhase(float c)
+{
+    const float g = kMieG;
+    const float k = 3.0f / (8.0f * kPi) * (1.0f - g * g) / (2.0f + g * g);
+    return k * (1.0f + c * c) / std::pow(std::max(1.0f + g * g - 2.0f * g * c, 1e-6f), 1.5f);
+}
+
+struct Atmosphere::Impl
+{
+    static void Transmittance(const std::vector<float>& lut, float r, float mu, float out[3])
+    {
+        if (HitsGround(r, mu))
+        {
+            out[0] = out[1] = out[2] = 0.0f;
+            return;
+        }
+        const float H = std::sqrt(kRt * kRt - kRg * kRg);
+        const float rho = std::sqrt(std::max(r * r - kRg * kRg, 0.0f));
+        const float d = DistanceToTop(r, mu);
+        const float dMin = kRt - r;
+        const float dMax = rho + H;
+        const float xMu = dMax > dMin ? (d - dMin) / (dMax - dMin) : 0.0f;
+        const float xR = rho / H;
+        const float fx = Clamp(xMu, 0.0f, 1.0f) * (kTW - 1);
+        const float fy = Clamp(xR, 0.0f, 1.0f) * (kTH - 1);
+        const int x0 = std::min(static_cast<int>(fx), kTW - 2);
+        const int y0 = std::min(static_cast<int>(fy), kTH - 2);
+        const float tx = fx - x0, ty = fy - y0;
+        for (int c = 0; c < 3; ++c)
+        {
+            const float a = lut[(y0 * kTW + x0) * 3 + c], b = lut[(y0 * kTW + x0 + 1) * 3 + c];
+            const float e = lut[((y0 + 1) * kTW + x0) * 3 + c], f = lut[((y0 + 1) * kTW + x0 + 1) * 3 + c];
+            out[c] = (a + (b - a) * tx) * (1.0f - ty) + (e + (f - e) * tx) * ty;
+        }
+    }
+
+    static void MultiScatter(const std::vector<float>& lut, float h, float muS, float out[3])
+    {
+        const float fx = Clamp((muS * 0.5f + 0.5f), 0.0f, 1.0f) * (kMW - 1);
+        const float fy = Clamp(h / (kRt - kRg), 0.0f, 1.0f) * (kMH - 1);
+        const int x0 = std::min(static_cast<int>(fx), kMW - 2);
+        const int y0 = std::min(static_cast<int>(fy), kMH - 2);
+        const float tx = fx - x0, ty = fy - y0;
+        for (int c = 0; c < 3; ++c)
+        {
+            const float a = lut[(y0 * kMW + x0) * 3 + c], b = lut[(y0 * kMW + x0 + 1) * 3 + c];
+            const float e = lut[((y0 + 1) * kMW + x0) * 3 + c], f = lut[((y0 + 1) * kMW + x0 + 1) * 3 + c];
+            out[c] = (a + (b - a) * tx) * (1.0f - ty) + (e + (f - e) * tx) * ty;
+        }
+    }
+
+    static void BuildTransmittance(std::vector<float>& lut, float haze)
+    {
+        lut.assign(kTW * kTH * 3, 0.0f);
+        const float H = std::sqrt(kRt * kRt - kRg * kRg);
+        for (int j = 0; j < kTH; ++j)
+        {
+            const float xR = static_cast<float>(j) / (kTH - 1);
+            const float rho = H * xR;
+            const float r = std::sqrt(rho * rho + kRg * kRg);
+            for (int i = 0; i < kTW; ++i)
+            {
+                const float xMu = static_cast<float>(i) / (kTW - 1);
+                const float dMin = kRt - r;
+                const float dMax = rho + H;
+                const float d = dMin + xMu * (dMax - dMin);
+                float mu = d == 0.0f ? 1.0f : (H * H - rho * rho - d * d) / (2.0f * r * d);
+                mu = Clamp(mu, -1.0f, 1.0f);
+                const float len = DistanceToTop(r, mu);
+                constexpr int kSteps = 64;
+                const float dt = len / kSteps;
+                double od[3] = {0, 0, 0};
+                for (int s = 0; s < kSteps; ++s)
+                {
+                    const float t = (s + 0.5f) * dt;
+                    const float rs = std::sqrt(r * r + t * t + 2.0f * r * mu * t);
+                    const Medium m = SampleMedium(rs - kRg, haze);
+                    for (int c = 0; c < 3; ++c)
+                        od[c] += m.ext[c] * dt;
+                }
+                for (int c = 0; c < 3; ++c)
+                    lut[(j * kTW + i) * 3 + c] = static_cast<float>(std::exp(-od[c]));
+            }
+        }
+    }
+
+    static void BuildMultiScatter(std::vector<float>& lut, const std::vector<float>& trans, float haze)
+    {
+        lut.assign(kMW * kMH * 3, 0.0f);
+        constexpr int kDirs = 64;
+        constexpr int kSteps = 20;
+        V3 dirs[kDirs];
+        const float golden = kPi * (3.0f - std::sqrt(5.0f));
+        for (int k = 0; k < kDirs; ++k)
+        {
+            const float y = 1.0f - 2.0f * (k + 0.5f) / kDirs;
+            const float rad = std::sqrt(std::max(0.0f, 1.0f - y * y));
+            const float th = golden * k;
+            dirs[k] = {rad * std::cos(th), y, rad * std::sin(th)};
+        }
+        const float pu = 1.0f / (4.0f * kPi);
+        for (int j = 0; j < kMH; ++j)
+        {
+            const float h = std::max(10.0f, (kRt - kRg) * j / (kMH - 1));
+            const float r = kRg + std::min(h, kRt - kRg - 10.0f);
+            for (int i = 0; i < kMW; ++i)
+            {
+                const float muS = -1.0f + 2.0f * i / (kMW - 1);
+                const V3 sun = {std::sqrt(std::max(0.0f, 1.0f - muS * muS)), muS, 0.0f};
+                const V3 origin = {0.0f, r, 0.0f};
+                double L2[3] = {0, 0, 0}, fms[3] = {0, 0, 0};
+                for (int k = 0; k < kDirs; ++k)
+                {
+                    const V3 dir = dirs[k];
+                    const float mu = dir.y;
+                    const bool ground = HitsGround(r, mu);
+                    const float tMax = ground ? DistanceToBottom(r, mu) : DistanceToTop(r, mu);
+                    const float dt = tMax / kSteps;
+                    float T[3] = {1, 1, 1};
+                    float Lp[3] = {0, 0, 0}, Lf[3] = {0, 0, 0};
+                    for (int s = 0; s < kSteps; ++s)
+                    {
+                        const float t = (s + 0.3f) * dt;
+                        const V3 P = Add(origin, Mul(dir, t));
+                        const float rp = Len(P);
+                        const Medium m = SampleMedium(rp - kRg, haze);
+                        const float muSp = Dot(Mul(P, 1.0f / rp), sun);
+                        float ts[3];
+                        Transmittance(trans, rp, muSp, ts);
+                        for (int c = 0; c < 3; ++c)
+                        {
+                            const float sig = m.scatR[c] + m.scatM;
+                            const float ext = std::max(m.ext[c], 1e-12f);
+                            const float stepT = std::exp(-ext * dt);
+                            const float S = sig * pu * ts[c];
+                            Lp[c] += T[c] * (S - S * stepT) / ext;
+                            Lf[c] += T[c] * (sig - sig * stepT) / ext;
+                            T[c] *= stepT;
+                        }
+                    }
+                    if (ground)
+                    {
+                        const V3 G = Add(origin, Mul(dir, tMax));
+                        const float rg = Len(G);
+                        const float muG = Dot(Mul(G, 1.0f / rg), sun);
+                        float tg[3];
+                        Transmittance(trans, rg, muG, tg);
+                        for (int c = 0; c < 3; ++c)
+                            Lp[c] += T[c] * tg[c] * std::max(muG, 0.0f) * kGroundAlbedo / kPi;
+                    }
+                    for (int c = 0; c < 3; ++c)
+                    {
+                        L2[c] += Lp[c];
+                        fms[c] += Lf[c];
+                    }
+                }
+                for (int c = 0; c < 3; ++c)
+                {
+                    const double l2 = L2[c] / kDirs;
+                    const double f = std::min(fms[c] / kDirs, 0.99);
+                    lut[(j * kMW + i) * 3 + c] = static_cast<float>(l2 / (1.0 - f));
+                }
+            }
+        }
+    }
+};
+
+Atmosphere::Atmosphere() = default;
+
+namespace
+{
+float s_tableHaze = -1.0f;
+}
+
+void Atmosphere::BuildSkyView(float sunElevationRad, const AtmosphereSettings& s, SkyViewLut& out) const
+{
+    auto& self = const_cast<Atmosphere&>(*this);
+    if (_transmittance.empty() || std::fabs(s_tableHaze - s.haze) > 1e-4f)
+    {
+        Impl::BuildTransmittance(self._transmittance, s.haze);
+        Impl::BuildMultiScatter(self._multiScatter, self._transmittance, s.haze);
+        s_tableHaze = s.haze;
+    }
+
+    constexpr int W = SkyViewLut::kWidth;
+    constexpr int H = SkyViewLut::kHeight;
+    out.rgba.assign(3 * W * H * 4, 0.0f);
+    out.sunElevationRad = sunElevationRad;
+    out.haze = s.haze;
+
+    const float r0 = kRg + std::max(s.viewerHeight, 1.0f);
+    const V3 origin = {0.0f, r0, 0.0f};
+    const V3 sun = {std::cos(sunElevationRad), std::sin(sunElevationRad), 0.0f};
+    constexpr int kSteps = 40;
+
+    for (int j = 0; j < H; ++j)
+    {
+        const float v = (j + 0.5f) / H;
+        const float x = 2.0f * v - 1.0f;
+        const float l = (x < 0.0f ? -1.0f : 1.0f) * x * x * (kPi * 0.5f);
+        for (int i = 0; i < W; ++i)
+        {
+            const float u = (i + 0.5f) / W;
+            const float phi = kPi * u * u;
+            const V3 dir = {std::cos(l) * std::cos(phi), std::sin(l), std::cos(l) * std::sin(phi)};
+            const float mu = dir.y;
+            const bool ground = HitsGround(r0, mu);
+            const float tMax = ground ? DistanceToBottom(r0, mu) : DistanceToTop(r0, mu);
+            const float cosT = Dot(dir, sun);
+            const float pR = RayleighPhase(cosT);
+            float T[3] = {1, 1, 1};
+            float LR[3] = {0, 0, 0}, LM[3] = {0, 0, 0};
+            float tPrev = 0.0f;
+            for (int k = 0; k < kSteps; ++k)
+            {
+                const float f1 = static_cast<float>(k + 1) / kSteps;
+                const float tNext = tMax * f1 * f1;
+                const float dt = tNext - tPrev;
+                const float t = tPrev + 0.3f * dt;
+                tPrev = tNext;
+                const V3 P = Add(origin, Mul(dir, t));
+                const float rp = Len(P);
+                const Medium m = SampleMedium(rp - kRg, s.haze);
+                const float muSp = Dot(Mul(P, 1.0f / rp), sun);
+                float ts[3], ms[3];
+                Impl::Transmittance(_transmittance, rp, muSp, ts);
+                Impl::MultiScatter(_multiScatter, rp - kRg, muSp, ms);
+                for (int c = 0; c < 3; ++c)
+                {
+                    const float ext = std::max(m.ext[c], 1e-12f);
+                    const float stepT = std::exp(-ext * dt);
+                    const float SR = m.scatR[c] * pR * ts[c] + (m.scatR[c] + m.scatM) * ms[c];
+                    const float SM = m.scatM * ts[c];
+                    LR[c] += T[c] * (SR - SR * stepT) / ext;
+                    LM[c] += T[c] * (SM - SM * stepT) / ext;
+                    T[c] *= stepT;
+                }
+            }
+            float* pr = &out.rgba[(j * 3 * W + i) * 4];
+            float* pm = &out.rgba[(j * 3 * W + W + i) * 4];
+            for (int c = 0; c < 3; ++c)
+            {
+                pr[c] = LR[c];
+                pm[c] = LM[c];
+            }
+            pr[3] = 1.0f;
+            pm[3] = 1.0f;
+        }
+    }
+
+    // Third region: the azimuthal mean of the full radiance (Mie phase
+    // applied) per elevation row, so the shader can relate a direction to the
+    // average of its elevation in one tap.
+    for (int j = 0; j < H; ++j)
+    {
+        const float v = (j + 0.5f) / H;
+        const float x = 2.0f * v - 1.0f;
+        const float l = (x < 0.0f ? -1.0f : 1.0f) * x * x * (kPi * 0.5f);
+        Rgb sum;
+        constexpr int kN = 96;
+        for (int a = 0; a < kN; ++a)
+        {
+            const float phi = (a + 0.5f) / kN * kPi;
+            const V3 dir = {std::cos(l) * std::cos(phi), std::sin(l), std::cos(l) * std::sin(phi)};
+            sum = sum + Sample(out, l, phi, Dot(dir, sun));
+        }
+        sum = sum * (1.0f / kN);
+        for (int i = 0; i < W; ++i)
+        {
+            float* pa = &out.rgba[(j * 3 * W + 2 * W + i) * 4];
+            pa[0] = sum.r;
+            pa[1] = sum.g;
+            pa[2] = sum.b;
+            pa[3] = 1.0f;
+        }
+    }
+
+    // ---- summary -----------------------------------------------------------
+    float t[3];
+    Impl::Transmittance(_transmittance, r0, std::sin(sunElevationRad), t);
+    out.sunTransmittance = Rgb(t[0], t[1], t[2]);
+    Impl::Transmittance(_transmittance, kRg + 2500.0f, std::sin(sunElevationRad), t);
+    out.sunAtClouds = Rgb(t[0], t[1], t[2]);
+
+    Rgb up, sunward, anti, low, upper;
+    double wLow = 0.0, wUpper = 0.0;
+    constexpr int kEl = 24, kAz = 48;
+    for (int e = 0; e < kEl; ++e)
+    {
+        const float l = (e + 0.5f) / kEl * (kPi * 0.5f);
+        const float dl = (kPi * 0.5f) / kEl;
+        for (int a = 0; a < kAz; ++a)
+        {
+            const float phi = -kPi + (a + 0.5f) / kAz * (2.0f * kPi);
+            const float dphi = 2.0f * kPi / kAz;
+            const float dw = std::cos(l) * dl * dphi;
+            const V3 dir = {std::cos(l) * std::cos(phi), std::sin(l), std::cos(l) * std::sin(phi)};
+            const Rgb L = Sample(out, l, std::fabs(phi), Dot(dir, sun));
+            up = up + L * (std::sin(l) * dw);
+            sunward = sunward + L * (std::max(0.0f, dir.x) * dw);
+            anti = anti + L * (std::max(0.0f, -dir.x) * dw);
+            upper = upper + L * dw;
+            wUpper += dw;
+            const float deg = l * 180.0f / kPi;
+            if (deg >= 2.0f && deg <= 25.0f)
+            {
+                low = low + L * dw;
+                wLow += dw;
+            }
+        }
+    }
+    out.irrUp = up;
+    out.irrSunward = sunward;
+    out.irrAntiSun = anti;
+    out.meanLowBand = wLow > 0 ? low * static_cast<float>(1.0 / wLow) : Rgb();
+    out.meanUpper = wUpper > 0 ? upper * static_cast<float>(1.0 / wUpper) : Rgb();
+}
+
+Rgb Atmosphere::Sample(const SkyViewLut& lut, float elevationRad, float azimuthFromSunRad, float cosToSun)
+{
+    constexpr int W = SkyViewLut::kWidth;
+    constexpr int H = SkyViewLut::kHeight;
+    if (lut.rgba.empty())
+        return Rgb();
+    const float phi = Clamp(azimuthFromSunRad, 0.0f, kPi);
+    float u = std::sqrt(phi / kPi);
+    const float l = Clamp(elevationRad, -kPi * 0.5f, kPi * 0.5f);
+    float v = 0.5f + 0.5f * (l < 0.0f ? -1.0f : 1.0f) * std::sqrt(std::fabs(l) / (kPi * 0.5f));
+    const float fx = Clamp(u * W - 0.5f, 0.0f, W - 1.0f);
+    const float fy = Clamp(v * H - 0.5f, 0.0f, H - 1.0f);
+    const int x0 = std::min(static_cast<int>(fx), W - 2);
+    const int y0 = std::min(static_cast<int>(fy), H - 2);
+    const float tx = fx - x0, ty = fy - y0;
+    auto fetch = [&](int half, int x, int y, int c) { return lut.rgba[(y * 3 * W + half * W + x) * 4 + c]; };
+    float R[3], M[3];
+    for (int c = 0; c < 3; ++c)
+    {
+        for (int half = 0; half < 2; ++half)
+        {
+            const float a = fetch(half, x0, y0, c), b = fetch(half, x0 + 1, y0, c);
+            const float e = fetch(half, x0, y0 + 1, c), f = fetch(half, x0 + 1, y0 + 1, c);
+            const float val = (a + (b - a) * tx) * (1.0f - ty) + (e + (f - e) * tx) * ty;
+            (half == 0 ? R : M)[c] = val;
+        }
+    }
+    const float pm = MiePhase(cosToSun);
+    return Rgb(R[0] + M[0] * pm, R[1] + M[1] * pm, R[2] + M[2] * pm);
+}
