+#pragma once
+
+#include <Poseidon/Graphics/Remaster/LightRig.hpp>
+
+#include <vector>
+
+// Physically based clear-sky atmosphere for the remastered lighting, in the
+// spirit of Hillaire 2020 ("A Scalable and Production Ready Sky and Atmosphere
+// Rendering Technique"): Rayleigh + Mie + ozone, a transmittance table, a
+// multiple-scattering table (the isotropic Psi_ms approximation) and a
+// sky-view table re-integrated on the CPU whenever the sun or the haze moves.
+// Pure math, no GL. RESEARCH PROTOTYPE (track "atmosphere").
+//
+// Sky-view table: two halves side by side, each kWidth x kHeight.
+//   left  half: Rayleigh single scattering with its phase + multiple scattering
+//   right half: Mie single scattering WITHOUT its phase (the shader applies the
+//               phase per pixel, so the aureole around the sun stays sharp)
+//   u = sqrt(phi / pi), phi = azimuth from the sun in [0, pi]
+//   v = 0.5 + 0.5 * sign(l) * sqrt(|l| / (pi / 2)), l = elevation
+// Radiance is per unit of solar irradiance at the top of the atmosphere.
+
+namespace Poseidon::remaster
+{
+
+struct AtmosphereSettings
+{
+    float haze = 1.0f;            // Mie density multiplier (turbidity)
+    float viewerHeight = 150.0f;  // metres above the planet surface
+};
+
+struct SkyViewLut
+{
+    static constexpr int kWidth = 64;  // per half (azimuth)
+    static constexpr int kHeight = 64; // elevation
+    std::vector<float> rgba;           // (3 * kWidth) x kHeight x 4: Rayleigh+MS | Mie | azimuthal mean
+    float sunElevationRad = 0.0f;
+    float haze = 1.0f;
+
+    // Summary used by the light rig and the calibration (same units).
+    Rgb sunTransmittance;  // sun colour at the viewer relative to the top of the atmosphere
+    Rgb sunAtClouds;       // sun transmittance at ~2.5 km
+    Rgb irrUp;             // sky irradiance on an up-facing surface
+    Rgb irrSunward;        // ... on a vertical surface facing the sun
+    Rgb irrAntiSun;        // ... on a vertical surface facing away from the sun
+    Rgb meanLowBand;       // mean radiance over elevations 2..25 deg, all azimuths
+    Rgb meanUpper;         // mean radiance over the upper hemisphere (solid angle)
+};
+
+class Atmosphere
+{
+  public:
+    Atmosphere();
+    // Sky-view table for a sun at this elevation (radians, may be negative).
+    void BuildSkyView(float sunElevationRad, const AtmosphereSettings& s, SkyViewLut& out) const;
+
+    // Sky radiance (Rayleigh + MS + Mie with phase) from a built table, for a
+    // direction given by elevation and azimuth from the sun (radians). CPU
+    // reference of the shader lookup.
+    static Rgb Sample(const SkyViewLut& lut, float elevationRad, float azimuthFromSunRad, float cosToSun);
+
+    static float MiePhase(float cosTheta);
+
+  private:
+    struct Impl;
+    std::vector<float> _transmittance; // kTW x kTH x 3
+    std::vector<float> _multiScatter;  // kMW x kMH x 3
+};
+
+} // namespace Poseidon::remaster
