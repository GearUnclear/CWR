+// Same placement as DrawClouds, for any rectangle of the world.
+int Landscape::CollectCloudSheets(int level, float xMin, float zMin, float xMax, float zMax, CloudSheet* out,
+                                  int maxOut) const
+{
+#define SP (2.0f)
+    const static float skyXSpeed[SKY_LEVELS] = {+0.020 * SP, +0.012 * SP, +0.010 * SP};
+    const static float skyZSpeed[SKY_LEVELS] = {+0.004 * SP, -0.002 * SP, -0.004 * SP};
+#undef SP
+    if (level < 0 || level >= SKY_LEVELS)
+        return 0;
+    float cPos = CloudsPosition();
+    float xMove = cPos * skyXSpeed[level];
+    float zMove = cPos * skyZSpeed[level];
+    int xMoveInt = toIntFloor(xMove);
+    int zMoveInt = toIntFloor(zMove);
+    xMove -= xMoveInt;
+    zMove -= zMoveInt;
+    xMove *= SKY_GRID;
+    zMove *= SKY_GRID;
+    const float posY = CloudSheetAltitude(level);
+    const int xBeg = toIntFloor(xMin / SKY_GRID) - 1, xEnd = toIntCeil(xMax / SKY_GRID) + 1;
+    const int zBeg = toIntFloor(zMin / SKY_GRID) - 1, zEnd = toIntCeil(zMax / SKY_GRID) + 1;
+    int n = 0;
+    for (int zz = zBeg; zz <= zEnd; zz++)
+    {
+        for (int xx = xBeg; xx <= xEnd; xx++)
+        {
+            int seedXZ = _randGen.GetSeed(xx - xMoveInt, zz - zMoveInt, level);
+            int isHere = toIntFloor(_randGen.RandomValue(seedXZ) * 8);
+            if (isHere >= N_CLOUDS)
+                continue;
+            if (n >= maxOut)
+                return n;
+            CloudSheet& c = out[n++];
+            c.x = xx * SKY_GRID + xMove + _randGen.RandomValue(seedXZ + 1) * (SKY_GRID * 0.5);
+            c.z = zz * SKY_GRID + zMove + _randGen.RandomValue(seedXZ + 2) * (SKY_GRID * 0.5);
+            c.y = posY;
+            c.azimut = _randGen.RandomValue(seedXZ + 3) * (2 * H_PI / 2);
+            c.type = isHere;
+        }
+    }
+    return n;
+}
