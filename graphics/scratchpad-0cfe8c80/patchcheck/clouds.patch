+// RESEARCH (clouds track): every texel of one mip, decoded once (GetPixel
+// re-reads and re-decodes the whole mip per call). Honours the weather-sky
+// interpolation like GetPixel.
+bool TextureGL33::GetPixels(int level, std::vector<Color>& out, int& w, int& h) const
+{
+    LoadHeadersNV();
+    if (!_src || level < 0 || level >= _nMipmaps)
+        return false;
+    PacLevelMem mip = _mipmaps[level];
+    w = mip._w;
+    h = mip._h;
+    if (w <= 0 || h <= 0)
+        return false;
+    std::vector<char> mem(static_cast<size_t>(mip._pitch) * mip._h);
+    _src->GetMipmapData(mem.data(), mip, level);
+    std::vector<char> imem;
+    PacLevelMem imip;
+    const bool ipol = _interpolate && _interpolate->_src && level < _interpolate->_nMipmaps;
+    if (ipol)
+    {
+        imip = _interpolate->_mipmaps[level];
+        imem.resize(static_cast<size_t>(imip._pitch) * imip._h);
+        _interpolate->_src->GetMipmapData(imem.data(), imip, level);
+    }
+    out.resize(static_cast<size_t>(w) * h);
+    for (int y = 0; y < h; y++)
+    {
+        for (int x = 0; x < w; x++)
+        {
+            const float u = (x + 0.5f) / w, v = (y + 0.5f) / h;
+            Color col = mip.GetPixel(mem.data(), u, v);
+            if (ipol)
