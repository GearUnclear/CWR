+
+namespace
+{
+float SmoothStep(float a, float b, float x)
+{
+    float t = (x - a) / (b - a);
+    t = t < 0.0f ? 0.0f : (t > 1.0f ? 1.0f : t);
+    return t * t * (3.0f - 2.0f * t);
+}
+} // namespace
+
+// The weather skies (jasno, oblacno, zatazeno) are painted panoramas: clear sky
+// is saturated blue that pales toward the horizon. Cloud is judged against its
+// own row (same elevation): whiter than the clearest sky in that row is broken
+// cloud; a row that is grey all the way round is a candidate overcast deck
+// (the shader gates it by the weather). Runtime-derived, no new art.
+void EngineGL33::UpdateSkyDensityMap()
+{
+    Landscape* land = GScene ? GScene->GetLandscape() : nullptr;
+    Texture* t = land ? land->SkyTexture() : nullptr;
+    if (!t)
+        return;
+    const TextureGL33* tg = static_cast<const TextureGL33*>(t);
+    const void* k0 = tg;
+    const void* k1 = tg->InterpolationPartner();
+    const float kf = tg->InterpolationFactor();
+    if (_skyDensityTex && k0 == _skyDensityKey[0] && k1 == _skyDensityKey[1] &&
+        std::fabs(kf - _skyDensityKeyF) < 0.01f)
+        return;
+    std::vector<Color> px;
+    int w = 0, h = 0;
+    if (!tg->GetPixels(0, px, w, h))
+        return;
+    _skyDensityKey[0] = k0;
+    _skyDensityKey[1] = k1;
+    _skyDensityKeyF = kf;
+    std::vector<unsigned char> out(static_cast<size_t>(w) * h * 4);
+    for (int y = 0; y < h; y++)
+    {
+        float qmin = 1e9f, sat = 0.0f;
+        for (int x = 0; x < w; x++)
+        {
+            const Color& c = px[static_cast<size_t>(y) * w + x];
+            const float mx = std::max(c.R(), std::max(c.G(), c.B()));
+            const float mn = std::min(c.R(), std::min(c.G(), c.B()));
+            sat += (mx - mn) / std::max(mx, 1e-3f);
+            qmin = std::min(qmin, (c.R() + c.G()) / std::max(2.0f * c.B(), 1e-3f));
+        }
+        sat /= static_cast<float>(w);
+        const float deckRow = 1.0f - SmoothStep(0.08f, 0.16f, sat);
+        for (int x = 0; x < w; x++)
+        {
+            const Color& c = px[static_cast<size_t>(y) * w + x];
+            const float q = (c.R() + c.G()) / std::max(2.0f * c.B(), 1e-3f);
+            const float feature = SmoothStep(0.03f, 0.30f, q - qmin);
+            const float lum = 0.2126f * c.R() + 0.7152f * c.G() + 0.0722f * c.B();
+            float dark = 1.2f - lum * 1.3f;
+            dark = dark < 0.0f ? 0.0f : (dark > 1.0f ? 1.0f : dark);
+            unsigned char* o = &out[(static_cast<size_t>(y) * w + x) * 4];
+            o[0] = static_cast<unsigned char>(feature * 255.0f + 0.5f);
+            o[1] = static_cast<unsigned char>(deckRow * 255.0f + 0.5f);
+            o[2] = static_cast<unsigned char>(dark * 255.0f + 0.5f);
+            o[3] = 255;
+        }
+    }
+    // The weather skies are 8-bit palettised: thresholds on them show the
+    // palette steps as contour bands. A 5-tap binomial blur (u wraps, v clamps)
+    // of the feature and darkness channels removes them.
+    {
+        static const float kW[5] = {1.0f / 16, 4.0f / 16, 6.0f / 16, 4.0f / 16, 1.0f / 16};
+        std::vector<float> a(static_cast<size_t>(w) * h), b(a.size());
+        for (int ch : {0, 2})
+        {
+            for (size_t i = 0; i < a.size(); i++)
+                a[i] = out[i * 4 + ch];
+            for (int y = 0; y < h; y++)
+                for (int x = 0; x < w; x++)
+                {
+                    float s = 0.0f;
+                    for (int k = -2; k <= 2; k++)
+                        s += kW[k + 2] * a[static_cast<size_t>(y) * w + ((x + k + w) % w)];
+                    b[static_cast<size_t>(y) * w + x] = s;
+                }
+            for (int y = 0; y < h; y++)
+                for (int x = 0; x < w; x++)
+                {
+                    float s = 0.0f;
+                    for (int k = -2; k <= 2; k++)
+                    {
+                        const int yy = std::min(std::max(y + k, 0), h - 1);
+                        s += kW[k + 2] * b[static_cast<size_t>(yy) * w + x];
+                    }
+                    out[(static_cast<size_t>(y) * w + x) * 4 + ch] = static_cast<unsigned char>(s + 0.5f);
+                }
+        }
+    }
+    if (!_skyDensityTex)
+        glGenTextures(1, &_skyDensityTex);
+    GL33Bind::ActiveUnit(kUploadUnit - GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, _skyDensityTex);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, out.data());
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_REPEAT);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, 0);
+    glBindTexture(GL_TEXTURE_2D, 0);
+    GL33Bind::Invalidate();
+    LOG_INFO(Graphics, "GL33: sky cloud-density map {}x{} rebuilt (interp {:.2f})", w, h, kf);
+}
+
+void EngineGL33::UploadSkyCamera()
+{
+    Camera* cam = GScene ? GScene->GetCamera() : nullptr;
+    if (!cam)
+        return;
+    const GfxMatrix& proj = _frameState.projection;
+    Vector3 r = cam->DirectionAside();
+    Vector3 u = cam->DirectionUp();
+    Vector3 f = cam->Direction();
+    r.Normalize();
+    u.Normalize();
+    f.Normalize();
+    const float p11 = proj._11 != 0.0f ? proj._11 : 1.0f;
+    const float p22 = proj._22 != 0.0f ? proj._22 : 1.0f;
+    SetSlot(LitConst::SkyRight, r.X() / p11, r.Y() / p11, r.Z() / p11, 0.0f);
+    SetSlot(LitConst::SkyUp, u.X() / p22, u.Y() / p22, u.Z() / p22, 0.0f);
+    SetSlot(LitConst::SkyFwd, f.X(), f.Y(), f.Z(), p11);
+    GLint vp[4] = {0, 0, 1, 1};
+    glGetIntegerv(GL_VIEWPORT, vp);
+    SetSlot(LitConst::SkyVp, static_cast<float>(vp[0]), static_cast<float>(vp[1]),
+            1.0f / static_cast<float>(vp[2] > 0 ? vp[2] : 1), 1.0f / static_cast<float>(vp[3] > 0 ? vp[3] : 1));
+}
+
+void EngineGL33::SetRemasterSkyMode(int mode)
+{
+    if (!_lightingActive || !s_litUBO || _portraitTargetSize || _worldSceneEnded || _nightVision)
+        return;
+    // Draws queued so far belong to the previous mode.
+    FlushQueues();
+    if (mode != 0)
+        UpdateSkyDensityMap();
+    // The sky, the cloud sheets and the sun are pre-lit TL draws issued before
+    // the first mesh opens the world's 3D pass, so they normally go through the
+    // classic programs. Force the remastered set around them.
+    static bool s_forced = false;
+    if (mode != 0 && !_remasterPrograms)
+    {
+        s_forced = true;
+        _remasterPrograms = true;
+        glBindSampler(2, _shadowCompareSampler);
+        InvalidatePipelineCache();
+        if (GScene || _pixelShaderSel != PSWater)
+            DoSelectPixelShader(_pixelShaderSel, _pixelShaderModeSel, _pixelShaderSpecularSel);
+        else
+            _pixelShaderSel = PSNone;
+    }
+    else if (mode == 0 && s_forced)
+    {
+        s_forced = false;
+        _remasterPrograms = false;
+        glBindSampler(2, 0);
+        InvalidatePipelineCache();
+        if (GScene || _pixelShaderSel != PSWater)
+            DoSelectPixelShader(_pixelShaderSel, _pixelShaderModeSel, _pixelShaderSpecularSel);
+        else
+            _pixelShaderSel = PSNone;
+    }
+    if (mode != 0)
+        UploadSkyCamera();
+    s_lit[LitConst::Sky * 4 + 0] = static_cast<float>(mode);
+    glBindBuffer(GL_UNIFORM_BUFFER, s_litUBO);
+    glBufferSubData(GL_UNIFORM_BUFFER, LitConst::Sky * 16, 16 * (LitConst::SkyFwd - LitConst::Sky + 1),
+                    s_lit + LitConst::Sky * 4);
+    // The sky texture may have been (re)uploaded by the dome draw just flushed.
+    const unsigned int sky = SkyTextureHandle();
+    GL33Bind::Tex2D(kSkyTexUnit, sky ? sky : _post.whiteTex);
     GL33Bind::ActiveUnit(0);
 }
 
