+// ---------------------------------------------------------------------------
+// HFRT research prototype: canopy heightfield. Every landscape object that can
+// shade the ground at a distance (trees, bushes, forest blocks, buildings,
+// rocks) is rasterised top-down onto the terrain grid: per texel the top of the
+// tallest object over it and an occluder density (coverage x opacity), so the
+// shaders can trace sun shadows and sky occlusion of tree lines and forests far
+// beyond the shadow maps.
+struct CanopyItem
+{
+    float cx = 0.0f, cz = 0.0f; // footprint centre (world)
+    float ux = 1.0f, uz = 0.0f; // unit axis 1 of the footprint
+    float vx = 0.0f, vz = 1.0f; // unit axis 2
+    float a = 0.0f, b = 0.0f;   // half extents along u, v
+    float top = 0.0f;           // world height of the object's top
+    float density = 0.0f;       // opacity of a fully covered texel
+    bool ellipse = false;       // crowns: the ellipse inscribed in the rectangle
+    std::vector<float> hull;    // optional convex hull (x, z pairs, CCW)
+};
+
+float CanopyDensity(MapType type, bool& ellipse)
+{
+    ellipse = false;
+    switch (type)
+    {
+        case MapTree:
+            ellipse = true;
+            return 0.8f;
+        case MapSmallTree:
+            ellipse = true;
+            return 0.65f;
+        case MapBush:
+            ellipse = true;
+            return 0.5f;
+        case MapForestBorder:
+        case MapForestTriangle:
+        case MapForestSquare:
+            return 0.95f;
+        case MapBuilding:
+        case MapHouse:
+        case MapChurch:
+        case MapChapel:
+        case MapBunker:
+        case MapFortress:
+        case MapViewTower:
+        case MapLighthouse:
+        case MapFuelstation:
+        case MapHospital:
+        case MapRock:
+            return 1.0f;
+        default:
+            return 0.0f;
+    }
+}
+
+std::vector<float> ConvexHull(std::vector<float> pts)
+{
+    const size_t n = pts.size() / 2;
+    if (n < 3)
+        return {};
+    std::vector<std::pair<float, float>> p(n);
+    for (size_t i = 0; i < n; ++i)
+        p[i] = {pts[i * 2], pts[i * 2 + 1]};
+    std::sort(p.begin(), p.end());
+    p.erase(std::unique(p.begin(), p.end()), p.end());
+    if (p.size() < 3)
+        return {};
+    auto cross = [](const std::pair<float, float>& o, const std::pair<float, float>& a, const std::pair<float, float>& b)
+    { return (a.first - o.first) * (b.second - o.second) - (a.second - o.second) * (b.first - o.first); };
+    std::vector<std::pair<float, float>> h(2 * p.size());
+    size_t k = 0;
+    for (size_t i = 0; i < p.size(); ++i)
+    {
+        while (k >= 2 && cross(h[k - 2], h[k - 1], p[i]) <= 0.0f)
+            --k;
+        h[k++] = p[i];
+    }
+    for (size_t i = p.size() - 1, t = k + 1; i > 0; --i)
+    {
+        while (k >= t && cross(h[k - 2], h[k - 1], p[i - 1]) <= 0.0f)
+            --k;
+        h[k++] = p[i - 1];
+    }
+    h.resize(k - 1);
+    std::vector<float> out;
+    out.reserve(h.size() * 2);
+    for (const auto& q : h)
+    {
+        out.push_back(q.first);
+        out.push_back(q.second);
+    }
+    return out;
+}
+
+// Main thread: one footprint per occluding landscape object.
+std::vector<CanopyItem> GatherCanopy(const Landscape& land, int& nObjects)
+{
+    std::vector<CanopyItem> items;
+    nObjects = 0;
+    const int n = land.GetLandRange();
+    for (int z = 0; z < n; ++z)
+    {
+        for (int x = 0; x < n; ++x)
+        {
+            const ObjectList& list = land.GetObjects(z, x);
+            for (int i = 0; i < list.Size(); ++i)
+            {
+                Object* obj = list[i];
+                if (!obj || obj->GetType() != Primary)
+                    continue;
+                LODShapeWithShadow* shape = obj->GetShape();
+                if (!shape)
+                    continue;
+                ++nObjects;
+                bool ellipse = false;
+                const float density = CanopyDensity(shape->GetMapType(), ellipse);
+                if (density <= 0.0f)
+                    continue;
+                const Vector3 mn = shape->Min();
+                const Vector3 mx = shape->Max();
+                const Vector3 c = (mn + mx) * 0.5f;
+                const Vector3 wc = obj->PositionModelToWorld(c);
+                const Vector3 wu = obj->PositionModelToWorld(Vector3(mx.X(), c.Y(), c.Z())) -
+                                   obj->PositionModelToWorld(Vector3(mn.X(), c.Y(), c.Z()));
+                const Vector3 wv = obj->PositionModelToWorld(Vector3(c.X(), c.Y(), mx.Z())) -
+                                   obj->PositionModelToWorld(Vector3(c.X(), c.Y(), mn.Z()));
+                float top = -1e9f;
+                for (int k = 0; k < 8; ++k)
+                {
+                    const Vector3 corner((k & 1) ? mx.X() : mn.X(), (k & 2) ? mx.Y() : mn.Y(),
+                                         (k & 4) ? mx.Z() : mn.Z());
+                    top = std::max(top, obj->PositionModelToWorld(corner).Y());
+                }
+                CanopyItem it;
+                it.cx = wc.X();
+                it.cz = wc.Z();
+                const float lu = std::sqrt(wu.X() * wu.X() + wu.Z() * wu.Z());
+                const float lv = std::sqrt(wv.X() * wv.X() + wv.Z() * wv.Z());
+                if (lu < 0.2f || lv < 0.2f)
+                    continue;
+                it.ux = wu.X() / lu;
+                it.uz = wu.Z() / lu;
+                it.vx = wv.X() / lv;
+                it.vz = wv.Z() / lv;
+                // Crowns are rounder and a little smaller than their boxes.
+                const float shrink = ellipse ? 0.85f : 1.0f;
+                it.a = 0.5f * lu * shrink;
+                it.b = 0.5f * lv * shrink;
+                it.top = top;
+                it.density = density;
+                it.ellipse = ellipse;
+                if (!ellipse)
+                {
+                    // Forest triangles and odd footprints: the hull of the
+                    // geometry LOD when it is loaded, else the box.
+                    const Shape* geo = shape->GeometryLevel();
+                    if (geo && geo->NPos() >= 3)
+                    {
+                        std::vector<float> pts;
+                        pts.reserve(geo->NPos() * 2);
+                        for (int k = 0; k < geo->NPos(); ++k)
+                        {
+                            const Vector3 w = obj->PositionModelToWorld(geo->Pos(k));
+                            pts.push_back(w.X());
+                            pts.push_back(w.Z());
+                        }
+                        it.hull = ConvexHull(std::move(pts));
+                    }
+                }
+                items.push_back(std::move(it));
+            }
+        }
+    }
+    return items;
+}
+
+bool CanopyInside(const CanopyItem& it, float px, float pz)
+{
+    if (!it.hull.empty())
+    {
+        const size_t n = it.hull.size() / 2;
+        for (size_t i = 0; i < n; ++i)
+        {
+            const float x0 = it.hull[i * 2], z0 = it.hull[i * 2 + 1];
+            const float x1 = it.hull[((i + 1) % n) * 2], z1 = it.hull[((i + 1) % n) * 2 + 1];
+            if ((x1 - x0) * (pz - z0) - (z1 - z0) * (px - x0) < 0.0f)
+                return false;
+        }
+        return true;
+    }
+    const float dx = px - it.cx, dz = pz - it.cz;
+    const float s = (dx * it.ux + dz * it.uz) / it.a;
+    const float t = (dx * it.vx + dz * it.vz) / it.b;
+    return it.ellipse ? s * s + t * t <= 1.0f : (std::fabs(s) <= 1.0f && std::fabs(t) <= 1.0f);
+}
+
+// Worker thread: rasterise the footprints, 4x4 samples per texel.
+std::vector<float> RasterizeCanopy(const std::vector<CanopyItem>& items, const std::vector<float>& heights, int range,
+                                   float grid)
+{
+    const size_t cells = static_cast<size_t>(range) * range;
+    std::vector<float> top(heights.begin(), heights.begin() + cells);
+    std::vector<float> trans(cells, 1.0f);
+    for (const CanopyItem& it : items)
+    {
+        float minx, maxx, minz, maxz;
+        if (!it.hull.empty())
+        {
+            minx = maxx = it.hull[0];
+            minz = maxz = it.hull[1];
+            for (size_t i = 0; i + 1 < it.hull.size(); i += 2)
+            {
+                minx = std::min(minx, it.hull[i]);
+                maxx = std::max(maxx, it.hull[i]);
+                minz = std::min(minz, it.hull[i + 1]);
+                maxz = std::max(maxz, it.hull[i + 1]);
+            }
+        }
+        else
+        {
+            const float ex = std::fabs(it.ux) * it.a + std::fabs(it.vx) * it.b;
+            const float ez = std::fabs(it.uz) * it.a + std::fabs(it.vz) * it.b;
+            minx = it.cx - ex;
+            maxx = it.cx + ex;
+            minz = it.cz - ez;
+            maxz = it.cz + ez;
+        }
+        const int x0 = std::max(0, static_cast<int>(std::floor(minx / grid - 0.5f)));
+        const int x1 = std::min(range - 1, static_cast<int>(std::ceil(maxx / grid + 0.5f)));
+        const int z0 = std::max(0, static_cast<int>(std::floor(minz / grid - 0.5f)));
+        const int z1 = std::min(range - 1, static_cast<int>(std::ceil(maxz / grid + 0.5f)));
+        for (int z = z0; z <= z1; ++z)
+        {
+            for (int x = x0; x <= x1; ++x)
+            {
+                int inside = 0;
+                for (int sz = 0; sz < 4; ++sz)
+                    for (int sx = 0; sx < 4; ++sx)
+                        inside += CanopyInside(it, (x + (sx + 0.5f) * 0.25f - 0.5f) * grid,
+                                               (z + (sz + 0.5f) * 0.25f - 0.5f) * grid)
+                                      ? 1
+                                      : 0;
+                if (!inside)
+                    continue;
+                const size_t idx = static_cast<size_t>(z) * range + x;
+                top[idx] = std::max(top[idx], it.top);
+                trans[idx] *= 1.0f - it.density * (static_cast<float>(inside) / 16.0f);
+            }
+        }
+    }
+    std::vector<float> out(cells * 2);
+    for (size_t i = 0; i < cells; ++i)
+    {
+        out[i * 2] = top[i];
+        out[i * 2 + 1] = 1.0f - trans[i];
+    }
+    return out;
+}
+
+// HFRT research v5: the canopy at k texels per terrain cell (cell-aligned:
+// texel j covers [j, j+1) * grid / k), with a max/mean mip chain so the shader
+// can cone-trace it (coarser levels further from the receiver).
+constexpr float kCanopyFineRelMax = 100.0f; // metres above the terrain at r = 1
+
+struct FineCanopy
+{
+    std::vector<std::uint16_t> data;
+    int size = 0;
+    int levels = 0;
+};
+
+float BilinearHeight(const std::vector<float>& h, int range, float grid, float x, float z)
+{
+    const float fx = std::clamp(x / grid, 0.0f, static_cast<float>(range - 1));
+    const float fz = std::clamp(z / grid, 0.0f, static_cast<float>(range - 1));
+    const int x0 = std::min(static_cast<int>(fx), range - 2);
+    const int z0 = std::min(static_cast<int>(fz), range - 2);
+    const float tx = fx - static_cast<float>(x0), tz = fz - static_cast<float>(z0);
+    auto at = [&](int xx, int zz) { return h[static_cast<size_t>(zz) * range + xx]; };
+    return (at(x0, z0) * (1.0f - tx) + at(x0 + 1, z0) * tx) * (1.0f - tz) +
+           (at(x0, z0 + 1) * (1.0f - tx) + at(x0 + 1, z0 + 1) * tx) * tz;
+}
+
+FineCanopy RasterizeCanopyFine(const std::vector<CanopyItem>& items, const std::vector<float>& heights, int range,
+                               float grid, int k)
+{
+    FineCanopy out;
+    const int n = range * k;
+    const float c = grid / static_cast<float>(k);
+    const size_t cells = static_cast<size_t>(n) * n;
+    std::vector<float> rel(cells, 0.0f);
+    std::vector<float> trans(cells, 1.0f);
+    for (const CanopyItem& it : items)
+    {
+        float minx, maxx, minz, maxz;
+        if (!it.hull.empty())
+        {
+            minx = maxx = it.hull[0];
+            minz = maxz = it.hull[1];
+            for (size_t i = 0; i + 1 < it.hull.size(); i += 2)
+            {
+                minx = std::min(minx, it.hull[i]);
+                maxx = std::max(maxx, it.hull[i]);
+                minz = std::min(minz, it.hull[i + 1]);
+                maxz = std::max(maxz, it.hull[i + 1]);
+            }
+        }
+        else
+        {
+            const float ex = std::fabs(it.ux) * it.a + std::fabs(it.vx) * it.b;
+            const float ez = std::fabs(it.uz) * it.a + std::fabs(it.vz) * it.b;
+            minx = it.cx - ex;
+            maxx = it.cx + ex;
+            minz = it.cz - ez;
+            maxz = it.cz + ez;
+        }
+        const float relTop =
+            std::clamp(it.top - BilinearHeight(heights, range, grid, it.cx, it.cz), 0.0f, kCanopyFineRelMax);
+        if (relTop < 0.5f)
+            continue;
+        const int x0 = std::max(0, static_cast<int>(std::floor(minx / c)));
+        const int x1 = std::min(n - 1, static_cast<int>(std::floor(maxx / c)));
+        const int z0 = std::max(0, static_cast<int>(std::floor(minz / c)));
+        const int z1 = std::min(n - 1, static_cast<int>(std::floor(maxz / c)));
+        for (int z = z0; z <= z1; ++z)
+        {
+            for (int x = x0; x <= x1; ++x)
+            {
+                int inside = 0;
+                for (int sz = 0; sz < 4; ++sz)
+                    for (int sx = 0; sx < 4; ++sx)
+                        inside += CanopyInside(it, (x + (sx + 0.5f) * 0.25f) * c, (z + (sz + 0.5f) * 0.25f) * c) ? 1 : 0;
+                if (!inside)
+                    continue;
+                const size_t idx = static_cast<size_t>(z) * n + x;
+                rel[idx] = std::max(rel[idx], relTop);
+                trans[idx] *= 1.0f - it.density * (static_cast<float>(inside) / 16.0f);
+            }
+        }
+    }
+    std::vector<float> den(cells);
+    for (size_t i = 0; i < cells; ++i)
+        den[i] = 1.0f - trans[i];
+    trans.clear();
+    trans.shrink_to_fit();
+
+    int levels = 1;
+    for (int s = n; s > 1; s = std::max(1, s / 2))
+        ++levels;
+    out.data.reserve(cells * 2 * 4 / 3 + 64);
+    auto enc = [](float v) { return static_cast<std::uint16_t>(std::lround(std::clamp(v, 0.0f, 1.0f) * 65535.0f)); };
+    int s = n;
+    for (int l = 0; l < levels; ++l)
+    {
+        const size_t m = static_cast<size_t>(s) * s;
+        for (size_t i = 0; i < m; ++i)
+        {
+            out.data.push_back(enc(rel[i] / kCanopyFineRelMax));
+            out.data.push_back(enc(den[i]));
+        }
+        if (s == 1)
+            break;
+        const int s2 = std::max(1, s / 2);
+        std::vector<float> rel2(static_cast<size_t>(s2) * s2, 0.0f);
+        std::vector<float> den2(static_cast<size_t>(s2) * s2, 0.0f);
+        for (int z = 0; z < s2; ++z)
+        {
+            for (int x = 0; x < s2; ++x)
+            {
+                float r = 0.0f, d = 0.0f;
+                for (int dz = 0; dz < 2; ++dz)
+                {
+                    for (int dx = 0; dx < 2; ++dx)
+                    {
+                        const int cx = std::min(s - 1, x * 2 + dx), cz = std::min(s - 1, z * 2 + dz);
+                        const size_t ci = static_cast<size_t>(cz) * s + cx;
+                        d += den[ci];
+                        if (den[ci] > 0.004f)
+                            r = std::max(r, rel[ci]);
+                    }
+                }
+                rel2[static_cast<size_t>(z) * s2 + x] = r;
+                den2[static_cast<size_t>(z) * s2 + x] = d * 0.25f;
+            }
+        }
+        rel = std::move(rel2);
+        den = std::move(den2);
+        s = s2;
+    }
+    out.size = n;
+    out.levels = levels;
+    return out;
+}
