+// SSR prototype: writes a constant colour where the stencil test passes (the
+// surface tags of the world pass, read out channel by channel).
+static const char s_psPostSsrTagGLSL[] = R"(#version 330 core
+uniform vec4 tagColor;
+out vec4 fragColor;
+void main() { fragColor = tagColor; }
+)";
+
+// SSR prototype: screen-space reflections for water (stencil tag 0x80), wet
+// terrain (0x40, scaled by rain) and glossy materials (0x20). Reads the
+// resolved frame (display space) and writes the reflected frame, alpha kept.
+static const char s_psPostSsrGLSL[] = R"(#version 330 core
+in vec2 vUV;
+uniform sampler2D depthTex;  // unit 0
+uniform sampler2D colorTex;  // unit 2: resolved frame (display space)
+uniform sampler2D mipTex;    // unit 3: the frame with a mip chain (cone blur)
+uniform sampler2D tagTex;    // unit 4: r water, g terrain, b glossy
+uniform sampler2D heightTex; // unit 6: terrain r = height (m)
+uniform vec4 projInfo;   // x _33, y _43, z 1/_11, w 1/_22
+uniform vec4 depthMap;   // ndcZ = depth * x + y
+uniform vec4 screen;     // xy size, zw 1/size
+uniform vec4 worldRect;  // 3D viewport in uv
+uniform mat3 w2v;        // world -> view rotation
+uniform vec4 camWorld;   // xyz camera world position, w sea level
+uniform vec4 ssrA;       // x strength, y water, z wave, w wetness
+uniform vec4 ssrB;       // x glossy, y debug, z time (s), w mip levels
+uniform vec4 ssrC;       // x rough scale, y night effect, z far plane (m)
+uniform vec4 fogParam;   // start, invRange, enabled
+uniform vec4 fogCol;     // display fog colour
+layout(std140) uniform LitConstants {
+    vec4 litSunDir; vec4 litSun; vec4 litZenith; vec4 litHorizon; vec4 litGround;
+    vec4 litMoonDir; vec4 litMoon; vec4 litCamPos; vec4 litMatDiffuse; vec4 litMatAmbient;
+    vec4 litMatForced; vec4 litMatEmissive; vec4 litMatSpecular; vec4 litTerrain;
+    vec4 litTerrainSel0; vec4 litTerrainSel1; vec4 litTerrainSun; vec4 litTerrainLift;
+    vec4 litCloud; vec4 litCloudOffset; vec4 litShadowDelta; vec4 litFlags; vec4 litLightCount;
+    vec4 litHorizonSun; vec4 litFogSun; vec4 litFogCap;
+};
+out vec4 fragColor;
+
+vec3 toLinear(vec3 c) { return pow(max(c, vec3(0.0)), vec3(2.2)); }
+vec3 toDisplay(vec3 c) { return pow(max(c, vec3(0.0)), vec3(1.0 / 2.2)); }
+float viewZ(float d) { return projInfo.y / ((d * depthMap.x + depthMap.y) - projInfo.x); }
+vec3 viewPos(vec2 uv, float z) {
+    vec2 ndc = (uv - worldRect.xy) / worldRect.zw * 2.0 - 1.0;
+    return vec3(ndc.x * z * projInfo.z, ndc.y * z * projInfo.w, z);
+}
+vec2 projUV(vec3 p) {
+    vec2 ndc = vec2(p.x / (projInfo.z * p.z), p.y / (projInfo.w * p.z));
+    return worldRect.xy + (ndc * 0.5 + 0.5) * worldRect.zw;
+}
+float sceneZ(vec2 uv) {
+    float d = textureLod(depthTex, uv, 0.0).r;
+    return d >= 0.999999 ? 1e9 : viewZ(d);
+}
+vec3 fogColorToward(vec3 dirW) {
+    if (litFogSun.w < 0.5) return fogCol.rgb;
+    float c = max(dot(dirW * inversesqrt(max(dot(dirW, dirW), 1e-12)), litSunDir.xyz), 0.0);
+    float c2 = c * c;
+    return min(fogCol.rgb + litFogSun.rgb * (c2 * c2 * c2), max(litFogCap.rgb, fogCol.rgb));
+}
+float hash12(vec2 p) {
+    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
+    p3 += dot(p3, p3.yzx + 33.33);
+    return fract((p3.x + p3.y) * p3.z);
+}
+float vnoise(vec2 p) {
+    vec2 i = floor(p), f = fract(p);
+    vec2 u = f * f * (3.0 - 2.0 * f);
+    return mix(mix(hash12(i), hash12(i + vec2(1, 0)), u.x), mix(hash12(i + vec2(0, 1)), hash12(i + vec2(1, 1)), u.x), u.y);
+}
+
+// Directional ripples: the slope of waves too short for this pixel's
+// footprint is filtered out of the normal and returned as variance (blur).
+vec3 waterNormal(vec2 xz, float t, float foot, out float lostVar) {
+    const vec2 dirs[6] = vec2[](vec2(0.94, 0.34), vec2(0.62, -0.78), vec2(-0.33, 0.94),
+                                vec2(0.99, -0.12), vec2(-0.71, -0.70), vec2(0.20, 0.98));
+    const float lambda[6] = float[](23.0, 11.0, 5.3, 2.7, 1.3, 0.7);
+    const float slope[6] = float[](0.030, 0.035, 0.040, 0.040, 0.035, 0.030);
+    vec2 g = vec2(0.0);
+    lostVar = 0.0;
+    for (int i = 0; i < 6; ++i) {
+        float k = 6.2831853 / lambda[i];
+        float ph = dot(dirs[i], xz) * k - sqrt(9.81 * k) * t + float(i) * 1.7;
+        float keep = clamp(lambda[i] / (3.0 * foot) - 0.5, 0.0, 1.0);
+        float s = slope[i] * ssrA.z;
+        g += dirs[i] * (s * cos(ph) * keep);
+        lostVar += 0.5 * s * s * (1.0 - keep * keep);
+    }
+    return normalize(vec3(-g.x, 1.0, -g.y));
+}
+
+vec3 depthNormalV(vec2 uv, vec3 p) {
+    vec2 tx = vec2(screen.z, 0.0), ty = vec2(0.0, screen.w);
+    vec3 pr = viewPos(uv + tx, viewZ(textureLod(depthTex, uv + tx, 0.0).r));
+    vec3 pl = viewPos(uv - tx, viewZ(textureLod(depthTex, uv - tx, 0.0).r));
+    vec3 pu = viewPos(uv + ty, viewZ(textureLod(depthTex, uv + ty, 0.0).r));
+    vec3 pd = viewPos(uv - ty, viewZ(textureLod(depthTex, uv - ty, 0.0).r));
+    vec3 dx = abs(pr.z - p.z) < abs(p.z - pl.z) ? pr - p : p - pl;
+    vec3 dy = abs(pu.z - p.z) < abs(p.z - pd.z) ? pu - p : p - pd;
+    vec3 n = normalize(cross(dx, dy));
+    if (dot(n, p) > 0.0) n = -n;
+    return n;
+}
+
+// Screen-space march of a view-space ray: linear in screen space with a
+// perspective-correct depth, an interval overlap test and a binary refine.
+// kind: 0 left the screen, 1 hit geometry, 2 ended on visible sky.
+const int kSteps = 80;
+vec2 traceRay(vec3 p0, vec3 r, float jitter, out int kind, out float travel, out vec2 exitUV) {
+    kind = 0;
+    travel = 0.0;
+    float len = ssrC.z * 0.98;
+    if (r.z < 0.0) len = min(len, (p0.z - 0.3) / -r.z);
+    vec3 p1 = p0 + r * len;
+    vec2 s0 = projUV(p0) * screen.xy;
+    vec2 s1 = projUV(p1) * screen.xy;
+    float k0 = 1.0 / p0.z, k1 = 1.0 / p1.z;
+    vec2 lo = worldRect.xy * screen.xy + 1.0;
+    vec2 hi = (worldRect.xy + worldRect.zw) * screen.xy - 1.0;
+    vec2 dS = s1 - s0;
+    float tc = 1.0;
+    if (dS.x > 1e-4) tc = min(tc, (hi.x - s0.x) / dS.x); else if (dS.x < -1e-4) tc = min(tc, (lo.x - s0.x) / dS.x);
+    if (dS.y > 1e-4) tc = min(tc, (hi.y - s0.y) / dS.y); else if (dS.y < -1e-4) tc = min(tc, (lo.y - s0.y) / dS.y);
+    tc = max(tc, 0.0);
+    bool clipped = tc < 0.9999;
+    float pix = max(abs(dS.x), abs(dS.y)) * tc;
+    int n = int(clamp(pix / 1.5, 4.0, float(kSteps)));
+    float dt = tc / float(n);
+    float tPrev = 0.0;
+    float zPrev = p0.z;
+    float startT = 2.0 / max(max(abs(dS.x), abs(dS.y)), 1e-3); // skip the first two pixels
+    exitUV = (s0 + dS * tc) * screen.zw;
+    for (int i = 0; i < kSteps; ++i) {
+        if (i >= n) break;
+        float t = min(dt * (float(i) + jitter) + startT, tc);
+        vec2 s = s0 + dS * t;
+        float rz = 1.0 / mix(k0, k1, t);
+        vec2 uv = s * screen.zw;
+        float sz = sceneZ(uv);
+        float thick = 0.4 + 0.04 * sz;
+        if (max(zPrev, rz) >= sz && min(zPrev, rz) <= sz + thick) {
+            float a = tPrev, b = t;
+            for (int j = 0; j < 6; ++j) {
+                float m = 0.5 * (a + b);
+                vec2 su = (s0 + dS * m) * screen.zw;
+                float mz = 1.0 / mix(k0, k1, m);
+                if (mz >= sceneZ(su)) b = m; else a = m;
+            }
+            float zr = 1.0 / mix(k0, k1, b);
+            travel = abs(r.z) > 1e-3 ? abs((zr - p0.z) / r.z) : len * b;
+            kind = 1;
+            return (s0 + dS * b) * screen.zw;
+        }
+        tPrev = t;
+        zPrev = rz;
+    }
+    if (!clipped && sceneZ(exitUV) > 1e8) { kind = 2; travel = 1e9; }
+    return exitUV;
+}
+
+void main() {
+    vec4 c = texture(colorTex, vUV);
+    vec3 tags = texture(tagTex, vUV).rgb;
+    float d0 = texture(depthTex, vUV).r;
+    int dbg = int(ssrB.y + 0.5);
+    if (dbg == 1) {
+        float anyTag = max(tags.r, max(tags.g, tags.b));
+        fragColor = vec4(mix(c.rgb * 0.5, tags, anyTag * 0.75), c.a);
+        return;
+    }
+    float wet = clamp(ssrA.w, 0.0, 1.0);
+    bool water = tags.r > 0.5 && ssrA.y > 0.0;
+    bool terrain = !water && tags.g > 0.5 && wet > 0.0;
+    bool glossy = !water && !terrain && tags.b > 0.5 && ssrB.x > 0.0;
+    if (d0 >= 0.999999 || !(water || terrain || glossy) || ssrA.x <= 0.0) {
+        fragColor = dbg >= 2 ? vec4(0.0, 0.0, 0.0, c.a) : c;
+        return;
+    }
+    float z = viewZ(d0);
+    vec3 p = viewPos(vUV, z);
+    mat3 v2w = inverse(w2v);
+    vec3 relW = v2w * p;
+    vec3 posW = relW + camWorld.xyz;
+    vec3 vW = normalize(-relW);
+    float dist = length(relW);
+    float pixAngle = 2.0 * projInfo.w * screen.w;
+
+    vec3 nW;
+    float cone; // reflected cone half angle (radians) for the mip blur
+    float puddle = 0.0;
+    if (water) {
+        float foot = dist * pixAngle / sqrt(max(vW.y, 0.01));
+        float lostVar;
+        nW = waterNormal(posW.xz, ssrB.z, foot, lostVar);
+        cone = 2.0 * sqrt(lostVar) + 0.004;
+    } else {
+        vec3 nD = normalize(v2w * depthNormalV(vUV, p));
+        if (terrain) {
+            float pn = vnoise(posW.xz / 6.0) * 0.65 + vnoise(posW.xz / 1.7) * 0.35;
+            float flatness = smoothstep(0.85, 0.98, nD.y);
+            puddle = wet * flatness * smoothstep(0.50, 0.58, pn + 0.15 * (wet - 0.5));
+            // Up-facing wet ground: a smoothed normal; a puddle is a level mirror.
+            nW = normalize(mix(nD, vec3(0.0, 1.0, 0.0), mix(0.5, 1.0, puddle)));
+            float rip = 0.04 * puddle * (vnoise(posW.xz * 3.0 + ssrB.z * 0.7) - 0.5);
+            nW = normalize(nW + vec3(rip, 0.0, -rip));
+            cone = mix(0.22, 0.01, puddle);
+        } else {
+            nW = nD;
+            cone = 0.06;
+        }
+    }
+    cone *= ssrC.x;
+    vec3 rW = reflect(-vW, nW);
+    if (water) {
+        rW.y = max(rW.y, 0.002 + 0.25 * vW.y);
+        rW = normalize(rW);
+    }
+    vec3 rV = normalize(w2v * rW);
+    float jitter = fract(52.9829189 * fract(dot(gl_FragCoord.xy, vec2(0.06711056, 0.00583715))));
+    int kind;
+    float travel;
+    vec2 exitUV;
+    vec2 huv = traceRay(p, rV, jitter, kind, travel, exitUV);
+
+    float conf = 0.0;
+    vec3 R = vec3(0.0);
+    if (kind != 0) {
+        vec2 e = min(huv - worldRect.xy, worldRect.xy + worldRect.zw - huv) / worldRect.zw;
+        conf = smoothstep(0.0, 0.03, min(e.x, e.y));
+        float hz = kind == 2 ? 1.0 : max(sceneZ(huv), 0.1);
+        float px = kind == 2 ? cone / pixAngle : cone * travel / (hz * pixAngle);
+        float maxLod = max(ssrB.w - 1.0, 0.0);
+        if (water) {
+            // Waves stretch a reflection along the view: vertical taps, a
+            // narrower horizontal footprint.
+            float pxH = px * sqrt(max(vW.y, 0.02)) * 2.0;
+            float lod = clamp(log2(max(pxH, 1.0)), 0.0, maxLod);
+            float span = min(px, 64.0) * screen.w;
+            vec3 acc = vec3(0.0);
+            float wsum = 0.0;
+            for (int k = -3; k <= 3; ++k) {
+                float w = exp(-float(k * k) / 4.5);
+                vec2 u = clamp(huv + vec2(0.0, float(k) * span / 3.0), worldRect.xy, worldRect.xy + worldRect.zw);
+                acc += toLinear(textureLod(mipTex, u, lod).rgb) * w;
+                wsum += w;
+            }
+            R = acc / wsum;
+        } else {
+            float lod = clamp(log2(max(px, 1.0)), 0.0, maxLod);
+            R = toLinear(textureLod(mipTex, huv, lod).rgb);
+        }
+    }
+
+    vec3 lin = toLinear(c.rgb);
+    float strength = ssrA.x;
+    if (water) {
+        // The water shader already reflects its sky approximation S with
+        // weight 0.6 F (flat normal); swap S for what the ray found.
+        float fFlat = 0.02 + 0.98 * pow(1.0 - clamp(vW.y, 0.0, 1.0), 5.0);
+        float fWave = 0.02 + 0.98 * pow(1.0 - clamp(dot(nW, vW), 0.0, 1.0), 5.0);
+        float F = mix(fFlat, fWave, 0.5);
+        vec3 rFlat = reflect(-vW, vec3(0.0, 1.0, 0.0));
+        vec3 S = toLinear(fogColorToward(vec3(rFlat.x, 0.0, rFlat.z)));
+        float fogT = fogParam.z > 0.5 ? clamp(1.0 - (dist - fogParam.x) * fogParam.y, 0.0, 1.0) : 1.0;
+        float depthFade = 1.0;
+        if (litTerrain.x > 0.5) {
+            vec2 g = posW.xz * litTerrain.y;
+            vec2 huv2 = (g + 0.5) * litTerrain.z;
+            float gh = textureLod(heightTex, huv2, 0.0).r;
+            depthFade = smoothstep(0.0, 1.2, camWorld.w - gh);
+        }
+        float w = F * clamp(0.6 * ssrA.y, 0.0, 1.0) * conf * fogT * depthFade * strength;
+        lin = max(lin + w * (R - S), vec3(0.0));
+    } else if (terrain) {
+        if (kind == 0 || conf < 1.0) {
+            // Off-screen: the sky at the edge the ray left through, else the fog sky.
+            vec3 sky = toLinear(fogColorToward(rW));
+            if (sceneZ(exitUV) > 1e8)
+                sky = toLinear(textureLod(mipTex, exitUV, max(ssrB.w - 4.0, 0.0)).rgb);
+            R = mix(sky, R, conf);
+            conf = 1.0;
+        }
+        float nv = clamp(dot(nW, vW), 0.0, 1.0);
+        float F = 0.02 + 0.98 * pow(1.0 - nv, 5.0);
+        float specW = mix(0.45 * wet, 1.0, puddle) * F * strength;
+        vec3 base = lin * mix(1.0, 0.62, wet * (1.0 - puddle) * strength) * mix(1.0, 0.5, puddle * strength);
+        float fogT = fogParam.z > 0.5 ? clamp(1.0 - (dist - fogParam.x) * fogParam.y, 0.0, 1.0) : 1.0;
+        vec3 wetLin = base * (1.0 - specW) + specW * R;
+        lin = mix(lin, wetLin, fogT);
+    } else {
+        float nv = clamp(dot(nW, vW), 0.0, 1.0);
+        float F = 0.04 + 0.96 * pow(1.0 - nv, 5.0);
+        float w = F * ssrB.x * conf * strength;
+        lin = mix(lin, R, w);
+    }
+    if (dbg == 2) { fragColor = vec4(toDisplay(R * conf), c.a); return; }
+    if (dbg == 3) { fragColor = vec4(kind == 1 ? conf : 0.0, 0.0, kind == 2 ? conf : 0.0, c.a); return; }
+    fragColor = vec4(toDisplay(lin), c.a);
+}
