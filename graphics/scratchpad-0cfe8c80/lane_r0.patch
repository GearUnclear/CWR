diff --git a/arma_CWR/engine/Poseidon/Graphics/Remaster/VolumetricFog.cpp b/arma_CWR/engine/Poseidon/Graphics/Remaster/VolumetricFog.cpp
new file mode 100644
index 0000000..f0dd875
--- /dev/null
+++ b/arma_CWR/engine/Poseidon/Graphics/Remaster/VolumetricFog.cpp
@@ -0,0 +1,234 @@
+#include <Poseidon/Graphics/Remaster/VolumetricFog.hpp>
+
+#include <algorithm>
+#include <cmath>
+
+namespace Poseidon::remaster
+{
+
+namespace
+{
+
+float Clamp01(float x)
+{
+    return x < 0.0f ? 0.0f : (x > 1.0f ? 1.0f : x);
+}
+
+float Smooth(float e0, float e1, float x)
+{
+    const float t = Clamp01((x - e0) / (e1 - e0));
+    return t * t * (3.0f - 2.0f * t);
+}
+
+// Rayleigh scattering of air at sea level, green (1/m; Atmosphere.hpp).
+constexpr float kRayleighGreen = 13.558e-6f;
+constexpr float kRayleighHeight = 8000.0f;
+
+} // namespace
+
+FogGrid FogGridFor(int w, int h, float quality)
+{
+    FogGrid g;
+    if (w <= 0 || h <= 0)
+        return g;
+    const int q = std::clamp(static_cast<int>(std::lround(quality)), 0, 2);
+    static constexpr int kCell[3] = {16, 12, 8};
+    static constexpr int kSlices[3] = {48, 64, 96};
+    g.cellPixels = kCell[q];
+    g.slices = kSlices[q];
+    g.cellsX = std::max(1, (w + g.cellPixels - 1) / g.cellPixels);
+    g.cellsY = std::max(1, (h + g.cellPixels - 1) / g.cellPixels);
+    return g;
+}
+
+float FogSliceDepth(float t, float zFar, float k)
+{
+    if (k < 1e-3f)
+        return zFar * t;
+    return zFar * (std::exp(k * t) - 1.0f) / (std::exp(k) - 1.0f);
+}
+
+float FogSliceCoord(float z, float zFar, float k)
+{
+    if (zFar <= 0.0f)
+        return 0.0f;
+    if (k < 1e-3f)
+        return Clamp01(z / zFar);
+    return Clamp01(std::log(1.0f + std::max(z, 0.0f) * (std::exp(k) - 1.0f) / zFar) / k);
+}
+
+float FogDepthK(float zFar, int slices)
+{
+    if (slices <= 0 || zFar <= 0.0f)
+        return 1e-3f;
+    const float first = kFogFirstSliceMetres * 64.0f / static_cast<float>(slices);
+    const float t = 1.0f / static_cast<float>(slices);
+    if (zFar * t <= first)
+        return 1e-3f; // even slices are already this fine
+    // FogSliceDepth(t) falls as k grows: bisect for the first slice's depth.
+    float lo = 1e-3f, hi = 30.0f;
+    for (int i = 0; i < 60; ++i)
+    {
+        const float mid = 0.5f * (lo + hi);
+        if (FogSliceDepth(t, zFar, mid) > first)
+            lo = mid;
+        else
+            hi = mid;
+    }
+    return 0.5f * (lo + hi);
+}
+
+float WeatherVisibility(float fog, float rain, float viewDistance)
+{
+    // Landscape.cpp's tactical range with the night factor at 1.
+    const float fogVisibility = 1.0f - Clamp01(fog) * 0.95f;
+    const float r = Clamp01(rain);
+    const float noFog = (1.0f - r) * viewDistance + kRainVisibility * r;
+    const float defaultDistance = std::min(900.0f, noFog) * fogVisibility;
+    const float currentDistance = noFog * fogVisibility;
+    float range = defaultDistance;
+    constexpr float kThreshold = 0.6f;
+    if (fogVisibility > kThreshold)
+    {
+        const float i = (fogVisibility - kThreshold) / (1.0f - kThreshold);
+        range = i * currentDistance + (1.0f - i) * defaultDistance;
+    }
+    return std::max(range, 0.1f);
+}
+
+float FogMorningWeight(float sunElevationDeg, float sunAzimuthDeg)
+{
+    const bool east = sunAzimuthDeg > 0.0f && sunAzimuthDeg < 180.0f;
+    if (!east)
+        return 0.0f;
+    return Smooth(-6.0f, -2.0f, sunElevationDeg) * (1.0f - Smooth(8.0f, 24.0f, sunElevationDeg));
+}
+
+float FogEdgeScale(float fogStart, float fogEnd)
+{
+    const float range = fogEnd - fogStart;
+    if (range <= 1e-3f || fogEnd <= 0.0f)
+        return 1.0f;
+    const float edge = fogEnd * (1.0f - kFogEdgeStart);
+    return std::max(1.0f, range / std::max(edge, 1e-3f));
+}
+
+FogMedium ComputeFogMedium(const FogInputs& in, const LightingTuning& t, bool applied)
+{
+    FogMedium m;
+    m.zFar = std::max(in.fogEnd, 50.0f);
+    if (!applied)
+        return m;
+    const float density = std::max(t.fogDensity, 0.0f);
+    const float overcast = 1.0f - Clamp01(in.skyThrough);
+    const float rain = Clamp01(in.rain);
+    const float fog = Clamp01(in.fog);
+    const float morning = FogMorningWeight(in.sunElevationDeg, in.sunAzimuthDeg);
+    m.morning = morning;
+    m.skyThrough = Clamp01(in.skyThrough);
+
+    // Haze: thicker under cloud, in rain and in the humid morning air.
+    m.hazeSigma = kHazeClear * density * (1.0f + 1.4f * overcast) * (1.0f + 0.4f * morning) * (1.0f + rain);
+    m.rayleigh = kRayleighScale * density;
+    // The humid air near the ground: at a low sun (the golden hours, where
+    // beams fall through trees), at night (headlight cones), under a grey sky
+    // and in rain.
+    const float lowSun = Smooth(28.0f, 8.0f, in.sunElevationDeg) * Smooth(-6.0f, 0.0f, in.sunElevationDeg);
+    const float groundWeight =
+        std::min(std::max(lowSun, 0.9f * Clamp01(in.nightEffect)) + 0.3f * overcast + 0.5f * rain, 1.5f);
+    m.groundSigma = kGroundHaze * groundWeight * density;
+
+    // Weather fog: the part of the classic tactical visibility the weather
+    // takes away, at the fog floor: half of a surface is gone a little before
+    // two thirds of the classic fog end (where its linear fog is half), and
+    // the forward fog's edge hides the rest.
+    const float vd = std::max(in.viewDistance, 100.0f);
+    const float visibility = WeatherVisibility(fog, rain, vd);
+    m.weatherSigma = kWeatherExtinction * std::max(0.0f, 1.0f / visibility - 1.0f / vd) * density;
+    const float wFog = fog / std::max(fog + rain, 1e-4f);
+    m.weatherHeight = kWeatherFogHeight * wFog + kRainHazeHeight * (1.0f - wFog);
+
+    // Valley mist: dawn, a little at dusk and at night, under a grey sky, in
+    // rain and in fog.
+    const bool west = !(in.sunAzimuthDeg > 0.0f && in.sunAzimuthDeg < 180.0f);
+    const float evening = west ? Smooth(6.0f, 0.0f, in.sunElevationDeg) : 0.0f;
+    const float night = Clamp01(in.nightEffect);
+    const float weight =
+        std::min(morning + 0.35f * std::max(evening, night) + 0.25f * overcast + 0.5f * rain + 1.5f * fog, 2.0f);
+    m.mistSigma = kMistSigma * weight * std::max(t.fogMist, 0.0f) * density;
+    m.mistDepth = kMistLayerDepth + 60.0f * fog + 20.0f * rain;
+    m.mistFall = kMistLayerFall * (1.0f + fog);
+    m.mistNoise = 0.8f - 0.5f * fog;
+
+    m.sun = std::max(t.fogSun, 0.0f);
+    m.sky = 1.0f;
+    m.lights = std::max(t.fogLights, 0.0f);
+    m.fogEdgeScale = FogEdgeScale(in.fogStart, in.fogEnd);
+    return m;
+}
+
+std::vector<float> BuildFogFloor(const float* heights, int size, float cellSize, float radius, float blur)
+{
+    std::vector<float> out;
+    if (!heights || size <= 1 || cellSize <= 0.0f)
+        return out;
+    const size_t n = static_cast<size_t>(size) * static_cast<size_t>(size);
+    const int r = std::max(1, static_cast<int>(std::lround(radius / cellSize)));
+    const int b = std::max(0, static_cast<int>(std::lround(blur / cellSize)));
+    std::vector<float> tmp(n);
+    out.assign(n, 0.0f);
+    // The lowest ground in a square window: across, then down.
+    for (int z = 0; z < size; ++z)
+        for (int x = 0; x < size; ++x)
+        {
+            float m = heights[static_cast<size_t>(z) * size + x];
+            for (int k = std::max(0, x - r); k <= std::min(size - 1, x + r); ++k)
+                m = std::min(m, heights[static_cast<size_t>(z) * size + k]);
+            tmp[static_cast<size_t>(z) * size + x] = m;
+        }
+    for (int z = 0; z < size; ++z)
+        for (int x = 0; x < size; ++x)
+        {
+            float m = tmp[static_cast<size_t>(z) * size + x];
+            for (int k = std::max(0, z - r); k <= std::min(size - 1, z + r); ++k)
+                m = std::min(m, tmp[static_cast<size_t>(k) * size + x]);
+            // Water holds its mist at its surface.
+            out[static_cast<size_t>(z) * size + x] = std::max(m, 0.0f);
+        }
+    if (b == 0)
+        return out;
+    // A box blur, across then down, so the layer's top runs smooth.
+    for (int z = 0; z < size; ++z)
+        for (int x = 0; x < size; ++x)
+        {
+            float s = 0.0f;
+            int c = 0;
+            for (int k = std::max(0, x - b); k <= std::min(size - 1, x + b); ++k, ++c)
+                s += out[static_cast<size_t>(z) * size + k];
+            tmp[static_cast<size_t>(z) * size + x] = s / static_cast<float>(c);
+        }
+    for (int z = 0; z < size; ++z)
+        for (int x = 0; x < size; ++x)
+        {
+            float s = 0.0f;
+            int c = 0;
+            for (int k = std::max(0, z - b); k <= std::min(size - 1, z + b); ++k, ++c)
+                s += tmp[static_cast<size_t>(k) * size + x];
+            out[static_cast<size_t>(z) * size + x] = s / static_cast<float>(c);
+        }
+    return out;
+}
+
+float FogExtinctionAt(const FogMedium& m, float y, float floorY, float aboveGround)
+{
+    const float above = std::max(y - floorY, 0.0f);
+    float sigma = m.hazeSigma * std::exp(-std::max(y, -50.0f) / m.hazeHeight);
+    sigma += m.groundSigma * std::exp(-std::max(aboveGround, 0.0f) / std::max(m.groundHeight, 1.0f));
+    sigma += m.rayleigh * kRayleighGreen * std::exp(-std::max(y, -50.0f) / kRayleighHeight);
+    sigma += m.weatherSigma * std::exp(-above / std::max(m.weatherHeight, 1.0f));
+    const float overTop = above - m.mistDepth;
+    sigma += m.mistSigma * (overTop <= 0.0f ? 1.0f : std::exp(-overTop / std::max(m.mistFall, 1.0f)));
+    return sigma;
+}
+
+} // namespace Poseidon::remaster
diff --git a/arma_CWR/engine/Poseidon/Graphics/Remaster/VolumetricFog.hpp b/arma_CWR/engine/Poseidon/Graphics/Remaster/VolumetricFog.hpp
new file mode 100644
index 0000000..b35f104
--- /dev/null
+++ b/arma_CWR/engine/Poseidon/Graphics/Remaster/VolumetricFog.hpp
@@ -0,0 +1,191 @@
+#pragma once
+
+#include <Poseidon/Graphics/Remaster/LightRig.hpp>
+
+#include <vector>
+
+// Volumetric fog and atmosphere (feature switch volFog, the look lane "fog";
+// the GL side is EngineGL33_PostFog.cpp and EngineGL33_PostFogShaders.cpp).
+//
+// The flat distance fog of the original (a linear blend toward one colour
+// between two distances) is replaced by a medium that fills a froxel volume,
+// a grid of cells aligned with the screen and sliced in depth, every frame:
+//
+//   - haze: aerosol extinction thinning with height (scale height
+//     kHazeScaleHeight), thin on a clear day, thicker under an overcast, in
+//     rain and in the humid morning air;
+//   - Rayleigh air: the physical sea-level scattering of air molecules,
+//     strongest in blue, so far ground takes the blue of the sky over a few
+//     kilometres;
+//   - weather fog: setFog and rain, at the density that gives the classic
+//     engine's tactical visibility (WeatherVisibility) at sea level, thinning
+//     upward so hilltops stand out of it;
+//   - valley mist: a flat-topped layer above the lowest ground nearby (the
+//     fog floor map, BuildFogFloor) that pools in valleys, on lakes and the
+//     sea at dawn, a little at dusk and at night, in fog and in rain, broken
+//     into banks by drifting noise.
+//
+// Each cell's air takes the sky's own colour at the horizon in its azimuth
+// (the sky table's aerial perspective, with its glow toward the sun), so the
+// far end of every line of sight melts into the sky behind it. The share of
+// that light that is scattered sunlight (most of it under a clear sky, little
+// under an overcast) goes dark in the shade of the shadow-map cascades, the
+// long canopy shadows, the terrain horizon map and the cloud field, so light
+// falls through trees and over ridges in beams and a ridge's shadow lies in
+// the haze; the mist and fog above a cell take light out of its sun. In the
+// near field the sun's Mie forward lobe adds its own glow (strong toward a
+// low sun), and the frame's lamps, headlights and fires glow in the air. A
+// front-to-back integration gives each cell the light scattered toward the
+// eye and the transmittance from the eye to its far face; the post pass
+// applies C' = C T + S to every pixel by its depth, and the sky near the
+// horizon takes the volume's far end (above it the dome already holds the
+// whole atmosphere's light).
+//
+// The forward shaders keep the classic fog only for the view-distance edge
+// (FogEdgeScale): the world's end and object fade-in stay hidden, everything
+// before them is the volume's.
+//
+// Pure: no GL, no engine state, so the medium's rules, the slice layout and
+// the fog floor can be tested.
+
+namespace Poseidon::remaster
+{
+
+// ---- The froxel grid ---------------------------------------------------------
+
+struct FogGrid
+{
+    int cellsX = 0, cellsY = 0; // over the 3D viewport
+    int slices = 0;             // depth slices, a multiple of kFogSlicesPerDraw
+    int cellPixels = 0;         // frame-target pixels per cell side
+};
+
+// The injection and the integration each write this many slices per draw
+// (eight colour attachments, the GL 3.3 minimum).
+constexpr int kFogSlicesPerDraw = 8;
+// The grid for a viewport of w x h pixels at a quality (0 coarse, 1 shipped,
+// 2 fine; the fogQuality knob, rounded and clamped): cells of 16, 12 or 8
+// pixels, 48, 64 or 96 slices.
+FogGrid FogGridFor(int w, int h, float quality);
+
+// Depth slices are exponential: the view depth (metres along the view axis) of
+// the slice coordinate t in [0, 1] is far * (exp(k t) - 1) / (exp(k) - 1), so
+// the cells near the eye are about a metre deep and the last ones hundreds.
+float FogSliceDepth(float t, float zFar, float k);
+// The inverse: the slice coordinate of a view depth (clamped to [0, 1]).
+float FogSliceCoord(float z, float zFar, float k);
+// The k that makes the first of `slices` slices kFogFirstSliceMetres deep at
+// 64 slices (deeper with fewer slices), for a far end at zFar.
+float FogDepthK(float zFar, int slices);
+constexpr float kFogFirstSliceMetres = 0.9f;
+
+// ---- The medium ----------------------------------------------------------------
+
+// Scale heights (m) and shapes.
+constexpr float kHazeScaleHeight = 1200.0f; // aerosol haze
+constexpr float kWeatherFogHeight = 450.0f; // setFog: thins upward from the fog floor
+constexpr float kRainHazeHeight = 900.0f;   // rain haze
+constexpr float kGroundHazeHeight = 50.0f;  // the humid air near the ground: its scale height above the ground
+constexpr float kMistLayerDepth = 45.0f;    // valley mist: the layer's top above the fog floor
+constexpr float kMistLayerFall = 28.0f;     // and its exponential fall above the top
+constexpr float kFogFloorRadius = 700.0f;   // the fog floor: the lowest ground within this radius
+constexpr float kFogFloorBlur = 350.0f;     // smoothed over this radius
+// Haze extinction at sea level on a clear day (1/m): a hazy summer visibility
+// near 9 km, so ridges 2 to 4 km out sit deep in the air and fade into the sky.
+constexpr float kHazeClear = 4.5e-4f;
+// Physical Rayleigh scattering of air at sea level (1/m, red, green, blue;
+// Atmosphere.hpp's kRayleighScattering) times this.
+constexpr float kRayleighScale = 2.5f;
+// The humid air near the ground at full weight (1/m at the ground): at a low
+// sun and at night the air under the first tens of metres holds the light
+// that makes beams through trees and headlight cones.
+constexpr float kGroundHaze = 1.3e-3f;
+// Valley mist extinction inside the layer at full weight (1/m).
+constexpr float kMistSigma = 6.0e-3f;
+// Mie phase: the forward lobe's asymmetry and the back lobe's share.
+constexpr float kFogMieG = 0.78f;
+constexpr float kFogBackShare = 0.12f;
+// The classic engine's visibility in rain at full density (Landscape.cpp: 350 m).
+constexpr float kRainVisibility = 350.0f;
+// The weather fog's extinction times the visibility it takes away: what the
+// weather leaves of a surface at the classic fog end is about e^-3.2.
+constexpr float kWeatherExtinction = 3.2f;
+// The forward fog keeps the view-distance edge: it starts at this share of
+// the fog end.
+constexpr float kFogEdgeStart = 0.82f;
+
+struct FogInputs
+{
+    float sunElevationDeg = 90.0f;
+    float sunAzimuthDeg = 180.0f; // 0 north, 90 east
+    float nightEffect = 0.0f;     // 0 day .. 1 night
+    float skyThrough = 1.0f;      // 1 clear .. 0 overcast
+    float fog = 0.0f;             // setFog 0..1
+    float rain = 0.0f;            // rain density 0..1
+    float viewDistance = 1500.0f; // the user's view distance (tactical range, m)
+    float fogStart = 0.0f;        // the classic fog's start and end (Scene fog range, m)
+    float fogEnd = 1500.0f;
+};
+
+struct FogMedium
+{
+    // The volume's far end (m of view depth): the classic fog end, the far
+    // plane of the world's projection; the sky is taken at this distance.
+    float zFar = 1500.0f;
+    float hazeSigma = 0.0f; // 1/m at sea level
+    float hazeHeight = kHazeScaleHeight;
+    float rayleigh = 0.0f;    // times the physical sea-level Rayleigh scattering
+    float groundSigma = 0.0f; // 1/m at the ground (the humid air near it)
+    float groundHeight = kGroundHazeHeight;
+    float weatherSigma = 0.0f; // 1/m at the fog floor
+    float weatherHeight = kWeatherFogHeight;
+    float mistSigma = 0.0f; // 1/m inside the valley mist layer
+    float mistDepth = kMistLayerDepth;
+    float mistFall = kMistLayerFall;
+    float mistNoise = 0.0f; // 0 an even layer .. 1 broken into banks
+    float sun = 1.0f;       // the sun's light in the air
+    float sky = 1.0f;       // the sky's light in the air
+    float lights = 1.0f;    // lamps, headlights and fires
+    float g = kFogMieG;
+    // The forward fog factor's scale (>= 1): the classic linear fog's start
+    // moves out to kFogEdgeStart of its end. 1 = the classic fog.
+    float fogEdgeScale = 1.0f;
+    // Morning weight of the mist (0..1), for logs.
+    float morning = 0.0f;
+    // The sky-through (1 clear .. 0 overcast): how much of the air's light is
+    // scattered sunlight that shadows take away.
+    float skyThrough = 1.0f;
+};
+
+// The classic engine's tactical visibility (m) for setFog `fog`, rain
+// `rain` and a view distance (Landscape.cpp, the night factor at 1): the
+// distance at which its fog ends.
+float WeatherVisibility(float fog, float rain, float viewDistance);
+// The mist's morning weight: an eastern sun from 6 degrees under the horizon
+// (full from 2 under to 8 above), gone by 24 degrees.
+float FogMorningWeight(float sunElevationDeg, float sunAzimuthDeg);
+// The forward fog factor's scale that moves the classic start to
+// kFogEdgeStart of the end (1 when the range is empty).
+float FogEdgeScale(float fogStart, float fogEnd);
+// The frame's medium from the weather, the time of day and the knobs.
+// `applied` false (the pass does not run this frame) gives the classic fog:
+// fogEdgeScale 1, nothing else read.
+FogMedium ComputeFogMedium(const FogInputs& in, const LightingTuning& t, bool applied);
+
+// ---- The fog floor ----------------------------------------------------------
+
+// The valley mist's floor over a heights grid (size x size, cellSize metres
+// apart, row-major by z then x as TerrainHorizonMap::height): the lowest
+// ground within `radius` metres (a square window), never below sea level (a
+// lake or the sea holds its mist at the water), smoothed by a box blur of
+// `blur` metres. Empty for an invalid grid.
+std::vector<float> BuildFogFloor(const float* heights, int size, float cellSize, float radius = kFogFloorRadius,
+                                 float blur = kFogFloorBlur);
+
+// Extinction (1/m) of the medium at an absolute height `y` over a fog floor
+// `floorY` and `aboveGround` metres over the ground, without the mist's
+// noise: the C++ mirror of the injection's density (Rayleigh at green), for
+// the tests and for AI sight later.
+float FogExtinctionAt(const FogMedium& m, float y, float floorY, float aboveGround = 1e4f);
+
+} // namespace Poseidon::remaster
