+// ---------------------------------------------------------------------------
+// texsharp research: rebuild the mip chain from the decoded top level.
+//   g_remip 1 = 2x2 box (control: same filter as the authoring tools, RGBA8)
+//   g_remip 2 = Lanczos-2 (8 taps per axis), sharper minified textures
+//   g_remip 3 = Lanczos-2 + alpha-coverage preservation for cutouts (ref 0xc0)
+// Gamma-space filtering, as the stored mips, so mean colours do not shift.
+namespace
+{
+struct RgbaImage
+{
+    int w = 0, h = 0;
+    std::vector<float> px; // 4 floats per texel, 0..255
+};
+
+RgbaImage DownsampleBox(const RgbaImage& s)
+{
+    RgbaImage d;
+    d.w = s.w > 1 ? s.w / 2 : 1;
+    d.h = s.h > 1 ? s.h / 2 : 1;
+    d.px.assign(static_cast<size_t>(d.w) * d.h * 4, 0.0f);
+    const int fx = s.w > 1 ? 2 : 1, fy = s.h > 1 ? 2 : 1;
+    for (int y = 0; y < d.h; ++y)
+        for (int x = 0; x < d.w; ++x)
+            for (int c = 0; c < 4; ++c)
+            {
+                float sum = 0.0f;
+                for (int j = 0; j < fy; ++j)
+                    for (int i = 0; i < fx; ++i)
+                        sum += s.px[(static_cast<size_t>(y * fy + j) * s.w + (x * fx + i)) * 4 + c];
+                d.px[(static_cast<size_t>(y) * d.w + x) * 4 + c] = sum / static_cast<float>(fx * fy);
+            }
+    return d;
+}
+
+// One axis of a 2x Lanczos-2 decimation (wrap addressing).
+RgbaImage DecimateAxis(const RgbaImage& s, bool horizontal)
+{
+    static const float kW[4] = {0.8774f, 0.2353f, -0.0847f, -0.0179f}; // taps at 0.5, 1.5, 2.5, 3.5 texels
+    const float norm = 1.0f / (2.0f * (kW[0] + kW[1] + kW[2] + kW[3]));
+    const int n = horizontal ? s.w : s.h;
+    if (n <= 1)
+        return s;
+    RgbaImage d;
+    d.w = horizontal ? s.w / 2 : s.w;
+    d.h = horizontal ? s.h : s.h / 2;
+    d.px.assign(static_cast<size_t>(d.w) * d.h * 4, 0.0f);
+    for (int y = 0; y < d.h; ++y)
+        for (int x = 0; x < d.w; ++x)
+        {
+            const int o = horizontal ? x : y; // output index on the axis
+            float acc[4] = {0, 0, 0, 0};
+            for (int k = 0; k < 4; ++k)
+            {
+                const int a = ((2 * o - k) % n + n) % n;     // left tap
+                const int b = ((2 * o + 1 + k) % n + n) % n; // right tap
+                const size_t ia = horizontal ? (static_cast<size_t>(y) * s.w + a) : (static_cast<size_t>(a) * s.w + x);
+                const size_t ib = horizontal ? (static_cast<size_t>(y) * s.w + b) : (static_cast<size_t>(b) * s.w + x);
+                for (int c = 0; c < 4; ++c)
+                    acc[c] += kW[k] * (s.px[ia * 4 + c] + s.px[ib * 4 + c]);
+            }
+            for (int c = 0; c < 4; ++c)
+            {
+                const float v = acc[c] * norm;
+                d.px[(static_cast<size_t>(y) * d.w + x) * 4 + c] = v < 0.0f ? 0.0f : (v > 255.0f ? 255.0f : v);
+            }
+        }
+    return d;
+}
+
+float AlphaCoverage(const RgbaImage& im, float ref, float scale)
+{
+    size_t n = 0;
+    const size_t total = static_cast<size_t>(im.w) * im.h;
+    for (size_t i = 0; i < total; ++i)
+        if (im.px[i * 4 + 3] * scale >= ref)
+            ++n;
+    return total ? static_cast<float>(n) / static_cast<float>(total) : 0.0f;
+}
+
+// Scale a level's alpha so its coverage at `ref` matches `target` (Castano).
+void PreserveCoverage(RgbaImage& im, float ref, float target)
+{
+    float lo = 0.0f, hi = 4.0f;
+    for (int it = 0; it < 12; ++it)
+    {
+        const float mid = 0.5f * (lo + hi);
+        if (AlphaCoverage(im, ref, mid) < target)
+            lo = mid;
+        else
+            hi = mid;
+    }
+    const size_t total = static_cast<size_t>(im.w) * im.h;
+    for (size_t i = 0; i < total; ++i)
+    {
+        float& a = im.px[i * 4 + 3];
+        a = a * hi > 255.0f ? 255.0f : a * hi;
+    }
+}
