+// texsharp: the upload format, RGBA8 when this texture's chain is rebuilt.
+PacFormat TextureGL33::UploadFormat(int levelMin) const
+{
+    const PacFormat f = UploadFormatForTextureGL33(_mipmaps[levelMin].DstFormat(), _interpolate);
+    if (Poseidon::texsharp::g_remip > 0 && !_interpolate && f != PacAI88 && f != PacP8 && RemipProbe())
+        return PacARGB8888;
+    return f;
+}
+
+// Decode the top level once to learn whether this texture can be rebuilt
+// (file readable through the file server, decoded size = header size).
+bool TextureGL33::RemipProbe() const
+{
+    if (_remipProbe != 0)
+        return _remipProbe == 1;
+    _remipProbe = 2;
+    QIFStream in;
+    GFileServer->Open(in, Name());
+    const int size = in.fail() ? 0 : in.rest();
+    if (size <= 0)
+        return false;
+    std::vector<char> file(static_cast<size_t>(size));
+    in.read(file.data(), size);
+    const char* name = Name();
+    const size_t len = name ? strlen(name) : 0;
+    const bool isPaa = len >= 4 && (name[len - 1] == 'a' || name[len - 1] == 'A');
+    const Poseidon::DecodedImage img = Poseidon::DecodePAABuffer(file.data(), file.size(), isPaa);
+    if (img.valid() && img.width == _mipmaps[0]._w && img.height == _mipmaps[0]._h)
+        _remipProbe = 1;
+    else
+        LOG_INFO(Graphics, "texsharp: remip skipped for {} (decode {}x{}, header {}x{})", name ? name : "?", img.width,
+                 img.height, _mipmaps[0]._w, _mipmaps[0]._h);
+    return _remipProbe == 1;
+}
+
+bool TextureGL33::UploadRemipped(int levelMin)
+{
+    const int mode = Poseidon::texsharp::g_remip;
+    QIFStream in;
+    GFileServer->Open(in, Name());
+    const int size = in.fail() ? 0 : in.rest();
+    if (size <= 0)
+        return false;
+    std::vector<char> file(static_cast<size_t>(size));
+    in.read(file.data(), size);
+    const char* name = Name();
+    const size_t len = name ? strlen(name) : 0;
+    const bool isPaa = len >= 4 && (name[len - 1] == 'a' || name[len - 1] == 'A');
+    const Poseidon::DecodedImage img = Poseidon::DecodePAABuffer(file.data(), file.size(), isPaa);
+    if (!img.valid() || img.width != _mipmaps[0]._w || img.height != _mipmaps[0]._h)
+    {
+        LOG_WARN(Graphics, "texsharp: remip decode mismatch for {} ({}x{} vs {}x{})", name ? name : "?", img.width,
+                 img.height, _mipmaps[0]._w, _mipmaps[0]._h);
+        return false;
+    }
+    RgbaImage cur;
+    cur.w = img.width;
+    cur.h = img.height;
+    cur.px.resize(img.rgba.size());
+    for (size_t i = 0; i < img.rgba.size(); ++i)
+        cur.px[i] = static_cast<float>(img.rgba[i]);
+
+    const bool cutout = mode >= 3 && GetAlphaClass() == Poseidon::AlphaStats::Cutout;
+    const float ref = 192.0f;
+    const float coverage0 = cutout ? AlphaCoverage(cur, ref, 1.0f) : 0.0f;
+
+    std::vector<uint8_t> bytes;
+    for (int i = 0; i < _nMipmaps; ++i)
+    {
+        if (i > 0)
+        {
+            cur = mode == 1 ? DownsampleBox(cur) : DecimateAxis(DecimateAxis(cur, true), false);
+            if (cutout)
+                PreserveCoverage(cur, ref, coverage0);
+        }
+        if (cur.w != _mipmaps[i]._w || cur.h != _mipmaps[i]._h)
+        {
+            LOG_WARN(Graphics, "texsharp: remip level {} size {}x{} vs {}x{} for {}", i, cur.w, cur.h, _mipmaps[i]._w,
+                     _mipmaps[i]._h, name ? name : "?");
+            return false;
+        }
+        if (i < levelMin)
+            continue;
+        bytes.resize(cur.px.size());
+        for (size_t k = 0; k < cur.px.size(); ++k)
+        {
+            const float v = cur.px[k] + 0.5f;
+            bytes[k] = static_cast<uint8_t>(v < 0.0f ? 0.0f : (v > 255.0f ? 255.0f : v));
+        }
+        glTexSubImage2D(GL_TEXTURE_2D, i - levelMin, 0, 0, cur.w, cur.h, GL_RGBA, GL_UNSIGNED_BYTE, bytes.data());
+    }
+    return true;
+}
