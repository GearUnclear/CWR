+// ---------------------------------------------------------------------------
+// RESEARCH PROTOTYPE (track aa): remastered present pass. Replaces the
+// GL_LINEAR downsample blit with a shader downsample (Lanczos2 scaled to the
+// render-scale footprint) and an optional RCAS sharpening pass at window
+// resolution. Remastered only; Classic keeps the blit. The variant rides on
+// the AO knob: k = round((ao - 0.7) * 1000), present variant p = (k / 10) % 10:
+//   p = 0  shader bilinear (equals the stock blit)
+//   p = 1  Lanczos2 downsample
+//   p = 2  Lanczos2 + RCAS 0.5
+//   p = 3  bilinear + RCAS 0.5
+//   p = 4  Lanczos2 + RCAS 1.0
+//   p = 5  Lanczos2 + RCAS 0.25
+// Shaders are overridable as vsPresent / psPresentDown / psPresentSharpen.
+// UD_AA_PRESENT=0 turns the whole pass off.
+namespace
+{
+const char s_vsPresentGLSL[] = R"(#version 330 core
+out vec2 vUV;
+void main() {
+    vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
+    vUV = p;
+    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+}
+)";
+const char s_psPresentDownGLSL[] = R"(#version 330 core
+in vec2 vUV;
+uniform sampler2D src;
+uniform vec4 srcSize; // w, h, 1/w, 1/h
+uniform vec4 dstSize; // w, h, 1/w, 1/h
+uniform vec4 sel;     // x present variant p
+out vec4 fragColor;
+float sinc(float x) { x *= 3.14159265; return abs(x) < 1e-4 ? 1.0 : sin(x) / x; }
+float lanczos2(float x) { return abs(x) < 2.0 ? sinc(x) * sinc(x * 0.5) : 0.0; }
+void main() {
+    int p = int(sel.x + 0.5);
+    if (p == 0 || p == 3) { fragColor = vec4(texture(src, vUV).rgb, 1.0); return; }
+    vec2 scale = max(srcSize.xy * dstSize.zw, vec2(1.0));
+    vec2 c = vUV * srcSize.xy - 0.5;
+    vec2 r = 2.0 * scale;
+    ivec2 lo = ivec2(floor(c - r + 1.0));
+    ivec2 hi = ivec2(floor(c + r));
+    ivec2 mx = ivec2(srcSize.xy) - 1;
+    vec3 sum = vec3(0.0);
+    float wsum = 0.0;
+    for (int y = lo.y; y <= hi.y; ++y) {
+        float wy = lanczos2((float(y) - c.y) / scale.y);
+        for (int x = lo.x; x <= hi.x; ++x) {
+            float w = wy * lanczos2((float(x) - c.x) / scale.x);
+            sum += w * texelFetch(src, clamp(ivec2(x, y), ivec2(0), mx), 0).rgb;
+            wsum += w;
+        }
+    }
+    fragColor = vec4(clamp(sum / max(wsum, 1e-4), 0.0, 1.0), 1.0);
+}
+)";
+// FSR1 RCAS (robust contrast-adaptive sharpening), with its noise limiter.
+const char s_psPresentSharpenGLSL[] = R"(#version 330 core
+in vec2 vUV;
+uniform sampler2D src;
+uniform vec4 sel; // x present variant p, y sharpness (0..1)
+out vec4 fragColor;
+void main() {
+    ivec2 p = ivec2(gl_FragCoord.xy);
+    ivec2 mx = textureSize(src, 0) - 1;
+    vec3 b = texelFetch(src, clamp(p + ivec2(0, 1), ivec2(0), mx), 0).rgb;
+    vec3 d = texelFetch(src, clamp(p + ivec2(-1, 0), ivec2(0), mx), 0).rgb;
+    vec3 e = texelFetch(src, p, 0).rgb;
+    vec3 f = texelFetch(src, clamp(p + ivec2(1, 0), ivec2(0), mx), 0).rgb;
+    vec3 h = texelFetch(src, clamp(p + ivec2(0, -1), ivec2(0), mx), 0).rgb;
+    float bL = b.g * 0.5 + (b.r + b.b) * 0.25;
+    float dL = d.g * 0.5 + (d.r + d.b) * 0.25;
+    float eL = e.g * 0.5 + (e.r + e.b) * 0.25;
+    float fL = f.g * 0.5 + (f.r + f.b) * 0.25;
+    float hL = h.g * 0.5 + (h.r + h.b) * 0.25;
+    float nz = 0.25 * (bL + dL + fL + hL) - eL;
+    float lmax = max(max(max(bL, dL), max(fL, hL)), eL);
+    float lmin = min(min(min(bL, dL), min(fL, hL)), eL);
+    nz = clamp(abs(nz) / max(lmax - lmin, 1e-4), 0.0, 1.0);
+    nz = -0.5 * nz + 1.0;
+    vec3 mn4 = min(min(b, d), min(f, h));
+    vec3 mx4 = max(max(b, d), max(f, h));
+    vec3 hitMin = mn4 / max(4.0 * mx4, vec3(1e-4));
+    vec3 hitMax = (1.0 - mx4) / min(4.0 * mn4 - 4.0, vec3(-1e-4));
+    vec3 lobeRGB = max(-hitMin, hitMax);
+    float lobe = max(-(0.25 - 1.0 / 16.0), min(max(lobeRGB.r, max(lobeRGB.g, lobeRGB.b)), 0.0)) * sel.y;
+    lobe *= nz;
+    float rcpL = 1.0 / (4.0 * lobe + 1.0);
+    fragColor = vec4(clamp((lobe * (b + d + h + f) + e) * rcpL, 0.0, 1.0), 1.0);
+}
+)";
+
+struct PresentAA
+{
+    bool tried = false;
+    bool ok = false;
+    GLuint progDown = 0, progSharpen = 0, vao = 0;
+    GLuint resolveTex = 0, resolveFbo = 0;
+    GLuint downTex = 0, downFbo = 0;
+    int rw = 0, rh = 0, dw = 0, dh = 0;
+};
+PresentAA s_present;
+
+GLuint PresentCompile(GLenum type, const char* src, const char* name)
+{
+    std::string overrideSource;
+    if (LoadShaderOverride(name, overrideSource))
+        src = overrideSource.c_str();
+    GLuint s = glCreateShader(type);
+    glShaderSource(s, 1, &src, nullptr);
+    glCompileShader(s);
+    GLint ok = 0;
+    glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+    if (!ok)
+    {
+        char log[1024];
+        glGetShaderInfoLog(s, sizeof(log), nullptr, log);
+        LOG_ERROR(Graphics, "GL33 present (aa research): compile error [{}]: {}", name, log);
+        glDeleteShader(s);
+        return 0;
+    }
+    return s;
+}
+
+GLuint PresentLink(GLuint vs, const char* fsSrc, const char* name)
+{
+    GLuint fs = PresentCompile(GL_FRAGMENT_SHADER, fsSrc, name);
+    if (!vs || !fs)
+        return 0;
+    GLuint p = glCreateProgram();
+    glAttachShader(p, vs);
+    glAttachShader(p, fs);
+    glLinkProgram(p);
+    glDeleteShader(fs);
+    GLint ok = 0;
+    glGetProgramiv(p, GL_LINK_STATUS, &ok);
+    if (!ok)
+    {
+        LOG_ERROR(Graphics, "GL33 present (aa research): link error [{}]", name);
+        glDeleteProgram(p);
+        return 0;
+    }
+    return p;
+}
+
+void PresentTarget(GLuint& tex, GLuint& fbo, int& tw, int& th, int w, int h)
+{
+    if (tex && tw == w && th == h)
+        return;
+    if (fbo)
+        glDeleteFramebuffers(1, &fbo);
+    if (tex)
+    {
+        GL33Bind::OnTexDeleted(tex);
+        glDeleteTextures(1, &tex);
+    }
+    glGenTextures(1, &tex);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, tex);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, 0);
+    glGenFramebuffers(1, &fbo);
+    glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex, 0);
+    tw = w;
+    th = h;
+}
