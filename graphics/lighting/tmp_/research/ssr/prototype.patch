+// SSR prototype: while tagging, draws that do not write depth and carry no tag
+// (sun and lamp flares, 2D quads, particles) leave the stencil alone, so a
+// screen-space quad does not wipe the tags of the surfaces it is drawn over.
+void EngineGL33::ApplySsrStencilMask()
+{
+    if (!_glContext || !_hasStencilBuffer)
+        return;
+    const bool tagging = _remasterPrograms && _worldPassOpen && _lighting.ssr > 0.0f;
+    const bool write = !tagging || _currentDepthMode == DepthMode::Normal || _currentDepthMode == DepthMode::Shadow ||
+                       _ssrTagApplied != 0;
+    const unsigned int mask = write ? 0xFFu : 0x00u;
+    if (mask != _ssrStencilMask)
+    {
+        _ssrStencilMask = mask;
+        glStencilMask(mask);
+    }
+}
