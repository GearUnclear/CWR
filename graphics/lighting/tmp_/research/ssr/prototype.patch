+    }
+    vec3 rV = normalize(w2v * rW);
+    float jitter = fract(52.9829189 * fract(dot(gl_FragCoord.xy, vec2(0.06711056, 0.00583715))));
+    int kind;
+    float travel;
+    vec2 exitUV;
+    vec2 huv = traceRay(p, rV, jitter, kind, travel, exitUV);
+
+    float conf = 0.0;
+    vec3 R = vec3(0.0);
+    if (kind != 0) {
+        vec2 e = min(huv - worldRect.xy, worldRect.xy + worldRect.zw - huv) / worldRect.zw;
+        conf = smoothstep(0.0, 0.03, min(e.x, e.y));
+        float hz = kind == 2 ? 1.0 : max(sceneZ(huv), 0.1);
+        float px = kind == 2 ? cone / pixAngle : cone * travel / (hz * pixAngle);
