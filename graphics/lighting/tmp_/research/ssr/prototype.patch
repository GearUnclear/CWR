+    };
+    glBindSampler(6, 0);
+    bindTex(0, p.depthTex);
+    bindTex(2, p.colorTex);
+    bindTex(3, p.mipTex);
+    bindTex(4, p.tagTex);
+    bindTex(6, _terrainHeightTex ? _terrainHeightTex : _dummyHeightTex);
+    glBindFramebuffer(GL_FRAMEBUFFER, p.ssrFbo);
+    glViewport(0, 0, w, h);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    static int s_logged = 0;
+    if (s_logged < 3)
+    {
+        ++s_logged;
+        LOG_INFO(Graphics, "GL33 post: SSR pass {}x{} strength {} wet {} far {} mips {} sea {}", w, h, _lighting.ssr,
+                 wet, farZ, p.mipLevels, land ? land->GetSeaLevel() : 0.0f);
+    }
+}
