+void EngineGL33::UpdateSsrFamilyTag()
+{
+    // Water and terrain (detail / grass layers), plus ground decals drawn on
+    // the surface (roads, tracks) through the mesh path.
+    // The sea is a PSDetail landscape draw like the terrain (its faces carry
+    // only SpecularTexture); its material is glossy (specular luminance ~0.6,
+    // the terrain's ~0.08), which tells the two apart.
+    // Tag codes (bits read out separately: r 0x80, g 0x40, b 0x20):
+    //   0x80 water, 0x40 terrain, 0x60 road / on-surface decal,
+    //   0xA0 vehicle body (a Transport draw), 0x20 other glossy material.
+    _ssrFamilyTag = 0;
+    _ssrGlossyTag = 0;
+    const bool mesh = _vertexShaderSel == VSTransform;
+    if (mesh && _pixelShaderSel == PSWater)
+        _ssrFamilyTag = 0x80;
+    else if (mesh && (_pixelShaderSel == PSDetail || _pixelShaderSel == PSGrass))
+        _ssrFamilyTag = _ssrMatGloss > 0.3f ? 0x80 : 0x40;
+    else if (mesh && _pixelShaderSel == PSNormal && _ssrOnSurface)
+        _ssrFamilyTag = 0x60;
+    else if (_ssrDrawClassSeen == 1 && !_ssrOnSurface && (_pixelShaderSel == PSNormal || _pixelShaderSel == PSFlat))
