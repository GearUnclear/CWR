// ============================================================================
//  RESEARCH (track exposure): local exposure, eye adaptation, HDR frame and
//  tonemap curves. Generated by tmp/research/exposure/gen_test.py; not committed.
// ============================================================================

#include "capture_lib.sqf"

triSimUntil { alive player }

capWorld = "Abel"
capFov = 0.7
capSimT = 0
capPinTime = false
capUseView = false
capProps = []
capView = "setup"
capModeName = "none"
capLit = "none"
capGpu = "none"
capPerf = "none"
capFire = objNull

triCaptureAtPresent true
triSetMsaa 4
triSetRenderScale 1.5
showCinemaBorder false
enableRadio false
player setCaptive true
player allowDamage false

createCenter west
createCenter east
capGrpW = createGroup west
capProbe = "HeliHEmpty" createVehicle [7300, 10900, 0]
capCam = "camera" camCreate [7300, 10900, 2]
capCam cameraEffect ["internal", "back"]

capResearchReset = ["hdr=0", "ltmShadow=1", "ltmHighlight=1", "ltmDetail=1", "ltmBlur=0.4", "ltmMid=-2.47", "ltmMidAdapt=0", "ltmMaxGain=3", "ltmMinGain=0.5", "ltmNight=0", "ltmSigma=1", "adapt=0", "adaptKey=-2", "adaptSpeed=1.5", "adaptMin=-1", "adaptMax=1.5", "tmCurve=0", "bloomHdr=0", "ltmDebug=0", "hdrWhite=24", "exposure=1"]
// [knob strings] call capSetKnobs: reset every research knob, then apply these.
capSetKnobs = {
    private ["_r", "_bad"];
    _bad = "";
    { _r = triSetLighting _x; if (_r != "OK") then { _bad = _bad + _x + "=>" + _r + " " } } forEach (capResearchReset + _this);
    capLit = "OK";
    if (_bad != "") then { capLit = _bad };
}
// [name, [knobs]] call capVariant: Remastered with these research knobs.
capVariant = {
    capModeName = _this select 0;
    (_this select 1) call capSetKnobs;
    capGpuOff = triGpuTimes false;
    capGpuOn = triGpuTimes true;
    capPerfRes = triPerfReset 0;
    format ["view=%1;event=mode;mode=%2;lit=%3;knobs=%4", capView, capModeName, capLit, _this select 1] call capLog;
}

triSimFrames 240
call { "view=setup;event=setup;world=Abel;msaa=4;scale=1.5;window=960x640;capture=present" call capLog }

// ---- adapt_seq: sunrise_ridge, look at the sun, then down at the ground
["adapt_seq", 4400, 3300, 1.75, 60, 2, [1985, 7, 5, 5, 8], 0, 0, 4000] call capBegin
triSimFrames 150
"remastered" call capMode
call { [] call capSetKnobs }
call { capP = -12 }
triSimFrames 90
[] call capReadTimers
[] call capPin
triSimFrames 3
triScreenshot "adapt_seq__remastered_down"
"adapt_seq__remastered_down" call capRecord
call { capP = 20 }
[] call capPin
["seq", ["ltmShadow=0.6", "ltmHighlight=0.9", "ltmDetail=1.15", "ltmBlur=0.3", "ltmMaxGain=2.5", "ltmMid=-2.8", "ltmMidAdapt=2", "bloomHdr=1", "adaptKey=-4", "hdrWhite=0.75", "adaptMin=0", "adaptMax=1", "ltmDebug=3", "adapt=1", "adaptSpeed=0.4"]] call capVariant
triSimFrames 150
[] call capPin
triSimFrames 2
triScreenshot "adapt_seq__up_settled"
"adapt_seq__up_settled" call capRecord
call { capP = -12 }
[] call capPin
triSimFrames 1
triScreenshot "adapt_seq__f001"
"adapt_seq__f001" call capRecord
triSimFrames 10
triScreenshot "adapt_seq__f011"
"adapt_seq__f011" call capRecord
triSimFrames 20
triScreenshot "adapt_seq__f031"
"adapt_seq__f031" call capRecord
triSimFrames 40
triScreenshot "adapt_seq__f071"
"adapt_seq__f071" call capRecord
triSimFrames 80
triScreenshot "adapt_seq__f151"
"adapt_seq__f151" call capRecord
triSimFrames 160
triScreenshot "adapt_seq__f311"
"adapt_seq__f311" call capRecord
call { [] call capSetKnobs }
call { "view=done;event=done" call capLog }
triEndTest
