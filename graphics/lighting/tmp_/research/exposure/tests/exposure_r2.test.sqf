    [["SoldierWB"], 50, 0, 180, "man"] call capSpawn;
}
call {
    capUseView = false;
    capCam cameraEffect ["terminate", "back"];
    capClearRes = triClearView;
    capTankCls = ["M60", "M1Abrams", "T72"] call capPick;
    capTank = objNull;
    if (capTankCls != "") then { capTank = capTankCls createVehicle [7300, 10900, 0] };
