// ---- tank_gunner_interior (player in the M60 gunner seat, INTERNAL camera)
["tank_gunner_interior", 7300, 10900, 1.75, 152.5, 0, [1985, 7, 5, 10, 0], 0, 0, 1500] call capBegin
