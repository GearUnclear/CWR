+// psPostLum: quarter-res log2 luminance (r), 1 (g), and the metering-weighted
+// log2 luminance (b = logL * w, a = w), mipmapped for the blurred base and the
+// frame average.
+static const char s_psPostLumGLSL[] = R"(#version 330 core
+in vec2 vUV;
+uniform sampler2D colorTex;
+uniform sampler2D depthTex;
+uniform vec4 srcTexel;    // xy 1/full-res size, z 1 = HDR frame, w 1 = depth valid
+uniform vec4 meterParams; // x sky weight, y centre-weight sigma (uv), zw log2 range
+out vec4 fragColor;
+const vec3 kLuma = vec3(0.2126, 0.7152, 0.0722);
+vec3 neutralInverse(vec3 o) {
+    float np = max(o.r, max(o.g, o.b));
+    if (np <= 0.8) return o;
+    np = min(np, 0.9929);
+    const float d = 0.2;
+    float peak = d * d / (1.0 - np) - d + 0.8;
+    float g = 1.0 - 1.0 / (0.15 * (peak - np) + 1.0);
+    vec3 cs = (min(o, vec3(np)) - g * np) / max(1.0 - g, 1e-3);
+    return max(cs, vec3(0.0)) * (peak / np);
+}
+vec3 sceneLinear(vec3 display) {
+    vec3 lin = pow(max(display, vec3(0.0)), vec3(2.2));
+    return srcTexel.z > 0.5 ? lin : neutralInverse(lin);
+}
+void main() {
+    float s = 0.0;
+    s += log2(max(dot(sceneLinear(texture(colorTex, vUV + srcTexel.xy * vec2(-1.0, -1.0)).rgb), kLuma), 1e-5));
+    s += log2(max(dot(sceneLinear(texture(colorTex, vUV + srcTexel.xy * vec2( 1.0, -1.0)).rgb), kLuma), 1e-5));
+    s += log2(max(dot(sceneLinear(texture(colorTex, vUV + srcTexel.xy * vec2(-1.0,  1.0)).rgb), kLuma), 1e-5));
+    s += log2(max(dot(sceneLinear(texture(colorTex, vUV + srcTexel.xy * vec2( 1.0,  1.0)).rgb), kLuma), 1e-5));
