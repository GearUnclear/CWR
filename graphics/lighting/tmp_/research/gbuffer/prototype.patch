+    const int key = (_gbufActive ? 1 << 13 : 0) | (_gbufMaskOn ? 1 << 12 : 0) |
+                    ((static_cast<int>(_currentBlendMode) & 3) << 10) | (path << 9) | ((ps & 7) << 6) | ((vs & 3) << 4) |
