diff --git a/arma_CWR/engine/PoseidonGL33/EngineGL33_PostFX.cpp b/arma_CWR/engine/PoseidonGL33/EngineGL33_PostFX.cpp
index c3c4094..a5d4329 100644
--- a/arma_CWR/engine/PoseidonGL33/EngineGL33_PostFX.cpp
+++ b/arma_CWR/engine/PoseidonGL33/EngineGL33_PostFX.cpp
@@ -206,26 +206,249 @@ void main() {
 }
 )";
 
+// ---------------------------------------------------------------------------
+// G-buffer research prototype (gbuffer track).
+//
+// Screen-space one-bounce indirect light from the MRT G-buffer the remastered
+// world pass writes (normals, non-sky radiance, ambient response). Half
+// resolution. For each pixel: cosine-weighted rays around the G-buffer normal
+// are marched through the depth buffer; a ray that hits a surface facing it
+// (the hit's own G-buffer normal) gathers that surface's non-sky radiance
+// (sunlit ground, a sunlit hull, a fire-lit wall), a ray that hits anything
+// counts as sky occlusion. Output rgb = bounce irradiance (exposed, linear),
+// a = sky visibility. A ray that leaves the screen or the radius counts as open
+// sky, so the far field keeps the rig's own hemisphere and ground bounce.
+static const char s_psPostGiGLSL[] = R"(#version 330 core
+in vec2 vUV;
+uniform sampler2D depthTex;  // full-res resolved depth
+uniform sampler2D normalTex; // G-buffer 1: world normal xyz, roughness
+uniform sampler2D directTex; // G-buffer 2: non-sky radiance rgb, fog transmittance
+uniform sampler2D colorTex;  // the resolved lit frame (display space)
+uniform vec4 projInfo;  // x = _33, y = _43, z = 1/_11, w = 1/_22
+uniform vec4 projFwd;   // x = _11, y = _22, z = bounce source (0 non-sky radiance, 1 whole frame)
+uniform vec4 depthMap;  // ndcZ = depth * x + y
+uniform vec4 giParams;  // x radius (m), y directions, z steps, w frame index
+uniform vec4 screen;    // xy full-res size, zw 1/size
+uniform vec4 worldRect; // xy origin, zw size of the 3D viewport in uv
+uniform vec4 giFade;    // x fade start (m), y fade end (m)
+uniform mat3 viewRot;   // world -> view rotation
+out vec4 fragColor;
+
+float viewZ(vec2 uv) {
+    float d = textureLod(depthTex, uv, 0.0).r;
+    return projInfo.y / ((d * depthMap.x + depthMap.y) - projInfo.x);
+}
+vec3 viewPos(vec2 uv, float z) {
+    vec2 ndc = (uv - worldRect.xy) / worldRect.zw * 2.0 - 1.0;
+    return vec3(ndc.x * z * projInfo.z, ndc.y * z * projInfo.w, z);
+}
+vec2 projectUV(vec3 q) {
+    vec2 ndc = vec2(q.x * projFwd.x, q.y * projFwd.y) / q.z;
+    return worldRect.xy + (ndc * 0.5 + 0.5) * worldRect.zw;
+}
+bool gbufNormal(vec2 uv, out vec3 n) {
+    vec3 g = textureLod(normalTex, uv, 0.0).xyz;
+    float l = length(g);
+    n = l > 0.3 ? normalize(viewRot * (g / l)) : vec3(0.0);
+    return l > 0.3;
+}
+float ign(vec2 p) { return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715)))); }
+
+void main() {
+    float d0 = textureLod(depthTex, vUV, 0.0).r;
+    if (d0 >= 0.999999) { fragColor = vec4(0.0, 0.0, 0.0, 1.0); return; } // sky
+    float z = viewZ(vUV);
+    vec3 p = viewPos(vUV, z);
+    vec3 n;
+    if (!gbufNormal(vUV, n)) {
+        // No G-buffer data here (only blended or pre-lit draws): normal from depth.
+        vec2 tx = vec2(screen.z, 0.0), ty = vec2(0.0, screen.w);
+        vec3 pr = viewPos(vUV + tx, viewZ(vUV + tx)), pl = viewPos(vUV - tx, viewZ(vUV - tx));
+        vec3 pu = viewPos(vUV + ty, viewZ(vUV + ty)), pd = viewPos(vUV - ty, viewZ(vUV - ty));
+        vec3 dx = abs(pr.z - p.z) < abs(p.z - pl.z) ? pr - p : p - pl;
+        vec3 dy = abs(pu.z - p.z) < abs(p.z - pd.z) ? pu - p : p - pd;
+        n = normalize(cross(dx, dy));
+    }
+    if (dot(n, p) > 0.0) n = -n; // two-sided cards and the far side of a crown: face the camera
+
+    vec3 t = normalize(abs(n.y) < 0.99 ? cross(n, vec3(0.0, 1.0, 0.0)) : cross(n, vec3(1.0, 0.0, 0.0)));
+    vec3 b = cross(n, t);
+    float R = giParams.x;
+    int D = int(giParams.y);
+    int S = int(giParams.z);
+    float fr = giParams.w;
+    float n1 = ign(gl_FragCoord.xy + 5.588238 * fr);
+    float n2 = ign(gl_FragCoord.yx + 17.0 + 7.137 * fr);
+    vec3 p0 = p + n * (0.03 + 0.003 * z);
+    vec3 bounce = vec3(0.0);
+    float occ = 0.0;
+    for (int i = 0; i < 32; ++i) {
+        if (i >= D) break;
+        float u = (float(i) + n1) / float(D);
+        float phi = 6.2831853 * fract(float(i) * 0.6180340 + n2);
+        float sinT = sqrt(u);
+        float cosT = sqrt(max(1.0 - u, 0.0));
+        vec3 dir = t * (cos(phi) * sinT) + b * (sin(phi) * sinT) + n * cosT;
+        float jit = fract(n1 * 7.0 + float(i) * 0.3819660);
+        for (int s = 0; s < 32; ++s) {
+            if (s >= S) break;
+            float f = (float(s) + jit) / float(S);
+            float tt = R * f * f + 0.04;
+            vec3 q = p0 + dir * tt;
+            if (q.z < 0.1) break;
+            vec2 uv = projectUV(q);
+            if (uv.x < worldRect.x || uv.y < worldRect.y || uv.x > worldRect.x + worldRect.z ||
+                uv.y > worldRect.y + worldRect.w)
+                break; // off screen: unknown, treat as open
+            float zs = viewZ(uv);
+            float behind = q.z - zs;
+            float thick = 0.35 + 0.35 * tt + 0.01 * zs;
+            if (behind > 0.0 && behind < thick) {
+                float w = 1.0 - smoothstep(0.6 * R, R, tt);
+                vec3 nh;
+                float facing = gbufNormal(uv, nh) ? smoothstep(-0.05, 0.25, dot(nh, -dir)) : 1.0;
+                vec3 L = textureLod(directTex, uv, 0.0).rgb;
+                if (projFwd.z > 0.0)
+                    L = mix(L, pow(textureLod(colorTex, uv, 0.0).rgb, vec3(2.2)), projFwd.z);
+                bounce += L * (facing * w);
+                occ += w;
+                break;
+            }
+        }
+    }
+    bounce /= float(D);
+    occ /= float(D);
+    float fadeW = (1.0 - smoothstep(giFade.x, giFade.y, z)) * textureLod(directTex, vUV, 0.0).a;
+    fragColor = vec4(bounce * fadeW, 1.0 - occ * fadeW);
+}
+)";
+
+// Temporal accumulation while the camera holds still: an exponential average
+// (blend 1 = reset). No reprojection in the prototype.
+static const char s_psPostGiTemporalGLSL[] = R"(#version 330 core
+in vec2 vUV;
+uniform sampler2D curTex;
+uniform sampler2D histTex;
+uniform vec4 tParams; // x blend weight of the new frame
+out vec4 fragColor;
+void main() {
+    fragColor = mix(texture(histTex, vUV), texture(curTex, vUV), tParams.x);
+}
+)";
+
+// Edge-aware blur of the GI (depth and G-buffer normal), run horizontally then
+// vertically at half resolution.
+static const char s_psPostGiBlurGLSL[] = R"(#version 330 core
+in vec2 vUV;
+uniform sampler2D giTex;
+uniform sampler2D depthTex;
+uniform sampler2D normalTex;
+uniform vec4 projInfo;
+uniform vec4 depthMap;
+uniform vec2 stepUV;
+out vec4 fragColor;
+float viewZ(vec2 uv) {
+    float d = textureLod(depthTex, uv, 0.0).r;
+    return projInfo.y / ((d * depthMap.x + depthMap.y) - projInfo.x);
+}
+void main() {
+    vec4 c = texture(giTex, vUV);
+    float z0 = viewZ(vUV);
+    vec3 n0 = textureLod(normalTex, vUV, 0.0).xyz;
+    vec4 sum = c;
+    float wsum = 1.0;
+    for (int i = -6; i <= 6; ++i) {
