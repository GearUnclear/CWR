+// PERF RESEARCH: terrain horizon occlusion (perf flag 256). From the camera,
+// march kHzAz rays over the heightfield and keep, per ray and per distance step,
+// the highest terrain elevation (as a tangent) seen so far. An object whose
+// bounding sphere lies wholly under that horizon along every ray it spans,
+// measured only with terrain samples in front of its near edge, is behind a
+// ridge and is not drawn. Conservative by construction except for notches
+// narrower than one ray spacing; the terrain is lowered by kHzMargin first so
+// a coarser rendered terrain LOD cannot reveal what the table hides.
+namespace
+{
+constexpr int kHzAz = 1024;
+constexpr float kHzStep = 25.0f;
+constexpr int kHzMaxSteps = 240;
+constexpr float kHzMargin = 2.0f;
+struct HorizonTable
+{
+    bool valid = false;
+    float cx = 0, cy = 0, cz = 0, range = 0;
+    int steps = 0;
+    std::vector<float> maxTan; // [az * kHzMaxSteps + k]: max tangent of samples 1..k+1
+};
+HorizonTable s_hz;
+} // namespace
+namespace Poseidon
+{
+extern int gPerfTerrainCulled, gPerfTerrainTested, gPerfHorizonBuilds; // defined in Engine.cpp
+extern float gPerfHorizonBuildMs;
+} // namespace Poseidon
+
+static void TerrainHorizonCull(SortObjectList& list, Vector3Par cam, float range)
+{
+    gPerfTerrainCulled = 0;
+    gPerfTerrainTested = 0;
+    if (!GLandscape)
+        return;
+    const bool moved = !s_hz.valid || std::fabs(cam.X() - s_hz.cx) > 0.25f || std::fabs(cam.Y() - s_hz.cy) > 0.25f ||
+                       std::fabs(cam.Z() - s_hz.cz) > 0.25f || std::fabs(range - s_hz.range) > 1.0f;
+    if (moved)
+    {
+        const auto t0 = std::chrono::steady_clock::now();
+        s_hz.cx = cam.X();
+        s_hz.cy = cam.Y();
+        s_hz.cz = cam.Z();
+        s_hz.range = range;
+        s_hz.steps = std::min(kHzMaxSteps, static_cast<int>(range / kHzStep) + 1);
+        s_hz.maxTan.assign(static_cast<size_t>(kHzAz) * kHzMaxSteps, 1e30f);
+        for (int a = 0; a < kHzAz; ++a)
+        {
+            const float ang = a * (6.2831853f / kHzAz);
+            const float dx = std::sin(ang), dz = std::cos(ang);
+            float m = -1e30f;
+            float* row = &s_hz.maxTan[static_cast<size_t>(a) * kHzMaxSteps];
+            for (int k = 0; k < s_hz.steps; ++k)
+            {
+                const float d = (k + 1) * kHzStep;
+                const float h = GLandscape->SurfaceY(cam.X() + dx * d, cam.Z() + dz * d) - kHzMargin;
+                m = std::max(m, (h - cam.Y()) / d);
+                row[k] = m;
+            }
+        }
+        s_hz.valid = true;
+        ++gPerfHorizonBuilds;
+        gPerfHorizonBuildMs =
+            std::chrono::duration<float, std::milli>(std::chrono::steady_clock::now() - t0).count();
+    }
+    for (int i = 0; i < list.Size(); i++)
+    {
+        SortObject* oi = list[i];
+        if (oi->drawLOD == LOD_INVISIBLE || !oi->object || oi->object == GWorld->CameraOn())
+            continue;
+        const Vector3 p = oi->object->Position();
+        const float r = oi->radius * 1.25f + 1.0f;
+        const float ox = p.X() - s_hz.cx, oz = p.Z() - s_hz.cz;
+        const float d = std::sqrt(ox * ox + oz * oz);
+        const float dn = d - r;
+        if (dn < 3.0f * kHzStep)
+            continue;
+        ++gPerfTerrainTested;
+        int k = static_cast<int>(dn / kHzStep) - 1; // samples at (k+1)*step <= near edge
+        k = std::min(k, s_hz.steps - 1);
+        const float tObj = (p.Y() + r - s_hz.cy) / dn;
+        float ang = std::atan2(ox, oz);
+        if (ang < 0)
+            ang += 6.2831853f;
+        const float halfBins = std::asin(std::min(1.0f, r / d)) * (kHzAz / 6.2831853f) + 1.0f;
+        const int b0 = static_cast<int>(std::floor(ang * (kHzAz / 6.2831853f) - halfBins));
+        const int b1 = static_cast<int>(std::ceil(ang * (kHzAz / 6.2831853f) + halfBins));
+        bool hidden = true;
+        for (int b = b0; b <= b1 && hidden; ++b)
+        {
+            const int bw = ((b % kHzAz) + kHzAz) % kHzAz;
+            if (!(tObj < s_hz.maxTan[static_cast<size_t>(bw) * kHzMaxSteps + k]))
+                hidden = false;
+        }
+        if (hidden)
+        {
+            oi->drawLOD = LOD_INVISIBLE;
+            ++gPerfTerrainCulled;
+        }
+    }
+}
