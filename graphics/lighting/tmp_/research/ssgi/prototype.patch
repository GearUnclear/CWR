+static const char s_psPostGiGLSL[] = R"(#version 330 core
+// RESEARCH (ssgi): half-resolution screen-space diffuse GI.
+//
+// Per pixel, a few cosine-distributed rays leave the surface (view-space
+// position and normal from the depth buffer) and march through the depth buffer
+// with quadratically growing steps. A ray that passes behind the depth surface
+// within a thickness hits; the lit colour there (from a mip of the frame, a cone
+// footprint) is the radiance coming back along the ray.
+//
+// The engine already lights every surface with a uniform sky hemisphere that
+// includes a ground bounce (skyIrradiance in the remastered shaders). Mode 1
+// adds only what a hit sends back in EXCESS of what that hemisphere assumes for
+// the ray's direction (sunlit sand under a hull, a lamp pool, a lit wall), so it
+// can only add light. Mode 3 replaces the hemisphere by the traced result (hits:
+// their radiance, misses: the sky), which can also darken. Mode 2 is the cheap
+// SSDO-style colour bleed: no marching; disc samples above the tangent plane
+// act as emitters.
+//
+// Output: rgb = ratio to the pixel's own sky irradiance (the composite adds
+// share * colour * ratio: share * colour / skyIrradiance(n) is the albedo the
+// shader lit with), a = view depth (m).
+in vec2 vUV;
+uniform sampler2D depthTex;  // unit 0
+uniform sampler2D colorTex;  // unit 2, mipmapped (trilinear sampler)
+uniform vec4 projInfo;       // x _33, y _43, z 1/_11, w 1/_22
+uniform vec4 depthMap;
+uniform vec4 screen;         // full-res size, 1/size
+uniform vec4 worldRect;
+uniform vec4 giParams;       // x radius scale, y frame, z mode
+uniform vec4 giParams2;      // x rays, y steps, z exposure, w sun on
+uniform vec4 upView;         // world up in view space
+uniform vec4 sunView;        // toward the sun in view space
+uniform vec4 rigZenith;
+uniform vec4 rigHorizon;
+uniform vec4 rigHorizonSun;
+uniform vec4 rigGround;
+out vec4 fragColor;
+
+float viewZ(vec2 uv) {
+    float d = textureLod(depthTex, uv, 0.0).r;
+    return projInfo.y / ((d * depthMap.x + depthMap.y) - projInfo.x);
+}
+vec3 viewPos(vec2 uv, float z) {
+    vec2 ndc = (uv - worldRect.xy) / worldRect.zw * 2.0 - 1.0;
+    return vec3(ndc.x * z * projInfo.z, ndc.y * z * projInfo.w, z);
