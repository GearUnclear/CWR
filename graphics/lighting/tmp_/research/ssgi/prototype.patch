+vec2 toUV(vec3 q) {
+    vec2 ndc = vec2(q.x / (q.z * projInfo.z), q.y / (q.z * projInfo.w));
+    return worldRect.xy + (ndc * 0.5 + 0.5) * worldRect.zw;
