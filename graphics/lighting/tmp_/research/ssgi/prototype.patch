+
+    if (mode == 2) {
+        // SSDO-style colour bleed: disc points above the tangent plane send
+        // their excess radiance, weighted by the receiver cosine and a falloff.
+        float radius = 2.5 * giParams.x;
+        vec2 radiusUV = vec2(radius / projInfo.z, radius / projInfo.w) * (0.5 / z) * worldRect.zw;
+        int taps = clamp(int(giParams2.x * giParams2.y * 0.25), 4, 32);
