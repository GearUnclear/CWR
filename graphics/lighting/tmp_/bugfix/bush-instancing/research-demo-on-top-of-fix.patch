+// RESEARCH ONLY (bush-instancing evidence build; not part of fix.patch).
+// UD_RESEARCH_INST bit 1: the perf track's per-object light gate (an object may
+// be instanced when the light list its own draw selects is empty, instead of
+// only when the scene has no light slot), so instancing runs on Abel.
+// Bit 2: the pre-fix grouping (objects that rewrite their own vertices batch).
+static int ResearchInstMode()
+{
+    static const int mode = []
+    {
+        const char* v = std::getenv("UD_RESEARCH_INST");
+        return v ? std::atoi(v) : 0;
+    }();
+    return mode;
+}
