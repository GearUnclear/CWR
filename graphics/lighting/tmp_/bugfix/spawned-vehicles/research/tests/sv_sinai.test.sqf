// RESEARCH (spawned-vehicles bug fix): capture test generated by gen_sv_tests.py.
// Not committed (tests/rendering/research is git-excluded).
#include "capture_lib.sqf"

triSimUntil { alive player }

capWorld = "Sinai"
capFov = 0.7
capSimT = 0
capPinTime = false
capUseView = false
capProps = []
capView = "setup"
capModeName = "none"
capLit = "none"
capGpu = "none"
capPerf = "none"
capFire = objNull

triCaptureAtPresent true
triSetMsaa 4
triSetRenderScale 1.5
showCinemaBorder false
enableRadio false
player setCaptive true
player allowDamage false

createCenter west
createCenter east
capGrpW = createGroup west
capProbe = "HeliHEmpty" createVehicle [8350, 2950, 0]
capCam = "camera" camCreate [8350, 2950, 2]
capCam cameraEffect ["internal", "back"]
capReFire = { if (not (isNull capFire)) then { capFire inflame true } }

triSimFrames 240
call { "view=setup;event=setup;world=Sinai" call capLog }
["sinai_lowsun_fp", 8350, 2950, 1.75, 338.8, -3, [2005, 7, 21, 16, 10], 0, 0, 2000] call capBegin
call {
    [["LoBoHMWV_Mag_Patrol", "Jeep"], 10, -5, -107.8, "veh"] call capSpawn;
    [["LoBo_Zelda", "M113"], 16, 5, 72.2, "veh"] call capSpawn;
    [["LoBoGolaniWB", "SoldierWB"], 7, 1, -112.8, "man"] call capSpawn;
    [["LoBo_camnet", "CampEast", "Camp"], 22, -3, -152.8, "veh"] call capSpawn;
}
triSimFrames 150
"classic" call capMode
triSimFrames 90
[] call capReadTimers
[] call capPin
[] call capReFire
triSimFrames 3
triScreenshot "sinai_lowsun_fp__classic"
"sinai_lowsun_fp__classic" call capRecord
"remastered" call capMode
triSimFrames 90
[] call capReadTimers
[] call capPin
[] call capReFire
triSimFrames 3
triScreenshot "sinai_lowsun_fp__remastered"
"sinai_lowsun_fp__remastered" call capRecord
call { capDbgA = triSetLighting "debug=3"; capDbgB = triSetLighting "post=0" }
triSimFrames 30
[] call capPin
[] call capReFire
triSimFrames 3
triScreenshot "sinai_lowsun_fp__debug"
"sinai_lowsun_fp__debug" call capRecord
call { capDbgA = triSetLighting "debug=0"; capDbgB = triSetLighting "post=1" }
[] call capClear
call { capFire = objNull }

["sinai_hull_close", 8350, 2950, 1.75, 338.8, -8, [2005, 7, 21, 16, 10], 0, 0, 2000] call capBegin
call {
    [["LoBo_Zelda", "M113"], 7.5, 1.5, 72.2, "veh"] call capSpawn;
    [["LoBoHMWV_Mag_Patrol", "Jeep"], 6, -3.5, -107.8, "veh"] call capSpawn;
}
triSimFrames 150
"classic" call capMode
triSimFrames 90
[] call capReadTimers
[] call capPin
[] call capReFire
triSimFrames 3
triScreenshot "sinai_hull_close__classic"
"sinai_hull_close__classic" call capRecord
"remastered" call capMode
triSimFrames 90
[] call capReadTimers
[] call capPin
[] call capReFire
triSimFrames 3
triScreenshot "sinai_hull_close__remastered"
"sinai_hull_close__remastered" call capRecord
call { capDbgA = triSetLighting "debug=3"; capDbgB = triSetLighting "post=0" }
triSimFrames 30
[] call capPin
[] call capReFire
triSimFrames 3
triScreenshot "sinai_hull_close__debug"
"sinai_hull_close__debug" call capRecord
call { capDbgA = triSetLighting "debug=0"; capDbgB = triSetLighting "post=1" }
[] call capClear
call { capFire = objNull }

call { "view=done;event=done" call capLog }
triEndTest
