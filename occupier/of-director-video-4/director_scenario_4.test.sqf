// ---- beat 4: Dourdan and Chapoi fall in the same zone tick (k) -------------
udBeat = "double"
udW13 = time
triSimUntil { call udTick; ((not (gmGarrisonSpawned udD)) and (not (gmGarrisonSpawned udCh))) or (time > udW13 + 300) }
call udLogNow
triSimUntil { call udTick; ((not (gmGarrisonSpawned udD)) and (not (gmGarrisonSpawned udCh))) or (time > udW13 + 600) }
