(format ["after the double capture: towns ever %1", (gmOccupierForces) select 10]) call udNote
{deleteVehicle _x} forEach ((units udSqD) + (units udSqC))
"the Dourdan and Chapoi cells move on: both towns are left empty" call udNote
udTd = time
udW15 = time
triSimUntil { call udTick; ((time > udTd + 900) and ((("Dourdan" call udOpsOn) + ("Chapoi" call udOpsOn)) == 0)) or (time > udW15 + 300) }
call udLogNow
