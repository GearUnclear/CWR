if (not ((not (gmGarrisonSpawned udD)) and (not (gmGarrisonSpawned udCh)))) then {"wait timed out after 600 s: Dourdan and Chapoi stored" call udNote}
(format ["before the double capture: towns ever %1", (gmOccupierForces) select 10]) call udNote
udDouble = {gmZoneSet [udD, "garrison", 0]; gmZoneSet [udCh, "garrison", 0]; gmZoneSet [udD, "support", 55]; gmZoneSet [udCh, "support", 55]; udSqD = [udRes, gmFactionSquad [gmResistanceSide, 1, 3], udDPos] call GM_fnSpawnSquad; udSqC = [udRes, gmFactionSquad [gmResistanceSide, 1, 3], udChPos] call GM_fnSpawnSquad; {_x allowDammage false} forEach ((units udSqD) + (units udSqC)); doStop ((units udSqD) + (units udSqC))}
call udDouble
"lever: Dourdan and Chapoi garrison 0, support 55, three fighters each (invulnerable), all set in one frame" call udNote
udW14 = time
triSimUntil { call udTick; ((((gmZone udD) select 2) == gmResistanceSide) and (((gmZone udCh) select 2) == gmResistanceSide)) or (time > udW14 + 300) }
call udLogNow
triSimUntil { call udTick; ((((gmZone udD) select 2) == gmResistanceSide) and (((gmZone udCh) select 2) == gmResistanceSide)) or (time > udW14 + 600) }
