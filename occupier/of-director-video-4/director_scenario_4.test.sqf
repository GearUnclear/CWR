// Scratch scenario for the fourth director video (not a regression test).
// Generated by gen_scenario.py from scenario.tmpl: every @WAIT directive
// becomes a run of triSimUntil chunks of at most 300 s of game time with a
// UDTRACE between them.
//
// The stock Guerrilla.Abel template (poolStart 60) on occupier-forces HEAD,
// the director at its shipped keys: NO director tuning lever (no
// directorInterval, waveLead or birthGiveUp change, no pool force).  The
// script plays the RESISTANCE side only: which cell takes which point, who
// stays, where the player stands, how fast time runs.  Every occupier
// decision is the engine's own.  Every lever is logged as a UDNOTE starting
// "lever:".  UDTRACE rows every 10 s of game time: [time, beat,
// gmOccupierForces, gmOccupierOps, gmOccupierIntel, counter-attack rows,
// zone rows, gmOccupierAir rows, player pos, gmHqState, accTime, gmSimDiag,
// gmCampaignEnd, band edges seen by the sampler, gmTrafficDiag skippedBudget].
//
// Beats: Houdan (dormant legacy roll), Le Port with four fighters staying
// (wake, a foot op, a live birth, a repel), the Outpost with its hold squad
// deleted (abstract arrival, occCapture), Dourdan and Chapoi in one tick (k),
// Arudy held (the road quote buys a helicopter), the Airfield raided and left
// (the spare cap), a jet strike on URGENT Le Port, a wave at 75 percent
// control, the HQ assault, then 45 minutes of free running.

triSimUntil { GM_LIB_READY }

GM_COMP_ALIVE = [false]
GM_QRF_TICK = 999999
{deleteVehicle _x} forEach ((units group player) - [player])
udT0 = time
triSimUntil { time > udT0 + 6 }
{deleteVehicle _x} forEach ((units group player) - [player])
player allowDammage false

udEvery = 10
udLast = -1000
udBeat = "setup"
udRoutes = []
udAuto = true
udEdges = 0
udBandPrev = "OFF"
udLogNow = {udZ = []; udI = 0; while {udI < gmZoneCount} do {udR = gmZone udI; udS = gmZoneSim udI; udZ = udZ + [[udI, udR select 2, udR select 3, udR select 4, udR select 6, udS select 14, udS select 13, udS select 9, udS select 1, udS select 2, udS select 16, udS select 0, udS select 17, udS select 15]]; udI = udI + 1}; udC = []; {udC = udC + [[_x select 10, _x select 0, _x select 1, _x select 2, _x select 3, _x select 4, _x select 15, getPos (_x select 20), getPos (_x select 18), getPos (_x select 23), _x select 21, _x select 9, _x select 11, _x select 13]]} forEach gmCounterAttacks; udA = []; {udA = udA + [[_x select 8, _x select 9, _x select 10, _x select 7, _x select 11, _x select 2, _x select 4, _x select 6, _x select 16]]} forEach gmOccupierAir; logInfo format ["UDTRACE %1", [time, udBeat, gmOccupierForces, gmOccupierOps, gmOccupierIntel, udC, udZ, udA, getPos player, gmHqState, accTime, gmSimDiag, gmCampaignEnd, udEdges, (gmTrafficDiag) select 17]]; {udK = format ["%1>%2", _x select 4, _x select 5]; if (not (udK in udRoutes)) then {udRoutes = udRoutes + [udK]; udSi = gmZoneIndex (_x select 4); udTi = gmZoneIndex (_x select 5); if ((udSi >= 0) and (udTi >= 0)) then {logInfo format ["UDROUTE %1", [_x select 4, _x select 5, gmRoadRoute [(gmZone udSi) select 8, (gmZone udTi) select 8]]]}}} forEach gmOccupierOps}
udAcc = {if (udAuto) then {udLv = false; {if ((_x select 6) == "LIVE") then {udLv = true}} forEach gmOccupierOps; {if ((_x select 2) == 1) then {udLv = true}} forEach gmOccupierAir; if (udLv) then {if (accTime != 4) then {setAccTime 4}} else {if (accTime != 8) then {setAccTime 8}}}}
udBandSample = {udBandNow = (gmOccupierForces) select 2; if ((udBandNow != udBandPrev) and (udBandPrev != "OFF")) then {udEdges = udEdges + 1}; udBandPrev = udBandNow}
udTick = {call udAcc; call udBandSample; call udXClean; if (time >= udLast + udEvery) then {udLast = time; call udLogNow}}
udNote = {logInfo format ["UDNOTE %1", [time, _this]]}
udOpOn = {udHit = []; {if (((_x select 5) == _this) and ((_x select 0) > 0)) then {udHit = _x}} forEach gmOccupierOps; udHit}
udOpsOn = {udN = 0; {if ((_x select 5) == _this) then {udN = udN + 1}} forEach gmOccupierOps; udN}
udIntelOn = {udIc = 0; udZn = _this; {if ((_x select 0) == udZn) then {udIc = _x select 1}} forEach gmOccupierIntel; udIc}
udXs = []
udXClean = {udXk = []; {udXe = _x; if (((gmZone (gmZoneIndex (udXe select 0))) select 2) == gmResistanceSide) then {{deleteVehicle _x} forEach (units (udXe select 1)); (format ["the cell in %1 moves on: the point is left to its own", udXe select 0]) call udNote} else {udXk = udXk + [udXe]}} forEach udXs; udXs = udXk}

// ---- geometry: every zone, and the road routes from every occupier base -----
udI = 0
while {udI < gmZoneCount} do {udR = gmZone udI; logInfo format ["UDZONE %1", [udI, udR select 0, udR select 1, udR select 2, udR select 3, udR select 8, (gmZoneSim udI) select 7, gmLandmass (udR select 8)]]; udI = udI + 1}
udBases = ["Outpost", "Southeast Compound", "Le Port Harbour", "Airfield"]
{udSi = gmZoneIndex _x; udJ = 0; while {udJ < gmZoneCount} do {if (udJ != udSi) then {logInfo format ["UDGRAPH %1", [_x, (gmZone udJ) select 0, gmRoadRoute [(gmZone udSi) select 8, (gmZone udJ) select 8]]]}; udJ = udJ + 1}} forEach udBases
logInfo format ["UDHQ %1", [gmHqState, gmHqPos]]

triSimUntil { ((gmOccupierForces) select 2) != "OFF" }
udBandPrev = (gmOccupierForces) select 2
(format ["sizing: pool %1, poolStart %2, band %3, K %4, control %5; no director lever: the shipped keys (token every 600 s STRONG, 3 born ops, the spare cap, the arrival rule, the road quote)", (gmOccupierForces) select 0, (gmOccupierForces) select 1, (gmOccupierForces) select 2, (gmOccupierForces) select 7, (gmOccupierForces) select 5]) call udNote
"lever: companions off (GM_COMP_ALIVE), the legacy script QRF parked (GM_QRF_TICK), the player invulnerable and kept in the hills, time x8 (x4 while a force is live or airborne)" call udNote
call udLogNow

udRes = gmResistanceSide call GM_fnSideFromString
udV = gmZoneIndex "Village"
udL = gmZoneIndex "Le Port"
udO = gmZoneIndex "Outpost"
udD = gmZoneIndex "Dourdan"
udCh = gmZoneIndex "Chapoi"
udAr = gmZoneIndex "Arudy"
udAf = gmZoneIndex "Airfield"
udH = gmZoneIndex "Le Port Harbour"
udCamp = gmZoneIndex "Camp"
udVPos = (gmZone udV) select 8
udLPos = (gmZone udL) select 8
udOPos = (gmZone udO) select 8
udDPos = (gmZone udD) select 8
udChPos = (gmZone udCh) select 8
udArPos = (gmZone udAr) select 8
udAfPos = (gmZone udAf) select 8

udFar = [4400, 7600, 0]
if ((gmLandmass udFar) < 0) then {udFar = [4500, 5200, 0]}
player setPos udFar
(format ["the player waits in the hills at %1", udFar]) call udNote
udW1 = time
triSimUntil { call udTick; ((not (gmGarrisonSpawned udV)) and (not (gmGarrisonSpawned udL)) and (not (gmGarrisonSpawned udO)) and (not (gmGarrisonSpawned udD)) and (not (gmGarrisonSpawned udCh)) and (not (gmGarrisonSpawned udAr)) and (not (gmGarrisonSpawned udAf))) or (time > udW1 + 300) }
call udLogNow
triSimUntil { call udTick; ((not (gmGarrisonSpawned udV)) and (not (gmGarrisonSpawned udL)) and (not (gmGarrisonSpawned udO)) and (not (gmGarrisonSpawned udD)) and (not (gmGarrisonSpawned udCh)) and (not (gmGarrisonSpawned udAr)) and (not (gmGarrisonSpawned udAf))) or (time > udW1 + 600) }
call udLogNow
if (not ((not (gmGarrisonSpawned udV)) and (not (gmGarrisonSpawned udL)) and (not (gmGarrisonSpawned udO)) and (not (gmGarrisonSpawned udD)) and (not (gmGarrisonSpawned udCh)) and (not (gmGarrisonSpawned udAr)) and (not (gmGarrisonSpawned udAf)))) then {"wait timed out after 600 s: garrisons stored" call udNote}
call udLogNow

// ---- beat 1: Houdan falls, the director is DORMANT: the legacy roll --------
udBeat = "houdan"
"lever: Houdan garrison 0, support 55 (the cell's earlier work); two fighters take it, invulnerable" call udNote
gmZoneSet [udV, "garrison", 0]
gmZoneSet [udV, "support", 55]
udSqV = [udRes, gmFactionSquad [gmResistanceSide, 1, 2], udVPos] call GM_fnSpawnSquad
{_x allowDammage false} forEach (units udSqV)
doStop (units udSqV)
udW2 = time
triSimUntil { call udTick; (((gmZone udV) select 2) == gmResistanceSide) or (time > udW2 + 300) }
call udLogNow
triSimUntil { call udTick; (((gmZone udV) select 2) == gmResistanceSide) or (time > udW2 + 600) }
call udLogNow
if (not (((gmZone udV) select 2) == gmResistanceSide)) then {"wait timed out after 600 s: Houdan taken" call udNote}
call udLogNow
{deleteVehicle _x} forEach (units udSqV)
"the Houdan cell moves on: the town is left empty" call udNote
udW3 = time
triSimUntil { call udTick; (false) or (time > udW3 + 180) }
call udLogNow

// ---- beat 2: Le Port falls, four fighters stay: the director wakes ---------
udBeat = "leport"
"lever: Le Port garrison 0, support 55; four fighters take it and stay, invulnerable" call udNote
gmZoneSet [udL, "garrison", 0]
gmZoneSet [udL, "support", 55]
udSqL = [udRes, gmFactionSquad [gmResistanceSide, 1, 4], udLPos] call GM_fnSpawnSquad
{_x allowDammage false} forEach (units udSqL)
doStop (units udSqL)
udW4 = time
triSimUntil { call udTick; (((gmZone udL) select 2) == gmResistanceSide) or (time > udW4 + 300) }
call udLogNow
triSimUntil { call udTick; (((gmZone udL) select 2) == gmResistanceSide) or (time > udW4 + 600) }
call udLogNow
if (not (((gmZone udL) select 2) == gmResistanceSide)) then {"wait timed out after 600 s: Le Port taken" call udNote}
udW5 = time
triSimUntil { call udTick; (((gmOccupierForces) select 4) == "AWAKE") or (time > udW5 + 300) }
call udLogNow
if (not (((gmOccupierForces) select 4) == "AWAKE")) then {"wait timed out after 300 s: director awake" call udNote}
call udLogNow
(format ["awake: pool %1 of %2, band %3, tokens %4, operations %5", (gmOccupierForces) select 0, (gmOccupierForces) select 1, (gmOccupierForces) select 2, (gmOccupierForces) select 3, count gmOccupierOps]) call udNote
udOpL = []
udW6 = time
triSimUntil { call udTick; udOpL = "Le Port" call udOpOn; ((count udOpL) > 0) or (time > udW6 + 300) }
call udLogNow
triSimUntil { call udTick; udOpL = "Le Port" call udOpOn; ((count udOpL) > 0) or (time > udW6 + 600) }
call udLogNow
triSimUntil { call udTick; udOpL = "Le Port" call udOpOn; ((count udOpL) > 0) or (time > udW6 + 900) }
call udLogNow
triSimUntil { call udTick; udOpL = "Le Port" call udOpOn; ((count udOpL) > 0) or (time > udW6 + 1200) }
call udLogNow
triSimUntil { call udTick; udOpL = "Le Port" call udOpOn; ((count udOpL) > 0) or (time > udW6 + 1500) }
call udLogNow
if (not ((count udOpL) > 0)) then {"wait timed out after 1500 s: a director op on Le Port" call udNote}
call udLogNow
(format ["the director's answer on Le Port: %1", udOpL]) call udNote
udTl = time
udW7 = time
triSimUntil { call udTick; ((time > udTl + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW7 + 300) }
call udLogNow
triSimUntil { call udTick; ((time > udTl + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW7 + 600) }
call udLogNow
triSimUntil { call udTick; ((time > udTl + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW7 + 900) }
call udLogNow
triSimUntil { call udTick; ((time > udTl + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW7 + 1200) }
call udLogNow
triSimUntil { call udTick; ((time > udTl + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW7 + 1500) }
call udLogNow
triSimUntil { call udTick; ((time > udTl + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW7 + 1800) }
call udLogNow
triSimUntil { call udTick; ((time > udTl + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW7 + 2100) }
call udLogNow
triSimUntil { call udTick; ((time > udTl + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW7 + 2400) }
call udLogNow
triSimUntil { call udTick; ((time > udTl + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW7 + 2700) }
call udLogNow
triSimUntil { call udTick; ((time > udTl + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW7 + 3000) }
call udLogNow
triSimUntil { call udTick; ((time > udTl + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW7 + 3300) }
call udLogNow
triSimUntil { call udTick; ((time > udTl + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW7 + 3600) }
call udLogNow
triSimUntil { call udTick; ((time > udTl + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW7 + 3900) }
call udLogNow
triSimUntil { call udTick; ((time > udTl + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW7 + 4200) }
call udLogNow
if (not ((time > udTl + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0))) then {"wait timed out after 4200 s: Le Port and Houdan operations settled" call udNote}
call udLogNow
(format ["after Le Port: owner %1, pool %2 of %3, band %4", (gmZone udL) select 2, (gmOccupierForces) select 0, (gmOccupierForces) select 1, (gmOccupierForces) select 2]) call udNote

// ---- beat 3: the Outpost falls, its hold squad is lost: an abstract retake --
udBeat = "outpost"
udW8 = time
triSimUntil { call udTick; (not (gmGarrisonSpawned udO)) or (time > udW8 + 300) }
call udLogNow
triSimUntil { call udTick; (not (gmGarrisonSpawned udO)) or (time > udW8 + 600) }
call udLogNow
if (not (not (gmGarrisonSpawned udO))) then {"wait timed out after 600 s: Outpost stored" call udNote}
"lever: Outpost reserve 0 (an ambush on its relief); three fighters take it, invulnerable" call udNote
gmZoneSet [udO, "garrison", 0]
udSqO = [udRes, gmFactionSquad [gmResistanceSide, 1, 3], udOPos] call GM_fnSpawnSquad
{_x allowDammage false} forEach (units udSqO)
doStop (units udSqO)
udW9 = time
triSimUntil { call udTick; (((gmZone udO) select 2) == gmResistanceSide) or (time > udW9 + 300) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) == gmResistanceSide) or (time > udW9 + 600) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) == gmResistanceSide) or (time > udW9 + 900) }
call udLogNow
if (not (((gmZone udO) select 2) == gmResistanceSide)) then {"wait timed out after 900 s: Outpost taken" call udNote}
udW10 = time
triSimUntil { call udTick; ((GM_HOLD_ZONES find "Outpost") >= 0) or (time > udW10 + 120) }
call udLogNow
if (not ((GM_HOLD_ZONES find "Outpost") >= 0)) then {"wait timed out after 120 s: hold squad" call udNote}
call udLogNow
udHi = GM_HOLD_ZONES find "Outpost"
udHg = grpNull
if (udHi >= 0) then {udHg = GM_HOLD_GRPS select udHi}
udHn = 0
if (not (isNull udHg)) then {udHn = count (units udHg)}
{deleteVehicle _x} forEach (units udSqO)
if (not (isNull udHg)) then {{deleteVehicle _x} forEach (units udHg)}
(format ["lever: the Outpost hold squad (%1) is deleted, GM_HOLD_GRPS select (GM_HOLD_ZONES find Outpost), a lost patrol; the cell moves on: the base is empty", udHn]) call udNote
udW11 = time
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 300) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 600) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 900) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 1200) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 1500) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 1800) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 2100) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 2400) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 2700) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 3000) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 3300) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 3600) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 3900) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 4200) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 4500) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 4800) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 5100) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 5400) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 5700) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 6000) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 6300) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 6600) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 6900) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW11 + 7200) }
call udLogNow
if (not (((gmZone udO) select 2) != gmResistanceSide)) then {"wait timed out after 7200 s: Outpost retaken" call udNote}
call udLogNow
(format ["the Outpost: owner %1, occCapture %2, reserve %3", (gmZone udO) select 2, (gmZoneSim udO) select 14, (gmZone udO) select 3]) call udNote
udW12 = time
triSimUntil { call udTick; (("Outpost" call udOpsOn) == 0) or (time > udW12 + 300) }
call udLogNow
triSimUntil { call udTick; (("Outpost" call udOpsOn) == 0) or (time > udW12 + 600) }
call udLogNow
triSimUntil { call udTick; (("Outpost" call udOpsOn) == 0) or (time > udW12 + 900) }
call udLogNow
triSimUntil { call udTick; (("Outpost" call udOpsOn) == 0) or (time > udW12 + 1200) }
call udLogNow
triSimUntil { call udTick; (("Outpost" call udOpsOn) == 0) or (time > udW12 + 1500) }
call udLogNow
