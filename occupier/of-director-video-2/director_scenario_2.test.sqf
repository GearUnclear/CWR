// Scratch scenario for the second director video (not a regression test).
// Generated by gen_scenario.py from scenario.tmpl: every @WAIT directive
// becomes a run of triSimUntil chunks of at most 300 s of game time with a
// UDTRACE between them, so no single eval runs long.
//
// A fictional campaign on the shipped Guerrilla.Abel template, played at
// high speed with the real occupier forces director.  The script plays the
// RESISTANCE side only (which cell takes which zone, who stays, where the
// player stands); every occupier decision is the engine's own.  Every lever
// is logged as a UDNOTE starting "lever:".  Every udTick writes a UDTRACE
// line every 10 s of game time: [time, beat, gmOccupierForces,
// gmOccupierOps, gmOccupierIntel, counter-attack rows, zone rows,
// gmOccupierAir rows, player pos, gmHqState, accTime, gmSimDiag,
// gmCampaignEnd, band edges seen by the scenario's own sampler].

triSimUntil { GM_LIB_READY }

GM_COMP_ALIVE = [false]
GM_QRF_TICK = 999999
{deleteVehicle _x} forEach ((units group player) - [player])
udT0 = time
triSimUntil { time > udT0 + 6 }
{deleteVehicle _x} forEach ((units group player) - [player])
player allowDammage false

udEvery = 10
udLast = -1000
udBeat = "setup"
udRoutes = []
udAuto = false
udEdges = 0
udBandPrev = "OFF"
udLogNow = {udZ = []; udI = 0; while {udI < gmZoneCount} do {udR = gmZone udI; udS = gmZoneSim udI; udZ = udZ + [[udI, udR select 2, udR select 3, udR select 4, udR select 6, udS select 14, udS select 13, udS select 9, udS select 1, udS select 2, udS select 16, udS select 0, udS select 17, udS select 15]]; udI = udI + 1}; udC = []; {udC = udC + [[_x select 10, _x select 0, _x select 1, _x select 2, _x select 3, _x select 4, _x select 15, getPos (_x select 20), getPos (_x select 18), getPos (_x select 23), _x select 21, _x select 9, _x select 11, _x select 13]]} forEach gmCounterAttacks; udA = []; {udA = udA + [[_x select 8, _x select 9, _x select 10, _x select 7, _x select 11, _x select 2, _x select 4, _x select 6, _x select 16]]} forEach gmOccupierAir; logInfo format ["UDTRACE %1", [time, udBeat, gmOccupierForces, gmOccupierOps, gmOccupierIntel, udC, udZ, udA, getPos player, gmHqState, accTime, gmSimDiag, gmCampaignEnd, udEdges]]; {udK = format ["%1>%2", _x select 4, _x select 5]; if (not (udK in udRoutes)) then {udRoutes = udRoutes + [udK]; udSi = gmZoneIndex (_x select 4); udTi = gmZoneIndex (_x select 5); if ((udSi >= 0) and (udTi >= 0)) then {logInfo format ["UDROUTE %1", [_x select 4, _x select 5, gmRoadRoute [(gmZone udSi) select 8, (gmZone udTi) select 8]]]}}} forEach gmOccupierOps}
udAcc = {if (udAuto) then {udLv = false; {if ((_x select 6) == "LIVE") then {udLv = true}} forEach gmOccupierOps; {if ((_x select 2) == 1) then {udLv = true}} forEach gmOccupierAir; if (udLv) then {if (accTime != 4) then {setAccTime 4}} else {if (accTime != 8) then {setAccTime 8}}}}
udBandSample = {udBandNow = (gmOccupierForces) select 2; if ((udBandNow != udBandPrev) and (udBandPrev != "OFF")) then {udEdges = udEdges + 1}; udBandPrev = udBandNow}
udTick = {call udAcc; call udBandSample; if (time >= udLast + udEvery) then {udLast = time; call udLogNow}}
udNote = {logInfo format ["UDNOTE %1", [time, _this]]}
udOpOn = {udHit = []; {if (((_x select 5) == _this) and ((_x select 0) > 0)) then {udHit = _x}} forEach gmOccupierOps; udHit}
udOpsOn = {udN = 0; {if ((_x select 5) == _this) then {udN = udN + 1}} forEach gmOccupierOps; udN}

// ---- geometry: every zone, and the road routes from every occupier base -----
udI = 0
while {udI < gmZoneCount} do {udR = gmZone udI; logInfo format ["UDZONE %1", [udI, udR select 0, udR select 1, udR select 2, udR select 3, udR select 8, (gmZoneSim udI) select 7, gmLandmass (udR select 8)]]; udI = udI + 1}
udBases = ["Outpost", "Southeast Compound", "Le Port Harbour", "Airfield"]
{udSi = gmZoneIndex _x; udJ = 0; while {udJ < gmZoneCount} do {if (udJ != udSi) then {logInfo format ["UDGRAPH %1", [_x, (gmZone udJ) select 0, gmRoadRoute [(gmZone udSi) select 8, (gmZone udJ) select 8]]]}; udJ = udJ + 1}} forEach udBases
logInfo format ["UDHQ %1", [gmHqState, gmHqPos]]

// ---- compression levers (test pacing only) ----------------------------------
triSimUntil { ((gmOccupierForces) select 2) != "OFF" }
udBandPrev = (gmOccupierForces) select 2
gmForcesTune ["directorInterval", 10]
gmForcesTune ["waveLead", 120]
gmCounterAttackTune ["birthGiveUp", 60]
"lever: directorInterval 10 s, waveLead 120 s, birthGiveUp 60 s" call udNote
call udLogNow

udRes = gmResistanceSide call GM_fnSideFromString
udV = gmZoneIndex "Village"
udL = gmZoneIndex "Le Port"
udO = gmZoneIndex "Outpost"
udAf = gmZoneIndex "Airfield"
udH = gmZoneIndex "Le Port Harbour"
udCh = gmZoneIndex "Chapoi"
udD = gmZoneIndex "Dourdan"
udVPos = (gmZone udV) select 8
udLPos = (gmZone udL) select 8
udOPos = (gmZone udO) select 8
udAfPos = (gmZone udAf) select 8
udChPos = (gmZone udCh) select 8
udDPos = (gmZone udD) select 8

// the player is away in the north-western hills, far from every zone and
// road the scenario uses
udFar = [4400, 7600, 0]
if ((gmLandmass udFar) < 0) then {udFar = [4500, 5200, 0]}
player setPos udFar
(format ["the player waits in the hills at %1", udFar]) call udNote
udW1 = time
triSimUntil { call udTick; ((not (gmGarrisonSpawned udV)) and (not (gmGarrisonSpawned udL)) and (not (gmGarrisonSpawned udO)) and (not (gmGarrisonSpawned udCh)) and (not (gmGarrisonSpawned udD))) or (time > udW1 + 300) }
call udLogNow
triSimUntil { call udTick; ((not (gmGarrisonSpawned udV)) and (not (gmGarrisonSpawned udL)) and (not (gmGarrisonSpawned udO)) and (not (gmGarrisonSpawned udCh)) and (not (gmGarrisonSpawned udD))) or (time > udW1 + 600) }
call udLogNow
if (not ((not (gmGarrisonSpawned udV)) and (not (gmGarrisonSpawned udL)) and (not (gmGarrisonSpawned udO)) and (not (gmGarrisonSpawned udCh)) and (not (gmGarrisonSpawned udD)))) then {"wait timed out after 600 s: garrisons stored" call udNote}
setAccTime 4

// ---- beat 1: Houdan falls to a cell, the director stays DORMANT ------------
udBeat = "town1"
"lever: Houdan garrison 0, support 55 (the cell's earlier work); two fighters, invulnerable" call udNote
gmZoneSet [udV, "garrison", 0]
gmZoneSet [udV, "support", 55]
udSqV = [udRes, gmFactionSquad [gmResistanceSide, 1, 2], udVPos] call GM_fnSpawnSquad
{_x allowDammage false} forEach (units udSqV)
doStop (units udSqV)
udW2 = time
triSimUntil { call udTick; (((gmZone udV) select 2) == gmResistanceSide) or (time > udW2 + 300) }
call udLogNow
triSimUntil { call udTick; (((gmZone udV) select 2) == gmResistanceSide) or (time > udW2 + 600) }
call udLogNow
if (not (((gmZone udV) select 2) == gmResistanceSide)) then {"wait timed out after 600 s: Houdan taken" call udNote}
call udLogNow
{deleteVehicle _x} forEach (units udSqV)
"the Houdan cell moves on: the town is left empty" call udNote
udW3 = time
triSimUntil { call udTick; (false) or (time > udW3 + 120) }
call udLogNow

// ---- beat 2: Le Port falls, four fighters stay: the director wakes ---------
udBeat = "town2"
"lever: Le Port garrison 0, support 55; four fighters stay, invulnerable" call udNote
gmZoneSet [udL, "garrison", 0]
gmZoneSet [udL, "support", 55]
udSqL = [udRes, gmFactionSquad [gmResistanceSide, 1, 4], udLPos] call GM_fnSpawnSquad
{_x allowDammage false} forEach (units udSqL)
doStop (units udSqL)
udW4 = time
triSimUntil { call udTick; (((gmZone udL) select 2) == gmResistanceSide) or (time > udW4 + 300) }
call udLogNow
triSimUntil { call udTick; (((gmZone udL) select 2) == gmResistanceSide) or (time > udW4 + 600) }
call udLogNow
if (not (((gmZone udL) select 2) == gmResistanceSide)) then {"wait timed out after 600 s: Le Port taken" call udNote}
udW5 = time
triSimUntil { call udTick; (((gmOccupierForces) select 4) == "AWAKE") or (time > udW5 + 300) }
call udLogNow
if (not (((gmOccupierForces) select 4) == "AWAKE")) then {"wait timed out after 300 s: director awake" call udNote}
call udLogNow

// ---- beat 2b: the first answers play out (Houdan empty, Le Port defended) --
udBeat = "answers"
udAuto = true
udT3 = time
udW6 = time
triSimUntil { call udTick; ((time > udT3 + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW6 + 300) }
call udLogNow
triSimUntil { call udTick; ((time > udT3 + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW6 + 600) }
call udLogNow
triSimUntil { call udTick; ((time > udT3 + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW6 + 900) }
call udLogNow
triSimUntil { call udTick; ((time > udT3 + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW6 + 1200) }
call udLogNow
triSimUntil { call udTick; ((time > udT3 + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW6 + 1500) }
call udLogNow
triSimUntil { call udTick; ((time > udT3 + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW6 + 1800) }
call udLogNow
triSimUntil { call udTick; ((time > udT3 + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW6 + 2100) }
call udLogNow
triSimUntil { call udTick; ((time > udT3 + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW6 + 2400) }
call udLogNow
triSimUntil { call udTick; ((time > udT3 + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW6 + 2700) }
call udLogNow
triSimUntil { call udTick; ((time > udT3 + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW6 + 3000) }
call udLogNow
triSimUntil { call udTick; ((time > udT3 + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW6 + 3300) }
call udLogNow
triSimUntil { call udTick; ((time > udT3 + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0)) or (time > udW6 + 3600) }
call udLogNow
if (not ((time > udT3 + 300) and (("Le Port" call udOpsOn) == 0) and (("Village" call udOpsOn) == 0))) then {"wait timed out after 3600 s: first answers settled" call udNote}
call udLogNow

// ---- beat 3: a cell takes the Outpost; its hold squad is lost ---------------
udBeat = "outpost"
udW7 = time
triSimUntil { call udTick; (not (gmGarrisonSpawned udO)) or (time > udW7 + 300) }
call udLogNow
if (not (not (gmGarrisonSpawned udO))) then {"wait timed out after 300 s: Outpost stored" call udNote}
"lever: Outpost reserve 0 (an ambush on its relief); three fighters take it, invulnerable" call udNote
gmZoneSet [udO, "garrison", 0]
udSqO = [udRes, gmFactionSquad [gmResistanceSide, 1, 3], udOPos] call GM_fnSpawnSquad
{_x allowDammage false} forEach (units udSqO)
doStop (units udSqO)
udW8 = time
triSimUntil { call udTick; (((gmZone udO) select 2) == gmResistanceSide) or (time > udW8 + 300) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) == gmResistanceSide) or (time > udW8 + 600) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) == gmResistanceSide) or (time > udW8 + 900) }
call udLogNow
if (not (((gmZone udO) select 2) == gmResistanceSide)) then {"wait timed out after 900 s: Outpost taken" call udNote}
udW9 = time
triSimUntil { call udTick; ((GM_HOLD_ZONES find "Outpost") >= 0) or (time > udW9 + 120) }
call udLogNow
if (not ((GM_HOLD_ZONES find "Outpost") >= 0)) then {"wait timed out after 120 s: hold squad" call udNote}
call udLogNow
udHi = GM_HOLD_ZONES find "Outpost"
udHg = grpNull
if (udHi >= 0) then {udHg = GM_HOLD_GRPS select udHi}
udHn = 0
if (not (isNull udHg)) then {udHn = count (units udHg)}
{deleteVehicle _x} forEach (units udSqO)
if (not (isNull udHg)) then {{deleteVehicle _x} forEach (units udHg)}
(format ["lever: the Outpost hold squad (%1) is deleted, a lost patrol; the cell moves on: the base is empty", udHn]) call udNote

// ---- beat 3b: the base is retaken through its meter ------------------------
udBeat = "base"
udW10 = time
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 300) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 600) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 900) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 1200) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 1500) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 1800) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 2100) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 2400) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 2700) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 3000) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 3300) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 3600) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 3900) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 4200) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 4500) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 4800) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 5100) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 5400) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 5700) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 6000) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 6300) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 6600) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 6900) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) != gmResistanceSide) or (time > udW10 + 7200) }
call udLogNow
if (not (((gmZone udO) select 2) != gmResistanceSide)) then {"wait timed out after 7200 s: Outpost retaken" call udNote}
call udLogNow
udW11 = time
triSimUntil { call udTick; (false) or (time > udW11 + 60) }
call udLogNow

// ---- beat 4: a column out of the Harbour, watched: the Mi17 re-plan ---------
udBeat = "column"
udW12 = time
triSimUntil { call udTick; ((not (gmGarrisonSpawned udAf)) and (not (gmGarrisonSpawned udO))) or (time > udW12 + 300) }
call udLogNow
triSimUntil { call udTick; ((not (gmGarrisonSpawned udAf)) and (not (gmGarrisonSpawned udO))) or (time > udW12 + 600) }
call udLogNow
if (not ((not (gmGarrisonSpawned udAf)) and (not (gmGarrisonSpawned udO)))) then {"wait timed out after 600 s: bases stored" call udNote}
udW13 = time
triSimUntil { call udTick; udCdL = false; {if ((_x select 0) == "Le Port") then {udCdL = true}} forEach ((gmOccupierForces) select 12); ((not udCdL) and (((gmOccupierForces) select 3) >= 1)) or (time > udW13 + 300) }
call udLogNow
triSimUntil { call udTick; udCdL = false; {if ((_x select 0) == "Le Port") then {udCdL = true}} forEach ((gmOccupierForces) select 12); ((not udCdL) and (((gmOccupierForces) select 3) >= 1)) or (time > udW13 + 600) }
call udLogNow
triSimUntil { call udTick; udCdL = false; {if ((_x select 0) == "Le Port") then {udCdL = true}} forEach ((gmOccupierForces) select 12); ((not udCdL) and (((gmOccupierForces) select 3) >= 1)) or (time > udW13 + 900) }
call udLogNow
triSimUntil { call udTick; udCdL = false; {if ((_x select 0) == "Le Port") then {udCdL = true}} forEach ((gmOccupierForces) select 12); ((not udCdL) and (((gmOccupierForces) select 3) >= 1)) or (time > udW13 + 1200) }
call udLogNow
triSimUntil { call udTick; udCdL = false; {if ((_x select 0) == "Le Port") then {udCdL = true}} forEach ((gmOccupierForces) select 12); ((not udCdL) and (((gmOccupierForces) select 3) >= 1)) or (time > udW13 + 1500) }
call udLogNow
triSimUntil { call udTick; udCdL = false; {if ((_x select 0) == "Le Port") then {udCdL = true}} forEach ((gmOccupierForces) select 12); ((not udCdL) and (((gmOccupierForces) select 3) >= 1)) or (time > udW13 + 1800) }
call udLogNow
triSimUntil { call udTick; udCdL = false; {if ((_x select 0) == "Le Port") then {udCdL = true}} forEach ((gmOccupierForces) select 12); ((not udCdL) and (((gmOccupierForces) select 3) >= 1)) or (time > udW13 + 2100) }
call udLogNow
triSimUntil { call udTick; udCdL = false; {if ((_x select 0) == "Le Port") then {udCdL = true}} forEach ((gmOccupierForces) select 12); ((not udCdL) and (((gmOccupierForces) select 3) >= 1)) or (time > udW13 + 2400) }
call udLogNow
if (not ((not udCdL) and (((gmOccupierForces) select 3) >= 1))) then {"wait timed out after 2400 s: Le Port off cooldown" call udNote}
"lever: Outpost reserve 2 and Airfield reserve 2 (raids on their barracks)" call udNote
gmZoneSet [udO, "garrison", 2]
gmZoneSet [udAf, "garrison", 2]
udRaise = 45 - ((gmZone udL) select 6)
if (udRaise < 5) then {udRaise = 5}
(format ["lever: Le Port heat +%1 (stands in for a loud ambush on the coast road)", udRaise]) call udNote
gmZoneSet [udL, "heatRaise", udRaise]
udOpL = []
udW14 = time
triSimUntil { call udTick; udOpL = "Le Port" call udOpOn; ((count udOpL) > 0) or (time > udW14 + 300) }
call udLogNow
triSimUntil { call udTick; udOpL = "Le Port" call udOpOn; ((count udOpL) > 0) or (time > udW14 + 600) }
call udLogNow
triSimUntil { call udTick; udOpL = "Le Port" call udOpOn; ((count udOpL) > 0) or (time > udW14 + 900) }
call udLogNow
triSimUntil { call udTick; udOpL = "Le Port" call udOpOn; ((count udOpL) > 0) or (time > udW14 + 1200) }
call udLogNow
triSimUntil { call udTick; udOpL = "Le Port" call udOpOn; ((count udOpL) > 0) or (time > udW14 + 1500) }
call udLogNow
triSimUntil { call udTick; udOpL = "Le Port" call udOpOn; ((count udOpL) > 0) or (time > udW14 + 1800) }
call udLogNow
triSimUntil { call udTick; udOpL = "Le Port" call udOpOn; ((count udOpL) > 0) or (time > udW14 + 2100) }
call udLogNow
triSimUntil { call udTick; udOpL = "Le Port" call udOpOn; ((count udOpL) > 0) or (time > udW14 + 2400) }
call udLogNow
triSimUntil { call udTick; udOpL = "Le Port" call udOpOn; ((count udOpL) > 0) or (time > udW14 + 2700) }
call udLogNow
triSimUntil { call udTick; udOpL = "Le Port" call udOpOn; ((count udOpL) > 0) or (time > udW14 + 3000) }
call udLogNow
if (not ((count udOpL) > 0)) then {"wait timed out after 3000 s: a director op on Le Port" call udNote}
call udLogNow

// the player scouts the column's base: 200 m down its road, facing the gate
udBeat = "watch"
udAuto = false
setAccTime 4
udSrc = "Le Port Harbour"
if ((count udOpL) > 0) then {udSrc = udOpL select 4}
udSPos = (gmZone (gmZoneIndex udSrc)) select 8
udRt = gmRoadRoute [udSPos, udLPos]
udPts = []
if ((count udRt) > 0) then {udPts = udRt select ((count udRt) - 1)}
udCum = 0
udVan = [(udSPos select 0) + (((udLPos select 0) - (udSPos select 0)) * 200 / (udSPos distance udLPos)), (udSPos select 1) + (((udLPos select 1) - (udSPos select 1)) * 200 / (udSPos distance udLPos)), 0]
udK = 1
if ((count udPts) > 1) then {udVan = [((udPts select 0) select 0), ((udPts select 0) select 1), 0]; while {(udK < (count udPts)) and (udCum < 200)} do {udP0 = udPts select (udK - 1); udP1 = udPts select udK; udCum = udCum + ([(udP0 select 0), (udP0 select 1), 0] distance [(udP1 select 0), (udP1 select 1), 0]); udVan = [(udP1 select 0), (udP1 select 1), 0]; udK = udK + 1}}
player setCaptive true
player setPos udVan
udLook = ((udSPos select 0) - (udVan select 0)) atan2 ((udSPos select 1) - (udVan select 1))
player setDir udLook
(format ["the player watches the road out of %1 from %2 m", udSrc, udVan distance udSPos]) call udNote
udId = -1
if ((count udOpL) > 0) then {udId = udOpL select 0}
udRow = []
udEdges0 = udEdges
udPool0 = (gmOccupierForces) select 0
udW15 = time
triSimUntil { call udTick; player setDir udLook; udRow = []; {if ((_x select 0) == udId) then {udRow = _x}} forEach gmOccupierOps; (((count udRow) == 0) or (((count udRow) > 0) and (((udRow select 4) != udSrc) or ((udRow select 6) == "LIVE") or ((udRow select 3) == "TRANSPORT_HELI")))) or (time > udW15 + 300) }
call udLogNow
