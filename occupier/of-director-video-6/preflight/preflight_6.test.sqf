// Scratch scenario for the sixth director video (not a regression test).
// Generated by gen_scenario.py from scenario.tmpl: every @WAIT directive
// becomes a run of triSimUntil chunks of at most 300 s of game time with a
// UDTRACE between them.
//
// The stock Guerrilla.Abel template on occupier-forces with the eight levers
// (a5b40f0) at Normal: NO director tuning lever.  The one director-side
// switch is gmForcesTune ["log", 1], the forcesLog diagnostic, so every
// director line lands in the log at INFO (--dev does the same).  The script
// plays the RESISTANCE side only: which cell takes which point, who stays,
// where the player stands, how fast time runs.  Every occupier decision is
// the engine's own.  Every lever is logged as a UDNOTE starting "lever:".
//
// Video 6: a defended town.  Two towns are taken and HELD by a real garrison
// of resistance fighters each (Arudy four, Sainte Marie six), invulnerable,
// staying put and fighting, their magazines topped up from the cell's cache
// every 300 s.  The director's repel ladder, massing, break-off and withdraw,
// the band on strength, then a rising that pushes control under 0.75 (wave
// 1, the containments lifted, the wave surge), then free running.
//
// UDTRACE rows every 10 s of game time: [time, beat, gmOccupierForces,
// gmOccupierOps, gmOccupierIntel, counter-attack rows, zone rows,
// gmOccupierAir rows, player pos, gmHqState, accTime, gmSimDiag,
// gmCampaignEnd, band edges seen by the sampler, gmTrafficDiag skippedBudget,
// gmOccupierLedger, gmOccupierRepels, gmOccupierMassing, defenders
// [[town, alive, magazines]], gmWarLevelOccupier].
// UDFINE rows every 2 s of game time while a born record has a hull or an
// escort: [time, op, town, phase, hull pos, escort pos, leader pos, seated
// infantry, living infantry, package].

triSimUntil { GM_LIB_READY }

udT0 = time
triSimUntil { time > udT0 + 6 }
player allowDammage false
{_x allowDammage false} forEach (units group player)

udEvery = 10
udLast = -1000
udBeat = "setup"
udRoutes = []
udAuto = true
udEdges = 0
udBandPrev = "OFF"
udDef = []
udDefRows = {udDr = []; {udDt = _x select 0; udDg = _x select 1; udDa = 0; udDm = 0; {if (alive _x) then {udDa = udDa + 1}; udDm = udDm + (count (magazines _x))} forEach (units udDg); udDr = udDr + [[udDt, udDa, udDm]]} forEach udDef; udDr}
udLogNow = {udZ = []; udI = 0; while {udI < gmZoneCount} do {udR = gmZone udI; udS = gmZoneSim udI; udZ = udZ + [[udI, udR select 2, udR select 3, udR select 4, udR select 6, udS select 14, udS select 13, udS select 9, udS select 1, udS select 2, udS select 16, udS select 0, udS select 17, udS select 15]]; udI = udI + 1}; udC = []; {udC = udC + [[_x select 10, _x select 0, _x select 1, _x select 2, _x select 3, _x select 4, _x select 15, getPos (_x select 20), getPos (_x select 18), getPos (_x select 23), _x select 21, _x select 9, _x select 11, _x select 13]]} forEach gmCounterAttacks; udA = []; {udA = udA + [[_x select 8, _x select 9, _x select 10, _x select 7, _x select 11, _x select 2, _x select 4, _x select 6, _x select 16]]} forEach gmOccupierAir; logInfo format ["UDTRACE %1", [time, udBeat, gmOccupierForces, gmOccupierOps, gmOccupierIntel, udC, udZ, udA, getPos player, gmHqState, accTime, gmSimDiag, gmCampaignEnd, udEdges, (gmTrafficDiag) select 17, gmOccupierLedger, gmOccupierRepels, gmOccupierMassing, call udDefRows, gmWarLevelOccupier]]; {udK = format ["%1>%2", _x select 4, _x select 5]; if (not (udK in udRoutes)) then {udRoutes = udRoutes + [udK]; udSi = gmZoneIndex (_x select 4); udTi = gmZoneIndex (_x select 5); if ((udSi >= 0) and (udTi >= 0)) then {logInfo format ["UDROUTE %1", [_x select 4, _x select 5, gmRoadRoute [(gmZone udSi) select 8, (gmZone udTi) select 8]]]}}} forEach gmOccupierOps}
udAcc = {if (udAuto) then {udLv = false; {if ((_x select 6) == "LIVE") then {udLv = true}} forEach gmOccupierOps; {if ((_x select 2) == 1) then {udLv = true}} forEach gmOccupierAir; if (udLv) then {if (accTime != 4) then {setAccTime 4}} else {if (accTime != 8) then {setAccTime 8}}}}
udBandSample = {udBandNow = (gmOccupierForces) select 2; if ((udBandNow != udBandPrev) and (udBandPrev != "OFF")) then {udEdges = udEdges + 1}; udBandPrev = udBandNow}
udResLast = 0
udResN = 0
udResup = {if (time >= udResLast + 300) then {udResLast = time; {udRg = _x select 1; udRm = _x select 2; udRk = 0; {udRu = _x; if (alive udRu) then {udRm0 = udRm select udRk; udRmn = magazines udRu; udRdone = []; {udRt = _x; if (not (udRt in udRdone)) then {udRdone = udRdone + [udRt]; udRc0 = {_x == udRt} count udRm0; udRcn = {_x == udRt} count udRmn; udRj = udRcn; while {udRj < udRc0} do {udRu addMagazine udRt; udResN = udResN + 1; udRj = udRj + 1}}} forEach udRm0}; udRk = udRk + 1} forEach (units udRg)} forEach udDef}}
udStay = {{udSg = _x select 1; udSp = _x select 3; {if ((alive _x) and ((_x distance udSp) > 120)) then {_x doMove udSp}} forEach (units udSg)} forEach udDef}
udStayLast = 0
udTick = {call udAcc; call udBandSample; call udXClean; call udTrack; call udFine; call udResup; if (time >= udStayLast + 60) then {udStayLast = time; call udStay}; if (time >= udLast + udEvery) then {udLast = time; call udLogNow}}
udTowns = []
udSeen = []
udLive = []
udRep = []
udTrack = {{udTn = _x; udTi = udTowns find udTn; udNow = []; {if ((_x select 5) == udTn) then {udNow = udNow + [_x select 0]}} forEach gmOccupierOps; {if (not (_x in udNow)) then {if (((gmZone (gmZoneIndex udTn)) select 2) == gmResistanceSide) then {udRep set [udTi, (udRep select udTi) + 1]}; (format ["%1: op %2 is over, the town is held by %3; operations on %1 ended with it held so far %4", udTn, _x, (gmZone (gmZoneIndex udTn)) select 2, udRep select udTi]) call udNote}} forEach (udLive select udTi); {if (not (_x in (udSeen select udTi))) then {udSeen set [udTi, (udSeen select udTi) + [_x]]; (format ["%1: op %2 launched on it, operation number %3 on %1; repels row %4; massing %5", udTn, _x, count (udSeen select udTi), udTn call udRepRow, gmOccupierMassing]) call udNote}} forEach udNow; udLive set [udTi, udNow]} forEach udTowns}
udFineLast = -1000
udFine = {if (time >= udFineLast + 2) then {udFineLast = time; {if ((not (isNull (_x select 18))) or (not (isNull (_x select 23)))) then {logInfo format ["UDFINE %1", [time, _x select 10, _x select 0, _x select 2, getPos (_x select 18), getPos (_x select 23), getPos (_x select 20), _x select 19, _x select 21, _x select 13]]}} forEach gmCounterAttacks}}
udNote = {logInfo format ["UDNOTE %1", [time, _this]]}
udOpOn = {udHit = []; {if (((_x select 5) == _this) and ((_x select 0) > 0)) then {udHit = _x}} forEach gmOccupierOps; udHit}
udOpsOn = {udN = 0; {if ((_x select 5) == _this) then {udN = udN + 1}} forEach gmOccupierOps; udN}
udIntelOn = {udIc = 0; udZn = _this; {if ((_x select 0) == udZn) then {udIc = _x select 1}} forEach gmOccupierIntel; udIc}
udRepRow = {udRr = []; udRz = _this; {if ((_x select 0) == udRz) then {udRr = _x}} forEach gmOccupierRepels; udRr}
udContained = {udCn = false; udCz = _this; {if ((_x select 0) == udCz) then {if (_x select 4) then {udCn = true}}} forEach gmOccupierRepels; udCn}
udXs = []
udXClean = {udXk = []; {udXe = _x; if (((gmZone (gmZoneIndex (udXe select 0))) select 2) == gmResistanceSide) then {{deleteVehicle _x} forEach (units (udXe select 1)); deleteGroup (udXe select 1); (format ["the cell in %1 moves on: the point is left to its own (deleteGroup)", udXe select 0]) call udNote} else {udXk = udXk + [udXe]}} forEach udXs; udXs = udXk}

// ---- geometry: every zone, and the road routes from every occupier base -----
udI = 0
while {udI < gmZoneCount} do {udR = gmZone udI; logInfo format ["UDZONE %1", [udI, udR select 0, udR select 1, udR select 2, udR select 3, udR select 8, (gmZoneSim udI) select 7, gmLandmass (udR select 8)]]; udI = udI + 1}
udBases = []
udI = 0
while {udI < gmZoneCount} do {udR = gmZone udI; if ((udR select 2) == "EAST") then {if ((udR select 1) != "CITY") then {udBases = udBases + [udR select 0]}}; udI = udI + 1}
{udSi = gmZoneIndex _x; udJ = 0; while {udJ < gmZoneCount} do {if (udJ != udSi) then {logInfo format ["UDGRAPH %1", [_x, (gmZone udJ) select 0, gmRoadRoute [(gmZone udSi) select 8, (gmZone udJ) select 8]]]}; udJ = udJ + 1}} forEach udBases
logInfo format ["UDHQ %1", [gmHqState, gmHqPos]]
logInfo format ["UDGEN %1", gmGeneratedBases]

triSimUntil { ((gmOccupierForces) select 2) != "OFF" }
udBandPrev = (gmOccupierForces) select 2
gmForcesTune ["log", 1]
(format ["sizing: pool %1, poolStart %2, band %3, K %4, control %5, ledger %6; no director lever: forcesDifficulty Normal, the eight levers at their presets (cadence 600, strength 1, recovery 4, reach 1500, aggression 1, waves 1, minimums 4, concurrency 3)", (gmOccupierForces) select 0, (gmOccupierForces) select 1, (gmOccupierForces) select 2, (gmOccupierForces) select 7, (gmOccupierForces) select 5, gmOccupierLedger]) call udNote
"lever: forcesLog on (gmForcesTune log 1, a diagnostic: every director line at INFO); the player and his companions invulnerable and kept in the north-western hills; time x8 (x4 while a force is live or airborne)" call udNote
call udLogNow

udRes = gmResistanceSide call GM_fnSideFromString
udAr = gmZoneIndex "Arudy"
udSm = gmZoneIndex "Sainte Marie"
udArPos = (gmZone udAr) select 8
udSmPos = (gmZone udSm) select 8

udFar = [4600, 9600, 0]
if ((gmLandmass udFar) < 0) then {udFar = [4400, 9000, 0]}
if ((gmLandmass udFar) < 0) then {udFar = [4500, 5200, 0]}
{_x setPos [(udFar select 0) + 4, (udFar select 1) + 4, 0]} forEach ((units group player) - [player])
player setPos udFar
(format ["the player and %1 companion(s) wait in the hills at %2 (landmass %3)", (count (units group player)) - 1, udFar, gmLandmass udFar]) call udNote
udW1 = time
triSimUntil { call udTick; ((not (gmGarrisonSpawned udAr)) and (not (gmGarrisonSpawned udSm))) or (time > udW1 + 300) }
call udLogNow
triSimUntil { call udTick; ((not (gmGarrisonSpawned udAr)) and (not (gmGarrisonSpawned udSm))) or (time > udW1 + 600) }
call udLogNow
if (not ((not (gmGarrisonSpawned udAr)) and (not (gmGarrisonSpawned udSm)))) then {"wait timed out after 600 s: garrisons stored" call udNote}
call udLogNow

// ---- the defenders: a real garrison that stays and fights -------------------
udHoldTown = {udHt = _this select 0; udHn = _this select 1; udHz = gmZoneIndex udHt; udHp = (gmZone udHz) select 8; gmZoneSet [udHz, "garrison", 0]; gmZoneSet [udHz, "support", 55]; udHg = [udRes, gmFactionSquad [gmResistanceSide, 1, udHn], udHp] call GM_fnSpawnSquad; {_x allowDammage false} forEach (units udHg); doStop (units udHg); udHm = []; {udHm = udHm + [magazines _x]} forEach (units udHg); udDef = udDef + [[udHt, udHg, udHm, udHp]]; udTowns = udTowns + [udHt]; udSeen = udSeen + [[]]; udLive = udLive + [[]]; udRep = udRep + [0]; (format ["lever: %1 garrison 0, support 55; %2 fighters take it and STAY as its garrison (invulnerable, held within 120 m of the centre, magazines topped up from the cell's cache every 300 s): %3", udHt, udHn, gmFactionSquad [gmResistanceSide, 1, udHn]]) call udNote}

// ---- beat 1: Arudy, four fighters (the first town: the legacy roll) ---------
udBeat = "arudy"
["Arudy", 4] call udHoldTown
udW2 = time
triSimUntil { call udTick; (((gmZone udAr) select 2) == gmResistanceSide) or (time > udW2 + 300) }
call udLogNow
triSimUntil { call udTick; (((gmZone udAr) select 2) == gmResistanceSide) or (time > udW2 + 600) }
call udLogNow
if (not (((gmZone udAr) select 2) == gmResistanceSide)) then {"wait timed out after 600 s: Arudy taken" call udNote}
call udLogNow
udW3 = time
triSimUntil { call udTick; (false) or (time > udW3 + 180) }
call udLogNow

// ---- beat 2: Sainte Marie, six fighters: the director wakes ----------------
udBeat = "saintemarie"
["Sainte Marie", 6] call udHoldTown
udW4 = time
triSimUntil { call udTick; (((gmZone udSm) select 2) == gmResistanceSide) or (time > udW4 + 300) }
call udLogNow
triSimUntil { call udTick; (((gmZone udSm) select 2) == gmResistanceSide) or (time > udW4 + 600) }
call udLogNow
if (not (((gmZone udSm) select 2) == gmResistanceSide)) then {"wait timed out after 600 s: Sainte Marie taken" call udNote}
udW5 = time
triSimUntil { call udTick; (((gmOccupierForces) select 4) == "AWAKE") or (time > udW5 + 300) }
call udLogNow
if (not (((gmOccupierForces) select 4) == "AWAKE")) then {"wait timed out after 300 s: director awake" call udNote}
call udLogNow
(format ["awake: pool %1 of %2, band %3, tokens %4, operations %5, ledger %6", (gmOccupierForces) select 0, (gmOccupierForces) select 1, (gmOccupierForces) select 2, (gmOccupierForces) select 3, count gmOccupierOps, gmOccupierLedger]) call udNote

// ---- beat 3: the hold: the ladder, massing, break-offs, the band ------------
udBeat = "hold"
udTh = time
(format ["the hold begins: both towns held by their garrisons; no lever until the rising (at least %1 s, until both are contained or %2 s)", 3000, 6600]) call udNote
udW6 = time
triSimUntil { call udTick; (false) or (time > udW6 + 300) }
call udLogNow
triSimUntil { call udTick; (false) or (time > udW6 + 600) }
call udLogNow
triSimUntil { call udTick; (false) or (time > udW6 + 900) }
call udLogNow
triSimUntil { call udTick; (false) or (time > udW6 + 1200) }
call udLogNow
triSimUntil { call udTick; (false) or (time > udW6 + 1500) }
call udLogNow
triSimUntil { call udTick; (false) or (time > udW6 + 1800) }
call udLogNow
triSimUntil { call udTick; (false) or (time > udW6 + 2100) }
call udLogNow
triSimUntil { call udTick; (false) or (time > udW6 + 2400) }
call udLogNow
call udLogNow
(format ["after the hold: repels %1, massing %2, ledger %3, pool %4 of %5, band %6, lost %7, magazines topped up %8", gmOccupierRepels, gmOccupierMassing, gmOccupierLedger, (gmOccupierForces) select 0, (gmOccupierForces) select 1, (gmOccupierForces) select 2, (gmOccupierForces) select 9, udResN]) call udNote
//@FINAL_END
(format ["end: pool %1 of %2, band %3, tokens %4, operation counter %5, waves fired %6, control %7, lost %8, repels %9", (gmOccupierForces) select 0, (gmOccupierForces) select 1, (gmOccupierForces) select 2, (gmOccupierForces) select 3, (gmOccupierForces) select 13, (gmOccupierForces) select 18, (gmOccupierForces) select 5, (gmOccupierForces) select 9, gmOccupierRepels]) call udNote
(format ["end: towns %1, operations seen %2, held after %3, defenders %4, magazines topped up %5, ledger %6", udTowns, udSeen, udRep, call udDefRows, udResN, gmOccupierLedger]) call udNote
(format ["end census: gmSimDiag %1", gmSimDiag]) call udNote
udAuto = false
setAccTime 1
call udLogNow
gmSimDiagLog

triEndTest
