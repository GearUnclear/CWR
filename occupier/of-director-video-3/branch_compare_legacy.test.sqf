// Scratch scenario for the branch comparison video (not a regression test).
// Generated by gen_scenario.py from scenario.tmpl: every @WAIT directive
// becomes a run of triSimUntil chunks of at most 200 s of game time with a
// UDTRACE between them.  The SAME script runs on both branches (A =
// origin/reviewable_forces, B = occupier-forces HEAD) and on the optional
// legacy-cadence run; it uses only commands both branches have.
//
// The script plays the RESISTANCE side and pulls test levers; every occupier
// decision is the engine's own.  Every lever is logged as a UDNOTE starting
// "lever:".  UDTRACE rows every 10 s of game time (the round-2 layout);
// UDFINE rows sample per frame around the two moments a single zone tick
// matters (the double birth, the bubble entry at the Outpost).
//
// Beats: floor (pool 15 of 50 at forcesPoolFloor 0.3, the wake comes there),
// double (Houdan and Dourdan taken in one frame: k), births (two births due in
// one step against a crowded 130-body budget), base (the player enters the
// Outpost bubble on a zone tick while an abstract force drains its meter),
// stretch (five towns, then 60 minutes of free running).

triSimUntil { GM_LIB_READY }

GM_COMP_ALIVE = [false]
GM_QRF_TICK = 999999
{deleteVehicle _x} forEach ((units group player) - [player])
udT0 = time
triSimUntil { time > udT0 + 6 }
{deleteVehicle _x} forEach ((units group player) - [player])
player allowDammage false

udEvery = 10
udLast = -1000
udBeat = "setup"
udRoutes = []
udAuto = false
udEdges = 0
udBandPrev = "OFF"
udLogNow = {udZ = []; udI = 0; while {udI < gmZoneCount} do {udR = gmZone udI; udS = gmZoneSim udI; udZ = udZ + [[udI, udR select 2, udR select 3, udR select 4, udR select 6, udS select 14, udS select 13, udS select 9, udS select 1, udS select 2, udS select 16, udS select 0, udS select 17, udS select 15]]; udI = udI + 1}; udC = []; {udC = udC + [[_x select 10, _x select 0, _x select 1, _x select 2, _x select 3, _x select 4, _x select 15, getPos (_x select 20), getPos (_x select 18), getPos (_x select 23), _x select 21, _x select 9, _x select 11, _x select 13]]} forEach gmCounterAttacks; udA = []; {udA = udA + [[_x select 8, _x select 9, _x select 10, _x select 7, _x select 11, _x select 2, _x select 4, _x select 6, _x select 16]]} forEach gmOccupierAir; logInfo format ["UDTRACE %1", [time, udBeat, gmOccupierForces, gmOccupierOps, gmOccupierIntel, udC, udZ, udA, getPos player, gmHqState, accTime, gmSimDiag, gmCampaignEnd, udEdges]]; {udK = format ["%1>%2", _x select 4, _x select 5]; if (not (udK in udRoutes)) then {udRoutes = udRoutes + [udK]; udSi = gmZoneIndex (_x select 4); udTi = gmZoneIndex (_x select 5); if ((udSi >= 0) and (udTi >= 0)) then {logInfo format ["UDROUTE %1", [_x select 4, _x select 5, gmRoadRoute [(gmZone udSi) select 8, (gmZone udTi) select 8]]]}}} forEach gmOccupierOps}
udAcc = {if (udAuto) then {udLv = false; {if ((_x select 6) == "LIVE") then {udLv = true}} forEach gmOccupierOps; {if ((_x select 2) == 1) then {udLv = true}} forEach gmOccupierAir; if (udLv) then {if (accTime != 4) then {setAccTime 4}} else {if (accTime != 8) then {setAccTime 8}}}}
udBandSample = {udBandNow = (gmOccupierForces) select 2; if ((udBandNow != udBandPrev) and (udBandPrev != "OFF")) then {udEdges = udEdges + 1}; udBandPrev = udBandNow}
udTick = {call udAcc; call udBandSample; if (time >= udLast + udEvery) then {udLast = time; call udLogNow}}
udNote = {logInfo format ["UDNOTE %1", [time, _this]]}
udOpOn = {udHit = []; {if (((_x select 5) == _this) and ((_x select 0) > 0)) then {udHit = _x}} forEach gmOccupierOps; udHit}
udOpsOn = {udN = 0; {if ((_x select 5) == _this) then {udN = udN + 1}} forEach gmOccupierOps; udN}

// ---- geometry: every zone, and the road routes from every occupier base -----
udI = 0
while {udI < gmZoneCount} do {udR = gmZone udI; logInfo format ["UDZONE %1", [udI, udR select 0, udR select 1, udR select 2, udR select 3, udR select 8, (gmZoneSim udI) select 7, gmLandmass (udR select 8)]]; udI = udI + 1}
udBases = ["Outpost", "Southeast Compound", "Le Port Harbour", "Airfield"]
{udSi = gmZoneIndex _x; udJ = 0; while {udJ < gmZoneCount} do {if (udJ != udSi) then {logInfo format ["UDGRAPH %1", [_x, (gmZone udJ) select 0, gmRoadRoute [(gmZone udSi) select 8, (gmZone udJ) select 8]]]}; udJ = udJ + 1}} forEach udBases
logInfo format ["UDHQ %1", [gmHqState, gmHqPos]]

// ---- compression levers (test pacing only) ----------------------------------
triSimUntil { ((gmOccupierForces) select 2) != "OFF" }
udBandPrev = (gmOccupierForces) select 2
gmForcesTune ["directorInterval", 10]
gmForcesTune ["waveLead", 120]
gmCounterAttackTune ["birthGiveUp", 60]
gmCounterAttackTune ["firstTownChance", 0]
gmCounterAttackTune ["chance", 0]
"lever: directorInterval 10 s, waveLead 120 s, birthGiveUp 60 s; the DORMANT answer chances 0 (firstTownChance, chance) so the first town gets no legacy answer on either branch" call udNote
(format ["sizing: pool %1, poolStart %2, band %3, K %4 (mission copy: forcesPoolMin 50, forcesPoolPerTown 1)", (gmOccupierForces) select 0, (gmOccupierForces) select 1, (gmOccupierForces) select 2, (gmOccupierForces) select 7]) call udNote
call udLogNow

udRes = gmResistanceSide call GM_fnSideFromString
udV = gmZoneIndex "Village"
udD = gmZoneIndex "Dourdan"
udO = gmZoneIndex "Outpost"
udAf = gmZoneIndex "Airfield"
udH = gmZoneIndex "Le Port Harbour"
udVPos = (gmZone udV) select 8
udDPos = (gmZone udD) select 8
udOPos = (gmZone udO) select 8

udFar = [4400, 7600, 0]
if ((gmLandmass udFar) < 0) then {udFar = [4500, 5200, 0]}
player setPos udFar
(format ["the player waits in the hills at %1", udFar]) call udNote
udW1 = time
triSimUntil { call udTick; ((not (gmGarrisonSpawned udV)) and (not (gmGarrisonSpawned udD)) and (not (gmGarrisonSpawned udO))) or (time > udW1 + 200) }
call udLogNow
triSimUntil { call udTick; ((not (gmGarrisonSpawned udV)) and (not (gmGarrisonSpawned udD)) and (not (gmGarrisonSpawned udO))) or (time > udW1 + 400) }
call udLogNow
triSimUntil { call udTick; ((not (gmGarrisonSpawned udV)) and (not (gmGarrisonSpawned udD)) and (not (gmGarrisonSpawned udO))) or (time > udW1 + 600) }
call udLogNow
if (not ((not (gmGarrisonSpawned udV)) and (not (gmGarrisonSpawned udD)) and (not (gmGarrisonSpawned udO)))) then {"wait timed out after 600 s: garrisons stored" call udNote}
setAccTime 4

// ---- beat 1: the pool at exactly its floor (fix 4) -------------------------
udBeat = "floor"
gmForcesTune ["poolFloor", 0.3]
gmForcesForce ["refillHours", 48]
gmForcesForce ["pool", 15]
(format ["lever: poolFloor 0.3, refill 48 h (holds the pool still), pool forced to 15: pool %1 of %2, band %3; 15 / 50 is exactly the floor", (gmOccupierForces) select 0, (gmOccupierForces) select 1, (gmOccupierForces) select 2]) call udNote
call udLogNow

// ---- beat 2: Houdan and Dourdan fall in the same zone tick (fix 3) ---------
udBeat = "double"
udDouble = {gmZoneSet [udV, "garrison", 0]; gmZoneSet [udD, "garrison", 0]; gmZoneSet [udV, "support", 55]; gmZoneSet [udD, "support", 55]; udSqV = [udRes, gmFactionSquad [gmResistanceSide, 1, 3], udVPos] call GM_fnSpawnSquad; udSqD = [udRes, gmFactionSquad [gmResistanceSide, 1, 3], udDPos] call GM_fnSpawnSquad; {_x allowDammage false} forEach ((units udSqV) + (units udSqD)); doStop ((units udSqV) + (units udSqD))}
call udDouble
"lever: Houdan and Dourdan garrison 0, support 55, three fighters each (invulnerable, they stay), all set in one frame" call udNote
udW2 = time
triSimUntil { call udTick; ((((gmZone udV) select 2) == gmResistanceSide) and (((gmZone udD) select 2) == gmResistanceSide)) or (time > udW2 + 200) }
call udLogNow
triSimUntil { call udTick; ((((gmZone udV) select 2) == gmResistanceSide) and (((gmZone udD) select 2) == gmResistanceSide)) or (time > udW2 + 400) }
call udLogNow
triSimUntil { call udTick; ((((gmZone udV) select 2) == gmResistanceSide) and (((gmZone udD) select 2) == gmResistanceSide)) or (time > udW2 + 600) }
call udLogNow
if (not ((((gmZone udV) select 2) == gmResistanceSide) and (((gmZone udD) select 2) == gmResistanceSide))) then {"wait timed out after 600 s: both towns taken" call udNote}
call udLogNow
udW3 = time
triSimUntil { call udTick; (((gmOccupierForces) select 4) == "AWAKE") or (time > udW3 + 120) }
call udLogNow
if (not (((gmOccupierForces) select 4) == "AWAKE")) then {"wait timed out after 120 s: director awake" call udNote}
call udLogNow
(format ["awake at the floor: pool %1 of %2, band %3, tokens %4, operations %5", (gmOccupierForces) select 0, (gmOccupierForces) select 1, (gmOccupierForces) select 2, (gmOccupierForces) select 3, count gmOccupierOps]) call udNote
udW4 = time
triSimUntil { call udTick; (false) or (time > udW4 + 200) }
call udLogNow
triSimUntil { call udTick; (false) or (time > udW4 + 240) }
call udLogNow
(format ["after 240 s at the floor: pool %1 of %2, band %3, tokens %4, operations %5", (gmOccupierForces) select 0, (gmOccupierForces) select 1, (gmOccupierForces) select 2, (gmOccupierForces) select 3, count gmOccupierOps]) call udNote

// ---- the pool comes back -----------------------------------------------------
udBeat = "restore"
gmForcesForce ["pool", 50]
gmForcesForce ["refillHours", 4]
(format ["lever: pool restored to 50, refill 4 h: band %1, tokens %2", (gmOccupierForces) select 2, (gmOccupierForces) select 3]) call udNote
call udLogNow

// ---- beat 3: two births due in one step, a crowded body budget (fix 1) -----
udBeat = "births"
udHD = {udTv = []; {if ((((_x select 5) == "Village") or ((_x select 5) == "Dourdan")) and ((_x select 2) == "DIRECTOR")) then {udTv = udTv + [_x]}} forEach gmOccupierOps; udTv}
udNT = 0
udW5 = time
triSimUntil { call udTick; udTv = call udHD; udNT = 0; {if ((_x select 6) == "TRAVEL") then {udNT = udNT + 1}} forEach udTv; (udNT >= 2) or (time > udW5 + 200) }
call udLogNow
triSimUntil { call udTick; udTv = call udHD; udNT = 0; {if ((_x select 6) == "TRAVEL") then {udNT = udNT + 1}} forEach udTv; (udNT >= 2) or (time > udW5 + 400) }
call udLogNow
triSimUntil { call udTick; udTv = call udHD; udNT = 0; {if ((_x select 6) == "TRAVEL") then {udNT = udNT + 1}} forEach udTv; (udNT >= 2) or (time > udW5 + 600) }
call udLogNow
triSimUntil { call udTick; udTv = call udHD; udNT = 0; {if ((_x select 6) == "TRAVEL") then {udNT = udNT + 1}} forEach udTv; (udNT >= 2) or (time > udW5 + 800) }
call udLogNow
triSimUntil { call udTick; udTv = call udHD; udNT = 0; {if ((_x select 6) == "TRAVEL") then {udNT = udNT + 1}} forEach udTv; (udNT >= 2) or (time > udW5 + 900) }
call udLogNow
if (not (udNT >= 2)) then {"wait timed out after 900 s: two director ops travelling on Houdan and Dourdan" call udNote}
call udLogNow
udTv = call udHD
udBmax = 0
udBmin = 99
{udBb = _x select 7; if ((_x select 3) != "FOOT") then {udBb = udBb + 3}; if (udBb > udBmax) then {udBmax = udBb}; if (udBb < udBmin) then {udBmin = udBb}} forEach udTv
if (udBmin > udBmax) then {udBmin = udBmax}
udM = (udBmin - (udBmin mod 2)) / 2
if (udM < 1) then {udM = 1}
udL0 = ((gmSimDiag) select 2) select 3
udF = 130 - udL0 - udBmax - udM
udFill = []
udFillPos = [(udFar select 0) + 250, (udFar select 1) + 250, 0]
udFillN = udF
while {udFillN > 0} do {udK = udFillN; if (udK > 10) then {udK = 10}; udG = [udRes, gmFactionSquad [gmResistanceSide, 1, udK], udFillPos] call GM_fnSpawnSquad; {_x allowDammage false} forEach (units udG); doStop (units udG); udFill = udFill + [udG]; udFillN = udFillN - udK}
udL1 = ((gmSimDiag) select 2) select 3
(format ["lever: %1 resistance bodies parked in the far hills stand in for a crowded map: live AI %2 -> %3 of the 130 budget; the forces on Houdan and Dourdan need about %4 and %5 bodies, one fits, two do not; %6 director op(s) travelling", udF, udL0, udL1, udBmin, udBmax, udNT]) call udNote
udBp = [6750, 6650, 0]
if ((gmLandmass udBp) < 0) then {udBp = [6850, 6600, 0]}
player setCaptive true
player setPos udBp
player setDir 270
(format ["the player steps between Houdan (%1 m) and Dourdan (%2 m): both destinations enter the 800 m bubble in the same frame", (udBp distance udVPos), (udBp distance udDPos)]) call udNote
setAccTime 1
udFineK = ""
udFineB = {udFs = []; {if (((_x select 5) == "Village") or ((_x select 5) == "Dourdan")) then {udFs = udFs + [[_x select 0, _x select 5, _x select 3, _x select 6, _x select 7, _x select 10]]}} forEach gmOccupierOps; udDg = gmSimDiag; udKey = format ["%1 %2 %3", udFs, (udDg select 2) select 3, (udDg select 3) select 0]; if (udKey != udFineK) then {udFineK = udKey; logInfo format ["UDFINE %1", [time, "births", udFs, udDg select 2, udDg select 3]]}}
udT1 = time
triSimUntil { call udFineB; time > udT1 + 45 }
call udLogNow
setAccTime 4
udT1 = time
triSimUntil { call udFineB; call udTick; time > udT1 + 120 }
triSimUntil { call udFineB; call udTick; time > udT1 + 240 }
call udLogNow
(format ["after the births: live AI %1 (budget 130), occupier groups %2", ((gmSimDiag) select 2) select 3, ((gmSimDiag) select 3) select 0]) call udNote
{{deleteVehicle _x} forEach (units _x)} forEach udFill
"lever: the parked bodies are removed" call udNote
udT1 = time
triSimUntil { call udFineB; call udTick; time > udT1 + 60 }
call udLogNow
player setPos udFar
player setCaptive false
"the player leaves for the hills" call udNote
udAuto = true
udW6 = time
triSimUntil { call udTick; (((count (call udHD)) == 0)) or (time > udW6 + 200) }
call udLogNow
triSimUntil { call udTick; (((count (call udHD)) == 0)) or (time > udW6 + 400) }
call udLogNow
triSimUntil { call udTick; (((count (call udHD)) == 0)) or (time > udW6 + 600) }
call udLogNow
triSimUntil { call udTick; (((count (call udHD)) == 0)) or (time > udW6 + 800) }
call udLogNow
triSimUntil { call udTick; (((count (call udHD)) == 0)) or (time > udW6 + 1000) }
call udLogNow
triSimUntil { call udTick; (((count (call udHD)) == 0)) or (time > udW6 + 1200) }
call udLogNow
triSimUntil { call udTick; (((count (call udHD)) == 0)) or (time > udW6 + 1400) }
call udLogNow
triSimUntil { call udTick; (((count (call udHD)) == 0)) or (time > udW6 + 1600) }
call udLogNow
triSimUntil { call udTick; (((count (call udHD)) == 0)) or (time > udW6 + 1800) }
call udLogNow
triSimUntil { call udTick; (((count (call udHD)) == 0)) or (time > udW6 + 2000) }
call udLogNow
triSimUntil { call udTick; (((count (call udHD)) == 0)) or (time > udW6 + 2200) }
call udLogNow
triSimUntil { call udTick; (((count (call udHD)) == 0)) or (time > udW6 + 2400) }
call udLogNow
triSimUntil { call udTick; (((count (call udHD)) == 0)) or (time > udW6 + 2600) }
call udLogNow
triSimUntil { call udTick; (((count (call udHD)) == 0)) or (time > udW6 + 2800) }
call udLogNow
triSimUntil { call udTick; (((count (call udHD)) == 0)) or (time > udW6 + 3000) }
call udLogNow
triSimUntil { call udTick; (((count (call udHD)) == 0)) or (time > udW6 + 3200) }
call udLogNow
triSimUntil { call udTick; (((count (call udHD)) == 0)) or (time > udW6 + 3400) }
call udLogNow
triSimUntil { call udTick; (((count (call udHD)) == 0)) or (time > udW6 + 3600) }
call udLogNow
if (not (((count (call udHD)) == 0))) then {"wait timed out after 3600 s: Houdan and Dourdan operations settled" call udNote}
call udLogNow
udW7 = time
triSimUntil { call udTick; (false) or (time > udW7 + 60) }
call udLogNow

// ---- beat 4: the Outpost falls, then the player walks in on its retake (fix 2)
udBeat = "outpost"
udW8 = time
triSimUntil { call udTick; (not (gmGarrisonSpawned udO)) or (time > udW8 + 200) }
call udLogNow
triSimUntil { call udTick; (not (gmGarrisonSpawned udO)) or (time > udW8 + 400) }
