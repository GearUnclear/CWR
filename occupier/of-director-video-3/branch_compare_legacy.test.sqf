triSimUntil { call udTick; (not (gmGarrisonSpawned udO)) or (time > udW8 + 600) }
call udLogNow
if (not (not (gmGarrisonSpawned udO))) then {"wait timed out after 600 s: Outpost stored" call udNote}
"lever: Outpost reserve 0 (an ambush on its relief); three fighters take it, invulnerable" call udNote
gmZoneSet [udO, "garrison", 0]
udSqO = [udRes, gmFactionSquad [gmResistanceSide, 1, 3], udOPos] call GM_fnSpawnSquad
{_x allowDammage false} forEach (units udSqO)
doStop (units udSqO)
udW9 = time
triSimUntil { call udTick; (((gmZone udO) select 2) == gmResistanceSide) or (time > udW9 + 200) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) == gmResistanceSide) or (time > udW9 + 400) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) == gmResistanceSide) or (time > udW9 + 600) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) == gmResistanceSide) or (time > udW9 + 800) }
call udLogNow
triSimUntil { call udTick; (((gmZone udO) select 2) == gmResistanceSide) or (time > udW9 + 900) }
call udLogNow
if (not (((gmZone udO) select 2) == gmResistanceSide)) then {"wait timed out after 900 s: Outpost taken" call udNote}
udW10 = time
triSimUntil { call udTick; ((GM_HOLD_ZONES find "Outpost") >= 0) or (time > udW10 + 120) }
call udLogNow
if (not ((GM_HOLD_ZONES find "Outpost") >= 0)) then {"wait timed out after 120 s: hold squad" call udNote}
call udLogNow
udHi = GM_HOLD_ZONES find "Outpost"
udHg = grpNull
if (udHi >= 0) then {udHg = GM_HOLD_GRPS select udHi}
udHn = 0
if (not (isNull udHg)) then {udHn = count (units udHg)}
{deleteVehicle _x} forEach (units udSqO)
if (not (isNull udHg)) then {{deleteVehicle _x} forEach (units udHg)}
(format ["lever: the Outpost hold squad (%1) is deleted, a lost patrol; the cell moves on: the base is empty", udHn]) call udNote
udBeat = "base"
udHo = []
udW11 = time
triSimUntil { call udTick; udHo = []; {if (((_x select 5) == "Outpost") and ((_x select 6) == "HOLDING")) then {udHo = _x}} forEach gmOccupierOps; ((((count udHo) > 0) and (((gmZoneSim udO) select 14) > 4)) or (((gmZone udO) select 2) != gmResistanceSide)) or (time > udW11 + 200) }
call udLogNow
triSimUntil { call udTick; udHo = []; {if (((_x select 5) == "Outpost") and ((_x select 6) == "HOLDING")) then {udHo = _x}} forEach gmOccupierOps; ((((count udHo) > 0) and (((gmZoneSim udO) select 14) > 4)) or (((gmZone udO) select 2) != gmResistanceSide)) or (time > udW11 + 400) }
call udLogNow
triSimUntil { call udTick; udHo = []; {if (((_x select 5) == "Outpost") and ((_x select 6) == "HOLDING")) then {udHo = _x}} forEach gmOccupierOps; ((((count udHo) > 0) and (((gmZoneSim udO) select 14) > 4)) or (((gmZone udO) select 2) != gmResistanceSide)) or (time > udW11 + 600) }
call udLogNow
triSimUntil { call udTick; udHo = []; {if (((_x select 5) == "Outpost") and ((_x select 6) == "HOLDING")) then {udHo = _x}} forEach gmOccupierOps; ((((count udHo) > 0) and (((gmZoneSim udO) select 14) > 4)) or (((gmZone udO) select 2) != gmResistanceSide)) or (time > udW11 + 800) }
call udLogNow
triSimUntil { call udTick; udHo = []; {if (((_x select 5) == "Outpost") and ((_x select 6) == "HOLDING")) then {udHo = _x}} forEach gmOccupierOps; ((((count udHo) > 0) and (((gmZoneSim udO) select 14) > 4)) or (((gmZone udO) select 2) != gmResistanceSide)) or (time > udW11 + 1000) }
call udLogNow
triSimUntil { call udTick; udHo = []; {if (((_x select 5) == "Outpost") and ((_x select 6) == "HOLDING")) then {udHo = _x}} forEach gmOccupierOps; ((((count udHo) > 0) and (((gmZoneSim udO) select 14) > 4)) or (((gmZone udO) select 2) != gmResistanceSide)) or (time > udW11 + 1200) }
call udLogNow
triSimUntil { call udTick; udHo = []; {if (((_x select 5) == "Outpost") and ((_x select 6) == "HOLDING")) then {udHo = _x}} forEach gmOccupierOps; ((((count udHo) > 0) and (((gmZoneSim udO) select 14) > 4)) or (((gmZone udO) select 2) != gmResistanceSide)) or (time > udW11 + 1400) }
call udLogNow
triSimUntil { call udTick; udHo = []; {if (((_x select 5) == "Outpost") and ((_x select 6) == "HOLDING")) then {udHo = _x}} forEach gmOccupierOps; ((((count udHo) > 0) and (((gmZoneSim udO) select 14) > 4)) or (((gmZone udO) select 2) != gmResistanceSide)) or (time > udW11 + 1600) }
call udLogNow
triSimUntil { call udTick; udHo = []; {if (((_x select 5) == "Outpost") and ((_x select 6) == "HOLDING")) then {udHo = _x}} forEach gmOccupierOps; ((((count udHo) > 0) and (((gmZoneSim udO) select 14) > 4)) or (((gmZone udO) select 2) != gmResistanceSide)) or (time > udW11 + 1800) }
call udLogNow
triSimUntil { call udTick; udHo = []; {if (((_x select 5) == "Outpost") and ((_x select 6) == "HOLDING")) then {udHo = _x}} forEach gmOccupierOps; ((((count udHo) > 0) and (((gmZoneSim udO) select 14) > 4)) or (((gmZone udO) select 2) != gmResistanceSide)) or (time > udW11 + 2000) }
call udLogNow
triSimUntil { call udTick; udHo = []; {if (((_x select 5) == "Outpost") and ((_x select 6) == "HOLDING")) then {udHo = _x}} forEach gmOccupierOps; ((((count udHo) > 0) and (((gmZoneSim udO) select 14) > 4)) or (((gmZone udO) select 2) != gmResistanceSide)) or (time > udW11 + 2200) }
call udLogNow
triSimUntil { call udTick; udHo = []; {if (((_x select 5) == "Outpost") and ((_x select 6) == "HOLDING")) then {udHo = _x}} forEach gmOccupierOps; ((((count udHo) > 0) and (((gmZoneSim udO) select 14) > 4)) or (((gmZone udO) select 2) != gmResistanceSide)) or (time > udW11 + 2400) }
call udLogNow
