#!/bin/sh
# Block pushes whose new commits add game data, LoBo data or secrets.
# Runs .githooks/check_no_game_data.py --push with Git's pre-push stdin
# ("<local ref> <local sha> <remote ref> <remote sha>" lines) passed through.
HOOK_DIR=$(cd "$(dirname "$0")" && pwd)
CHECKER="$HOOK_DIR/check_no_game_data.py"

PY=""
if python3 -c "import sys" >/dev/null 2>&1; then
  PY="python3"
elif python -c "import sys" >/dev/null 2>&1; then
  PY="python"
elif py -3 -c "import sys" >/dev/null 2>&1; then
  PY="py -3"
fi
if [ -z "$PY" ]; then
  echo "pre-push: no working Python 3 (tried python3, python, py -3)." >&2
  echo "pre-push: the game data guard cannot run, so the push is refused." >&2
  exit 1
fi
if [ ! -f "$CHECKER" ]; then
  echo "pre-push: $CHECKER is missing; refusing the push." >&2
  exit 1
fi
exec $PY "$CHECKER" --push
