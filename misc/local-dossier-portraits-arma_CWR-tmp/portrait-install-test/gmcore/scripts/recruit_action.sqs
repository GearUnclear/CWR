; ============================================================================
;  recruit_action.sqs  -  thin addAction dispatcher for the recruit system.
; ----------------------------------------------------------------------------
;  addAction runs this FILE with _this bound to [target, caller, actionId]
;  (EntityAI::AddUserAction -> Script(desc->script, [this, person, id])).
;
;  It deliberately does NO state mutation: it only ENQUEUES the request so
;  recruit.sqs's loop remains the single writer of GM_PLAYER_GROUPS and the
;  gmResources/gmManpower debits. recruit.sqs polls gmReqPending every second
;  and dispatches on gmReqId. Same queue-and-consume pattern the native-event
;  handlers use (see init.sqs).
; ============================================================================

gmReqId = _this select 2
gmReqCaller = _this select 1
gmReqPending = true
exit
