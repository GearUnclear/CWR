// texsharp research capture run (generated by tmp/research/texsharp/scripts/gen_tests.py).
#include "capture_lib.sqf"

triSimUntil { alive player }

capWorld = "Sinai"
capFov = 0.7
capSimT = 0
capPinTime = false
capUseView = false
capProps = []
capView = "setup"
capModeName = "none"
capLit = "none"
capGpu = "none"
capPerf = "none"

// texsharp helpers: set knobs (logged), name a variant and restart the timers
tsSet = { { capK = triSetLighting _x; format ["view=%1;event=knob;set=%2;res=%3", capView, _x, capK] call capLog } forEach _this }
tsMode = { capModeName = _this; capGpuOff = triGpuTimes false; capGpuOn = triGpuTimes true; capPerfRes = triPerfReset 0; format ["view=%1;event=mode;mode=%2;lit=variant", capView, _this] call capLog }

triCaptureAtPresent true
triSetMsaa 4
triSetRenderScale 1.5
showCinemaBorder false
enableRadio false
player setCaptive true
player allowDamage false

createCenter west
createCenter east
capGrpW = createGroup west
capProbe = "HeliHEmpty" createVehicle [8350, 2950, 0]
capCam = "camera" camCreate [8350, 2950, 2]
capCam cameraEffect ["internal", "back"]
triSimFrames 240
call { "view=setup;event=setup;world=Sinai;msaa=4;scale=1.5;window=960x640;capture=present;track=texsharp" call capLog }

// ---- sinai_desert_noon
["sinai_desert_noon", 7300, 10300, 1.75, 210, 1, [2005, 7, 21, 12, 15], 0, 0, 4000] call capBegin
