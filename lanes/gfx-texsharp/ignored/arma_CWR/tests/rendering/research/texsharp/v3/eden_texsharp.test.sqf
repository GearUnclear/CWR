// texsharp research capture run (generated by tmp/research/texsharp/scripts/gen_tests.py).
#include "capture_lib.sqf"

triSimUntil { alive player }

capWorld = "Eden"
capFov = 0.7
capSimT = 0
capPinTime = false
capUseView = false
capProps = []
capView = "setup"
capModeName = "none"
capLit = "none"
capGpu = "none"
capPerf = "none"

// texsharp helpers: set knobs (logged), name a variant and restart the timers
tsSet = { { capK = triSetLighting _x; format ["view=%1;event=knob;set=%2;res=%3", capView, _x, capK] call capLog } forEach _this }
tsMode = { capModeName = _this; capGpuOff = triGpuTimes false; capGpuOn = triGpuTimes true; capPerfRes = triPerfReset 0; format ["view=%1;event=mode;mode=%2;lit=variant", capView, _this] call capLog }

triCaptureAtPresent true
triSetMsaa 4
triSetRenderScale 1.5
showCinemaBorder false
enableRadio false
player setCaptive true
player allowDamage false

createCenter west
createCenter east
capGrpW = createGroup west
capProbe = "HeliHEmpty" createVehicle [9200, 3700, 0]
capCam = "camera" camCreate [9200, 3700, 2]
capCam cameraEffect ["internal", "back"]
triSimFrames 240
call { "view=setup;event=setup;world=Eden;msaa=4;scale=1.5;window=960x640;capture=present;track=texsharp" call capLog }

// ---- overcast_broken
["overcast_broken", 9200, 3700, 1.75, 288, -4, [1985, 7, 5, 14, 30], 0.5, 0, 3500] call capBegin
call {
    [["Jeep"], 12, -5, 70, "veh"] call capSpawn;
}
call { ["texStreamFix=0", "texMipBias=0", "texLodBias=0", "texAniso=16", "texSharpen=0", "texK1=0", "texK2=0", "texK3=0", "texRemip=0", "texFlush=60"] call tsSet }
triSimFrames 150
"classic" call capMode
triSimFrames 90
[] call capReadTimers
[] call capPin
call { capK = triSetLighting "texStats=1" }
triSimFrames 3
triScreenshot "overcast_broken__classic"
"overcast_broken__classic" call capRecord
"remastered" call capMode
triSimFrames 90
[] call capReadTimers
[] call capPin
call { capK = triSetLighting "texStats=1" }
triSimFrames 3
triScreenshot "overcast_broken__remastered"
"overcast_broken__remastered" call capRecord
call { ["texStreamFix=0", "texMipBias=0", "texLodBias=0", "texAniso=16", "texSharpen=0", "texK1=0", "texK2=0", "texK3=0", "texRemip=0", "texRemip=1"] call tsSet; "rbox" call tsMode }
triSimFrames 120
[] call capReadTimers
[] call capPin
call { capK = triSetLighting "texStats=1" }
triSimFrames 3
triScreenshot "overcast_broken__rbox"
"overcast_broken__rbox" call capRecord
call { ["texStreamFix=0", "texMipBias=0", "texLodBias=0", "texAniso=16", "texSharpen=0", "texK1=0", "texK2=0", "texK3=0", "texRemip=0", "texRemip=2"] call tsSet; "rlz" call tsMode }
triSimFrames 120
[] call capReadTimers
[] call capPin
call { capK = triSetLighting "texStats=1" }
triSimFrames 3
triScreenshot "overcast_broken__rlz"
"overcast_broken__rlz" call capRecord
call { ["texStreamFix=0", "texMipBias=0", "texLodBias=0", "texAniso=16", "texSharpen=0", "texK1=0", "texK2=0", "texK3=0", "texRemip=0", "texRemip=3"] call tsSet; "rlzc" call tsMode }
triSimFrames 120
[] call capReadTimers
[] call capPin
call { capK = triSetLighting "texStats=1" }
triSimFrames 3
triScreenshot "overcast_broken__rlzc"
"overcast_broken__rlzc" call capRecord
call { ["texStreamFix=0", "texMipBias=0", "texLodBias=0", "texAniso=16", "texSharpen=0", "texK1=0", "texK2=0", "texK3=0", "texRemip=0", "texRemip=3", "texLodBias=-0.5"] call tsSet; "rlzcb" call tsMode }
triSimFrames 120
[] call capReadTimers
[] call capPin
call { capK = triSetLighting "texStats=1" }
triSimFrames 3
triScreenshot "overcast_broken__rlzcb"
"overcast_broken__rlzcb" call capRecord
call { ["texStreamFix=0", "texMipBias=0", "texLodBias=0", "texAniso=16", "texSharpen=0", "texK1=0", "texK2=0", "texK3=0", "texRemip=0"] call tsSet }
[] call capClear

call { "view=done;event=done" call capLog }
triEndTest
