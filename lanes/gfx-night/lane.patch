+// NIGHT PROTOTYPE: the frame's local lights for the post-pass haze. Empties the
+// list: a frame that draws no world must not reuse the previous frame's lights.
+int NightFrameLights(LightDescription* out, int max)
+{
+    const int n = s_frameLightCount < max ? s_frameLightCount : max;
+    for (int i = 0; i < n; i++)
