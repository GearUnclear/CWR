+// NIGHT RESEARCH PROTOTYPE: single scattering of the local lights (street
+// lamps, fires, headlights) in a thin night haze. Half resolution, written into
+// the shaft target and composited with the shaft path. For every light the
+// camera ray segment [0, surface] is integrated with equiangular samples
+// (Kulla and Fajardo 2012): t - tc = h tan(theta) turns 1/d^2 into a uniform
+// measure, so 5-10 samples give a smooth glow around a bulb and a beam through
+// the air for a spotlight. Phase: half isotropic, half Henyey-Greenstein, so
+// halos are brighter looking toward the light. Headlights use a low-beam
+// pattern (wide, sharp upper cutoff, hot spot just below the horizon line).
+static const char s_psPostNightHazeGLSL[] = R"(#version 330 core
+in vec2 vUV;
+uniform sampler2D depthTex;
+uniform vec4 projInfo;
+uniform vec4 depthMap;
+uniform vec4 worldRect;
+uniform vec4 hazeCtl;  // x light count, y scattering (1/m), z extinction (1/m), w HG g
+uniform vec4 hzUp;     // xyz world up in view space, w spot scatter gain
+uniform vec4 hzPos[16]; // view space xyz, w unused
+uniform vec4 hzCol[16]; // linear rgb * intensity, w 1 = spot
+uniform vec4 hzDir[16]; // view space beam direction
+out vec4 fragColor;
+
+float viewZ(vec2 uv) {
+    float d = texture(depthTex, uv).r;
+    return projInfo.y / ((d * depthMap.x + depthMap.y) - projInfo.x);
+}
+float hg(float c, float g) {
+    float g2 = g * g;
+    return (1.0 - g2) / (12.566371 * pow(max(1.0 + g2 - 2.0 * g * c, 1e-4), 1.5));
+}
+// Low beam: wide horizontally, sharp cut-off just above the horizon line, a
+// hot spot 1.5 degrees below it. Relative to the hot-spot intensity.
+float lowBeam(vec3 L, vec3 beam, vec3 up) {
+    float c = dot(L, beam);
+    if (c <= 0.0) return 0.0;
+    vec3 right = normalize(cross(up, beam));
+    vec3 u = cross(beam, right);
+    float ah = atan(dot(L, right), c);
+    float av = atan(dot(L, u), c);
+    float cut = 1.0 - smoothstep(-0.004, 0.015, av);
+    float hv = (av + 0.03) / 0.05;
+    float vert = exp(-hv * hv) + 0.02 * smoothstep(-0.6, -0.1, av);
+    float h1 = ah / 0.25;
+    float h2 = ah / 0.6;
+    float horiz = exp(-h1 * h1) + 0.15 * exp(-h2 * h2);
+    return vert * horiz * cut;
+}
+void main() {
+    vec2 ndc = (vUV - worldRect.xy) / worldRect.zw * 2.0 - 1.0;
+    vec3 rd = normalize(vec3(ndc.x * projInfo.z, ndc.y * projInfo.w, 1.0));
+    float d0 = texture(depthTex, vUV).r;
+    float tMax = 2000.0;
+    if (d0 < 0.999999) tMax = viewZ(vUV) / rd.z;
+    float jitter = fract(52.9829189 * fract(dot(gl_FragCoord.xy, vec2(0.06711056, 0.00583715))));
+    vec3 sum = vec3(0.0);
+    int n = int(hazeCtl.x);
+    float g = hazeCtl.w;
+    for (int i = 0; i < 16; ++i) {
+        if (i >= n) break;
+        vec3 p = hzPos[i].xyz;
+        float tc = dot(p, rd);
+        vec3 q = p - rd * tc;
+        float h = max(length(q), 0.2);
+        float thA = atan(-tc, h);
+        float thB = atan(tMax - tc, h);
+        if (thB <= thA + 1e-4) continue;
+        bool spot = hzCol[i].w > 0.5;
+        int N = spot ? 10 : 5;
+        float acc = 0.0;
+        for (int k = 0; k < 10; ++k) {
+            if (k >= N) break;
+            float th = mix(thA, thB, (float(k) + jitter) / float(N));
+            float t = tc + h * tan(th);
+            vec3 x = rd * t;
+            vec3 Lv = x - p;
+            float dist = max(length(Lv), 1e-3);
+            vec3 L = Lv / dist;
+            float cs = dot(L, -rd); // light travelling toward the camera = forward scattering
+            float phase = 0.5 * 0.0795775 + 0.5 * hg(cs, g);
+            float w = phase * exp(-hazeCtl.z * (t + dist));
+            if (spot) w *= lowBeam(L, hzDir[i].xyz, hzUp.xyz) * hzUp.w;
+            // A lamp's halo: moist air and insects close to the bulb, not a
+            // uniform fog (that turns the whole sky into a lamp-coloured wash).
+            else w *= hzPos[i].w * exp(-dist / 1.5);
+            acc += w;
+        }
+        sum += hzCol[i].rgb * (acc / float(N)) * (thB - thA) / h;
+    }
+    fragColor = vec4(sum * hazeCtl.y, 1.0);
+}
+)";
