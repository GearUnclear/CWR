+TileView MakeView(float headingDeg, float pitchDeg, const float vp[4] = nullptr)
+{
+    const float h = headingDeg * kPi / 180.0f, p = pitchDeg * kPi / 180.0f;
+    const Vec3 f{std::sin(h) * std::cos(p), std::sin(p), std::cos(h) * std::cos(p)};
