+void EngineGL33::UpdateLightTiles()
+{
+    LightTileState& t = _lightTiles;
+    const std::uint32_t frame = GetFrameCounter();
+    if (t.frame == frame || !t.dataBuf || !t.tileTex)
+        return;
+    t.frame = frame;
+    const auto start = std::chrono::steady_clock::now();
