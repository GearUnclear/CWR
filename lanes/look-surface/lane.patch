+    o.sky = pref * fEnv * (skyVis * roughSky);
+    // The diffuse gives up only the energy the reflection actually shows.
+    o.diffuse = (1.0 - dot(fEnv, kLuma) * roughSky) * (1.0 - metal);
+    float s = litSurface.y * litHorizon.w;
+    o.sun *= s;
+    o.sky *= s;
+    return o;
+}
