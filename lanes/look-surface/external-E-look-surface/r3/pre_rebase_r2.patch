+    // relief as much as the sky, and the sky fill already carries its
+    // diffuse-looking part: 0.15 of the sky reflection from roughness 0.5 on
+    // (matt paint, rubber, cloth, soil), so they keep their colour instead of
+    // a grey veil. Grazing views catch some more of it at an edge (a hull's
+    // silhouette, a wall seen along its face), up to 0.45; the land none (the
+    // haze carries the far ground's sheen).
+    float matt = smoothstep(0.25, 0.5, rough) * (1.0 - metal);
+    float roughSky = mix(1.0, 0.15, matt);
+    float edgeSky = terrain ? roughSky : mix(1.0, 0.45, matt);
+    roughSky = mix(roughSky, edgeSky, pow(1.0 - nv, 5.0));
+    o.sky = pref * fEnv * (skyVis * roughSky);
+    // The diffuse gives up only the energy the reflection actually shows.
+    o.diffuse = (1.0 - dot(fEnv, kLuma) * roughSky) * (1.0 - metal);
+    float s = litSurface.y * litHorizon.w;
+    o.sun *= s;
+    o.sky *= s;
+    return o;
+}
