// "classic" | "remastered" | "combat" call capMode3
capMode3 = {
    if (_this == "combat_ns") then {
        capLitC = triSetLighting "combatLights=1";
        capLitS = triSetLighting "combatScatter=0";
        "remastered" call capMode;
        capModeName = "combat_ns";
    };
    if (_this == "combat") then {
        capLitS = triSetLighting "combatScatter=1";
        capLitC = triSetLighting "combatLights=1";
        "remastered" call capMode;
        capModeName = "combat";
    };
    if ((_this == "classic") or (_this == "remastered")) then {
        capLitC = triSetLighting "combatLights=0";
        _this call capMode;
    };
    format ["view=%1;event=mode3;mode=%2;combat=%3", capView, capModeName, capLitC] call capLog;
}
// [units] call capVolley: everyone in the list fires his primary weapon now.
capVolley = { { _x fire (primaryWeapon _x) } forEach _this }
capEngageN = {
    private ["_i"];
    if (((count capFW) > 0) and ((count capFE) > 0)) then {
        { (capFW select 0) reveal _x } forEach capFE;
        { (capFE select 0) reveal _x } forEach capFW;
        _i = 0;
        { _x doFire (capFE select (_i mod (count capFE))); _i = _i + 1 } forEach capFW;
        _i = 0;
        { _x doFire (capFW select (_i mod (count capFW))); _i = _i + 1 } forEach capFE;
    };
}
capBoom = {
    private ["_p"];
    _p = _this call capRel;
    capShell = createShell ["Shell120", [_p select 0, _p select 1, 40], [0, 0, -250], player, objNull];
}
capBurn = { if (not (isNull capBurnV)) then { capBurnV inflame true } }
capClearAll = {
    [] call capClear;
    capFW = [];
    capFE = [];
}

