+#include <Poseidon/Graphics/Remaster/LightRig.hpp>
+#include <Poseidon/Graphics/Remaster/NightLights.hpp>
+#include <Poseidon/Graphics/Remaster/SunShadows.hpp>
+#include <PoseidonGL33/EngineGL33_Lighting.hpp>
