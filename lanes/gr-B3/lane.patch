+#include <catch2/catch_test_macros.hpp>
+#include <catch2/catch_approx.hpp>
+#include <Poseidon/Graphics/Rendering/Lighting/FrameLights.hpp>
+#include <Poseidon/Graphics/Remaster/FeatureGates.hpp>
