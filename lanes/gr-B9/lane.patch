+TEST_CASE("Canopy: removing a destroyed object gives the canopy built without it, at every level", "[remaster][Canopy]")
+{
+    const std::vector<CanopyItem> all = {Crown(7, TexelCentre(30), TexelCentre(30), 4.0f, 14.0f, 0.8f),
