// RESEARCH (spawned-vehicles bug fix): capture test generated by gen_sv_tests.py.
// Not committed (tests/rendering/research is git-excluded).
#include "capture_lib.sqf"

triSimUntil { alive player }

capWorld = "Abel"
capFov = 0.7
capSimT = 0
capPinTime = false
capUseView = false
capProps = []
capView = "setup"
capModeName = "none"
capLit = "none"
capGpu = "none"
capPerf = "none"
capFire = objNull

triCaptureAtPresent true
triSetMsaa 4
triSetRenderScale 1.5
showCinemaBorder false
enableRadio false
player setCaptive true
player allowDamage false

createCenter west
createCenter east
capGrpW = createGroup west
capProbe = "HeliHEmpty" createVehicle [7300, 10900, 0]
capCam = "camera" camCreate [7300, 10900, 2]
capCam cameraEffect ["internal", "back"]
capReFire = { if (not (isNull capFire)) then { capFire inflame true } }

triSimFrames 240
call { "view=setup;event=setup;world=Abel" call capLog }
["lowsun_fp", 7300, 10900, 1.75, 152.5, -3, [1985, 3, 1, 8, 0], 0, 0, 1500] call capBegin
call {
    [["Jeep"], 10, -5, -107.5, "veh"] call capSpawn;
    [["M113"], 16, 5, 72.5, "veh"] call capSpawn;
    [["SoldierWB"], 7, 1, -112.5, "man"] call capSpawn;
    [["LoBo_camnet", "CampEast", "Camp"], 22, -3, -152.5, "veh"] call capSpawn;
}
triSimFrames 150
"classic" call capMode
triSimFrames 90
[] call capReadTimers
[] call capPin
[] call capReFire
triSimFrames 3
triScreenshot "lowsun_fp__classic"
"lowsun_fp__classic" call capRecord
"remastered" call capMode
triSimFrames 90
[] call capReadTimers
[] call capPin
[] call capReFire
triSimFrames 3
triScreenshot "lowsun_fp__remastered"
"lowsun_fp__remastered" call capRecord
call { capDbgA = triSetLighting "debug=3"; capDbgB = triSetLighting "post=0" }
triSimFrames 30
[] call capPin
[] call capReFire
triSimFrames 3
triScreenshot "lowsun_fp__debug"
"lowsun_fp__debug" call capRecord
call { capDbgA = triSetLighting "debug=0"; capDbgB = triSetLighting "post=1" }
[] call capClear
call { capFire = objNull }

