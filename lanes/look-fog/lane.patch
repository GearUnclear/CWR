+    m = ComputeAirMedium(ClearNoon(), AirParts{}, -1.0f);
+    CHECK(m.hazeSigma == 0.0f);
+    CHECK(m.valleyMist == 0.0f);
+    CHECK(m.beamMist == 0.0f);
+    CHECK(m.fogEdgeScale == 1.0f);
+}
