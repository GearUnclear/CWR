+          Pin{"kBeamFloorEnd", lt::kLowBeamFloorEnd, 1}, Pin{"kBeamFloorStart", lt::kLowBeamFloorStart, 1},
+          Pin{"kBeamCoreWidth", lt::kLowBeamCoreWidth, 2}, Pin{"kBeamSpill", lt::kLowBeamSpill, 2},
