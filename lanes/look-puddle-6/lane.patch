+bool FogSightMap::Valid() const
+{
+    const size_t n = static_cast<size_t>(std::max(size, 0)) * static_cast<size_t>(std::max(size, 0));
+    return size > 1 && cellSize > 0.0f && ground.size() == n && floorY.size() == n && layer.size() == n;
+}
