+    // Out-of-range knob values clamp to the ends; every grid writes whole
+    // eight-slice draws.
+    CHECK(FogGridFor(1920, 1080, 7.0f).slices == 96);
+    CHECK(FogGridFor(1920, 1080, -3.0f).slices == 48);
+    for (float q : {0.0f, 1.0f, 2.0f})
