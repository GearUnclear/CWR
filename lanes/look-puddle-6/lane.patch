+    const size_t lum = meter.find("float l = log2(", use);
+    CHECK(lum != std::string::npos);
+    for (const char* u :
+         {"uniform vec4 meterSky;", "uniform vec4 meterSun;", "uniform vec4 meterProj;", "uniform vec4 meterRect;"})
+    {
+        CAPTURE(u);
+        CHECK(meter.find(u) != std::string::npos);
+    }
+}
