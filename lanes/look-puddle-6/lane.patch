+    float cut = 1.0 - smoothstep(kAirBeamCutLow, kAirBeamCutHigh, av);
+    float hv = (av - kAirBeamHotBand) / kAirBeamHotWidth;
+    float vert = exp(-hv * hv) + kAirBeamFloor * smoothstep(kAirBeamFloorEnd, kAirBeamFloorStart, av);
