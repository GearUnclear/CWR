+// (Look fix round 5 "mist": 0.6 -> 0.2 by day; the mist layer in the
+// hollows before the rock thickened the light mist again.)
+constexpr float kMistFogWeight = 0.2f;
+constexpr float kMistFogWeightNight = 1.2f;
