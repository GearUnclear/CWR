+    CHECK(deck.hazeNearKeep == Catch::Approx(kHazeNearKeepGrey));
+    // A desert: dust, laid by rain.
+    FogInputs desert = clear;
+    desert.aridity = 1.0f;
+    const FogMedium dry = ComputeFogMedium(desert, t, true);
+    CHECK(dry.dustSigma == Catch::Approx(kDustHaze));
+    desert.rain = 1.0f;
