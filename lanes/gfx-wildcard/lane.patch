+GLuint s_skyReadFbo = 0;
+GLuint s_skyDrawFbo = 0;
+bool RenderSkyMaps(const float* vps, const float* dirs, const bool* update, int k, int res, bool haveSolid,
+                   int solidVertCount, bool haveAlpha, const ResolvedAlphaBatch* batches, int batchCount,
+                   const float* solidAlbedo, bool albedo, bool frontFaces)
+{
+    if (k < 1 || res <= 0 || (!haveSolid && !haveAlpha))
+        return false;
