+        if (haveSolid)
+        {
+            // Front faces (default): what the sky itself sees, so the inside
+            // of a building or hull never mixes into a footprint's depth and a
+            // receiver on a surface (offset along its normal) is in front of
+            // its own stored depth. Back faces (skyFaces=0) as the cascades.
+            if (frontFaces)
