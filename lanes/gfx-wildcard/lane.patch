+// ---------------------------------------------------------------------------
+// wildcard research prototype: SKY VISIBILITY MAPS.
+// K orthographic occluder maps around the camera, one per direction spread
+// evenly (equal solid angle) over the sky hemisphere, rendered every frame
+// from the same caster set as the sun cascades (opaque shapes plus alpha-cut
+// foliage). A texel stores the nearest occluder toward the sky as
+// coverage-weighted depth moments (c, c*z, c*z^2) with z = -dot(pos, dir) in
+// metres, and the caster colour with coverage in alpha. Mip levels then hold the
+// occluded fraction, the depth distribution and the mean colour of any
+// footprint, so the lit shader cone-traces each direction with two filtered
+// fetches (blocker search, then a footprint sized to the cone at the blocker
+// distance): soft, contact-hardening sky occlusion plus a one-bounce estimate.
+// ---------------------------------------------------------------------------
+constexpr int kSkyMaxDirs = 24;
+constexpr unsigned int kSkyBinding = 4; // UBO binding (VS 0, PS 1, instances 2, lit 3)
+constexpr int kSkyMomentsUnit = 6;
+constexpr int kSkyAlbedoUnit = 8;
+GLuint s_skyFbo = 0;
+GLuint s_skyTex = 0;
+GLuint s_skyAlbTex = 0;
+GLuint s_skyDepthRb = 0;
+GLuint s_skyDummyMom = 0;
+GLuint s_skyDummyAlb = 0;
+int s_skyRes = 0;
+int s_skyLayers = 0;
+int s_skyLevels = 1;
+GLuint s_skyProg = 0;
+GLint s_skyLocVP = -1, s_skyLocDir = -1, s_skyLocAlb = -1;
+GLuint s_skyAlphaProg = 0;
+GLint s_skyAlphaLocVP = -1, s_skyAlphaLocDir = -1, s_skyAlphaLocTex = -1;
+GLuint s_skyUBO = 0;
+struct SkyBlock
+{
+    float vp[kSkyMaxDirs * 16];
+    float dir[kSkyMaxDirs * 4];
+    float off[kSkyMaxDirs * 4]; // this pass's camera minus the camera the layer was drawn from
+    float ctl[4];  // x count, y occlusion strength, z texel (m, level 0), w bounce scale
+    float ctl2[4]; // x bleed cut, y cone tan, z min variance (m^2), w map half width (m)
+    float ctl3[4]; // x debug, y crown keep, z albedo from maps, w mip levels
+    float ctl4[4]; // x leaf transmission, y crown shell offset scale, z visibility floor, w leaf tint
+    float ctl5[4]; // x sky gain while the maps are on
+};
+SkyBlock s_sky = {};
+bool s_skyRendered = false;
+bool s_skyEverRendered = false;
+
+const char* kSkyVS = R"(#version 330 core
+layout(location = 0) in vec3 pos;
+uniform mat4 uLightVP;
+uniform vec4 uDir;
+out float vZ;
+void main() { gl_Position = uLightVP * vec4(pos, 1.0); vZ = -dot(pos, uDir.xyz); }
+)";
+
+const char* kSkyFS = R"(#version 330 core
+in float vZ;
+uniform vec4 uAlbedo;
+layout(location = 0) out vec4 oMom;
+layout(location = 1) out vec4 oAlb;
+void main() {
+    float dx = dFdx(vZ), dy = dFdy(vZ);
+    oMom = vec4(1.0, vZ, vZ * vZ + 0.25 * (dx * dx + dy * dy), 0.0);
+    oAlb = vec4(uAlbedo.rgb, 1.0);
+}
+)";
+
+const char* kSkyAlphaVS = R"(#version 330 core
+layout(location = 0) in vec3 pos;
+layout(location = 1) in vec2 uv;
+uniform mat4 uLightVP;
+uniform vec4 uDir;
+out float vZ;
+out vec2 vUV;
+void main() { vUV = uv; gl_Position = uLightVP * vec4(pos, 1.0); vZ = -dot(pos, uDir.xyz); }
+)";
+
+const char* kSkyAlphaFS = R"(#version 330 core
+in float vZ;
+in vec2 vUV;
+uniform sampler2D uTex;
+layout(location = 0) out vec4 oMom;
+layout(location = 1) out vec4 oAlb;
+void main() {
+    float dx = dFdx(vZ), dy = dFdy(vZ);
+    vec4 t = texture(uTex, vUV);
+    if (t.a < 0.5) discard;
+    // w = 1: an alpha-cut (foliage) caster, which lets part of the sky through.
+    oMom = vec4(1.0, vZ, vZ * vZ + 0.25 * (dx * dx + dy * dy), 1.0);
+    oAlb = vec4(t.rgb, 1.0);
+}
+)";
+
+GLuint LinkSky(const char* vsSrc, const char* fsSrc)
+{
+    GLuint vs = CompileOne(GL_VERTEX_SHADER, vsSrc);
+    GLuint fs = CompileOne(GL_FRAGMENT_SHADER, fsSrc);
+    if (!vs || !fs)
+        return 0;
+    GLuint prog = glCreateProgram();
+    glAttachShader(prog, vs);
+    glAttachShader(prog, fs);
+    glLinkProgram(prog);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    GLint ok = 0;
+    glGetProgramiv(prog, GL_LINK_STATUS, &ok);
+    if (!ok)
+    {
+        char log[512];
+        glGetProgramInfoLog(prog, sizeof(log), nullptr, log);
+        LOG_ERROR(Graphics, "wildcard sky maps: link failed: {}", log);
+        glDeleteProgram(prog);
+        return 0;
+    }
+    return prog;
+}
+
+bool EnsureSkyPrograms()
+{
+    if (s_skyProg && s_skyAlphaProg)
+        return true;
+    if (!s_skyProg)
+    {
+        s_skyProg = LinkSky(kSkyVS, kSkyFS);
+        if (s_skyProg)
+        {
+            s_skyLocVP = glGetUniformLocation(s_skyProg, "uLightVP");
+            s_skyLocDir = glGetUniformLocation(s_skyProg, "uDir");
+            s_skyLocAlb = glGetUniformLocation(s_skyProg, "uAlbedo");
+        }
+    }
+    if (!s_skyAlphaProg)
+    {
+        s_skyAlphaProg = LinkSky(kSkyAlphaVS, kSkyAlphaFS);
+        if (s_skyAlphaProg)
+        {
+            s_skyAlphaLocVP = glGetUniformLocation(s_skyAlphaProg, "uLightVP");
+            s_skyAlphaLocDir = glGetUniformLocation(s_skyAlphaProg, "uDir");
+            s_skyAlphaLocTex = glGetUniformLocation(s_skyAlphaProg, "uTex");
+        }
+    }
+    return s_skyProg && s_skyAlphaProg;
+}
+
+GLuint MakeSkyArray(GLenum internalFormat, GLenum type, int res, int layers, int levels)
+{
+    GLuint t = 0;
+    glGenTextures(1, &t);
+    glBindTexture(GL_TEXTURE_2D_ARRAY, t);
+    for (int l = 0; l < levels; ++l)
+    {
+        const int s = (res >> l) > 0 ? (res >> l) : 1;
+        glTexImage3D(GL_TEXTURE_2D_ARRAY, l, internalFormat, s, s, layers, 0, GL_RGBA, type, nullptr);
+    }
+    glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_BASE_LEVEL, 0);
+    glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_MAX_LEVEL, levels - 1);
+    return t;
+}
+
+bool EnsureSkyTarget(int res, int layers)
+{
+    if (s_skyFbo && s_skyRes == res && s_skyLayers == layers)
+        return true;
+    if (s_skyTex)
+        glDeleteTextures(1, &s_skyTex);
+    if (s_skyAlbTex)
+        glDeleteTextures(1, &s_skyAlbTex);
+    if (s_skyDepthRb)
+        glDeleteRenderbuffers(1, &s_skyDepthRb);
+    if (s_skyFbo)
+        glDeleteFramebuffers(1, &s_skyFbo);
+    s_skyTex = s_skyAlbTex = s_skyDepthRb = s_skyFbo = 0;
+
+    int levels = 1;
+    while ((res >> levels) > 0)
+        levels++;
+    GL33Bind::ActiveUnit(kSkyMomentsUnit);
+    s_skyTex = MakeSkyArray(GL_RGBA32F, GL_FLOAT, res, layers, levels);
+    s_skyAlbTex = MakeSkyArray(GL_RGBA8, GL_UNSIGNED_BYTE, res, layers, levels);
+    glGenRenderbuffers(1, &s_skyDepthRb);
+    glBindRenderbuffer(GL_RENDERBUFFER, s_skyDepthRb);
+    glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH_COMPONENT24, res, res);
+    glGenFramebuffers(1, &s_skyFbo);
+    glBindFramebuffer(GL_FRAMEBUFFER, s_skyFbo);
+    glFramebufferTextureLayer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, s_skyTex, 0, 0);
+    glFramebufferTextureLayer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT1, s_skyAlbTex, 0, 0);
+    glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, s_skyDepthRb);
+    const GLenum bufs[2] = {GL_COLOR_ATTACHMENT0, GL_COLOR_ATTACHMENT1};
+    glDrawBuffers(2, bufs);
+    const GLenum status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    GL33Bind::Invalidate();
+    if (status != GL_FRAMEBUFFER_COMPLETE)
+    {
+        LOG_ERROR(Graphics, "wildcard sky maps: FBO incomplete: {}", static_cast<unsigned>(status));
+        return false;
+    }
+    s_skyRes = res;
+    s_skyLayers = layers;
+    s_skyLevels = levels;
+    LOG_INFO(Graphics, "wildcard sky maps: {} directions at {}x{} ({} mips)", layers, res, res, levels);
+    return true;
+}
+
+void EnsureSkyUbo()
+{
+    if (s_skyUBO)
+        return;
+    glGenBuffers(1, &s_skyUBO);
+    glBindBuffer(GL_UNIFORM_BUFFER, s_skyUBO);
+    glBufferData(GL_UNIFORM_BUFFER, sizeof(SkyBlock), nullptr, GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_UNIFORM_BUFFER, kSkyBinding, s_skyUBO);
+}
+
+// Equal-solid-angle directions over the sky above `minSinEl`, golden-angle spiral.
+void SkyDirections(int k, float* out4)
+{
+    const float minSin = 0.104f; // 6 degrees: below it the terrain horizon map rules
+    for (int i = 0; i < k; ++i)
+    {
+        const float s = minSin + (1.0f - minSin) * (static_cast<float>(i) + 0.5f) / static_cast<float>(k);
+        const float c = std::sqrt(std::max(0.0f, 1.0f - s * s));
+        const float phi = 2.39996323f * static_cast<float>(i) + 0.4f;
+        out4[i * 4 + 0] = c * std::sin(phi);
+        out4[i * 4 + 1] = s;
+        out4[i * 4 + 2] = c * std::cos(phi);
+        out4[i * 4 + 3] = 1.0f; // equal solid angle
+    }
+}
