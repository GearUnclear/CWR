+    GLint prevVP[4] = {0, 0, 0, 0};
+    glGetIntegerv(GL_FRAMEBUFFER_BINDING, &prevFBO);
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &prevRead);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &prevDraw);
+    glGetIntegerv(GL_CURRENT_PROGRAM, &prevProg);
+    glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &prevVAO);
+    glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &prevArrayBuf);
+    glGetIntegerv(GL_VIEWPORT, prevVP);
+    GLboolean prevMask[4] = {GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE};
+    glGetBooleanv(GL_COLOR_WRITEMASK, prevMask);
+    const GLboolean prevBlend = glIsEnabled(GL_BLEND);
+    const GLboolean prevScissor = glIsEnabled(GL_SCISSOR_TEST);
+    const GLboolean prevA2C = glIsEnabled(GL_SAMPLE_ALPHA_TO_COVERAGE);
+    auto restore = [&]()
+    {
+        glBindFramebuffer(GL_FRAMEBUFFER, static_cast<GLuint>(prevFBO));
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(prevRead));
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, static_cast<GLuint>(prevDraw));
+        glViewport(prevVP[0], prevVP[1], prevVP[2], prevVP[3]);
+        glUseProgram(static_cast<GLuint>(prevProg));
+        glBindBuffer(GL_ARRAY_BUFFER, static_cast<GLuint>(prevArrayBuf));
+        GL33Bind::Vao(static_cast<GLuint>(prevVAO));
+        glColorMask(prevMask[0], prevMask[1], prevMask[2], prevMask[3]);
+        if (prevBlend)
