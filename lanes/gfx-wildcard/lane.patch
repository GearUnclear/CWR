+// wildcard research: the lit pass reads the sky maps through the SkyVis block
+// (binding 4) and units 6 (moments) and 8 (colour). Called every lit pass.
+void WildcardSkyUpload(bool active, const Poseidon::remaster::LightingTuning& t)
+{
+    EnsureSkyUbo();
+    const bool on = active && s_skyRendered && t.skyOcc > 0.0f && s_skyTex;
+    s_sky.ctl[0] = on ? static_cast<float>(s_skyLayers) : 0.0f;
+    s_sky.ctl[1] = t.skyOcc;
+    s_sky.ctl[3] = t.skyBounce;
+    s_sky.ctl2[0] = std::min(std::max(t.skyBleed, 0.0f), 0.95f);
