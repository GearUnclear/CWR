+    for (int i = 0; i < k; ++i)
+    {
+        if (!update[i])
+            continue;
+        glFramebufferTextureLayer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, s_skyTex, 0, i);
+        glFramebufferTextureLayer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT1, s_skyAlbTex, 0, i);
+        glClearBufferfv(GL_COLOR, 0, zero);
