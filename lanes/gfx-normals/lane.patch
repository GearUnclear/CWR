+void ResearchLateOptimize(LODShape* shape)
+{
+    if (!shape || !g_researchLateTried.insert(shape).second)
+        return;
+    // Sky dome, sun/moon and halo, clouds, stars: special light modes and no
+    // fog. They were never vertex-buffered (loaded after the landscape's
+    // OptimizeAll) and the T&L path does not light them (the sun disc vanished).
+    if ((shape->GetOrHints() & (ClipLightMask | ClipFogMask)) != 0)
+    {
+        LOG_INFO(Graphics, "RESEARCH late VB: {} skipped (special light/fog hints 0x{:X})", (const char*)shape->Name(),
+                 (unsigned)(shape->GetOrHints() & (ClipLightMask | ClipFogMask)));
+        return;
+    }
+    int before[64] = {};
+    const int n = shape->NLevels() < 64 ? shape->NLevels() : 64;
+    for (int l = 0; l < n; l++)
+        before[l] = shape->Level(l) && shape->Level(l)->GetVertexBuffer() ? 1 : 0;
+    shape->OptimizeRendering();
+    int added = 0;
+    for (int l = 0; l < n; l++)
+    {
+        Shape* level = shape->Level(l);
+        if (level && !before[l] && level->GetVertexBuffer())
+        {
+            g_researchLateVB.insert(level);
+            added++;
+        }
+    }
+    LOG_INFO(Graphics, "RESEARCH late VB: {} ({} of {} levels)", (const char*)shape->Name(), added, shape->NLevels());
+}
+
+// Round 5: the drawn level itself, whatever its resolution (the tank's gunner
+// view LOD has resolution 1200, which OptimizeRendering skips as a "view"
+// level), gets a buffer when it is an ordinary lit mesh. No pointer memory, so
+// a shape freed and reloaded at the same address (a vehicle deleted and
+// spawned again) is handled too.
+void ResearchEnsureVB(LODShape* shape, int level)
+{
+    Shape* s = shape ? shape->LevelOpaque(level) : nullptr;
+    if (!s || s->GetVertexBuffer() || s->NVertex() <= 0 || s->NFaces() <= 0)
+        return;
+    if ((shape->GetOrHints() & (ClipLightMask | ClipFogMask)) != 0)
+        return;
+    if (s->Special() & (IsLight | OnSurface))
+        return;
+    const RStringB tentString("tent");
+    VBType type = shape->GetAllowAnimation() ? VBDynamic : VBStatic;
+    if (shape->GetPropertyDammage() == tentString)
+        type = VBDynamic;
+    s->ConvertToVBuffer(type);
+    if (s->GetVertexBuffer())
+    {
+        g_researchLateVB.insert(s);
+        LOG_INFO(Graphics, "RESEARCH ensure VB: {} level {} res {:.0f}", (const char*)shape->Name(), level,
+                 shape->Resolution(level));
+    }
+}
+
+// Why a drawn level still has no vertex buffer (once per shape and level).
+void ResearchReportNoVB(LODShape* shape, int level)
+{
+    static std::unordered_set<const Shape*> reported;
+    Shape* s = shape ? shape->LevelOpaque(level) : nullptr;
+    if (!s || !reported.insert(s).second)
+        return;
+    LOG_INFO(Graphics,
+             "RESEARCH no VB at draw: {} level {} (opaque {}) res {:.3f} nV {} nF {} special 0x{:X} anim {} orHints 0x{:X} "
+             "levelPtrMatches {}",
+             (const char*)shape->Name(), level, (const void*)s, shape->Resolution(level), s->NVertex(), s->NFaces(),
+             (unsigned)s->Special(), shape->GetAllowAnimation() ? 1 : 0, (unsigned)shape->GetOrHints(),
+             shape->Level(level) == s ? 1 : 0);
+}
+
+bool ResearchIsLateVB(const Shape* level)
+{
+    return !g_researchLateVB.empty() && g_researchLateVB.count(level) != 0;
+}
