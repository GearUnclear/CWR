+// RESEARCH (normals track, prototype): load-time "normal maps" derived from the
+// existing albedo textures. No new art: every time a texture's mips are
+// uploaded, its top level is read back (the driver decodes DXT), a slope map is
+// filtered from its luminance on the CPU and uploaded as an RG16F companion
+// texture with mips. The remastered fragment shaders sample it on unit 6
+// (tex0Normal) through a tangent frame built from screen derivatives, so no
+// mesh tangents are needed. GL33Bind::Tex2D(0, tex) binds tex's companion on
+// unit 6 (or a flat 1x1 map).
+//
+// Filter (per texel, wrap addressing, per BASE texel units):
+//   height = display luminance; three scales (Gaussian sigma 0.7 / 1.4 / 2.8,
+//   central differences over 1 / 2 / 4 texels), weights 1 / 1.5 / 2;
+//   Retinex gate per scale: a luminance step that comes with a chromaticity
+//   step is paint (reflectance), not relief, and is dropped;
+//   transparent texels (alpha < 0.5 in the blurred alpha) carry no slope.
+// CWR_RESEARCH_NORMALS=0 turns generation off (flat map everywhere).
+// Round 3: wrapped index tables in the blur, sky shapes skipped by the late-VB
+// hack, late VBs toggled at runtime (saturation >= 99.5 = off).
+// Round 4: the companion is RGBA16F; b holds a gated high-pass height.
+
+#include <PoseidonGL33/GL33BindCache.hpp>
+#include <PoseidonGL33/EngineGL33.hpp>
+#include <Poseidon/Foundation/Framework/Log.hpp>
+
+#include <glad/gl.h>
+
+#include <chrono>
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <vector>
+
+namespace Poseidon::research
+{
+namespace
+{
+bool Enabled()
+{
+    static const bool on = []
+    {
+        const char* e = std::getenv("CWR_RESEARCH_NORMALS");
+        return !(e && e[0] == '0');
+    }();
+    return on;
+}
+
+int g_count = 0;
+double g_ms = 0.0;
+
+void Blur(const std::vector<float>& src, std::vector<float>& dst, int w, int h, float sigma)
+{
+    const int r = static_cast<int>(std::ceil(sigma * 2.5f));
+    std::vector<float> k(2 * r + 1);
+    float sum = 0.0f;
+    for (int i = -r; i <= r; i++)
+    {
+        k[i + r] = std::exp(-0.5f * i * i / (sigma * sigma));
+        sum += k[i + r];
+    }
+    for (float& v : k)
+        v /= sum;
+    // Wrapped index tables (no modulo in the inner loops).
+    std::vector<int> wx(w + 2 * r), wy(h + 2 * r);
+    for (int i = 0; i < w + 2 * r; i++)
+        wx[i] = ((i - r) % w + w) % w;
+    for (int i = 0; i < h + 2 * r; i++)
+        wy[i] = (((i - r) % h + h) % h) * w;
+    std::vector<float> tmp(src.size());
+    for (int y = 0; y < h; y++)
+    {
+        const float* row = &src[static_cast<size_t>(y) * w];
+        for (int x = 0; x < w; x++)
+        {
+            float a = 0.0f;
+            const int* ix = &wx[x];
+            for (int i = 0; i <= 2 * r; i++)
+                a += k[i] * row[ix[i]];
+            tmp[static_cast<size_t>(y) * w + x] = a;
+        }
+    }
+    dst.resize(src.size());
+    for (int y = 0; y < h; y++)
+    {
+        const int* iy = &wy[y];
+        for (int x = 0; x < w; x++)
+        {
+            float a = 0.0f;
+            for (int i = 0; i <= 2 * r; i++)
+                a += k[i] * tmp[iy[i] + x];
+            dst[static_cast<size_t>(y) * w + x] = a;
+        }
+    }
+}
+} // namespace
+
+unsigned FlatCompanion()
+{
+    static unsigned flat = 0;
+    if (!flat)
+    {
+        glGenTextures(1, &flat);
+        GL33Bind::Tex2D(EngineGL33::kUploadUnit - GL_TEXTURE0, flat);
+        const float zero[2] = {0.0f, 0.0f};
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RG16F, 1, 1, 0, GL_RG, GL_FLOAT, zero);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, 0);
+        GL33Bind::SetFlatCompanion(flat);
+    }
+    return flat;
+}
+
+void DeleteNormalCompanion(unsigned tex)
+{
+    const unsigned c = GL33Bind::GetCompanion(tex);
+    if (!c)
+        return;
+    GL33Bind::SetCompanion(tex, 0);
+    GL33Bind::OnTexDeleted(c);
+    glDeleteTextures(1, &c);
+}
+
+// Called with `tex` bound on the upload unit, right after its mips were
+// uploaded; w x h is its level 0.
+void GenerateNormalCompanion(unsigned tex, int w, int h, const char* name)
+{
+    FlatCompanion();
+    DeleteNormalCompanion(tex);
+    if (!Enabled() || w < 8 || h < 8 || w > 2048 || h > 2048)
+        return;
+    const auto t0 = std::chrono::steady_clock::now();
+    GLint fmt = 0;
+    glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_INTERNAL_FORMAT, &fmt);
+    std::vector<unsigned char> rgba(static_cast<size_t>(w) * h * 4);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glGetTexImage(GL_TEXTURE_2D, 0, GL_RGBA, GL_UNSIGNED_BYTE, rgba.data());
+    if (glGetError() != GL_NO_ERROR)
+        return;
+    const bool rg = fmt == GL_RG8; // PacAI88: r = intensity, g = alpha
+    const int n = w * h;
+    std::vector<float> L(n), cr(n), cg(n), A(n);
+    for (int i = 0; i < n; i++)
+    {
+        float r = rgba[i * 4 + 0] / 255.0f, g = rgba[i * 4 + 1] / 255.0f, b = rgba[i * 4 + 2] / 255.0f;
+        float a = rgba[i * 4 + 3] / 255.0f;
+        if (rg)
+        {
+            a = g;
+            g = r;
+            b = r;
+        }
+        const float s = r + g + b + 1e-3f;
+        L[i] = 0.2126f * r + 0.7152f * g + 0.0722f * b;
+        cr[i] = r / s;
+        cg[i] = g / s;
+        A[i] = a;
+    }
+    std::vector<float> out(static_cast<size_t>(n) * 4, 0.0f);
+    std::vector<float> gate0(n, 0.0f), L0;
+    const float sigmas[3] = {0.7f, 1.4f, 2.8f};
+    const int dists[3] = {1, 2, 4};
+    const float weights[3] = {1.0f, 1.5f, 2.0f};
+    std::vector<float> Ls, Rs, Gs, As;
+    double gateSum = 0.0, gradSum = 0.0;
+    for (int s = 0; s < 3; s++)
+    {
+        if (dists[s] * 4 > w || dists[s] * 4 > h)
+            break;
+        Blur(L, Ls, w, h, sigmas[s]);
+        Blur(cr, Rs, w, h, sigmas[s]);
+        Blur(cg, Gs, w, h, sigmas[s]);
+        Blur(A, As, w, h, sigmas[s]);
+        if (s == 0)
+            L0 = Ls;
+        const int d = dists[s];
+        for (int y = 0; y < h; y++)
+        {
+            const int ym = ((y - d) % h + h) % h, yp = (y + d) % h;
+            for (int x = 0; x < w; x++)
+            {
+                const int i = y * w + x;
+                if (As[i] < 0.98f)
+                    continue;
+                const int xm = ((x - d) % w + w) % w, xp = (x + d) % w;
+                const float inv = 1.0f / (2.0f * d);
+                const float gx = (Ls[y * w + xp] - Ls[y * w + xm]) * inv;
+                const float gy = (Ls[yp * w + x] - Ls[ym * w + x]) * inv;
+                const float crx = (Rs[y * w + xp] - Rs[y * w + xm]) * inv, cry = (Rs[yp * w + x] - Rs[ym * w + x]) * inv;
+                const float cgx = (Gs[y * w + xp] - Gs[y * w + xm]) * inv, cgy = (Gs[yp * w + x] - Gs[ym * w + x]) * inv;
+                const float shade = std::sqrt(gx * gx + gy * gy) / (Ls[i] + 0.04f);
+                const float chroma = 3.0f * std::sqrt(crx * crx + cry * cry + cgx * cgx + cgy * cgy);
+                const float gate = shade * shade / (shade * shade + 4.0f * chroma * chroma + 1e-9f);
+                out[i * 4 + 0] += weights[s] * gate * gx;
+                out[i * 4 + 1] += weights[s] * gate * gy;
+                if (s == 0)
+                {
+                    gate0[i] = gate;
+                    gateSum += gate;
+                    gradSum += std::sqrt(gx * gx + gy * gy);
+                }
+            }
+        }
+    }
+    // Round 4: b = height for the micro shadows and cavity occlusion, the
+    // fine luminance (sigma 0.7) minus a broad one (sigma 6, or the mean on
+    // small textures), times the smoothed relief gate, so a paint field (a
+    // star, a number, a camouflage blob) does not stand up as a plateau.
+    if (!L0.empty())
+    {
+        std::vector<float> Lbig, Gs0;
+        if (w >= 32 && h >= 32)
+            Blur(L, Lbig, w, h, 6.0f);
+        else
+        {
+            double m = 0.0;
+            for (float v : L)
+                m += v;
+            Lbig.assign(n, static_cast<float>(m / n));
+        }
+        Blur(gate0, Gs0, w, h, 2.0f);
+        for (int i = 0; i < n; i++)
+            out[i * 4 + 2] = (L0[i] - Lbig[i]) * std::min(1.0f, 1.5f * Gs0[i]);
+    }
+    for (int i = 0; i < n; i++)
+        out[i * 4 + 3] = 1.0f;
+    unsigned c = 0;
+    glGenTextures(1, &c);
+    GL33Bind::Tex2D(EngineGL33::kUploadUnit - GL_TEXTURE0, c);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA16F, w, h, 0, GL_RGBA, GL_FLOAT, out.data());
+    glGenerateMipmap(GL_TEXTURE_2D);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_REPEAT);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_REPEAT);
+    float maxAniso = 1.0f;
+    glGetFloatv(GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT, &maxAniso);
+    if (maxAniso > 1.0f)
+        glTexParameterf(GL_TEXTURE_2D, GL_TEXTURE_MAX_ANISOTROPY_EXT, maxAniso < 8.0f ? maxAniso : 8.0f);
+    // Leave the albedo bound on the upload unit as UploadToGPU had it.
+    GL33Bind::Tex2D(EngineGL33::kUploadUnit - GL_TEXTURE0, tex);
+    GL33Bind::SetCompanion(tex, c);
+    const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+    g_ms += ms;
