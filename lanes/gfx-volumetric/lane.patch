+    vec2 ndc = (vUV - worldRect.xy) / worldRect.zw * 2.0 - 1.0;
+    vec3 rel = inverse(mat3(viewRot)) * (vec3(ndc.x * projInfo.z, ndc.y * projInfo.w, 1.0) * z);
