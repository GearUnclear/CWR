+    vec3 m1 = vec3(0.0);
+    vec3 m2 = vec3(0.0);
+    for (int j = -1; j <= 1; ++j) {
+        for (int i = -1; i <= 1; ++i) {
+            vec3 s = texture(curTex, vUV + vec2(i, j) * halfTexel.xy).rgb;
+            m1 += s;
+            m2 += s * s;
+        }
