+        vec2 puv = worldRect.xy + (pndc * 0.5 + 0.5) * worldRect.zw;
+        if (puv.x > 0.0 && puv.x < 1.0 && puv.y > 0.0 && puv.y < 1.0) {
+            vec4 h = texture(histTex, puv);
+            bool sameSurface = (cur.a >= 9e4 && h.a >= 9e4) || abs(h.a - pv.z) < 0.1 * pv.z + 0.5;
+            if (sameSurface) {
