+        const float sun = Luminance(rig.sun);
+        CHECK(rig.cloudCover >= lastCover);
+        CHECK(rig.cloudCover - lastCover < 0.005f);
+        CHECK(std::abs(sun - lastSun) < 0.005f * lastSun);
+        lastCover = rig.cloudCover;
+        lastSun = sun;
+    }
+    CHECK(lastCover == Catch::Approx(1.0f));
+}
