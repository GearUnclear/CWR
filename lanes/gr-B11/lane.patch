+// The mip level the GPU picks (kTdMaxAniso anisotropy) for uv derivatives dx,
+// dy on a texture of size ts.
+float tdLod(vec2 dx, vec2 dy, vec2 ts) {
+    float l1 = length(dx * ts);
+    float l2 = length(dy * ts);
