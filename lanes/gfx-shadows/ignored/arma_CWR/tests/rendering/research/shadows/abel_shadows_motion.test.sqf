// RESEARCH (shadows track) - generated by tmp/research/shadows/gen_tests.py. Not committed.
#include "capture_lib.sqf"

triSimUntil { alive player }

capWorld = "Abel"
capFov = 0.7
capSimT = 0
capPinTime = false
capUseView = false
capProps = []
capView = "setup"
capModeName = "none"
capLit = "none"
capGpu = "none"
capPerf = "none"

triCaptureAtPresent true
triSetMsaa 4
triSetRenderScale 1.5
showCinemaBorder false
enableRadio false
player setCaptive true
player allowDamage false

createCenter west
createCenter east
capGrpW = createGroup west
capProbe = "HeliHEmpty" createVehicle [7300, 10900, 0]
capCam = "camera" camCreate [7300, 10900, 2]
capCam cameraEffect ["internal", "back"]

triSimFrames 240
call { "view=setup;event=setup;world=Abel;msaa=4;scale=1.5;window=960x640;capture=present" call capLog }


// [frame index, metres to the right] call capMoveTo: camera to the base view
// shifted sideways, sim clock pinned to base + k frames.
capMoveTo = {
    private ["_k", "_s"];
    _k = _this select 0;
    _s = _this select 1;
    capOX = capBX + _s * (cos capH);
    capOZ = capBZ - _s * (sin capH);
    capSimRes = triSetSimTime (capSimT + _k / 30);
    [] call capPinView;
}


