+
+// Research (haze track): keep the finished sky pass (dome, sun, moon, stars,
+// clouds) as a mipmapped texture on unit 6, so the world shaders can fade
+// distant geometry into the sky that is actually behind it. Called by
+// Landscape::Draw between the sky and the ground. Research code, not
+// production: no reset handling beyond a size check, unit 6 assumed free.
+void EngineGL33::CaptureSkyBackdrop()
+{
+    {
+        static int s_skyLog = 0;
+        if ((s_skyLog++ % 600) == 0)
+            LOG_INFO(Graphics, "GL33 haze: CaptureSkyBackdrop lighting={} ssaa={} portrait={} ended={} nv={}",
+                     _lightingActive, SSAAActive(), _portraitTargetSize, _worldSceneEnded, _nightVision);
+    }
+    // The sky draws through pre-lit screen-space vertices, so the world's 3D
+    // pass (and _remasterPrograms / _worldEffectsOn) has not begun yet here.
+    if (!_lightingActive || !SSAAActive() || _portraitTargetSize || _worldSceneEnded || _nightVision)
+        return;
+    GLint prevDraw = 0, prevRead = 0, prevViewport[4] = {};
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &prevDraw);
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &prevRead);
+    glGetIntegerv(GL_VIEWPORT, prevViewport);
+    FlushAndFreeAllQueues(_queueNo);
+    int w = 0, h = 0;
+    RenderTargetSize(w, h);
+    if (w <= 0 || h <= 0)
+        return;
+    if (!_skyBackdropTex || _skyBackdropW != w || _skyBackdropH != h)
+    {
+        if (_skyBackdropFbo)
+        {
+            glDeleteFramebuffers(1, &_skyBackdropFbo);
+            _skyBackdropFbo = 0;
+        }
+        if (_skyBackdropTex)
+        {
+            GL33Bind::OnTexDeleted(_skyBackdropTex);
+            glDeleteTextures(1, &_skyBackdropTex);
+            _skyBackdropTex = 0;
+        }
+        GL33Bind::ActiveUnit(kUploadUnit - GL_TEXTURE0);
+        glGenTextures(1, &_skyBackdropTex);
+        glBindTexture(GL_TEXTURE_2D, _skyBackdropTex);
+        int levels = 0;
+        for (int lw = w, lh = h;; lw = lw > 1 ? lw / 2 : 1, lh = lh > 1 ? lh / 2 : 1)
+        {
+            glTexImage2D(GL_TEXTURE_2D, levels++, GL_RGBA8, lw, lh, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+            if (lw == 1 && lh == 1)
+                break;
+        }
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, levels - 1);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        glBindTexture(GL_TEXTURE_2D, 0);
+        glGenFramebuffers(1, &_skyBackdropFbo);
+        glBindFramebuffer(GL_FRAMEBUFFER, _skyBackdropFbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, _skyBackdropTex, 0);
+        if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE)
+            LOG_WARN(Graphics, "GL33 haze: sky backdrop target {}x{} incomplete", w, h);
+        else
+            LOG_INFO(Graphics, "GL33 haze: sky backdrop {}x{}, {} levels", w, h, levels);
+        _skyBackdropW = w;
+        _skyBackdropH = h;
+        GL33Bind::Invalidate();
+    }
+    const GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST);
+    glDisable(GL_SCISSOR_TEST);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, _ssaaFbo);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, _skyBackdropFbo);
+    glBlitFramebuffer(0, 0, w, h, 0, 0, w, h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    if (scissor)
+        glEnable(GL_SCISSOR_TEST);
+    GL33Bind::Tex2D(6, _skyBackdropTex);
+    glGenerateMipmap(GL_TEXTURE_2D);
+    GL33Bind::ActiveUnit(0);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, static_cast<GLuint>(prevDraw));
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(prevRead));
+    glViewport(prevViewport[0], prevViewport[1], prevViewport[2], prevViewport[3]);
+    GL33Bind::Invalidate();
+    InvalidatePipelineCache();
+}
