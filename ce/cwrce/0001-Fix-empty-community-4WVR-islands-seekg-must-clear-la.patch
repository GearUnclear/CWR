From 6d8c4f5593fb11a1014769aa1c79bfcf37546685 Mon Sep 17 00:00:00 2001
From: GearUnclear <dane@danewagenhoffer.com>
Date: Fri, 17 Jul 2026 02:03:24 -0700
Subject: [PATCH 1/2] Fix empty community (4WVR) islands: seekg must clear
 latched EOF

Community-made islands in the 4WVR/RVW .wrp format (WrpTool-era
terrains) load with terrain and textures intact but zero wrp-embedded
objects: no buildings, walls, or trees. The 2001/1.99 engine loads the
same files correctly. BIS islands are OPRW (binarized) and unaffected.

Root cause: Landscape::LoadData (engine/Poseidon/World/Terrain/
LandSave.cpp) probes every world with WrpReader via LoadOptimized (the
OPRW fast path). For a non-OPRW world the probe parses the whole file
to EOF before being rejected for its format, latching the stream's
_eof. The RVW fallback then seeks back to the start and re-parses, but
QIStream::seekg cleared only _fail, so _eof stayed latched. The
header/heightmap/texture reads never consult eof(), which is why
terrain loads fine, but the object loop's first
`if (f.fail() || f.eof()) break;` trips immediately and creates zero
objects. Debug-log fingerprint: `Total 1 objects, max. id -1` (the
counter increments before the first read).

Evidence: a large community 4WVR island containing 81,383 valid
128-byte object records parses fully via WrpReader from a plain file
stream, while in-game the same file loads with zero objects. The
shipped CWA Remastered Steam binary shares this code and reproduces
the bug identically.

Fix: a successful seekg now clears _eof alongside _fail, matching
C++11 std::istream::seekg semantics (which clear eofbit).

Adds a regression test that builds a synthetic RVW v4 blob in memory
and asserts the probe-parse-to-EOF, seekg-back, re-parse sequence
leaves eof() clear after the seek and sees the full object list on the
second parse. Verified red/green: without the fix it fails on the
eof() check after seekg.
---
 engine/Poseidon/IO/Streams/QStream.hpp        |  4 +-
 .../Poseidon/Asset/Formats/test_wrp.cpp       | 60 +++++++++++++++++++
 2 files changed, 63 insertions(+), 1 deletion(-)

diff --git a/engine/Poseidon/IO/Streams/QStream.hpp b/engine/Poseidon/IO/Streams/QStream.hpp
index a0efcb8..906ac3c 100644
--- a/engine/Poseidon/IO/Streams/QStream.hpp
+++ b/engine/Poseidon/IO/Streams/QStream.hpp
@@ -150,7 +150,9 @@ class QIStream
         }
         else
         {
-            _readFrom = static_cast<int>(nPos), _fail = false;
+            _readFrom = static_cast<int>(nPos);
+            _fail = false;
+            _eof = false;
         }
     }
     bool fail() const { return _fail; }
diff --git a/tests/unit/engine/Poseidon/Asset/Formats/test_wrp.cpp b/tests/unit/engine/Poseidon/Asset/Formats/test_wrp.cpp
index f238773..9c61ffa 100644
--- a/tests/unit/engine/Poseidon/Asset/Formats/test_wrp.cpp
+++ b/tests/unit/engine/Poseidon/Asset/Formats/test_wrp.cpp
@@ -5,6 +5,7 @@
 #include <stdio.h>
 #include <catch2/catch_message.hpp>
 #include <string>
+#include <vector>
 #include <Poseidon/Foundation/platform.hpp>
 
 using namespace Poseidon;
@@ -96,3 +97,62 @@ TEST_CASE("WRP: WrpReader reports error for invalid data", "[Formats][WRP]")
 
     remove(tmpPath);
 }
+
+static std::vector<char> BuildRvw4Blob()
+{
+    std::vector<char> blob;
+    auto put = [&blob](const void* p, size_t n) {
+        const char* c = static_cast<const char*>(p);
+        blob.insert(blob.end(), c, c + n);
+    };
+
+    put("4WVR", 4);
+    int range = 4;
+    put(&range, 4); // xRange
+    put(&range, 4); // zRange
+
+    short cell = 0;
+    for (int i = 0; i < 4 * 4; i++)
+        put(&cell, sizeof(cell)); // heightmap
+    for (int i = 0; i < 4 * 4; i++)
+        put(&cell, sizeof(cell)); // texture indices
+
+    char texName[32] = "landtext\mo.pac";
+    put(texName, sizeof(texName));
+    char emptyTex[32] = {};
+    for (int i = 1; i < 512; i++)
+        put(emptyTex, sizeof(emptyTex));
+
+    for (int id = 0; id < 2; id++)
+    {
+        float matrix[12] = {1, 0, 0, 0, 1, 0, 0, 0, 1, 100.0f + id, 0, 200.0f};
+        put(matrix, sizeof(matrix));
+        put(&id, sizeof(id));
+        char name[76] = {};
+        snprintf(name, sizeof(name), "data3d\dummy%d.p3d", id);
+        put(name, sizeof(name));
+    }
+    return blob;
+}
+
+TEST_CASE("WRP: RVW re-parse after a probe-to-EOF and seekg sees all objects", "[Formats][WRP]")
+{
+    std::vector<char> blob = BuildRvw4Blob();
+
+    QIStream s(blob.data(), (int)blob.size());
+
+    WrpReader probe;
+    REQUIRE(probe.Load(s));
+    REQUIRE(probe.GetFormat() == WrpReader::RVW_V4);
+    REQUIRE(probe.GetObjectCount() == 2);
+
+    s.seekg(0, QIOS::beg);
+    REQUIRE_FALSE(s.fail());
+    REQUIRE_FALSE(s.eof());
+
+    WrpReader fallback;
+    REQUIRE(fallback.Load(s));
+    REQUIRE(fallback.GetFormat() == WrpReader::RVW_V4);
+    REQUIRE(fallback.GetObjectCount() == 2);
+    REQUIRE(std::string((const char*)fallback.GetObject(0).name) == "data3d\dummy0.p3d");
+}
