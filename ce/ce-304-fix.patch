@@ -2,6 +2,46 @@
 
 #include <Poseidon/AI/AI.hpp>
 #include <Poseidon/Network/Network.hpp>
+#include <Poseidon/Network/NetworkMessages.hpp>
+#include <catch2/generators/catch_generators.hpp>
+
+NetworkMessageIndices* GetIndicesExplosionDammageEffects();
+
+TEST_CASE("Impact surface survives network message transfer", "[network][weapon-impact]")
+{
+    class ImpactFormat : public NetworkMessageFormat
+    {
+      public:
+        void RemoveWeaponField() { _items.Resize(_items.Size() - 1); }
+    };
+    ImpactFormat format;
+    ExplosionDammageEffectsMessage::CreateFormat(NMCCreate, format);
+    const bool legacy = GENERATE(false, true);
+    if (legacy)
+        format.RemoveWeaponField();
+    format.Init(GetIndicesExplosionDammageEffects());
+
+    ExplosionDammageEffectsMessage source;
+    source.owner = nullptr;
+    source.shot = nullptr;
+    source.directHit = nullptr;
+    source.pos = Vector3(1, 2, 3);
+    source.dir = VForward;
+    source.type = "BulletSingleW";
+    source.enemyDammage = false;
+    source.weaponHit = GENERATE(false, true);
+    NetworkMessage message;
+    NetworkMessageContext sending(&message, &format, nullptr, 0, true);
+    REQUIRE(source.TransferMsg(sending) == TMOK);
+
+    ExplosionDammageEffectsMessage observer;
+    CHECK_FALSE(observer.weaponHit);
+    NetworkMessageContext receiving(&message, &format, nullptr, 0, false);
+    REQUIRE(observer.TransferMsg(receiving) == TMOK);
+    CHECK(observer.weaponHit == (!legacy && source.weaponHit));
+    CHECK(observer.type == source.type);
+    CHECK(observer.pos == source.pos);
+}
 
