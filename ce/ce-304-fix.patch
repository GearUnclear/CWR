@@ -45,6 +45,40 @@ class CollisionShape : public LODShapeWithShadow
 };
 } // namespace
 
+TEST_CASE("Fire intersections carry weapon surfaces and skip absent weapons", "[World][Collision][weapon-impact]")
+{
+    class WeaponObject : public ObjectPlain
+    {
+      public:
+        using ObjectPlain::ObjectPlain;
+        CollisionSurface surface = CollisionSurface::Weapon;
+        CollisionSurface GetCollisionSurface(int, int) const override { return surface; }
+    };
+    Ref<CollisionShape> shape = new CollisionShape();
+    Ref<WeaponObject> object = new WeaponObject(shape, 1);
+    const auto type = GENERATE(ObjIntersectFire, ObjIntersectIFire);
+    CollisionBuffer collisions;
+    object->Intersect(collisions, Vector3(0, 0, -2), Vector3(0, 0, 2), 0, type);
+    REQUIRE(collisions.Size() == 1);
+    CHECK(collisions[0].weaponHit);
+
+    object->surface = CollisionSurface::Ignored;
+    collisions.Clear();
+    object->Intersect(collisions, Vector3(0, 0, -2), Vector3(0, 0, 2), 0, type);
+    CHECK(collisions.Size() == 0);
+
+    // Physical geometry retains its original behavior regardless of weapon visibility.
+    object->Intersect(collisions, Vector3(0, 0, -2), Vector3(0, 0, 2), 0, ObjIntersectGeom);
+    REQUIRE(collisions.Size() == 1);
+    CHECK_FALSE(collisions[0].weaponHit);
+
+    object->surface = CollisionSurface::Default;
+    collisions.Clear();
+    object->Intersect(collisions, Vector3(0, 0, -2), Vector3(0, 0, 2), 0, type);
+    REQUIRE(collisions.Size() == 1);
+    CHECK_FALSE(collisions[0].weaponHit);
+}
