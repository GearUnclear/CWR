 #include <catch2/catch_test_macros.hpp>
 #include <Poseidon/World/Simulation/Animation/Animation.hpp>
 #include <Poseidon/World/Simulation/Animation/RtAnimation.hpp>
+#include <Poseidon/Graphics/Rendering/Shape/Shape.hpp>
+
+using namespace Poseidon;
+
+TEST_CASE("Collision components require exclusive bone membership", "[animation][weapon-impact]")
+{
+    Ref<Shape> shape = new Shape();
+    shape->Init(4);
+    const SelInfo componentPoints[] = {{0, 255}, {1, 255}, {2, 255}};
+    const NamedSelection component("arbitrary_component_name", componentPoints, 3, nullptr, 0);
+    AnimationRTWeights weights(shape);
+    const auto addBone = [&](const char* name, const SelInfo* points, int count, int bone)
+    {
+        shape->AddNamedSel(NamedSelection(name, points, count, nullptr, 0));
+        weights.AddSelection(shape, shape->FindNamedSel(name), bone);
+    };
+
+    SECTION("rifle and launcher bone indices need not be fixed")
+    {
+        addBone("zbran", componentPoints, 3, 17);
+        const SelInfo launcherPoint[] = {{3, 255}};
+        addBone("roura", launcherPoint, 1, 29);
+        weights.Normalize();
+        CHECK(weights.FindComponentBone(component) == 17);
+        CHECK(weights.FindComponentBone(NamedSelection("other", launcherPoint, 1, nullptr, 0)) == 29);
+    }
+    SECTION("body overlap retains body collisions")
+    {
+        addBone("zbran", componentPoints, 3, 17);
+        const SelInfo bodyPoint[] = {{1, 128}};
+        addBone("body", bodyPoint, 1, 4);
+        weights.Normalize();
+        CHECK(weights.FindComponentBone(component) == -1);
+    }
+    SECTION("different bones on different vertices are mixed")
+    {
+        addBone("zbran", componentPoints, 2, 17);
+        addBone("roura", componentPoints + 2, 1, 29);
+        weights.Normalize();
+        CHECK(weights.FindComponentBone(component) == -1);
+    }
+    SECTION("partly unweighted components retain body collisions")
+    {
+        addBone("zbran", componentPoints, 2, 17);
+        weights.Normalize();
+        CHECK(weights.FindComponentBone(component) == -1);
+    }
+    SECTION("empty or invalid selections do not classify as weapons")
+    {
+        CHECK(weights.FindComponentBone(NamedSelection("empty", nullptr, 0, nullptr, 0)) == -1);
+        const SelInfo invalidPoint[] = {{9, 255}};
+        CHECK(weights.FindComponentBone(NamedSelection("invalid", invalidPoint, 1, nullptr, 0)) == -1);
+    }
+}
 
