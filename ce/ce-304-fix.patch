+++ b/tests/integration/ingame/units/weapon_impacts.test.sqf
@@ -0,0 +1,76 @@
+// Issue #304: stock SoldierEB fire components 12/13 are rifle/launcher.
+// Classification uses bones in production; these indices belong only to this fixture.
+setAccTime 0
+player setPos [7600,5890,0]
+corpse304 addWeapon "RPGLauncher"
+triAssertEq [((triFireGeometry corpse304) select 12) select 1, 1]
+triAssertEq [((triFireGeometry corpse304) select 13) select 1, 1]
+corpse304 setDammage 0
+
+// rifle impact: verify the nearest component, then exercise the real projectile path.
+tri304Row = (triFireGeometry corpse304) select 12
+tri304X = tri304Row select 2
+tri304Y = tri304Row select 3
+tri304Z = tri304Row select 4
+triAssertEq [triTraceFire [corpse304,[tri304X,tri304Y,tri304Z+0.8],[tri304X,tri304Y,tri304Z-0.2]], [12,true]]
+tri304Shot = "BulletSingleW" createVehicle [tri304X,tri304Z+0.8,30]
+tri304Shot setPosASL [tri304X,tri304Z+0.8,tri304Y]
+tri304Shot setVelocity [0,-200,0]
+setAccTime 0.25
+triSimFrames 15
+setAccTime 0
+triAssertEq [getDammage corpse304, 0]
+
+// launcher impact: verify the nearest component, then exercise the real projectile path.
+tri304Row = (triFireGeometry corpse304) select 13
+tri304X = tri304Row select 2
+tri304Y = tri304Row select 3
+tri304Z = tri304Row select 4
+triAssertEq [triTraceFire [corpse304,[tri304X,tri304Y,tri304Z+0.8],[tri304X,tri304Y,tri304Z-0.2]], [13,true]]
+tri304Shot = "BulletSingleW" createVehicle [tri304X,tri304Z+0.8,30]
+tri304Shot setPosASL [tri304X,tri304Z+0.8,tri304Y]
+tri304Shot setVelocity [0,-200,0]
+setAccTime 0.25
+triSimFrames 15
+setAccTime 0
+triAssertEq [getDammage corpse304, 0]
+
+// body impact: verify the nearest component, then exercise the real projectile path.
+tri304Row = (triFireGeometry corpse304) select 2
+tri304X = tri304Row select 2
+tri304Y = tri304Row select 3
+tri304Z = tri304Row select 4
+triAssertEq [triTraceFire [corpse304,[tri304X,tri304Y,tri304Z+0.8],[tri304X,tri304Y,tri304Z-0.2]], [2,false]]
+tri304Shot = "BulletSingleW" createVehicle [tri304X,tri304Z+0.8,30]
+tri304Shot setPosASL [tri304X,tri304Z+0.8,tri304Y]
+tri304Shot setVelocity [0,-200,0]
+setAccTime 0.25
+triSimFrames 15
+setAccTime 0
+triAssertGt [getDammage corpse304, 0]
+
+// Pickup/removal must not leave either invisible collision component active.
+corpse304 removeWeapon "AK74"
+triAssertEq [((triFireGeometry corpse304) select 12) select 1, 2]
+corpse304 addWeapon "AK74"
+triAssertEq [((triFireGeometry corpse304) select 12) select 1, 1]
+corpse304 removeWeapon "RPGLauncher"
+triAssertEq [((triFireGeometry corpse304) select 13) select 1, 2]
+corpse304 addWeapon "RPGLauncher"
+triAssertEq [((triFireGeometry corpse304) select 13) select 1, 1]
+
+// Explosive damage remains active even on a weapon component.
+corpse304 setDammage 0
+tri304Row = (triFireGeometry corpse304) select 12
+tri304X = tri304Row select 2
+tri304Y = tri304Row select 3
+tri304Z = tri304Row select 4
+triAssertEq [triTraceFire [corpse304,[tri304X,tri304Y,tri304Z+0.8],[tri304X,tri304Y,tri304Z-0.2]], [12,true]]
+tri304Shot = "Shell73" createVehicle [tri304X,tri304Z+0.8,30]
+tri304Shot setPosASL [tri304X,tri304Z+0.8,tri304Y]
+tri304Shot setVelocity [0,-200,0]
+setAccTime 0.25
+triSimFrames 15
+setAccTime 0
+triAssertGt [getDammage corpse304, 0]
+triEndTest
