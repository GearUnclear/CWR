+int AnimationRTWeights::FindComponentBone(const NamedSelection& component) const
+{
+    int bone = -1;
+    for (int i = 0; i < component.Size(); ++i)
+    {
+        const int vertex = component[i];
+        if (vertex < 0 || vertex >= _data.Size())
+            return -1;
+        const AnimationRTWeight& weights = _data[vertex];
+        int vertexBone = -1;
+        for (int j = 0; j < weights.Size(); ++j)
+        {
+            if (weights[j].GetWeight() <= 0)
+                continue;
+            const int selection = weights[j].GetSel();
+            if (selection < 0 || (vertexBone >= 0 && vertexBone != selection))
+                return -1;
+            vertexBone = selection;
+        }
+        // Mixed or unweighted components retain their original collision behavior.
+        if (vertexBone < 0 || (bone >= 0 && bone != vertexBone))
+            return -1;
+        bone = vertexBone;
+    }
+    return bone;
+}
