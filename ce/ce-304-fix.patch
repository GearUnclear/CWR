+/// triFireGeometry object -> [component index, surface (0=body, 1=weapon, 2=absent),
+/// world X, world Y (height), world Z] rows. Uses the animated collision geometry.
+GameValue TriFireGeometry(const GameState* state, GameValuePar arg)
+{
+    GameValue result = state->CreateGameValue(GameArray);
+    GameArrayType& rows = result;
+    Object* object = GetObject(arg);
+    if (!object || !object->GetShape())
+        return result;
+    LODShape* shape = object->GetShape();
+    const int level = shape->FindFireGeometryLevel();
+    if (level < 0)
+        return result;
+    ConvexComponents* components = shape->GetConvexComponents(level);
+    if (!components)
+        return result;
+    object->AnimateComponentLevel(level);
+    components->RecalculateAsNeeded(shape->LevelOpaque(level));
+    for (int i = 0; i < components->Size(); ++i)
+    {
+        const Vector3 position = object->PositionModelToWorld(components->Get(i)->GetCenter());
+        GameValue row = state->CreateGameValue(GameArray);
+        GameArrayType& values = row;
+        values.Add(GameValue(float(i)));
+        values.Add(GameValue(float(object->GetCollisionSurface(level, i))));
+        values.Add(GameValue(position.X()));
+        values.Add(GameValue(position.Y()));
+        values.Add(GameValue(position.Z()));
+        rows.Add(row);
+    }
+    object->DeanimateComponentLevel(level);
+    return result;
+}
+
+/// triTraceFire [object, [x,y,z], [x,y,z]] -> [nearest component, weapon hit].
+/// Coordinates use engine axes (Y is height), as in triFireGeometry.
+GameValue TriTraceFire(const GameState* state, GameValuePar arg)
+{
+    GameValue result = state->CreateGameValue(GameArray);
+    GameArrayType& values = result;
+    const GameArrayType& args = arg;
+    if (args.Size() != 3 || args[0].GetType() != GameObject || args[1].GetType() != GameArray ||
+        args[2].GetType() != GameArray)
+        return result;
+    Object* object = GetObject(args[0]);
+    const GameArrayType& begin = args[1];
+    const GameArrayType& end = args[2];
+    if (!object || begin.Size() != 3 || end.Size() != 3)
+        return result;
+    CollisionBuffer collisions;
+    object->Intersect(collisions, Vector3(float(begin[0]), float(begin[1]), float(begin[2])),
+                      Vector3(float(end[0]), float(end[1]), float(end[2])), 0, ObjIntersectFire);
+    int nearest = -1;
+    for (int i = 0; i < collisions.Size(); ++i)
+        if (nearest < 0 || collisions[i].under < collisions[nearest].under)
+            nearest = i;
+    if (nearest >= 0)
+    {
+        values.Add(GameValue(float(collisions[nearest].component)));
+        values.Add(GameValue(collisions[nearest].weaponHit));
+    }
+    return result;
+}
+
+/// triBenchmarkFireGeometry [objects, iterations] -> [rays, intersections, milliseconds].
+/// Time only animated fire-geometry intersections; scene setup and rendering are excluded.
+GameValue TriBenchmarkFireGeometry(const GameState* state, GameValuePar arg)
+{
+    GameValue result = state->CreateGameValue(GameArray);
+    GameArrayType& values = result;
+    const GameArrayType& args = arg;
+    if (args.Size() != 2 || args[0].GetType() != GameArray || args[1].GetType() != GameScalar)
+        return result;
+    const GameArrayType& objects = args[0];
+    const int iterations = std::clamp(int(float(args[1])), 1, 1000000);
+    struct Ray { Object* object; Vector3 begin, end; };
+    std::vector<Ray> rays;
+    for (int i = 0; i < objects.Size(); ++i)
+    {
+        if (objects[i].GetType() != GameObject)
+            continue;
+        Object* object = GetObject(objects[i]);
+        if (!object || !object->GetShape())
+            continue;
+        LODShape* shape = object->GetShape();
+        const int level = shape->FindFireGeometryLevel();
+        if (level < 0)
+            continue;
+        ConvexComponents* components = shape->GetConvexComponents(level);
+        if (!components)
+            continue;
+        object->AnimateComponentLevel(level);
+        components->RecalculateAsNeeded(shape->LevelOpaque(level));
+        for (int j = 0; j < components->Size(); ++j)
+        {
+            const Vector3 center = object->PositionModelToWorld(components->Get(j)->GetCenter());
+            rays.push_back({object, center + Vector3(0, 0, 2), center - Vector3(0, 0, 2)});
+        }
+        object->DeanimateComponentLevel(level);
+    }
+    if (rays.empty())
+        return result;
+    CollisionBuffer collisions;
+    int hits = 0;
+    const auto start = std::chrono::steady_clock::now();
+    for (int i = 0; i < iterations; ++i)
+    {
+        const Ray& ray = rays[size_t(i) % rays.size()];
+        collisions.Clear();
+        ray.object->Intersect(collisions, ray.begin, ray.end, 0, ObjIntersectFire);
+        hits += collisions.Size();
+    }
+    const auto end = std::chrono::steady_clock::now();
+    values.Add(GameValue(float(iterations)));
+    values.Add(GameValue(float(hits)));
+    values.Add(GameValue(float(std::chrono::duration<double, std::milli>(end - start).count())));
+    return result;
+}
