+CollisionSurface Man::GetCollisionSurface(int level, int component) const
+{
+    const ManType* type = Type();
+    if (!type->_isMan || level != _shape->FindFireGeometryLevel() || component < 0 ||
+        component >= type->_fireGeometryComponentBones.Size())
+        return CollisionSurface::Default;
+
+    const int bone = type->_fireGeometryComponentBones[component];
+    if (bone < 0)
+        return CollisionSurface::Default;
+    if (bone == type->_gunMatIndex)
+        return _showPrimaryWeapon && FindWeaponType(MaskSlotPrimary) >= 0 ? CollisionSurface::Weapon
+                                                                         : CollisionSurface::Ignored;
+    if (bone == type->_rpgMatIndex)
+        return _showSecondaryWeapon && FindWeaponType(MaskSlotSecondary, MaskSlotPrimary) >= 0
+                   ? CollisionSurface::Weapon
+                   : CollisionSurface::Ignored;
+    return CollisionSurface::Default;
+}
