+mission = "tests/integration/missions/menu_return.Abel"
+binary = "PoseidonGame"
+tags = ["ui", "full_cwa", "headless"]
+timeout = 90
+assert_timeout = 20
+# The rejected missing-addon scene emits expected archive diagnostics.
+extra_args = ["--no-strict", "--mods-dir", "../../tests/fixtures/mods-menu-return", "--mod", "@allinvalid"]
diff --git a/tests/integration/ui/main_menu/return_retry_cutscenes.test.sqf b/tests/integration/ui/main_menu/return_retry_cutscenes.test.sqf
new file mode 100644
index 0000000..585dbc6
--- /dev/null
+++ b/tests/integration/ui/main_menu/return_retry_cutscenes.test.sqf
@@ -0,0 +1,11 @@
+// Preserve a valid island intro even when the other candidate has no groups.
+triSimUntil { triReturnMissionTicks > 0 }
+triAssertEq [(typeOf player), "SoldierWB"]
+triAssertEq [(triStartRandomCutscene), "OK"]
+triAssertEq [(triGameMode), 2]
+triAssertEq [(getWorld), "abel"]
+triSimUntil { triMenuGoodIntro }
+triReturnMissionTicks = 0
+triSimFrames 60
+triAssertEq [(triReturnMissionTicks), 0]
+triEndTest
