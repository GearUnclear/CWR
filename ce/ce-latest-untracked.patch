diff --git a/tests/integration/ui/main_menu/return_all_invalid_cutscenes.test.sqf b/tests/integration/ui/main_menu/return_all_invalid_cutscenes.test.sqf
new file mode 100644
index 0000000..5651249
--- /dev/null
+++ b/tests/integration/ui/main_menu/return_all_invalid_cutscenes.test.sqf
@@ -0,0 +1,11 @@
+// Empty groups and missing addons invalidate every island and default intro.
+triSimUntil { triReturnMissionTicks > 0 }
+triAssertEq [(typeOf player), "SoldierWB"]
+triAssertEq [(triStartRandomCutscene), "OK"]
+triAssertEq [(triGameMode), 2]
+triAssertEq [(isNull player), true]
+triReturnMissionTicks = 0
+triSimFrames 60
+triAssertEq [(triReturnMissionTicks), 0]
+triAssertEq [(isNull player), true]
+triEndTest
diff --git a/tests/integration/ui/main_menu/return_all_invalid_cutscenes.test.toml b/tests/integration/ui/main_menu/return_all_invalid_cutscenes.test.toml
